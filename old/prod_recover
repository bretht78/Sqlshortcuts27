-- =============================================================================
-- DAASI-3641 · PROD · RECOVER
-- =============================================================================
-- ONLY IF A CALL WAS CANCELLED OR CUT OFF (a statement timeout, say; closing
-- the tab or losing the connection does NOT stop a call). A cut-off call
-- still holds the run lock, its transaction may still be open, and the trip
-- chain is still paused. This ends the transaction, resumes the chain,
-- releases the lock and marks the run ABORTED (or keeps COMMITTED if it had
-- committed). Nothing it half-did is kept.
--
-- EDIT ONE LINE: put the cut-off run's run_id (DAASI_3641_RUNS, status
-- STARTED) in P_RUN_ID below. Run it in a NEW worksheet, as the same user,
-- once Query History shows the cut-off call is no longer running. Expect
-- RESULT = RECOVERED. Then run the FIX again.
--
-- How to run: paste the whole file into a NEW Snowsight worksheet, set the
-- worksheet's role and warehouse (Large or bigger) by hand, put the cursor
-- anywhere in the file and press Ctrl+Enter. It is one statement and uses
-- the worksheet's role and warehouse exactly as set (it switches neither).
-- Nothing to deploy, no session variables, nothing to edit (except where a
-- script says so).
-- =============================================================================
EXECUTE IMMEDIATE $$
DECLARE
    P_RUN_ID        VARCHAR DEFAULT '<paste the run_id here>';
    v_has_chain     BOOLEAN DEFAULT TRUE;
    v_status        VARCHAR;
    v_session       VARCHAR;
    v_paused        BOOLEAN;
    v_finished      TIMESTAMP_LTZ;
    v_running       NUMBER DEFAULT 0;
    v_look          VARCHAR;
    v_txn           NUMBER;
    v_aborted       VARCHAR DEFAULT 'none';
    v_holder        VARCHAR;
    v_task_state    VARCHAR;
    v_chain_msg     VARCHAR DEFAULT 'n/a (no chain)';
    v_lock_msg      VARCHAR;
    v_new_status    VARCHAR;
    e_bad_arg       EXCEPTION (-20646, 'DAASI-3641: pass a run_id exactly as DAASI_3641_RUNS shows it.');
    e_not_found     EXCEPTION (-20659, 'DAASI-3641: no such run in DAASI_3641_RUNS. Nothing was changed.');
    e_finished      EXCEPTION (-20660, 'DAASI-3641: that run finished on its own (it recorded finished_at and holds no lock), so there is nothing to recover. Nothing was changed.');
    e_still_running EXCEPTION (-20661, 'DAASI-3641: that run''s session still has a query running, so the call may still be going. Nothing was changed. Check Query History and try again later.');
    e_open_txn      EXCEPTION (-20657, 'DAASI-3641: this session has a transaction open (left by a cancelled call?), so nothing was done. Use a new worksheet. If that call was RUN_ALL or ROLLBACK: run DAASI_3641_RECOVER for that run_id: the RECOVER script with the run_id at its top, or CALL DAASI_3641_RECOVER(''<run_id>'').');
BEGIN
    -- Never inside a transaction left open by a cancelled call: the table
    -- statements below are DDL, and DDL would commit it (with whatever that call
    -- had half done). Use a new worksheet; RECOVER cleans the old one up.
    IF (CURRENT_TRANSACTION() IS NOT NULL) THEN
        RAISE e_open_txn;
    END IF;
    IF (P_RUN_ID IS NULL OR NOT REGEXP_LIKE(P_RUN_ID, '[0-9]{8}_[0-9]{6,9}')) THEN
        RAISE e_bad_arg;
    END IF;
    -- the six working tables, created only if missing (DDL, so before any transaction)
    CREATE TABLE IF NOT EXISTS DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_RUNS (
        run_id          VARCHAR(20),
        kind            VARCHAR(10),      -- RUN or ROLLBACK
        from_dt         DATE,
        to_dt           DATE,
        status          VARCHAR(20),      -- STARTED, COMMITTED, NOTHING_TO_DO, CHECKS_FAILED, CHAIN_BUSY,
                                          -- CHAIN_PAUSED, LOCK_BUSY, ERROR, ABORTED, ROLLED_BACK
        chain_paused    BOOLEAN,          -- TRUE while this run holds the trip chain paused
        started_at      TIMESTAMP_LTZ,
        committed_at    TIMESTAMP_LTZ,
        finished_at     TIMESTAMP_LTZ,
        trips_retired   NUMBER(38,0),
        trips_copied    NUMBER(38,0),
        details_moved   NUMBER(38,0),
        scan_from       DATE,
        scan_to         DATE,
        run_by          VARCHAR(200),
        session_id      VARCHAR(100),     -- the Snowflake session that ran it (RECOVER uses it)
        message         VARCHAR(4000)
    );
    CREATE TABLE IF NOT EXISTS DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_CHECKS (
        run_id          VARCHAR(20),
        phase           VARCHAR(10),      -- GATE, POST1, POST3, ROLLBACK, PREFLIGHT, RECOVER
        check_no        NUMBER(4,0),
        check_name      VARCHAR(200),
        expected        VARCHAR(100),
        actual          VARCHAR(100),
        passed          BOOLEAN,          -- NULL = information only
        checked_at      TIMESTAMP_LTZ
    );
    CREATE TABLE IF NOT EXISTS DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_LOG (
        run_id             VARCHAR(20),
        logged_at          TIMESTAMP_NTZ,
        from_dt            DATE,
        to_dt              DATE,
        action             VARCHAR(10),
        trip_master_id     NUMBER(38,0),  -- RETIRE: the old market trip.  COPY: the source property trip.
        new_trip_master_id NUMBER(38,0),  -- COPY only: the new market trip
        market_cd          VARCHAR(100),
        trip_start_dt      DATE,
        trip_end_dt        DATE
    );
    CREATE TABLE IF NOT EXISTS DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TM AS
    SELECT CAST(NULL AS VARCHAR(20)) AS run_id, t.*
    FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER t
    WHERE FALSE;
    CREATE TABLE IF NOT EXISTS DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TD AS
    SELECT CAST(NULL AS VARCHAR(20)) AS run_id, d.*
    FROM DAAS_PROD.DAAS_CORE.TRIP_DETAIL d
    WHERE FALSE;
    -- (created with its one row)
    CREATE TABLE IF NOT EXISTS DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_LOCK AS
    SELECT CAST(NULL AS VARCHAR(20)) AS holder, CAST(NULL AS TIMESTAMP_LTZ) AS since;
    SELECT MAX(status), MAX(session_id), BOOLOR_AGG(chain_paused), MAX(finished_at)
    INTO :v_status, :v_session, :v_paused, :v_finished
    FROM DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_RUNS WHERE run_id = :P_RUN_ID;
    IF (v_status IS NULL) THEN
        RAISE e_not_found;
    END IF;
    SELECT MAX(holder) INTO :v_holder FROM DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_LOCK;
    IF (v_finished IS NOT NULL AND COALESCE(v_holder, '') <> P_RUN_ID) THEN
        RAISE e_finished;
    END IF;

    -- 1. Is the call really over? Only this user's queries are visible, and a look
    --    that fails cannot tell: both are reported, so the person checks Query
    --    History themselves before calling (the run sheet says so).
    BEGIN
        SELECT COUNT(*) INTO :v_running
        FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.QUERY_HISTORY_BY_SESSION(SESSION_ID => TO_NUMBER(:v_session), RESULT_LIMIT => 1000))
        WHERE execution_status IN ('RUNNING', 'BLOCKED', 'QUEUED', 'RESUMING_WAREHOUSE', 'QUEUED_REPAIRING_WAREHOUSE')
          AND query_text ILIKE '%DAASI_3641_%';
        v_look := TO_VARCHAR(v_running) || ' seen (this user''s queries only)';
    EXCEPTION
        WHEN OTHER THEN
            v_running := 0;
            v_look := LEFT('could not look: ' || SQLERRM, 100);
    END;
    IF (v_running > 0) THEN
        RAISE e_still_running;
    END IF;

    -- 2. End the run's open transactions (its session's, as far as this user can see
    --    them), one at a time.
    SHOW TRANSACTIONS;
    LET rs_txn RESULTSET := (SELECT "id" AS txn_id
                             FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
                             WHERE TO_VARCHAR("session") = :v_session);
    LET c_txn CURSOR FOR rs_txn;
    FOR rec IN c_txn DO
        v_txn := rec.txn_id;
        BEGIN
            SELECT SYSTEM$ABORT_TRANSACTION(:v_txn);
            v_aborted := IFF(v_aborted = 'none', '', v_aborted || '; ') || 'ended ' || TO_VARCHAR(v_txn);
        EXCEPTION
            WHEN OTHER THEN
                v_aborted := IFF(v_aborted = 'none', '', v_aborted || '; ') || 'could not end ' || TO_VARCHAR(v_txn) || ': ' || SQLERRM;
        END;
    END FOR;

    -- 3. Resume the trip chain if this run had paused it.
    IF (v_has_chain) THEN
        IF (COALESCE(v_paused, FALSE)) THEN
            SHOW TASKS LIKE 'TRIP_ROOT_TASK' IN SCHEMA DAAS_PROD.DAAS_COMMON;
            SELECT MAX("state") INTO :v_task_state FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
            IF (v_task_state = 'suspended') THEN
                ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK RESUME;
                v_chain_msg := 'resumed';
            ELSE
                v_chain_msg := 'already ' || COALESCE(v_task_state, 'not visible');
            END IF;
        ELSE
            v_chain_msg := 'the run had not paused it';
        END IF;
    END IF;

    -- 4. Release the lock if this run holds it, and close the run.
    IF (v_holder = P_RUN_ID) THEN
        UPDATE DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = NULL, since = NULL WHERE holder = :P_RUN_ID;
        v_lock_msg := 'released';
    ELSE
        v_lock_msg := COALESCE('held by ' || v_holder, 'was already free');
    END IF;
    v_new_status := IFF(v_status = 'STARTED', 'ABORTED', v_status);
    UPDATE DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_RUNS
       SET status = :v_new_status, chain_paused = FALSE, finished_at = COALESCE(finished_at, CURRENT_TIMESTAMP()),
           message = LEFT(COALESCE(message, '') || ' Closed by RECOVER as ' || CURRENT_USER() || '.', 4000)
     WHERE run_id = :P_RUN_ID;

    INSERT INTO DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_CHECKS
        (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    SELECT  :P_RUN_ID, 'RECOVER', 1, 'Queries of the run''s session still going', '0 seen', LEFT(:v_look, 100), NULL, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :P_RUN_ID, 'RECOVER', 2, 'Open transactions of the run''s session', 'ended, or none visible', LEFT(:v_aborted, 100), NULL, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :P_RUN_ID, 'RECOVER', 3, 'Trip chain', 'running', :v_chain_msg, NULL, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :P_RUN_ID, 'RECOVER', 4, 'Run lock', 'released', :v_lock_msg, :v_lock_msg IN ('released', 'was already free'), CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :P_RUN_ID, 'RECOVER', 5, 'Run status', 'ABORTED (or COMMITTED if it had committed)', :v_new_status, NULL, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :P_RUN_ID, 'RECOVER', 99, 'RESULT', 'RECOVERED', 'RECOVERED', TRUE, CURRENT_TIMESTAMP();

    LET rs RESULTSET := (SELECT check_name, expected, actual, passed
                         FROM DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_CHECKS
                         WHERE run_id = :P_RUN_ID AND phase = 'RECOVER'
                           AND checked_at = (SELECT MAX(checked_at) FROM DAAS_PROD.DAAS_TEMP_WORK.DAASI_3641_CHECKS
                                             WHERE run_id = :P_RUN_ID AND phase = 'RECOVER')
                         ORDER BY check_no);
    RETURN TABLE(rs);
END;
$$;
