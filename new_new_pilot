-- DAASI-3641 UAT pilot: rebuild the broken BEM and WLM market trips of five guests through the trip pipeline's
-- own recalculation path, then prove the result at the transaction (SK) level and in every trip table.
--
-- What it does, in plain terms. A "trip" is the pipeline's grouping of one guest's transactions (ratings, hotel
-- nights, meals, comps...) into a visit with a start and end date. BEM and WLM are one-property markets, so each
-- market trip should be a copy of the property trip (same guest, same dates, same transactions). The old market
-- trips were built under a 7-day cap; the cap is now 1 (BEM) and 3 (WLM), and nothing in the hourly chain ever
-- shortens a trip that already exists. The pipeline does have a "rebuild this trip" door: a trip id written to
-- TRIP_RECALC_QUEUE makes TRIP_RECALCULATION_PROC retire the trip, re-cut its transactions under today's caps and
-- build the replacements with new ids; the merge, summary and comp-worth steps then finish the job, exactly as
-- they do every hour for trips touched by voids.
--
-- Changed in this version (after the first run of the block stopped at its preflight, with nothing changed):
-- B2 is new: it shows whether UAT's own trip chain will run, which roles you hold, and records who owns the
-- DAAS_TEMP objects the steps recreate. B3 offers two routes: route A lets UAT's chain run the steps as the
-- pipeline role (by its schedule, or one EXECUTE TASK), which is also how PROD will run; route B is the hand-run
-- block, whose preflight now also refuses to run beside a chain run or with secondary roles on, and names the
-- role it ran as. B4 confirms the run from the pipeline's own records. C8 restores ownership from B2's record.
-- Then, from B2's results (UAT's chain root is suspended; UAT has an on-demand task per step; no role you hold can
-- recreate the work tables): route A2 in B3a, one block that starts those on-demand tasks in chain order and waits
-- for each, is now the recommended run. B2a reads the task list's predecessors column as the array it is.
-- Parts A and B1 are unchanged and need not be run again.
--
-- One thing to expect, from the code: the comp-worth step (TRIP_COMP_WORTH_LOAD_PROC) values a market trip from
-- the property trips whose detail rows changed in the same run. Here only market rows change, so it will likely
-- write COMP_WORTH = 0 on the rebuilt market trips. Scoreboard rows 17-18 measure it. If confirmed, the fix is a
-- REPLAY_COUNTER bump on the same guests' ratings after the rebuild (next file), which re-presents property and
-- market rows together.
--
-- Roles. PART A, B1, B2, B4 and PART C run as DAAS_TEAM. The run itself (B3) needs the pipeline role: the steps
--        recreate DAAS_TEMP work tables owned by DOMAIN_TEMP_ADMIN_UAT and a stream owned by STREAM_OWNERS_UAT,
--        and every procedure switches to the job warehouse. UAT's tasks do this every run as APP_SERVICE_UAT.
-- Run statement by statement. Every check says what it expects.
-- Scratch tables (DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_*): GUESTS, LOG, MARKS, QUEUE, OWNERS,
-- TM/TD/TS/DAS _BEFORE/_AFTER.


-- ===================================================================================================
-- PART A. Pre-checks, scope and the before-picture (DAAS_TEAM, read-only on DAAS_CORE)
-- ===================================================================================================
USE ROLE DAAS_TEAM;
USE DATABASE DAAS_UAT;
USE SCHEMA DAAS_TEMP_WORK;

-- A0a. Code check for the four procedures this pilot now also runs (adds them to the table readiness E5 built).
EXECUTE IMMEDIATE $$
DECLARE
    c CURSOR FOR
        SELECT env, procedure_name, argument_signature,
               REGEXP_REPLACE(REPLACE(argument_signature, '"', ''), '[A-Za-z0-9_$]+ ([A-Za-z0-9_]+)', '\\1') AS types_only
        FROM (
            SELECT 'DAAS_PROD' AS env, procedure_name, argument_signature
            FROM DAAS_PROD.INFORMATION_SCHEMA.PROCEDURES
            WHERE procedure_schema = 'DAAS_COMMON'
            UNION ALL
            SELECT 'DAAS_UAT', procedure_name, argument_signature
            FROM DAAS_UAT.INFORMATION_SCHEMA.PROCEDURES
            WHERE procedure_schema = 'DAAS_COMMON'
        )
        WHERE procedure_name IN ('TRIP_COMP_WORTH_LOAD_PROC', 'TRIP_NG_REVENUE_SUMMARY_LOAD_PROC',
                                 'TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER_PROC', 'TRIP_CUSTOMER_MERGE_PROC')
        ORDER BY procedure_name, argument_signature, env;
    collected INTEGER DEFAULT 0;
BEGIN
    CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PROC_DDL (
        env VARCHAR, procedure_name VARCHAR, argument_signature VARCHAR, ddl VARCHAR, problem VARCHAR);
    DELETE FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PROC_DDL
     WHERE procedure_name IN ('TRIP_COMP_WORTH_LOAD_PROC', 'TRIP_NG_REVENUE_SUMMARY_LOAD_PROC',
                              'TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER_PROC', 'TRIP_CUSTOMER_MERGE_PROC');
    FOR r IN c DO
        LET v_env   VARCHAR := r.env;
        LET v_name  VARCHAR := r.procedure_name;
        LET v_sig   VARCHAR := r.argument_signature;
        LET v_types VARCHAR := r.types_only;
        LET v_ddl   VARCHAR := NULL;
        LET v_prob  VARCHAR := NULL;
        BEGIN
            LET q VARCHAR := 'SELECT GET_DDL(''PROCEDURE'', ''' || v_env || '.DAAS_COMMON.' || v_name || v_types || ''') AS ddl_text';
            LET rs RESULTSET := (EXECUTE IMMEDIATE :q);
            LET cur CURSOR FOR rs;
            FOR x IN cur DO
                v_ddl := x.ddl_text;
            END FOR;
        EXCEPTION
            WHEN OTHER THEN
                v_prob := SQLERRM;
        END;
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PROC_DDL VALUES (:v_env, :v_name, :v_sig, :v_ddl, :v_prob);
        collected := collected + 1;
    END FOR;
    RETURN collected || ' definitions added to DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PROC_DDL';
END;
$$;

-- A0b. Verdicts for every procedure collected so far, now also ignoring VARCHAR length declarations
--      (VARCHAR and VARCHAR(16777216) are the same type; two part-3 rows differed only in that).
--      The pass verdicts are 'identical', 'whitespace only', 'declarations only' and 'environment names only'.
WITH d AS (
    SELECT procedure_name, argument_signature,
           MAX(IFF(env = 'DAAS_PROD', ddl, NULL)) AS pd,
           MAX(IFF(env = 'DAAS_UAT',  ddl, NULL)) AS ud
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PROC_DDL
    GROUP BY 1, 2
),
norm AS (
    SELECT d.*,
           REGEXP_REPLACE(REPLACE(UPPER(pd), 'VARCHAR(16777216)', 'VARCHAR'), '\\s+', ' ') AS pw,
           REGEXP_REPLACE(REPLACE(UPPER(ud), 'VARCHAR(16777216)', 'VARCHAR'), '\\s+', ' ') AS uw,
           REGEXP_REPLACE(REPLACE(REPLACE(REPLACE(UPPER(pd), 'VARCHAR(16777216)', 'VARCHAR'), 'DAAS_PROD', 'DAAS_X'), 'PROD', 'X'), '\\s+', ' ') AS pn,
           REGEXP_REPLACE(REPLACE(REPLACE(REPLACE(UPPER(ud), 'VARCHAR(16777216)', 'VARCHAR'), 'DAAS_UAT',  'DAAS_X'), 'UAT',  'X'), '\\s+', ' ') AS un
    FROM d
),
pos AS (SELECT SEQ4() + 1 AS n FROM TABLE(GENERATOR(ROWCOUNT => 400000))),
firstdiff AS (
    SELECT nm.procedure_name, nm.argument_signature, MIN(pos.n) AS first_diff
    FROM norm nm
    JOIN pos ON pos.n <= GREATEST(LENGTH(nm.pn), LENGTH(nm.un))
    WHERE nm.pn IS NOT NULL AND nm.un IS NOT NULL
      AND COALESCE(SUBSTR(nm.pn, pos.n, 1), '') <> COALESCE(SUBSTR(nm.un, pos.n, 1), '')
    GROUP BY 1, 2
)
SELECT nm.procedure_name, nm.argument_signature,
       LENGTH(nm.pd) AS prod_chars, LENGTH(nm.ud) AS uat_chars,
       CASE WHEN nm.pd IS NULL THEN 'PROD definition not readable'
            WHEN nm.ud IS NULL THEN 'MISSING IN UAT'
            WHEN nm.pd = nm.ud THEN 'identical'
            WHEN REGEXP_REPLACE(nm.pd, '\\s+', ' ') = REGEXP_REPLACE(nm.ud, '\\s+', ' ') THEN 'whitespace only'
            WHEN nm.pw = nm.uw THEN 'declarations only'
            WHEN nm.pn = nm.un THEN 'environment names only'
            ELSE 'REAL DIFFERENCE' END AS verdict,
       f.first_diff,
       SUBSTR(nm.pn, GREATEST(COALESCE(f.first_diff, 1) - 60, 1), 140) AS prod_around_first_diff,
       SUBSTR(nm.un, GREATEST(COALESCE(f.first_diff, 1) - 60, 1), 140) AS uat_around_first_diff
FROM norm nm
LEFT JOIN firstdiff f ON f.procedure_name = nm.procedure_name AND f.argument_signature = nm.argument_signature
ORDER BY verdict = 'REAL DIFFERENCE' DESC, 1, 2;

-- A0c. The summary tables' columns, UAT against PROD. Expect no rows. A column the UAT procedures write but the
--      UAT table lacks makes the summary or comp-worth step fail (UAT's procedures still carry an older
--      CMP_PCT_MULT design next to PROD's COMP_WORTH; A0d shows which ones).
WITH u AS (
    SELECT table_name, column_name FROM DAAS_UAT.INFORMATION_SCHEMA.COLUMNS
    WHERE table_schema = 'DAAS_CORE' AND table_name IN ('TRIP_MASTER', 'TRIP_DETAIL', 'TRIP_SUMMARY', 'DAILY_ACTIVITY_SUMMARY')
),
p AS (
    SELECT table_name, column_name FROM DAAS_PROD.INFORMATION_SCHEMA.COLUMNS
    WHERE table_schema = 'DAAS_CORE' AND table_name IN ('TRIP_MASTER', 'TRIP_DETAIL', 'TRIP_SUMMARY', 'DAILY_ACTIVITY_SUMMARY')
)
SELECT COALESCE(u.table_name, p.table_name)   AS table_name,
       COALESCE(u.column_name, p.column_name) AS column_name,
       IFF(u.column_name IS NULL, 'in PROD, missing in UAT', 'in UAT only') AS verdict
FROM u
FULL OUTER JOIN p ON p.table_name = u.table_name AND p.column_name = u.column_name
WHERE u.column_name IS NULL OR p.column_name IS NULL
ORDER BY 1, 2;

-- A0d. Which collected procedures write the comp columns, per environment.
SELECT procedure_name, env,
       REGEXP_COUNT(ddl, 'CMP_PCT_MULT', 1, 'i') AS mentions_cmp_pct_mult,
       REGEXP_COUNT(ddl, 'COMP_WORTH', 1, 'i')   AS mentions_comp_worth
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PROC_DDL
WHERE ddl ILIKE ANY ('%CMP_PCT_MULT%', '%COMP_WORTH%')
ORDER BY 1, 2;

-- A0e. Batch-control job rows for every job name the B2 block calls. Expect 7 rows. A missing row makes that
--      step return its batch status instead of running (the block reports it and carries on where it can).
SELECT alltext
FROM (SELECT OBJECT_CONSTRUCT(*)::VARCHAR AS alltext FROM DAAS_UAT.DAAS_COMMON.JOB)
WHERE alltext ILIKE ANY ('%"TRIP_RECALCULATION"%', '%"TRIP_MERGE_CHECK"%', '%"TRIP_MERGE"%',
                         '%"TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER"%', '%"TRIP_SUMMARY_WRAPPER"%',
                         '%"TRIP_COMP_WORTH"%', '%"TRIP_NG_REVENUE_SUMMARY"%')
ORDER BY 1;

-- A1. The pilot guests: the three WLM guests from the RCA, plus the two BEM guests with the most market trips that
--     have no identical property trip ("twin"), among real guest ids and at most 1,000 such trips each.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS (
    guest_unique_id NUMBER(38,0), market_cd VARCHAR, property_cd VARCHAR, pick_reason VARCHAR);

INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS
SELECT column1, 'WLM', 'IWA', column2
FROM VALUES (17600543027, 'RCA trip 2895722234'), (19606195360, 'RCA trip 2895809361'), (15903662806, 'RCA trip 2895852622');

INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS
WITH prop AS (
    SELECT DISTINCT guest_unique_id, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER
    WHERE trip_type = 'PROPERTY' AND property_cd = 'IBE' AND delete_ind = 'N'
),
no_twin AS (
    SELECT m.guest_unique_id,
           COUNT(*)                                               AS trips_without_twin,
           MAX(DATEDIFF(day, m.trip_start_dt, m.trip_end_dt) + 1) AS longest_days
    FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
    LEFT JOIN prop p
           ON p.guest_unique_id = m.guest_unique_id
          AND p.trip_start_dt   = m.trip_start_dt
          AND p.trip_end_dt     = m.trip_end_dt
    WHERE m.trip_type = 'MARKET' AND m.market_cd = 'BEM' AND m.delete_ind = 'N'
      AND m.guest_unique_id > 0
      AND p.guest_unique_id IS NULL
    GROUP BY m.guest_unique_id
    HAVING COUNT(*) <= 1000
    QUALIFY ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC, m.guest_unique_id) <= 2
)
SELECT nt.guest_unique_id, 'BEM', 'IBE',
       'BEM guest with ' || nt.trips_without_twin || ' market trips lacking a property twin, longest ' || nt.longest_days || ' days'
FROM no_twin nt;

SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS ORDER BY market_cd, guest_unique_id;

-- A2. A log, so later checks can refer to the moment the pilot started without session variables, and the highest
--     trip ids in UAT right now: everything the pipeline builds carries a higher id.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG (step VARCHAR, logged_at TIMESTAMP_NTZ, note VARCHAR);
INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG VALUES ('A_START', CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'before-picture starts');

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS AS
SELECT 'max_trip_master_id_before' AS mark, MAX(trip_master_id) AS value FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER
UNION ALL
SELECT 'max_trip_detail_id_before', MAX(trip_detail_id) FROM DAAS_UAT.DAAS_CORE.TRIP_DETAIL;

-- A3. Before-picture: every TRIP_MASTER row of the pilot guests in their market and its property (live or not),
--     every TRIP_DETAIL row of those masters, and their TRIP_SUMMARY and DAILY_ACTIVITY_SUMMARY rows.
--     The TRIP_DETAIL statement reads the whole table once: minutes on X-Small, faster on a Medium.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE AS
SELECT m.*
FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS g ON g.guest_unique_id = m.guest_unique_id
WHERE (m.trip_type = 'MARKET'   AND m.market_cd   = g.market_cd)
   OR (m.trip_type = 'PROPERTY' AND m.property_cd = g.property_cd);

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE AS
SELECT d.*
FROM DAAS_UAT.DAAS_CORE.TRIP_DETAIL d
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = d.trip_master_id;

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_BEFORE AS
SELECT s.*
FROM DAAS_UAT.DAAS_CORE.TRIP_SUMMARY s
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = s.trip_master_id;

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_DAS_BEFORE AS
SELECT s.*
FROM DAAS_UAT.DAAS_CORE.DAILY_ACTIVITY_SUMMARY s
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = s.trip_master_id;

INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG
SELECT 'A_SNAPSHOT', CURRENT_TIMESTAMP()::TIMESTAMP_NTZ,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE) || ' masters, ' ||
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE) || ' details snapshotted';

-- A4. The trips to rebuild: every live market trip of a pilot guest, in the pilot market, that has no identical
--     property twin. Trips built after the config change are included on purpose: a trip cut from the wrong
--     starting day stays wrong, and the rebuild re-cuts the whole run of consecutive days in one pass.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE AS
WITH prop AS (
    SELECT DISTINCT guest_unique_id, DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE
    WHERE trip_type = 'PROPERTY' AND delete_ind = 'N'
),
hotel AS (
    SELECT DISTINCT trip_master_id
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE
    WHERE transaction_table = 'HOTEL_GUEST_RESERVATIONS_FACT' AND delete_ind = 'N' AND transaction_sub_type = 'OPENED'
),
live_rows AS (
    SELECT trip_master_id, COUNT(*) AS live_detail_rows
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE
    WHERE delete_ind = 'N' AND transaction_sub_type = 'OPENED'
    GROUP BY 1
),
revive AS (  -- the rebuild gathers OPENED rows without checking their own delete flag: these would come back
    SELECT trip_master_id, COUNT(*) AS soft_deleted_opened_rows
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE
    WHERE delete_ind = 'Y' AND transaction_sub_type = 'OPENED'
    GROUP BY 1
)
SELECT m.trip_master_id, m.guest_unique_id, m.market_cd, m.trip_start_dt, m.trip_end_dt,
       DATEDIFF(day, m.trip_start_dt, m.trip_end_dt) + 1                    AS trip_days,
       DECODE(m.market_cd, 'BEM', 1, 'WLM', 3)                               AS max_trip_days,
       IFF(h.trip_master_id IS NOT NULL, 'Y', 'N')                           AS has_hotel_stay,
       COALESCE(r.live_detail_rows, 0)                                       AS live_detail_rows,
       COALESCE(z.soft_deleted_opened_rows, 0)                               AS soft_deleted_opened_rows,
       m.created_dttm,
       IFF(m.created_dttm < '2026-08-12 11:16:26', 'before config change', 'after config change') AS built
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE m
LEFT JOIN prop p
       ON p.guest_unique_id = m.guest_unique_id AND p.market_cd = m.market_cd
      AND p.trip_start_dt = m.trip_start_dt AND p.trip_end_dt = m.trip_end_dt
LEFT JOIN hotel     h ON h.trip_master_id = m.trip_master_id
LEFT JOIN live_rows r ON r.trip_master_id = m.trip_master_id
LEFT JOIN revive    z ON z.trip_master_id = m.trip_master_id
WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
  AND p.guest_unique_id IS NULL;

-- A5. Dry-run report: what the rebuild will touch, per guest. Read this before PART B.
SELECT q.guest_unique_id, q.market_cd,
       COUNT(*)                                          AS trips_to_rebuild,
       COUNT_IF(q.trip_days > q.max_trip_days)           AS over_cap,
       MAX(q.trip_days)                                  AS longest_days,
       COUNT_IF(q.built = 'before config change')        AS built_before_change,
       COUNT_IF(q.built = 'after config change')         AS built_after_change,
       COUNT_IF(q.has_hotel_stay = 'Y')                  AS with_hotel_stay,
       COUNT_IF(q.live_detail_rows = 0)                  AS with_no_live_detail,
       SUM(q.live_detail_rows)                           AS live_detail_rows,
       SUM(q.soft_deleted_opened_rows)                   AS deleted_rows_the_rebuild_would_revive,
       MIN(q.trip_start_dt)                              AS first_trip_start,
       MAX(q.trip_end_dt)                                AS last_trip_end
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q
GROUP BY ALL
ORDER BY 2, 1;

-- A6. Pete's question, before: is anything missing from TRIP_DETAIL on the market side? Every live transaction on
--     a live property trip should also sit on a live market trip (one-property market), and nothing extra. The
--     rebuild re-cuts what the market trips already hold; anything missing here needs the replay step later.
WITH mk AS (
    SELECT DISTINCT t.guest_unique_id, t.market_cd, d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
),
pr AS (
    SELECT DISTINCT t.guest_unique_id, DECODE(t.property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd,
                    d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'PROPERTY' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
)
SELECT COALESCE(mk.guest_unique_id, pr.guest_unique_id)     AS guest_unique_id,
       COALESCE(mk.market_cd, pr.market_cd)                 AS market_cd,
       COALESCE(mk.transaction_table, pr.transaction_table) AS transaction_table,
       COUNT_IF(mk.transaction_table_sk IS NOT NULL AND pr.transaction_table_sk IS NOT NULL) AS on_both,
       COUNT_IF(mk.transaction_table_sk IS NULL)             AS missing_on_market,
       COUNT_IF(pr.transaction_table_sk IS NULL)             AS extra_on_market
FROM mk
FULL OUTER JOIN pr
       ON pr.guest_unique_id = mk.guest_unique_id AND pr.market_cd = mk.market_cd
      AND pr.transaction_table = mk.transaction_table AND pr.transaction_table_sk = mk.transaction_table_sk
GROUP BY ALL
ORDER BY 2, 1, 3;

-- A7. Before: transactions sitting on more than one live market trip (the doubled-ratings residue).
SELECT COUNT(*) AS sks_on_more_than_one_live_market_trip_before
FROM (
    SELECT d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
    GROUP BY 1, 2
    HAVING COUNT(DISTINCT d.trip_master_id) > 1
);

-- A8. The three RCA trips as they stand now, next to the property trips covering the same days.
SELECT q.trip_master_id, q.guest_unique_id, q.market_cd, q.trip_start_dt, q.trip_end_dt, q.trip_days, q.has_hotel_stay,
       LISTAGG(p.trip_master_id || ' [' || p.trip_start_dt || '..' || p.trip_end_dt || ']', ', ')
           WITHIN GROUP (ORDER BY p.trip_start_dt) AS property_trips_on_those_days
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q
LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE p
       ON p.guest_unique_id = q.guest_unique_id AND p.trip_type = 'PROPERTY' AND p.delete_ind = 'N'
      AND p.trip_start_dt <= q.trip_end_dt AND p.trip_end_dt >= q.trip_start_dt
WHERE q.trip_master_id IN (2895722234, 2895809361, 2895852622)
GROUP BY ALL
ORDER BY 1;


-- ===================================================================================================
-- PART B. The rebuild, through the pipeline
-- ===================================================================================================

-- B1. (DAAS_TEAM) Queue the trips: the same INSERT the pipeline itself makes into this table. BATCH_ID -3641 marks
--     the rows as ours. The queue stream must hold nothing else (the block in B3 checks again).
USE ROLE DAAS_TEAM;
SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM') AS queue_stream_has_data_expect_false;

INSERT INTO DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE (TRIP_MASTER_ID, STATUS, BATCH_ID, CREATED_DTTM, CREATED_BY, UPDATED_DTTM, UPDATED_BY)
SELECT trip_master_id, 'PENDING', -3641, CURRENT_TIMESTAMP(), CURRENT_USER(), CURRENT_TIMESTAMP(), 'DAASI-3641 pilot'
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE;

INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG
SELECT 'B1_QUEUED', CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, COUNT(*) || ' trips queued' FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE;

SELECT (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM WHERE METADATA$ACTION = 'INSERT') AS rows_waiting_in_stream,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE)                              AS trips_queued_expect_equal;
-- To take the rows back out before the run in B3 (the stream then shows nothing for them):
--   DELETE FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE WHERE BATCH_ID = -3641

-- B2. (DAAS_TEAM; read-only apart from one scratch table) Which way the run can happen. The steps after the queue
--     recreate DAAS_TEMP work tables owned by DOMAIN_TEMP_ADMIN_UAT and a stream owned by STREAM_OWNERS_UAT, and
--     every procedure switches to the job warehouse DAAS_UAT_IT_WHSRCTORAW_COMPUTE. UAT's own tasks do all of that
--     on every run as their owner, APP_SERVICE_UAT. So the run goes either through those tasks (route A in B3, the
--     way PROD will run it) or through the block in B3 under a role that holds both owner roles (route B).

-- B2a. Will UAT's own chain run? Run the SHOW, then the SELECT right after it. A task graph runs only while its
--      root is 'started', and each step task under it runs only while it is 'started' too. Expect the regular
--      chain (root TRIP_ROOT_TASK) and the 2024 market-replay copy (root TRIP_ROOT_TASK_MARKET_REPLAY).
SHOW TASKS IN SCHEMA DAAS_UAT.DAAS_COMMON;
SELECT "name", "state", "schedule",
       ARRAY_TO_STRING("predecessors", ', ')                                                  AS runs_after,
       IFF(COALESCE("condition", '') = '', NULL,
           CONTAINS(UPPER("condition"), 'TRIP_RECALC_QUEUE_STREAM'))                           AS wakes_on_recalc_queue,
       "owner", "warehouse", "last_suspended_on"
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
WHERE "name" IN ('TRIP_ROOT_TASK', 'TRIP_ROOT_TASK_MARKET_REPLAY')
   OR ("name" NOT ILIKE '%INITIAL_LOAD%'
       AND "definition" ILIKE ANY ('%''TRIP_RECALCULATION''%', '%''TRIP_MERGE_CHECK''%', '%''TRIP_MERGE''%',
                                   '%''TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER''%', '%''TRIP_SUMMARY_WRAPPER''%',
                                   '%''TRIP_COMP_WORTH''%', '%''TRIP_NG_REVENUE_SUMMARY''%'))
ORDER BY "name";

-- B2b. Has UAT run these jobs lately? The pipeline's own batch log (all seven jobs log to shard S02). A task run
--      shows as SYSTEM (or a service user) in last_run_by. Jobs that check a stream first (recalculation, merge
--      check, merge, customer-merge check, summary) only log a run when their stream held rows.
SELECT j.job_name, COUNT(*) AS runs_last_7_days, MAX(b.batch_start_date) AS last_run_start,
       MAX_BY(b.batch_status, b.batch_id) AS last_status, MAX_BY(b.created_by, b.batch_id) AS last_run_by
FROM DAAS_UAT.DAAS_COMMON.BATCH_S02 b
JOIN DAAS_UAT.DAAS_COMMON.JOB j ON j.job_id = b.job_id
WHERE j.job_name IN ('TRIP_RECALCULATION', 'TRIP_MERGE_CHECK', 'TRIP_MERGE', 'TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER',
                     'TRIP_SUMMARY_WRAPPER', 'TRIP_COMP_WORTH', 'TRIP_NG_REVENUE_SUMMARY')
  AND b.batch_start_date >= DATEADD(day, -7, CURRENT_TIMESTAMP()::TIMESTAMP_NTZ)
GROUP BY 1
ORDER BY 3 DESC;

-- B2c. The roles you hold anywhere in your grants (every role you can switch to, and every role under those).
--      Route B needs a role holding both owner roles; APP_SERVICE_UAT holds them.
SELECT CURRENT_USER()                                       AS you,
       ARRAY_CONTAINS('APP_SERVICE_UAT'::VARIANT, r)       AS hold_app_service_uat,
       ARRAY_CONTAINS('DOMAIN_TEMP_ADMIN_UAT'::VARIANT, r) AS hold_domain_temp_admin_uat,
       ARRAY_CONTAINS('STREAM_OWNERS_UAT'::VARIANT, r)     AS hold_stream_owners_uat,
       r                                                    AS every_role_you_hold
FROM (SELECT PARSE_JSON(CURRENT_AVAILABLE_ROLES())::ARRAY AS r);

-- B2d. Who owns the objects the steps recreate, and when the pipeline last recreated them (CREATE OR REPLACE gives
--      them a new created_on on every run). Recorded for C8. Run each SHOW, then the statement right after it.
--      Reading it: TRIP_RECALC_QUEUE_TEMP's date is the last recalculation run that had work, TRIP_DETAIL_TMP's the
--      last summary run. A recent date with the owner still DOMAIN_TEMP_ADMIN_UAT means UAT hands new DAAS_TEMP
--      tables to that role automatically, so ownership comes out right whichever role runs the steps.
SHOW TABLES IN SCHEMA DAAS_UAT.DAAS_TEMP;
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_OWNERS AS
SELECT 'TABLE'::VARCHAR AS object_kind, "name"::VARCHAR AS object_name, "owner"::VARCHAR AS owner_before,
       "created_on"::TIMESTAMP_LTZ AS recreated_on_before
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
WHERE "name" IN ('TRIP_RECALC_QUEUE_TEMP', 'TRIP_MERGE_TEMP', 'TRIP_MERGE_TEMP_1', 'TRIP_MERGE_TEMP_2',
                 'TRIP_MERGE_TEMP_2A', 'CUSTOMER_MERGE_CHECK', 'CUSTOMER_MERGE_CHECK_2', 'TRIP_DETAIL_TMP',
                 'TRIP_MASTER_DAILY_SUMMARY_WRAPPER_STREAM_TEMP', 'DAILY_ACTIVITY_SUMMARY_BM_TRIP',
                 'DAILY_ACTIVITY_SUMMARY_TRIP', 'TRIP_NG_REVENUE_SUMMARY_TMP');

SHOW STREAMS LIKE 'TRIP_MASTER_TRIP_MERGE_CHECK_STREAM' IN SCHEMA DAAS_UAT.DAAS_TEMP;
INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_OWNERS
SELECT 'STREAM', "name", "owner", "created_on" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));

SELECT object_kind, object_name, owner_before, recreated_on_before
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_OWNERS
ORDER BY recreated_on_before DESC;

-- B3. The run. What B2 found on 2026-10-18: UAT's TRIP_ROOT_TASK is suspended (last suspended Aug 5) while every step
--     under it is 'started'; UAT also has one standalone on-demand task per step we need, owned by APP_SERVICE_UAT;
--     and no role you hold can recreate the DAAS_TEMP work tables. So:
--
--   ROUTE A2, recommended: start those on-demand tasks in chain order (B3a, one block). Each step runs as the
--     pipeline role, exactly as its chain task would, and nothing else in UAT runs with it. Starting a task needs
--     only OPERATE on it through a role in your session; the procedures run with the task owner's rights.
--
--   ROUTE A: one run of the whole chain, by anyone with OPERATE on the root (it runs once as the task owner and
--     leaves the root suspended):
--         EXECUTE TASK DAAS_UAT.DAAS_COMMON.TRIP_ROOT_TASK;
--     It would also push whatever UAT's feeds have loaded since Aug 5 through the ratings, hotel, POS, offer, comp,
--     marker and freeplay steps, and run the customer merge if the check queues one. Use it only if A2 is not open.
--
--   ROUTE B: the hand-run block further down, under a role holding DOMAIN_TEMP_ADMIN_UAT and STREAM_OWNERS_UAT
--     (APP_SERVICE_UAT). B2c shows you hold only STREAM_OWNERS_UAT, so it is not open to you.

-- B3a. ROUTE A2: the on-demand step tasks, in chain order, from one block. Preflight: no trip job in progress, only
--      our rows in the recalc queue, the other streams empty, one suspended on-demand task per step whose
--      definition calls what the chain task calls, and a role in this session that may start each one. Then, step
--      by step: EXECUTE TASK, wait for that step's batch to finish in the pipeline's batch log (BATCH_S02), check
--      what it did, go on. It stops at the first problem. If it stops in the preflight nothing has run. If it stops
--      after a step ran, fix the cause and run the block again with v_start_at set to the step to resume from (the
--      S rows number the steps). It waits on each step, so it can run for a while; B4b shows progress meanwhile. If
--      the block itself is cancelled or times out, the step in flight still finishes on its own: check B4b, then
--      resume with v_start_at set to the next step.
--      Secondary roles on first, so OPERATE can come from whichever of your roles holds it.
USE SECONDARY ROLES ALL;

EXECUTE IMMEDIATE $$
DECLARE
    v_start_at INTEGER DEFAULT 1;      -- 1 for a fresh run; to resume after a stop, the number of the step to start from
    v_max_wait INTEGER DEFAULT 5400;   -- longest wait for one step, in seconds (90 minutes)
    v_log      VARCHAR DEFAULT '';
    v_txt      VARCHAR;
    v_out      VARCHAR;
    v_job      VARCHAR;
    v_task     VARCHAR;
    v_cmd      VARCHAR;
    v_wait     VARCHAR;
    v_who      VARCHAR DEFAULT '';
    v_checked  INTEGER DEFAULT 0;
    v_blocked  INTEGER DEFAULT 0;
    v_status   VARCHAR;
    v_has      BOOLEAN;
    v_ng_clean BOOLEAN DEFAULT TRUE;
    v_grants   BOOLEAN DEFAULT TRUE;
    v_queued   INTEGER;
    v_other    INTEGER;
    v_n        INTEGER;
    v_m        INTEGER;
    v_step     INTEGER;
    v_waited   INTEGER;
    v_mark     NUMBER(38,0);
    res        RESULTSET;
    pilot_stop EXCEPTION (-20641, 'DAASI-3641 pilot stopped, see the step rows');
BEGIN
    ---------------------------------------------------------------- preflight: nothing here starts anything
    -- P0. No chain or on-demand run under way.
    v_n := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_COMMON.BATCH_S02 b
            JOIN DAAS_UAT.DAAS_COMMON.JOB j ON j.job_id = b.job_id
            WHERE j.job_name LIKE 'TRIP%' AND b.batch_status = 'IN PROGRESS'
              AND b.batch_start_date >= DATEADD(hour, -6, CURRENT_TIMESTAMP()::TIMESTAMP_NTZ));
    IF (v_n > 0) THEN
        v_log := v_log || 'P0 runs~|~STOP~|~' || v_n || ' trip job(s) show IN PROGRESS in the last 6 hours (B2b lists the jobs): '
                       || 'let them finish, then run this block again#ROW#';
        RAISE pilot_stop;
    END IF;
    v_log := v_log || 'P0 runs~|~ok~|~no trip job in progress#ROW#';

    -- P1. The session, for the record: the steps themselves run as the task owner.
    v_txt := (SELECT COALESCE(TRY_PARSE_JSON(CURRENT_SECONDARY_ROLES()):roles::VARCHAR, ''));
    v_log := v_log || 'P1 session~|~ok~|~role ' || CURRENT_ROLE()
                   || IFF(v_txt = '', ', no secondary roles', ', secondary roles ' || v_txt)
                   || ', warehouse ' || COALESCE(CURRENT_WAREHOUSE(), '(none)') || '#ROW#';

    IF (v_start_at = 1) THEN
        -- P2. Only our rows wait in the recalc queue.
        v_queued := (SELECT COUNT(DISTINCT trip_master_id) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM
                     WHERE METADATA$ACTION = 'INSERT' AND batch_id = -3641);
        v_other  := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM
                     WHERE METADATA$ACTION = 'INSERT' AND batch_id IS DISTINCT FROM -3641);
        IF (v_queued = 0) THEN
            v_log := v_log || 'P2 recalc queue~|~STOP~|~no pilot rows are waiting: run B4a to see whether the pilot already ran#ROW#';
            RAISE pilot_stop;
        END IF;
        IF (v_other > 0) THEN
            v_log := v_log || 'P2 recalc queue~|~STOP~|~' || v_other || ' other queue rows are waiting and would be rebuilt with ours#ROW#';
            RAISE pilot_stop;
        END IF;
        v_log := v_log || 'P2 recalc queue~|~ok~|~' || v_queued || ' pilot trips waiting, nothing else#ROW#';

        -- P3. The other streams hold nothing that would be processed with ours.
        v_txt := '';
        v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_TEMP.TRIP_MASTER_TRIP_MERGE_CHECK_STREAM'));
        IF (v_has) THEN v_txt := v_txt || ' merge-check'; END IF;
        v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_MERGE_QUEUE_STREAM'));
        IF (v_has) THEN v_txt := v_txt || ' merge-queue'; END IF;
        v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_MASTER_TRIP_CUSTOMER_MERGE_CHECK_STREAM'));
        IF (v_has) THEN v_txt := v_txt || ' customer-merge-check'; END IF;
        v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_CUSTOMER_MERGE_QUEUE_STREAM'));
        IF (v_has) THEN v_txt := v_txt || ' customer-merge-queue'; END IF;
        v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM'));
        IF (v_has) THEN v_txt := v_txt || ' detail-summary'; END IF;
        v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_MASTER_DAILY_SUMMARY_WRAPPER_STREAM'));
        IF (v_has) THEN v_txt := v_txt || ' daily-summary'; END IF;
        IF (v_txt <> '') THEN
            v_log := v_log || 'P3 other streams~|~STOP~|~these already hold changes that would be processed with ours:' || v_txt || '#ROW#';
            RAISE pilot_stop;
        END IF;
        BEGIN
            v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_DETAIL_NG_VW_STREAM'));
            v_ng_clean := NOT v_has;
        EXCEPTION
            WHEN OTHER THEN
                v_ng_clean := FALSE;
        END;
        v_log := v_log || 'P3 other streams~|~ok~|~merge, customer-merge and summary streams empty; non-gaming stream '
                       || IFF(v_ng_clean, 'empty', 'not empty or unreadable, that step will be skipped') || '#ROW#';
    ELSE
        v_log := v_log || 'P2 recalc queue~|~skipped~|~resuming at step ' || v_start_at || '#ROW#';
    END IF;

    -- P4. One suspended, standalone on-demand task per step, calling what the chain task calls (same job, same stream).
    SHOW TASKS IN SCHEMA DAAS_UAT.DAAS_COMMON;
    CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TASKS AS
    WITH steps AS (
        SELECT column1 AS step_no, column2 AS job_name, column3 AS stream_name
        FROM VALUES (1, 'TRIP_RECALCULATION',                    'DAAS_CORE.TRIP_RECALC_QUEUE_STREAM'),
                    (2, 'TRIP_MERGE_CHECK',                      'DAAS_TEMP.TRIP_MASTER_TRIP_MERGE_CHECK_STREAM'),
                    (3, 'TRIP_MERGE',                            'DAAS_CORE.TRIP_MERGE_QUEUE_STREAM'),
                    (4, 'TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER', 'DAAS_CORE.TRIP_MASTER_TRIP_CUSTOMER_MERGE_CHECK_STREAM'),
                    (5, 'TRIP_SUMMARY_WRAPPER',                  'DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM'),
                    (6, 'TRIP_COMP_WORTH',                       NULL),
                    (7, 'TRIP_NG_REVENUE_SUMMARY',               NULL)),
    tasks AS (
        SELECT "name"::VARCHAR AS task_name, "state"::VARCHAR AS task_state, "definition"::VARCHAR AS task_definition,
               COALESCE(ARRAY_SIZE("predecessors"), 0) AS predecessor_count
        FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
        WHERE "name" ILIKE '%ONDEMAND%')
    SELECT s.step_no, s.job_name, s.stream_name, t.task_name, t.task_state, t.task_definition, t.predecessor_count,
           COUNT(t.task_name) OVER (PARTITION BY s.step_no) AS candidates,
           (s.stream_name IS NULL
            OR REPLACE(UPPER(t.task_definition), ' ', '') ILIKE ('%' || s.stream_name || '''%')) AS definition_ok
    FROM steps s
    LEFT JOIN tasks t ON t.task_definition ILIKE ('%''' || s.job_name || '''%')
    QUALIFY ROW_NUMBER() OVER (PARTITION BY s.step_no ORDER BY t.task_name) = 1;

    v_txt := (SELECT COALESCE(LISTAGG('step ' || step_no || ' ' || job_name || ': '
                                      || CASE WHEN task_name IS NULL THEN 'no on-demand task calls this job'
                                              WHEN candidates > 1 THEN candidates || ' on-demand tasks call this job'
                                              WHEN predecessor_count > 0 THEN task_name || ' runs after another task'
                                              WHEN NOT definition_ok THEN task_name || ' calls something else: ' || task_definition
                                              ELSE task_name || ' is ' || task_state || ', so it runs on its own schedule'
                                         END, '; ') WITHIN GROUP (ORDER BY step_no), '')
              FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TASKS
              WHERE step_no >= :v_start_at
                AND (task_name IS NULL OR candidates > 1 OR predecessor_count > 0 OR NOT definition_ok
                     OR task_state <> 'suspended'));
    IF (v_txt <> '') THEN
        v_log := v_log || 'P4 tasks~|~STOP~|~' || REPLACE(REPLACE(v_txt, '#ROW#', ''), '~|~', '') || '#ROW#';
        RAISE pilot_stop;
    END IF;
    v_txt := (SELECT LISTAGG(step_no || ' ' || task_name, ', ') WITHIN GROUP (ORDER BY step_no)
              FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TASKS WHERE step_no >= :v_start_at);
    v_log := v_log || 'P4 tasks~|~ok~|~' || v_txt || '#ROW#';

    -- P5. Which tasks a role active in this session may start (OPERATE, or ownership). Some but not all: stop, since
    --     starting only some would leave the run half done. None: the first EXECUTE TASK settles it, and fails before
    --     anything runs if this session really may not start them.
    v_txt     := '';
    v_who     := '';
    v_checked := 0;
    v_blocked := 0;
    LET rs_perm RESULTSET := (SELECT step_no, task_name FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TASKS
                              WHERE step_no >= :v_start_at ORDER BY step_no);
    LET c_perm CURSOR FOR rs_perm;
    FOR r IN c_perm DO
        v_task := r.task_name;
        BEGIN
            v_cmd := 'SHOW GRANTS ON TASK DAAS_UAT.DAAS_COMMON.' || v_task;
            EXECUTE IMMEDIATE v_cmd;
            SELECT COALESCE(LISTAGG(DISTINCT "grantee_name", ', '), '(no role)'), COUNT_IF(IS_ROLE_IN_SESSION("grantee_name"))
              INTO :v_out, :v_n
              FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
             WHERE "privilege" IN ('OPERATE', 'OWNERSHIP') AND "granted_to" = 'ROLE';
            v_checked := v_checked + 1;
            IF (v_n = 0) THEN
                v_blocked := v_blocked + 1;
                v_txt := v_txt || ' ' || v_task;
                IF (v_who = '') THEN
                    v_who := v_out;
                END IF;
            END IF;
        EXCEPTION
            WHEN OTHER THEN
                v_grants := FALSE;
        END;
    END FOR;
    IF (v_blocked > 0 AND v_blocked < v_checked) THEN
        v_log := v_log || 'P5 permission~|~STOP~|~this session may start some of the tasks but not:' || v_txt
                       || ' (may be started by: ' || v_who || '). Get OPERATE on those first (DevOps), then run this again#ROW#';
        RAISE pilot_stop;
    END IF;
    IF (v_blocked > 0) THEN
        v_log := v_log || 'P5 permission~|~note~|~no role active in this session shows OPERATE on the tasks (they may be started by: '
                       || v_who || '); the first EXECUTE TASK settles it#ROW#';
    ELSE
        v_log := v_log || 'P5 permission~|~' || IFF(v_grants, 'ok~|~this session may start every task',
                                                    'note~|~grants are not visible to this session; the first EXECUTE TASK settles it') || '#ROW#';
    END IF;

    ---------------------------------------------------------------- the steps, each started as the task owner
    v_queued := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE);
    LET rs_plan RESULTSET := (SELECT step_no, job_name, task_name FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TASKS
                              WHERE step_no >= :v_start_at ORDER BY step_no);
    LET c_plan CURSOR FOR rs_plan;
    FOR r IN c_plan DO
        v_step := r.step_no;
        v_job  := r.job_name;
        v_task := r.task_name;

        -- Does the step have work? A stream-checked job logs no batch when its stream is empty.
        v_has := TRUE;
        IF (v_job = 'TRIP_RECALCULATION') THEN
            v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM'));
        ELSEIF (v_job = 'TRIP_MERGE_CHECK') THEN
            v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_TEMP.TRIP_MASTER_TRIP_MERGE_CHECK_STREAM'));
        ELSEIF (v_job = 'TRIP_MERGE') THEN
            v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_MERGE_QUEUE_STREAM'));
        ELSEIF (v_job = 'TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER') THEN
            v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_MASTER_TRIP_CUSTOMER_MERGE_CHECK_STREAM'));
        ELSEIF (v_job = 'TRIP_SUMMARY_WRAPPER') THEN
            v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM'));
        ELSEIF (v_job = 'TRIP_NG_REVENUE_SUMMARY') THEN
            v_has := v_ng_clean;
        END IF;
        IF (NOT v_has) THEN
            IF (v_job = 'TRIP_RECALCULATION') THEN
                v_log := v_log || 'S1 TRIP_RECALCULATION~|~STOP~|~the recalc queue stream is empty: nothing to rebuild#ROW#';
                RAISE pilot_stop;
            END IF;
            v_log := v_log || 'S' || v_step || ' ' || v_job || '~|~skipped~|~'
                           || IFF(v_job = 'TRIP_NG_REVENUE_SUMMARY', 'its stream held other changes or could not be read at preflight',
                                  IFF(v_job = 'TRIP_MERGE', 'nothing was queued for merging', 'its stream is empty, so the job has no work'))
                           || '#ROW#';
            CONTINUE;
        END IF;

        -- Start it.
        v_mark := (SELECT COALESCE(MAX(batch_id), 0) FROM DAAS_UAT.DAAS_COMMON.BATCH_S02);
        BEGIN
            v_cmd := 'EXECUTE TASK DAAS_UAT.DAAS_COMMON.' || v_task;
            EXECUTE IMMEDIATE v_cmd;
        EXCEPTION
            WHEN OTHER THEN
                v_log := v_log || 'S' || v_step || ' ' || v_job || '~|~STOP~|~could not start ' || v_task || ': '
                               || REPLACE(REPLACE(SQLERRM, '#ROW#', ''), '~|~', '')
                               || IFF(v_who <> '', '. Roles that may start it: ' || v_who || ' (the ask for DevOps: run this block, or grant OPERATE on the on-demand tasks)', '')
                               || '#ROW#';
                RAISE pilot_stop;
        END;

        -- Wait for its batch in the pipeline's log to finish.
        v_waited := 0;
        v_status := NULL;
        WHILE (v_waited < v_max_wait) DO
            v_wait := (SELECT SYSTEM$WAIT(15));
            v_waited := v_waited + 15;
            v_status := (SELECT MAX_BY(b.batch_status, b.batch_id) FROM DAAS_UAT.DAAS_COMMON.BATCH_S02 b
                         JOIN DAAS_UAT.DAAS_COMMON.JOB j ON j.job_id = b.job_id
                         WHERE j.job_name = :v_job AND b.batch_id > :v_mark);
            IF (v_status IS NOT NULL AND v_status <> 'IN PROGRESS') THEN
                BREAK;
            END IF;
            IF (v_status IS NULL AND v_waited >= 900) THEN
                BREAK;
            END IF;
        END WHILE;
        IF (v_status IS NULL) THEN
            v_log := v_log || 'S' || v_step || ' ' || v_job || '~|~STOP~|~' || v_task || ' was started but logged no run within 15 minutes; '
                           || 'its TASK_HISTORY says why (a WHEN condition may have skipped it). Then rerun with v_start_at = ' || v_step || '#ROW#';
            RAISE pilot_stop;
        END IF;
        IF (v_status = 'IN PROGRESS') THEN
            v_log := v_log || 'S' || v_step || ' ' || v_job || '~|~STOP~|~still running after ' || (v_max_wait / 60)::INTEGER
                           || ' minutes. Let it finish (B4b shows it), then rerun with v_start_at = ' || (v_step + 1) || '#ROW#';
            RAISE pilot_stop;
        END IF;

        -- Check what it did.
        IF (v_job = 'TRIP_RECALCULATION') THEN
            v_n := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
                    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q ON q.trip_master_id = m.trip_master_id
                    WHERE m.delete_ind = 'N');
            v_m := (SELECT COUNT(DISTINCT p.trip_master_id) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_PROCESSED p
                    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q ON q.trip_master_id = p.trip_master_id);
            IF (NOT STARTSWITH(v_status, 'SUCCESS') OR v_n > 0 OR v_m < v_queued) THEN
                v_log := v_log || 'S1 TRIP_RECALCULATION~|~STOP~|~' || LEFT(v_status, 500) || '; ' || v_m || ' of ' || v_queued
                               || ' logged as processed; ' || v_n || ' still live#ROW#';
                RAISE pilot_stop;
            END IF;
            v_log := v_log || 'S1 TRIP_RECALCULATION~|~ok~|~' || v_m || ' trips retired and re-cut, logged in TRIP_RECALC_PROCESSED#ROW#';
        ELSEIF (v_job = 'TRIP_MERGE_CHECK') THEN
            IF (NOT STARTSWITH(v_status, 'SUCCESS')) THEN
                v_log := v_log || 'S2 TRIP_MERGE_CHECK~|~STOP~|~' || LEFT(v_status, 500) || '#ROW#';
                RAISE pilot_stop;
            END IF;
            v_n := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_MERGE_QUEUE_STREAM WHERE METADATA$ACTION = 'INSERT');
            v_log := v_log || 'S2 TRIP_MERGE_CHECK~|~ok~|~' || LEFT(v_status, 200) || '; ' || v_n || ' trip ids queued for merging#ROW#';
        ELSEIF (v_job = 'TRIP_MERGE') THEN
            IF (NOT (STARTSWITH(v_status, 'SUCCESS') OR STARTSWITH(v_status, 'Alert'))) THEN
                v_log := v_log || 'S3 TRIP_MERGE~|~STOP~|~' || LEFT(v_status, 500) || '#ROW#';
                RAISE pilot_stop;
            END IF;
            v_log := v_log || 'S3 TRIP_MERGE~|~ok~|~' || LEFT(v_status, 200) || '#ROW#';
        ELSEIF (v_job = 'TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER') THEN
            v_n := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_CUSTOMER_MERGE_QUEUE_STREAM WHERE METADATA$ACTION = 'INSERT');
            v_log := v_log || 'S4 TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER~|~' || IFF(STARTSWITH(v_status, 'SUCCESS') AND v_n = 0, 'ok', 'note')
                           || '~|~' || LEFT(v_status, 200)
                           || IFF(v_n = 0, '; no guest merges queued',
                                  '; ' || v_n || ' guest-merge rows queued and left for the chain (a guest merge rebuilds every trip of both guests)')
                           || '#ROW#';
        ELSEIF (v_job = 'TRIP_SUMMARY_WRAPPER') THEN
            IF (NOT STARTSWITH(v_status, 'SUCCESS')) THEN
                v_log := v_log || 'S5 TRIP_SUMMARY_WRAPPER~|~STOP~|~' || LEFT(v_status, 500)
                               || '. TRIP_MASTER and TRIP_DETAIL are rebuilt and checkable; the summary rows are not#ROW#';
                RAISE pilot_stop;
            END IF;
            v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM'));
            v_log := v_log || 'S5 TRIP_SUMMARY_WRAPPER~|~ok~|~' || LEFT(v_status, 200)
                           || IFF(v_has, '; detail-summary stream still holds rows', '; summary stream consumed') || '#ROW#';
        ELSE
            v_log := v_log || 'S' || v_step || ' ' || v_job || '~|~' || IFF(STARTSWITH(v_status, 'SUCCESS'), 'ok', 'note')
                           || '~|~' || LEFT(v_status, 300) || '#ROW#';
        END IF;
    END FOR;

    v_log := v_log || 'END~|~done~|~next: B4, then PART C, then C8#ROW#';
    res := (SELECT t.index AS n, SPLIT_PART(t.value, '~|~', 1) AS step, SPLIT_PART(t.value, '~|~', 2) AS verdict, SPLIT_PART(t.value, '~|~', 3) AS detail
            FROM TABLE(SPLIT_TO_TABLE(:v_log, '#ROW#')) t WHERE t.value <> '' ORDER BY t.index);
    RETURN TABLE(res);
EXCEPTION
    WHEN pilot_stop THEN
        res := (SELECT t.index AS n, SPLIT_PART(t.value, '~|~', 1) AS step, SPLIT_PART(t.value, '~|~', 2) AS verdict, SPLIT_PART(t.value, '~|~', 3) AS detail
                FROM TABLE(SPLIT_TO_TABLE(:v_log, '#ROW#')) t WHERE t.value <> '' ORDER BY t.index);
        RETURN TABLE(res);
    WHEN OTHER THEN
        v_log := v_log || 'error~|~STOP~|~' || REPLACE(REPLACE(SQLERRM, '#ROW#', ''), '~|~', '') || '#ROW#';
        res := (SELECT t.index AS n, SPLIT_PART(t.value, '~|~', 1) AS step, SPLIT_PART(t.value, '~|~', 2) AS verdict, SPLIT_PART(t.value, '~|~', 3) AS detail
                FROM TABLE(SPLIT_TO_TABLE(:v_log, '#ROW#')) t WHERE t.value <> '' ORDER BY t.index);
        RETURN TABLE(res);
END;
$$;

-- ROUTE B only (not open to you, see B3): the session lines, the check, then the hand-run block. Set the role,
-- warehouse DAAS_UAT_IT_WHSRCTORAW_COMPUTE and DAAS_UAT / DAAS_COMMON in this file's context picker first (the first
-- attempt ran as DAAS_TEAM even after a USE ROLE line), then run the four USE lines one at a time, then B3b.
USE SECONDARY ROLES NONE;
USE DATABASE DAAS_UAT;
USE SCHEMA DAAS_COMMON;
USE WAREHOUSE DAAS_UAT_IT_WHSRCTORAW_COMPUTE;

-- B3b. (route B) Who the block will run as. Expect the role you picked, empty roles in secondary_roles, the job
--      warehouse, and TRUE in the last two columns. Anything else: fix the context picker before running the block
--      (the block repeats these checks and stops if they fail).
SELECT CURRENT_ROLE()                              AS runs_as,
       CURRENT_SECONDARY_ROLES()                   AS secondary_roles,
       CURRENT_WAREHOUSE()                         AS warehouse,
       IS_ROLE_IN_SESSION('DOMAIN_TEMP_ADMIN_UAT') AS can_recreate_work_tables,
       IS_ROLE_IN_SESSION('STREAM_OWNERS_UAT')     AS can_recreate_merge_stream;

-- The block (route B). In chain order it runs every step our change triggers: recalculation, merge check, merge (if
-- anything was queued), the trip-master customer-merge check, summary, comp worth, non-gaming revenue. Each step is
-- the exact CALL its task makes. The preflight confirms no chain run is under way, the session is in DAAS_UAT with
-- secondary roles off, only our rows are waiting, the other streams are empty, and this role can recreate the
-- DAAS_TEMP objects. It stops at the first problem, before any step, and returns one row per check and step.

EXECUTE IMMEDIATE $$
DECLARE
    v_log      VARCHAR DEFAULT '';
    v_out      VARCHAR;
    v_txt      VARCHAR;
    v_owners   VARCHAR;
    v_stream   VARCHAR;
    v_ids      VARCHAR;
    v_has      BOOLEAN;
    v_ng_clean BOOLEAN DEFAULT FALSE;
    v_queued   INTEGER;
    v_other    INTEGER;
    v_n        INTEGER;
    v_m        INTEGER;
    res        RESULTSET;
    pilot_stop EXCEPTION (-20641, 'DAASI-3641 pilot stopped, see the step rows');
BEGIN
    ---------------------------------------------------------------- preflight: nothing here changes data
    -- P0. A chain run under way would race this block for the same streams and work tables.
    v_n := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_COMMON.BATCH_S02 b
            JOIN DAAS_UAT.DAAS_COMMON.JOB j ON j.job_id = b.job_id
            WHERE j.job_name LIKE 'TRIP%' AND b.batch_status = 'IN PROGRESS'
              AND b.batch_start_date >= DATEADD(hour, -6, CURRENT_TIMESTAMP()::TIMESTAMP_NTZ));
    IF (v_n > 0) THEN
        v_log := v_log || 'P0 chain~|~STOP~|~' || v_n || ' trip job(s) show IN PROGRESS in the last 6 hours (B2b lists the jobs): '
                       || 'a chain run may be under way and may take our rows. Let it finish, then run B4#ROW#';
        RAISE pilot_stop;
    END IF;
    v_log := v_log || 'P0 chain~|~ok~|~no trip job in progress#ROW#';

    -- P1. Session: database, role, warehouse, and no secondary roles. CREATE OR REPLACE is authorised by the primary
    --     role alone, so the owner checks in P4 must see the primary role alone, as a task run does.
    IF (CURRENT_DATABASE() IS DISTINCT FROM 'DAAS_UAT') THEN
        v_log := v_log || 'P1 session~|~STOP~|~session database is ' || COALESCE(CURRENT_DATABASE(), '(none)') || ': run USE DATABASE DAAS_UAT and this block again#ROW#';
        RAISE pilot_stop;
    END IF;
    v_txt := (SELECT COALESCE(TRY_PARSE_JSON(CURRENT_SECONDARY_ROLES()):roles::VARCHAR, ''));
    IF (v_txt <> '') THEN
        v_log := v_log || 'P1 session~|~STOP~|~running as ' || CURRENT_ROLE() || ' with secondary roles on (' || v_txt
                       || '): run USE SECONDARY ROLES NONE on its own, check B3b, then run this block again#ROW#';
        RAISE pilot_stop;
    END IF;
    v_log := v_log || 'P1 session~|~ok~|~database DAAS_UAT, role ' || CURRENT_ROLE() || ', warehouse ' || COALESCE(CURRENT_WAREHOUSE(), '(none)') || ', no secondary roles#ROW#';

    v_queued := (SELECT COUNT(DISTINCT trip_master_id) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM
                 WHERE METADATA$ACTION = 'INSERT' AND batch_id = -3641);
    v_other  := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM
                 WHERE METADATA$ACTION = 'INSERT' AND batch_id IS DISTINCT FROM -3641);
    IF (v_queued = 0) THEN
        v_log := v_log || 'P2 recalc queue~|~STOP~|~no pilot rows are waiting: run B1 as DAAS_TEAM first (or the pilot already ran)#ROW#';
        RAISE pilot_stop;
    END IF;
    IF (v_other > 0) THEN
        v_log := v_log || 'P2 recalc queue~|~STOP~|~' || v_other || ' other queue rows are waiting and would be rebuilt with ours#ROW#';
        RAISE pilot_stop;
    END IF;
    v_ids := (SELECT LISTAGG(DISTINCT trip_master_id, ',') FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM
              WHERE METADATA$ACTION = 'INSERT' AND batch_id = -3641);
    v_log := v_log || 'P2 recalc queue~|~ok~|~' || v_queued || ' pilot trips waiting, nothing else#ROW#';

    v_txt := '';
    v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_TEMP.TRIP_MASTER_TRIP_MERGE_CHECK_STREAM'));
    IF (v_has) THEN v_txt := v_txt || ' merge-check'; END IF;
    v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_MERGE_QUEUE_STREAM'));
    IF (v_has) THEN v_txt := v_txt || ' merge-queue'; END IF;
    v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_MASTER_TRIP_CUSTOMER_MERGE_CHECK_STREAM'));
    IF (v_has) THEN v_txt := v_txt || ' customer-merge-check'; END IF;
    v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_CUSTOMER_MERGE_QUEUE_STREAM'));
    IF (v_has) THEN v_txt := v_txt || ' customer-merge-queue'; END IF;
    v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM'));
    IF (v_has) THEN v_txt := v_txt || ' detail-summary'; END IF;
    v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_MASTER_DAILY_SUMMARY_WRAPPER_STREAM'));
    IF (v_has) THEN v_txt := v_txt || ' daily-summary'; END IF;
    IF (v_txt <> '') THEN
        v_log := v_log || 'P3 other streams~|~STOP~|~these already hold changes that would be processed with ours:' || v_txt || '#ROW#';
        RAISE pilot_stop;
    END IF;
    BEGIN
        v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_DETAIL_NG_VW_STREAM'));
        v_ng_clean := NOT v_has;
    EXCEPTION
        WHEN OTHER THEN
            v_ng_clean := FALSE;
    END;
    v_log := v_log || 'P3 other streams~|~ok~|~merge, customer-merge and summary streams empty; non-gaming stream '
                   || IFF(v_ng_clean, 'empty', 'not empty or unreadable, that step will be skipped') || '#ROW#';

    -- P4. The steps empty and refill 7 work tables that must exist, and recreate 12 more plus a stream with
    --     CREATE OR REPLACE, which needs the owner role (or one granted it) as the primary role.
    v_n := (SELECT COUNT(*) FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
            WHERE table_schema = 'DAAS_TEMP'
              AND table_name IN ('TRIP_RESULT_TMP_RECALC', 'TRIP_RESULT_TMP_RECALC_1', 'TRIP_ROW_GEN',
                                 'TRIP_UNMAPPED_SPLIT_TRANS_TEMP', 'TRIP_UNMAPPED_TRANS_HOTEL_TEMP',
                                 'TRIP_RESULT_TMP_MERGE', 'TRIP_RESULT_TMP_MERGE_1'));
    v_txt := (SELECT COALESCE(LISTAGG(DISTINCT COALESCE(table_owner, '(unknown)'), ', '), '')
              FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
              WHERE table_schema = 'DAAS_TEMP'
                AND table_name IN ('TRIP_RECALC_QUEUE_TEMP', 'TRIP_MERGE_TEMP', 'TRIP_MERGE_TEMP_1', 'TRIP_MERGE_TEMP_2',
                                   'TRIP_MERGE_TEMP_2A', 'CUSTOMER_MERGE_CHECK', 'CUSTOMER_MERGE_CHECK_2', 'TRIP_DETAIL_TMP',
                                   'TRIP_MASTER_DAILY_SUMMARY_WRAPPER_STREAM_TEMP', 'DAILY_ACTIVITY_SUMMARY_BM_TRIP',
                                   'DAILY_ACTIVITY_SUMMARY_TRIP', 'TRIP_NG_REVENUE_SUMMARY_TMP')
                AND NOT IS_ROLE_IN_SESSION(COALESCE(table_owner, 'NO_SUCH_ROLE')));
    v_owners := (SELECT COALESCE(LISTAGG(DISTINCT table_owner, ', '), '')
                 FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
                 WHERE table_schema = 'DAAS_TEMP'
                   AND table_name IN ('TRIP_RECALC_QUEUE_TEMP', 'TRIP_MERGE_TEMP', 'TRIP_MERGE_TEMP_1', 'TRIP_MERGE_TEMP_2',
                                      'TRIP_MERGE_TEMP_2A', 'CUSTOMER_MERGE_CHECK', 'CUSTOMER_MERGE_CHECK_2', 'TRIP_DETAIL_TMP',
                                      'TRIP_MASTER_DAILY_SUMMARY_WRAPPER_STREAM_TEMP', 'DAILY_ACTIVITY_SUMMARY_BM_TRIP',
                                      'DAILY_ACTIVITY_SUMMARY_TRIP', 'TRIP_NG_REVENUE_SUMMARY_TMP'));
    SHOW STREAMS LIKE 'TRIP_MASTER_TRIP_MERGE_CHECK_STREAM' IN SCHEMA DAAS_UAT.DAAS_TEMP;
    v_stream := (SELECT COALESCE(LISTAGG(' stream owner ' || "owner", ', '), '')
                 FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
                 WHERE NOT IS_ROLE_IN_SESSION("owner"));
    v_txt := v_txt || v_stream;
    IF (v_n < 7 OR v_txt <> '') THEN
        v_log := v_log || 'P4 work tables~|~STOP~|~role ' || CURRENT_ROLE() || ' sees ' || v_n || ' of the 7 work tables the steps refill'
                       || IFF(v_txt <> '', ' and cannot recreate objects owned by: ' || v_txt, '')
                       || '. Use route A2 (B3a), or run the block as a role that holds those (B2c)#ROW#';
        RAISE pilot_stop;
    END IF;
    v_txt := (SELECT COALESCE(LISTAGG(DISTINCT table_owner, ', '), '')
              FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
              WHERE table_schema = 'DAAS_TEMP'
                AND REGEXP_LIKE(table_name, '(TRIP|TS_RATING|DAS_RATING|DA_RATING).*')
                AND NOT IS_ROLE_IN_SESSION(COALESCE(table_owner, 'NO_SUCH_ROLE')));
    v_log := v_log || 'P4 work tables~|~ok~|~owned by ' || v_owners || ', which this role can act as'
                   || IFF(v_txt <> '', '; other trip-named tables in DAAS_TEMP belong to ' || v_txt || ' (a summary step fails cleanly if it needs one)', '')
                   || '#ROW#';

    ---------------------------------------------------------------- S1. recalculation
    BEGIN
        CALL DAAS_UAT.DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_RECALCULATION', '', 'Core To Core', 'DAAS_CORE.TRIP_RECALC_QUEUE_STREAM') INTO :v_out;
    EXCEPTION
        WHEN OTHER THEN
            v_out := 'ERROR ' || SQLERRM;
    END;
    v_n := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER
            WHERE delete_ind = 'N'
              AND trip_master_id IN (SELECT TO_NUMBER(value) FROM TABLE(SPLIT_TO_TABLE(:v_ids, ','))));
    v_m := (SELECT COUNT(DISTINCT trip_master_id) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_PROCESSED
            WHERE trip_master_id IN (SELECT TO_NUMBER(value) FROM TABLE(SPLIT_TO_TABLE(:v_ids, ','))));
    IF (NOT STARTSWITH(COALESCE(v_out, ''), 'SUCCESS') OR v_out = 'SUCCESS:No Data in Stream' OR v_n > 0 OR v_m < v_queued) THEN
        v_log := v_log || 'S1 recalculation~|~STOP~|~returned ' || COALESCE(v_out, '(null)') || '; ' || v_m || ' of ' || v_queued
                       || ' logged as processed; ' || v_n || ' still live#ROW#';
        RAISE pilot_stop;
    END IF;
    v_log := v_log || 'S1 recalculation~|~ok~|~' || v_m || ' trips retired and re-cut, logged in TRIP_RECALC_PROCESSED#ROW#';

    ---------------------------------------------------------------- S2. merge check
    BEGIN
        CALL DAAS_UAT.DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_MERGE_CHECK', '', 'Core To Core', 'DAAS_TEMP.TRIP_MASTER_TRIP_MERGE_CHECK_STREAM') INTO :v_out;
    EXCEPTION
        WHEN OTHER THEN
            v_out := 'ERROR ' || SQLERRM;
    END;
    IF (NOT STARTSWITH(COALESCE(v_out, ''), 'SUCCESS')) THEN
        v_log := v_log || 'S2 merge check~|~STOP~|~returned ' || COALESCE(v_out, '(null)') || '#ROW#';
        RAISE pilot_stop;
    END IF;
    v_n := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_MERGE_QUEUE_STREAM WHERE METADATA$ACTION = 'INSERT');
    v_log := v_log || 'S2 merge check~|~ok~|~' || v_out || '; ' || v_n || ' trip ids queued for merging#ROW#';

    ---------------------------------------------------------------- S3. merge
    IF (v_n > 0) THEN
        BEGIN
            CALL DAAS_UAT.DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_MERGE', '', 'Core To Core', 'DAAS_CORE.TRIP_MERGE_QUEUE_STREAM') INTO :v_out;
        EXCEPTION
            WHEN OTHER THEN
                v_out := 'ERROR ' || SQLERRM;
        END;
        IF (NOT (STARTSWITH(COALESCE(v_out, ''), 'SUCCESS') OR STARTSWITH(COALESCE(v_out, ''), 'Alert'))) THEN
            v_log := v_log || 'S3 merge~|~STOP~|~returned ' || COALESCE(v_out, '(null)') || '#ROW#';
            RAISE pilot_stop;
        END IF;
        v_log := v_log || 'S3 merge~|~ok~|~' || v_out || '#ROW#';
    ELSE
        v_log := v_log || 'S3 merge~|~skipped~|~nothing was queued for merging#ROW#';
    END IF;

    ---------------------------------------------------------------- S4. customer-merge check on the new masters
    BEGIN
        CALL DAAS_UAT.DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER', '', 'Core To Core', 'DAAS_CORE.TRIP_MASTER_TRIP_CUSTOMER_MERGE_CHECK_STREAM') INTO :v_out;
    EXCEPTION
        WHEN OTHER THEN
            v_out := 'ERROR ' || SQLERRM;
    END;
    v_n := (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_CUSTOMER_MERGE_QUEUE_STREAM WHERE METADATA$ACTION = 'INSERT');
    v_log := v_log || 'S4 customer-merge check~|~' || IFF(STARTSWITH(COALESCE(v_out, ''), 'SUCCESS'), IFF(v_n = 0, 'ok', 'note'), 'note') || '~|~'
                   || COALESCE(v_out, '(null)')
                   || IFF(v_n = 0, '; no guest merges queued',
                          '; ' || v_n || ' guest-merge rows queued and left for the hourly chain (a guest merge rebuilds every trip of both guests)')
                   || '#ROW#';

    ---------------------------------------------------------------- S5. summary
    BEGIN
        CALL DAAS_UAT.DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_SUMMARY_WRAPPER', '', 'Core To Core', 'DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM') INTO :v_out;
    EXCEPTION
        WHEN OTHER THEN
            v_out := 'ERROR ' || SQLERRM;
    END;
    IF (NOT STARTSWITH(COALESCE(v_out, ''), 'SUCCESS')) THEN
        v_log := v_log || 'S5 summary~|~STOP~|~returned ' || COALESCE(v_out, '(null)')
                       || '. TRIP_MASTER and TRIP_DETAIL are rebuilt and checkable; the summary rows are not#ROW#';
        RAISE pilot_stop;
    END IF;
    v_has := (SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM'));
    v_log := v_log || 'S5 summary~|~ok~|~' || v_out || IFF(v_has, '; detail-summary stream still holds rows', '; summary streams consumed') || '#ROW#';

    ---------------------------------------------------------------- S6. comp worth (reads the rows the summary step just staged)
    BEGIN
        CALL DAAS_UAT.DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_COMP_WORTH', '', 'Core To Core') INTO :v_out;
    EXCEPTION
        WHEN OTHER THEN
            v_out := 'ERROR ' || SQLERRM;
    END;
    v_log := v_log || 'S6 comp worth~|~' || IFF(STARTSWITH(COALESCE(v_out, ''), 'SUCCESS'), 'ok', 'note') || '~|~' || COALESCE(v_out, '(null)') || '#ROW#';

    ---------------------------------------------------------------- S7. non-gaming revenue summary
    IF (v_ng_clean) THEN
        BEGIN
            CALL DAAS_UAT.DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_NG_REVENUE_SUMMARY', '', 'Core To Core') INTO :v_out;
        EXCEPTION
            WHEN OTHER THEN
                v_out := 'ERROR ' || SQLERRM;
        END;
        v_log := v_log || 'S7 non-gaming revenue~|~' || IFF(STARTSWITH(COALESCE(v_out, ''), 'SUCCESS'), 'ok', 'note') || '~|~' || COALESCE(v_out, '(null)') || '#ROW#';
    ELSE
        v_log := v_log || 'S7 non-gaming revenue~|~skipped~|~its stream held other changes or could not be read at preflight#ROW#';
    END IF;

    v_log := v_log || 'END~|~done~|~next: B4, then PART C as DAAS_TEAM, then C8#ROW#';
    res := (SELECT t.index AS n, SPLIT_PART(t.value, '~|~', 1) AS step, SPLIT_PART(t.value, '~|~', 2) AS verdict, SPLIT_PART(t.value, '~|~', 3) AS detail
            FROM TABLE(SPLIT_TO_TABLE(:v_log, '#ROW#')) t WHERE t.value <> '' ORDER BY t.index);
    RETURN TABLE(res);
EXCEPTION
    WHEN pilot_stop THEN
        res := (SELECT t.index AS n, SPLIT_PART(t.value, '~|~', 1) AS step, SPLIT_PART(t.value, '~|~', 2) AS verdict, SPLIT_PART(t.value, '~|~', 3) AS detail
                FROM TABLE(SPLIT_TO_TABLE(:v_log, '#ROW#')) t WHERE t.value <> '' ORDER BY t.index);
        RETURN TABLE(res);
    WHEN OTHER THEN
        v_log := v_log || 'error~|~STOP~|~' || REPLACE(REPLACE(SQLERRM, '#ROW#', ''), '~|~', '') || '#ROW#';
        res := (SELECT t.index AS n, SPLIT_PART(t.value, '~|~', 1) AS step, SPLIT_PART(t.value, '~|~', 2) AS verdict, SPLIT_PART(t.value, '~|~', 3) AS detail
                FROM TABLE(SPLIT_TO_TABLE(:v_log, '#ROW#')) t WHERE t.value <> '' ORDER BY t.index);
        RETURN TABLE(res);
END;
$$;

-- (route B) After the block: the procedures set a query tag on the session; secondary roles back on.
ALTER SESSION UNSET QUERY_TAG;
USE SECONDARY ROLES ALL;

-- B4. (DAAS_TEAM, both routes) Did the pipeline take our rows, and did every step after it finish? Until a run has
--     happened B4a shows the rows still waiting; run it again after the chain's next run. After route B, set the
--     context picker back to DAAS_TEAM first.
USE ROLE DAAS_TEAM;

-- B4a. Expect still_waiting 0, processed equal to trips_queued, still_live 0. processed_by is the user the
--      recalculation ran under (SYSTEM for a task run).
WITH q AS (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE),
p AS (SELECT r.trip_master_id, r.batch_id, r.created_by
      FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_PROCESSED r
      JOIN q ON q.trip_master_id = r.trip_master_id)
SELECT (SELECT COUNT(*) FROM q)                                                   AS trips_queued,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM s
         WHERE s.METADATA$ACTION = 'INSERT' AND s.batch_id = -3641)               AS still_waiting_expect_0,
       (SELECT COUNT(DISTINCT trip_master_id) FROM p)                             AS processed_expect_queued,
       (SELECT LISTAGG(DISTINCT batch_id, ', ') FROM p)                           AS recalculation_batch,
       (SELECT LISTAGG(DISTINCT created_by, ', ') FROM p)                         AS processed_by,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
         JOIN q ON q.trip_master_id = m.trip_master_id WHERE m.delete_ind = 'N')  AS still_live_expect_0;

-- B4b. Every trip job logged from the recalculation batch on. Expect TRIP_RECALCULATION, TRIP_MERGE_CHECK (TRIP_MERGE
--      too if the check queued merges), TRIP_CUSTOMER_MERGE_CHECK_TRIP_MASTER, TRIP_SUMMARY_WRAPPER, TRIP_COMP_WORTH and
--      TRIP_NG_REVENUE_SUMMARY, each with a finished status. IN PROGRESS: that step is still running, wait and rerun.
--      A route-A run logs its other steps here too (ratings, hotel...) when they had work.
SELECT b.batch_id, j.job_name, b.batch_status, b.batch_start_date, b.updated_dttm AS last_update, b.created_by AS run_by
FROM DAAS_UAT.DAAS_COMMON.BATCH_S02 b
JOIN DAAS_UAT.DAAS_COMMON.JOB j ON j.job_id = b.job_id
WHERE j.job_name LIKE 'TRIP%'
  AND b.batch_id >= (SELECT MIN(r.batch_id)
                     FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_PROCESSED r
                     JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q ON q.trip_master_id = r.trip_master_id)
ORDER BY b.batch_id
LIMIT 50;


-- ===================================================================================================
-- PART C. Proof (DAAS_TEAM)
-- ===================================================================================================
USE ROLE DAAS_TEAM;
USE DATABASE DAAS_UAT;
USE SCHEMA DAAS_TEMP_WORK;
INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG VALUES ('C_START', CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'after-picture starts');

-- C1. After-picture, same shape as A3.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER AS
SELECT m.*
FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS g ON g.guest_unique_id = m.guest_unique_id
WHERE (m.trip_type = 'MARKET'   AND m.market_cd   = g.market_cd)
   OR (m.trip_type = 'PROPERTY' AND m.property_cd = g.property_cd);

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER AS
SELECT d.*
FROM DAAS_UAT.DAAS_CORE.TRIP_DETAIL d
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id;

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_AFTER AS
SELECT s.*
FROM DAAS_UAT.DAAS_CORE.TRIP_SUMMARY s
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = s.trip_master_id;

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_DAS_AFTER AS
SELECT s.*
FROM DAAS_UAT.DAAS_CORE.DAILY_ACTIVITY_SUMMARY s
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = s.trip_master_id;

-- C2. Scoreboard: one row per check, the expected value next to the actual one. verdict 'LOOK' is a row to explain;
--     'info' rows have no fixed expectation. Rows 15-16: theo is the house's expected win from the guest's play,
--     the figure Tracy reads. Rows 17-18: comp worth, see the note at the top of the file.
WITH mark AS (
    SELECT MAX(IFF(mark = 'max_trip_master_id_before', value, NULL)) AS max_tm,
           MAX(IFF(mark = 'max_trip_detail_id_before', value, NULL)) AS max_td
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS
),
t0   AS (SELECT MIN(logged_at) AS queued_at FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG WHERE step = 'B1_QUEUED'),
g    AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS),
q    AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE),
tmb  AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE),
tdb  AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE),
tsb  AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_BEFORE),
tma  AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER),
tda  AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER),
tsa  AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_AFTER),
dasa AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_DAS_AFTER),
mk   AS (SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt
         FROM tma WHERE trip_type = 'MARKET' AND delete_ind = 'N'),
pr   AS (SELECT trip_master_id, guest_unique_id, DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS twin_market_cd,
                trip_start_dt, trip_end_dt
         FROM tma WHERE trip_type = 'PROPERTY' AND delete_ind = 'N'),
hotel AS (SELECT DISTINCT trip_master_id FROM tda
          WHERE transaction_table = 'HOTEL_GUEST_RESERVATIONS_FACT' AND delete_ind = 'N' AND transaction_sub_type = 'OPENED'),
live_d AS (SELECT d.trip_master_id, d.transaction_table, d.transaction_table_sk, d.business_start_dt,
                  mk.guest_unique_id, mk.market_cd, mk.trip_start_dt, mk.trip_end_dt
           FROM tda d JOIN mk ON mk.trip_master_id = d.trip_master_id
           WHERE d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'),
tx_before AS (SELECT DISTINCT m.guest_unique_id, m.market_cd, d.transaction_table, d.transaction_table_sk
              FROM tdb d JOIN tmb m ON m.trip_master_id = d.trip_master_id
              WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'),
tx_after  AS (SELECT DISTINCT guest_unique_id, market_cd, transaction_table, transaction_table_sk FROM live_d),
tx_prop   AS (SELECT DISTINCT p.guest_unique_id, p.twin_market_cd AS market_cd, d.transaction_table, d.transaction_table_sk
              FROM tda d JOIN pr p ON p.trip_master_id = d.trip_master_id
              WHERE d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'),
twin_m AS (SELECT DISTINCT mk.trip_master_id FROM mk
           JOIN pr ON pr.guest_unique_id = mk.guest_unique_id AND pr.twin_market_cd = mk.market_cd
                  AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt),
twin_p AS (SELECT DISTINCT pr.trip_master_id FROM pr
           JOIN mk ON mk.guest_unique_id = pr.guest_unique_id AND mk.market_cd = pr.twin_market_cd
                  AND mk.trip_start_dt = pr.trip_start_dt AND mk.trip_end_dt = pr.trip_end_dt),
theo_b AS (SELECT m.guest_unique_id, m.market_cd, SUM(s.total_theo_win_amt) AS theo
           FROM tmb m JOIN tsb s ON s.trip_master_id = m.trip_master_id
           WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N' GROUP BY 1, 2),
theo_a AS (SELECT mk.guest_unique_id, mk.market_cd, SUM(s.total_theo_win_amt) AS theo
           FROM mk JOIN tsa s ON s.trip_master_id = mk.trip_master_id GROUP BY 1, 2),
theo_p AS (SELECT pr.guest_unique_id, pr.twin_market_cd AS market_cd, SUM(s.total_theo_win_amt) AS theo
           FROM pr JOIN tsa s ON s.trip_master_id = pr.trip_master_id GROUP BY 1, 2),
theo AS (SELECT g.guest_unique_id, g.market_cd, b.theo AS before_theo, a.theo AS after_theo, p.theo AS property_theo
         FROM g
         LEFT JOIN theo_b b ON b.guest_unique_id = g.guest_unique_id AND b.market_cd = g.market_cd
         LEFT JOIN theo_a a ON a.guest_unique_id = g.guest_unique_id AND a.market_cd = g.market_cd
         LEFT JOIN theo_p p ON p.guest_unique_id = g.guest_unique_id AND p.market_cd = g.market_cd),
tso AS (SELECT trip_master_id, OBJECT_CONSTRUCT(*) AS o FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_AFTER),
cw AS (SELECT mk.trip_master_id,
              sm.o:COMP_WORTH::NUMBER(38,6) AS market_cw,
              sp.o:COMP_WORTH::NUMBER(38,6) AS property_cw
       FROM mk
       JOIN pr ON pr.guest_unique_id = mk.guest_unique_id AND pr.twin_market_cd = mk.market_cd
              AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt
       LEFT JOIN tso sm ON sm.trip_master_id = mk.trip_master_id
       LEFT JOIN tso sp ON sp.trip_master_id = pr.trip_master_id
       WHERE mk.trip_master_id > (SELECT max_tm FROM mark)
       QUALIFY ROW_NUMBER() OVER (PARTITION BY mk.trip_master_id ORDER BY pr.trip_master_id) = 1),
board AS (
    SELECT 1 AS n, 'Queued trips now retired' AS check_name,
           (SELECT COUNT(*) FROM q) AS expected,
           (SELECT COUNT(*) FROM q JOIN tma ON tma.trip_master_id = q.trip_master_id WHERE tma.delete_ind = 'Y') AS actual
    UNION ALL SELECT 2, 'Replacement market trips built', NULL,
           (SELECT COUNT(*) FROM mk WHERE trip_master_id > (SELECT max_tm FROM mark))
    UNION ALL SELECT 3, 'Live market trips longer than the cap, no hotel stay', 0,
           (SELECT COUNT(*) FROM mk WHERE trip_master_id NOT IN (SELECT trip_master_id FROM hotel)
              AND DATEDIFF(day, trip_start_dt, trip_end_dt) + 1 > DECODE(market_cd, 'BEM', 1, 'WLM', 3))
    UNION ALL SELECT 4, 'Live market trips with no identical property trip', 0,
           (SELECT COUNT(*) FROM mk WHERE trip_master_id NOT IN (SELECT trip_master_id FROM twin_m))
    UNION ALL SELECT 5, 'Live property trips with no identical market trip', 0,
           (SELECT COUNT(*) FROM pr WHERE trip_master_id NOT IN (SELECT trip_master_id FROM twin_p))
    UNION ALL SELECT 6, 'Market transactions lost by the rebuild', 0,
           (SELECT COUNT(*) FROM (SELECT * FROM tx_before MINUS SELECT * FROM tx_after))
    UNION ALL SELECT 7, 'Market transactions added by the rebuild (revived deleted rows)', 0,
           (SELECT COUNT(*) FROM (SELECT * FROM tx_after MINUS SELECT * FROM tx_before))
    UNION ALL SELECT 8, 'Transactions on more than one live market trip', 0,
           (SELECT COUNT(*) FROM (SELECT transaction_table, transaction_table_sk FROM live_d GROUP BY 1, 2
                                  HAVING COUNT(DISTINCT trip_master_id) > 1))
    UNION ALL SELECT 9, 'Property-trip transactions missing from market trips', NULL,
           (SELECT COUNT(*) FROM (SELECT * FROM tx_prop MINUS SELECT * FROM tx_after))
    UNION ALL SELECT 10, 'Live detail rows dated outside their trip', 0,
           (SELECT COUNT(*) FROM live_d WHERE business_start_dt NOT BETWEEN trip_start_dt AND trip_end_dt)
    UNION ALL SELECT 11, 'Live market trips with no live detail rows', 0,
           (SELECT COUNT(*) FROM mk WHERE trip_master_id NOT IN (SELECT trip_master_id FROM live_d))
    UNION ALL SELECT 12, 'Live market trips with no TRIP_SUMMARY row', 0,
           (SELECT COUNT(*) FROM mk WHERE trip_master_id NOT IN (SELECT trip_master_id FROM tsa))
    UNION ALL SELECT 13, 'TRIP_SUMMARY.TRIP_DAYS not equal to the trip window', 0,
           (SELECT COUNT(*) FROM mk JOIN tsa s ON s.trip_master_id = mk.trip_master_id
            WHERE s.trip_days <> DATEDIFF(day, mk.trip_start_dt, mk.trip_end_dt) + 1)
    UNION ALL SELECT 14, 'Retired trips whose daily rows are still live', 0,
           (SELECT COUNT(*) FROM dasa s JOIN q ON q.trip_master_id = s.trip_master_id WHERE s.delete_ind = 'N')
    UNION ALL SELECT 15, 'Guests whose market theo changed with the rebuild', 0,
           (SELECT COUNT(*) FROM theo WHERE ROUND(COALESCE(before_theo, 0), 2) <> ROUND(COALESCE(after_theo, 0), 2))
    UNION ALL SELECT 16, 'Guests whose market theo differs from their property theo', 0,
           (SELECT COUNT(*) FROM theo WHERE ROUND(COALESCE(after_theo, 0), 2) <> ROUND(COALESCE(property_theo, 0), 2))
    UNION ALL SELECT 17, 'Rebuilt trips with a twin: comp worth 0 or missing while the twin has one', 0,
           (SELECT COUNT(*) FROM cw WHERE COALESCE(market_cw, 0) = 0 AND COALESCE(property_cw, 0) <> 0)
    UNION ALL SELECT 18, 'Rebuilt trips with a twin: comp worth equal to the twin', (SELECT COUNT(*) FROM cw),
           (SELECT COUNT(*) FROM cw WHERE ROUND(COALESCE(market_cw, 0), 2) = ROUND(COALESCE(property_cw, 0), 2))
    UNION ALL SELECT 19, 'Trip masters changed outside the pilot', 0,
           (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
            WHERE m.updated_dttm >= (SELECT queued_at FROM t0)
              AND NOT EXISTS (SELECT 1 FROM g WHERE g.guest_unique_id = m.guest_unique_id
                                               AND m.trip_type = 'MARKET' AND m.market_cd = g.market_cd))
    UNION ALL SELECT 20, 'Trip detail rows created outside the pilot', 0,
           (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_DETAIL d
            WHERE d.trip_detail_id > (SELECT max_td FROM mark)
              AND NOT EXISTS (SELECT 1 FROM tma WHERE tma.trip_master_id = d.trip_master_id))
)
SELECT n, check_name, expected, actual,
       CASE WHEN expected IS NULL THEN 'info' WHEN actual = expected THEN 'ok' ELSE 'LOOK' END AS verdict
FROM board
ORDER BY n;

-- C3. The twin misses, if scoreboard rows 4-5 show any: both sides in date order, so a boundary difference shows.
WITH mk AS (
    SELECT guest_unique_id, market_cd, trip_master_id, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER WHERE trip_type = 'MARKET' AND delete_ind = 'N'
),
pr AS (
    SELECT guest_unique_id, DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd, trip_master_id, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER WHERE trip_type = 'PROPERTY' AND delete_ind = 'N'
),
miss AS (
    SELECT 'market' AS side, mk.guest_unique_id, mk.market_cd, mk.trip_master_id, mk.trip_start_dt, mk.trip_end_dt
    FROM mk
    WHERE NOT EXISTS (SELECT 1 FROM pr WHERE pr.guest_unique_id = mk.guest_unique_id AND pr.market_cd = mk.market_cd
                                        AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt)
    UNION ALL
    SELECT 'property', pr.guest_unique_id, pr.market_cd, pr.trip_master_id, pr.trip_start_dt, pr.trip_end_dt
    FROM pr
    WHERE NOT EXISTS (SELECT 1 FROM mk WHERE mk.guest_unique_id = pr.guest_unique_id AND mk.market_cd = pr.market_cd
                                        AND mk.trip_start_dt = pr.trip_start_dt AND mk.trip_end_dt = pr.trip_end_dt)
)
SELECT guest_unique_id, market_cd, trip_start_dt, trip_end_dt, side, trip_master_id,
       DATEDIFF(day, trip_start_dt, trip_end_dt) + 1 AS trip_days
FROM miss
ORDER BY 1, 2, 3, 5
LIMIT 500;

-- C4. Transactions by table, market side against property side, after (same shape as A6). Expect the A6 numbers.
WITH mk AS (
    SELECT DISTINCT t.guest_unique_id, t.market_cd, d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
),
pr AS (
    SELECT DISTINCT t.guest_unique_id, DECODE(t.property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd,
                    d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'PROPERTY' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
)
SELECT COALESCE(mk.guest_unique_id, pr.guest_unique_id)     AS guest_unique_id,
       COALESCE(mk.market_cd, pr.market_cd)                 AS market_cd,
       COALESCE(mk.transaction_table, pr.transaction_table) AS transaction_table,
       COUNT_IF(mk.transaction_table_sk IS NOT NULL AND pr.transaction_table_sk IS NOT NULL) AS on_both,
       COUNT_IF(mk.transaction_table_sk IS NULL)             AS missing_on_market,
       COUNT_IF(pr.transaction_table_sk IS NULL)             AS extra_on_market
FROM mk
FULL OUTER JOIN pr
       ON pr.guest_unique_id = mk.guest_unique_id AND pr.market_cd = mk.market_cd
      AND pr.transaction_table = mk.transaction_table AND pr.transaction_table_sk = mk.transaction_table_sk
GROUP BY ALL
ORDER BY 2, 1, 3;

-- C5. TRIP_SUMMARY column by column: every rebuilt market trip against its property twin. One row per column that
--     differs anywhere, with up to three examples. Expect only COMP_WORTH (see the top note). Hotel, POS, freeplay
--     and markers columns come from summary procedures whose UAT code differs from PROD's (readiness E5b), so a
--     difference there can be UAT's code rather than the trip; ratings, comps and offers use identical code.
WITH mark AS (SELECT value AS max_tm FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_master_id_before'),
twin AS (
    SELECT mk.trip_master_id AS market_trip_id, pr.trip_master_id AS property_trip_id
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER mk
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER pr
      ON pr.guest_unique_id = mk.guest_unique_id
     AND pr.trip_type = 'PROPERTY' AND pr.delete_ind = 'N'
     AND pr.property_cd = DECODE(mk.market_cd, 'BEM', 'IBE', 'WLM', 'IWA')
     AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt
    WHERE mk.trip_type = 'MARKET' AND mk.delete_ind = 'N'
      AND mk.trip_master_id > (SELECT max_tm FROM mark)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY mk.trip_master_id ORDER BY pr.trip_master_id) = 1
),
s AS (
    SELECT trip_master_id,
           OBJECT_DELETE(OBJECT_CONSTRUCT(*), 'TRIP_SUMMARY_ID', 'TRIP_MASTER_ID', 'LAST_DML_CD',
                         'CREATED_DTTM', 'CREATED_BY', 'UPDATED_DTTM', 'UPDATED_BY', 'BATCH_ID') AS o
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_AFTER
),
km AS (SELECT t.market_trip_id, f.key, f.value FROM twin t JOIN s ON s.trip_master_id = t.market_trip_id,   LATERAL FLATTEN(input => s.o) f),
kp AS (SELECT t.market_trip_id, f.key, f.value FROM twin t JOIN s ON s.trip_master_id = t.property_trip_id, LATERAL FLATTEN(input => s.o) f),
diffs AS (
    SELECT COALESCE(km.market_trip_id, kp.market_trip_id) AS market_trip_id,
           COALESCE(km.key, kp.key) AS summary_column, km.value AS market_value, kp.value AS property_value
    FROM km FULL OUTER JOIN kp ON kp.market_trip_id = km.market_trip_id AND kp.key = km.key
    WHERE NOT EQUAL_NULL(km.value, kp.value)
)
SELECT '(twin pairs compared)' AS summary_column, (SELECT COUNT(*) FROM twin) AS twin_pairs, NULL AS examples
UNION ALL
SELECT summary_column, COUNT(*),
       ARRAY_SLICE(ARRAY_AGG(OBJECT_CONSTRUCT('market_trip', market_trip_id, 'market', market_value, 'property', property_value)), 0, 3)
FROM diffs
GROUP BY 1
ORDER BY 2 DESC, 1;

-- C6. DAILY_ACTIVITY_SUMMARY: for every day the rebuilt market trips cover, the market row against the property
--     row for the same guest and day. First the presence counts, then one row per column that differs.
WITH mark AS (SELECT value AS max_tm FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_master_id_before'),
g AS (SELECT guest_unique_id, market_cd, property_cd FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS),
rebuilt AS (
    SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER
    WHERE trip_type = 'MARKET' AND delete_ind = 'N' AND trip_master_id > (SELECT max_tm FROM mark)
),
obj AS (
    SELECT trip_master_id, guest_unique_id, guest_activity_date, trip_type, property_cd, delete_ind,
           OBJECT_DELETE(OBJECT_CONSTRUCT(*), 'DAILY_ACTIVITY_SUMMARY_ID', 'TRIP_MASTER_ID', 'PROPERTY_CD', 'MARKET_CD',
                         'TRIP_TYPE', 'LAST_DML_CD', 'CREATED_DTTM', 'CREATED_BY', 'UPDATED_DTTM', 'UPDATED_BY', 'BATCH_ID') AS o
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_DAS_AFTER
),
mrow AS (
    SELECT ob.guest_unique_id, ob.guest_activity_date, ob.o
    FROM obj ob JOIN rebuilt r ON r.trip_master_id = ob.trip_master_id
    WHERE ob.delete_ind = 'N'
),
prow AS (
    SELECT ob.guest_unique_id, ob.guest_activity_date, ob.o
    FROM obj ob
    JOIN g ON g.guest_unique_id = ob.guest_unique_id AND g.property_cd = ob.property_cd
    WHERE ob.trip_type = 'PROPERTY' AND ob.delete_ind = 'N'
      AND EXISTS (SELECT 1 FROM rebuilt r WHERE r.guest_unique_id = ob.guest_unique_id
                                           AND ob.guest_activity_date BETWEEN r.trip_start_dt AND r.trip_end_dt)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY ob.guest_unique_id, ob.guest_activity_date ORDER BY ob.trip_master_id) = 1
),
pairs AS (
    SELECT COALESCE(m.guest_unique_id, p.guest_unique_id) AS guest_unique_id,
           COALESCE(m.guest_activity_date, p.guest_activity_date) AS guest_activity_date,
           m.o AS mo, p.o AS po
    FROM mrow m FULL OUTER JOIN prow p
      ON p.guest_unique_id = m.guest_unique_id AND p.guest_activity_date = m.guest_activity_date
),
km AS (SELECT pa.guest_unique_id, pa.guest_activity_date, f.key, f.value FROM pairs pa, LATERAL FLATTEN(input => pa.mo) f WHERE pa.mo IS NOT NULL AND pa.po IS NOT NULL),
kp AS (SELECT pa.guest_unique_id, pa.guest_activity_date, f.key, f.value FROM pairs pa, LATERAL FLATTEN(input => pa.po) f WHERE pa.mo IS NOT NULL AND pa.po IS NOT NULL),
diffs AS (
    SELECT COALESCE(km.guest_unique_id, kp.guest_unique_id) AS guest_unique_id,
           COALESCE(km.guest_activity_date, kp.guest_activity_date) AS guest_activity_date,
           COALESCE(km.key, kp.key) AS daily_column, km.value AS market_value, kp.value AS property_value
    FROM km FULL OUTER JOIN kp
      ON kp.guest_unique_id = km.guest_unique_id AND kp.guest_activity_date = km.guest_activity_date AND kp.key = km.key
    WHERE NOT EQUAL_NULL(km.value, kp.value)
)
SELECT 'presence' AS kind, 'days with both a market and a property row' AS item, COUNT_IF(mo IS NOT NULL AND po IS NOT NULL) AS days, NULL AS examples FROM pairs
UNION ALL SELECT 'presence', 'days with a market row only (expect 0)',   COUNT_IF(po IS NULL), NULL FROM pairs
UNION ALL SELECT 'presence', 'days with a property row only (expect 0)', COUNT_IF(mo IS NULL), NULL FROM pairs
UNION ALL
SELECT 'column', daily_column, COUNT(*),
       ARRAY_SLICE(ARRAY_AGG(OBJECT_CONSTRUCT('guest', guest_unique_id, 'day', guest_activity_date, 'market', market_value, 'property', property_value)), 0, 3)
FROM diffs
GROUP BY 1, 2
ORDER BY 1 DESC, 3 DESC, 2;

-- C7. The three RCA trips: what replaced them, next to the property trips on the same days.
SELECT q.trip_master_id AS old_trip, q.trip_start_dt AS old_start, q.trip_end_dt AS old_end, q.trip_days AS old_days,
       n.trip_master_id AS new_trip, n.trip_start_dt AS new_start, n.trip_end_dt AS new_end,
       DATEDIFF(day, n.trip_start_dt, n.trip_end_dt) + 1 AS new_days,
       IFF(p.trip_master_id IS NOT NULL, 'yes: ' || p.trip_master_id, 'NO') AS has_property_twin
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q
LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER n
       ON n.guest_unique_id = q.guest_unique_id AND n.trip_type = 'MARKET' AND n.market_cd = q.market_cd AND n.delete_ind = 'N'
      AND n.trip_start_dt <= q.trip_end_dt AND n.trip_end_dt >= q.trip_start_dt
LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER p
       ON p.guest_unique_id = n.guest_unique_id AND p.trip_type = 'PROPERTY' AND p.delete_ind = 'N'
      AND p.trip_start_dt = n.trip_start_dt AND p.trip_end_dt = n.trip_end_dt
WHERE q.trip_master_id IN (2895722234, 2895809361, 2895852622)
ORDER BY 1, 6;

