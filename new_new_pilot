-- C8. (DAAS_TEAM) Ownership check: the owners of the recreated DAAS_TEMP objects now, against what B2d recorded.
--     No rows: nothing to do. Rows with owner_now APP_SERVICE_UAT after a route-A run: leave them, that is what
--     every UAT chain run does. Any other owner_now (route B under another role): UAT's own tasks may then fail to
--     recreate those objects, so run the GRANT statements printed, as the role shown in owner_now.
--     Run each SHOW, then the SELECT right after it.
SHOW TABLES IN SCHEMA DAAS_UAT.DAAS_TEMP;
SELECT o.object_name, o.owner_before, t."owner" AS owner_now, t."created_on" AS recreated_on,
       'GRANT OWNERSHIP ON TABLE DAAS_UAT.DAAS_TEMP.' || o.object_name || ' TO ROLE ' || o.owner_before
           || ' COPY CURRENT GRANTS;' AS run_this_as_owner_now
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_OWNERS o
JOIN TABLE(RESULT_SCAN(LAST_QUERY_ID())) t ON t."name" = o.object_name
WHERE o.object_kind = 'TABLE' AND t."owner" IS DISTINCT FROM o.owner_before
ORDER BY 1;

SHOW STREAMS LIKE 'TRIP_MASTER_TRIP_MERGE_CHECK_STREAM' IN SCHEMA DAAS_UAT.DAAS_TEMP;
SELECT o.object_name, o.owner_before, t."owner" AS owner_now, t."created_on" AS recreated_on,
       'GRANT OWNERSHIP ON STREAM DAAS_UAT.DAAS_TEMP.' || o.object_name || ' TO ROLE ' || o.owner_before
           || ' COPY CURRENT GRANTS;' AS run_this_as_owner_now
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_OWNERS o
JOIN TABLE(RESULT_SCAN(LAST_QUERY_ID())) t ON t."name" = o.object_name
WHERE o.object_kind = 'STREAM' AND t."owner" IS DISTINCT FROM o.owner_before;
