-- DAASI-3641, diagnostics part 6. Read-only (P2a makes one TEMPORARY table, gone when the session ends). Kept apart
-- from the other files. Run each statement on its own, in order, in one worksheet.
--
-- Part N: the NG revenue question from part 5 (H4), with the view name fixed. It replaces N1-N2 of the rehearsal file,
-- which need not be run again. Those pointed at DAAS_CORE.TRIP_DETAIL_NG_VW; the rehearsal's Z1 showed the view lives in
-- DAAS_CORE_MARKETING_VW (only its stream sits in DAAS_CORE). Snowflake gives a missing object and a forbidden one the
-- same message ("does not exist or not authorized"), so it read as a permissions error.
--   The question: 56 NG rows (47 hotel, 9 POS) sit on property twins whose rebuilt market twin got no NG rows at all,
--   and the stays, folio lines and checks behind them still exist in UAT (part 5, H4). Either those property rows are
--   leftovers (the NG step never deletes a row), or a later step of the NG load drops the market twin's rows. That
--   matters for the PROD rebuild, not the replay: if the cause is the code, PROD's rebuilt trips would miss the same rows.
--   N0   where UAT's NG stream reads from (expect DAAS_UAT.DAAS_CORE_MARKETING_VW.TRIP_DETAIL_NG_VW)
--   N1   one row per transaction: still on the property twin? on the market twin? then each join of the NG step, in UAT
--   N1b  the same transactions in the NG view, for both twins
--   N2   the view's text, UAT and PROD (as a .txt, please)
--   N3   the NG step's joins for the same transactions in PROD (UAT's trip tables carry PROD's transaction ids, part 5
--        H1), and whether PROD already has NG rows for them
--
-- Part P: what the PROD runbook needs, all read-only on PROD.
--   P1   the trip caps PROD will cut with: BEM, WLM, IBE, IWA and the retention period, UAT against PROD
--   P2   the full PROD rebuild: twinless BEM and WLM market trips for every guest (P2a keeps them in a temporary table)
--   P2b  the detail rows those trips hold, which the rebuild moves (one pass over PROD's TRIP_DETAIL: a few minutes)
--   P3   how long PROD's hourly trip steps take, and took on the two big recalculation days (Aug 18, Sep 21)
--   P4   who may write the two PROD tables the runbook writes: TRIP_RECALC_QUEUE (rebuild) and TRIP_DETAIL (replay)
--   P5   what the replay could change on PROD's property trips, all guests: comp worth recalculated today against
--        what is stored (part 5's H2 method), an upper bound
--
-- Screenshots are fine for everything except N2.

USE ROLE DAAS_TEAM;
USE SECONDARY ROLES ALL;
USE SCHEMA DAAS_UAT.DAAS_TEMP_WORK;


-- N0. The view UAT's NG stream reads (run the SHOW, then the SELECT right after it). If table_name is not
--     DAAS_UAT.DAAS_CORE_MARKETING_VW.TRIP_DETAIL_NG_VW, skip N1b and N2 (they use that name) and send this row; the
--     rest of the file does not need it.
SHOW STREAMS LIKE 'TRIP_DETAIL_NG_VW_STREAM' IN DATABASE DAAS_UAT;
SELECT "schema_name", "name", "table_name", "source_type", "base_tables", "mode", "stale", "owner"
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));


-- N1. UAT, one row per transaction behind the 56 rows, walking the NG step's own path (TRIP_NG_REVENUE_SUMMARY_LOAD_PROC)
--     for the market twin. How to read it:
--       on_property_twin_now 0 -> the property NG row is a leftover from an older trip shape: nothing to fix;
--       on_market_twin_now 1 -> the step had the transaction to work with; in the join columns after it, the first 0
--         is where the row was lost. Hotel: stay_live (the stay row, not deleted), folio_lines_on_this_stay (this NG
--         row's folio lines that join to the stay by reservation and property), folio_header_ok (header found, not
--         deleted, folio type 1 or 5), ticket_type_ok (ticket type listed as TICKET), folio_line_filters_ok (not
--         ticket type D or A, not transferred, revenue centre filled). POS: check_attribute_ok (the check's attribute
--         row, not deleted).
--     Every join passing on a transaction the market twin holds would point at the run or the view (N1b, N2).
WITH mark AS (
    SELECT value AS max_tm FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_master_id_before'
),
tma AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER),
twin AS (
    SELECT mk.trip_master_id AS market_trip_id, pr.trip_master_id AS property_trip_id
    FROM tma mk
    JOIN tma pr
      ON pr.guest_unique_id = mk.guest_unique_id AND pr.trip_type = 'PROPERTY' AND pr.delete_ind = 'N'
     AND pr.property_cd = DECODE(mk.market_cd, 'BEM', 'IBE', 'WLM', 'IWA')
     AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt
    WHERE mk.trip_type = 'MARKET' AND mk.delete_ind = 'N' AND mk.trip_master_id > (SELECT max_tm FROM mark)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY mk.trip_master_id ORDER BY pr.trip_master_id) = 1
),
ng AS (
    SELECT trip_master_id, transaction_type, transaction_table_sk, transaction_secondary_table_sk, business_start_dt, f_cash_spnd_amt
    FROM DAAS_UAT.DAAS_CORE.TRIP_NG_REVENUE_SUMMARY
    WHERE delete_ind = 'N'
      AND trip_master_id IN (SELECT market_trip_id FROM twin UNION SELECT property_trip_id FROM twin)
),
bare AS (
    SELECT t.*
    FROM twin t
    WHERE t.market_trip_id NOT IN (SELECT trip_master_id FROM ng)
      AND t.property_trip_id IN (SELECT trip_master_id FROM ng)
),
probe AS (
    SELECT b.market_trip_id, b.property_trip_id, n.transaction_type, n.transaction_table_sk AS sk,
           n.transaction_secondary_table_sk AS sk2, n.business_start_dt, n.f_cash_spnd_amt
    FROM bare b
    JOIN ng n ON n.trip_master_id = b.property_trip_id
),
held AS (
    SELECT DISTINCT trip_master_id, transaction_table_sk
    FROM DAAS_UAT.DAAS_CORE.TRIP_DETAIL
    WHERE delete_ind = 'N'
      AND trip_master_id IN (SELECT market_trip_id FROM bare UNION SELECT property_trip_id FROM bare)
),
hg AS (
    SELECT hotel_guest_reservations_fact_sk AS sk, MAX(reservation_id) AS reservation_id, MAX(property_cd) AS property_cd,
           MAX(IFF(delete_ind = 'N', 1, 0)) AS live
    FROM DAAS_UAT.DAAS_CORE.HOTEL_GUEST_RESERVATIONS_FACT
    WHERE hotel_guest_reservations_fact_sk IN (SELECT sk FROM probe WHERE transaction_type = 'HOTEL')
    GROUP BY 1
),
fl AS (
    SELECT hotel_folio_detail_fact_sk AS sk2, reservation_id, property_cd, folio_id, ticket_type, folio_transfer_status, revenue_center_cd
    FROM DAAS_UAT.DAAS_CORE.HOTEL_FOLIO_DETAIL_FACT
    WHERE hotel_folio_detail_fact_sk IN (SELECT sk2 FROM probe WHERE transaction_type = 'HOTEL')
),
fh AS (
    SELECT folio_id, property_cd, MAX(IFF(delete_ind = 'N' AND folio_type IN ('1', '5'), 1, 0)) AS ok
    FROM DAAS_UAT.DAAS_CORE.HOTEL_FOLIO_HEADER_FACT
    WHERE folio_id IN (SELECT folio_id FROM fl)
    GROUP BY 1, 2
),
tt AS (SELECT DISTINCT folio_ticket_type FROM DAAS_UAT.DAAS_CORE.FOLIO_TICKET_TYPE_LKP WHERE type_nm = 'TICKET'),
cs AS (
    SELECT check_sales_sk AS sk, MAX(check_attribute_id) AS check_attribute_id, MAX(property_cd) AS property_cd,
           MAX(src_property_cd) AS src_property_cd
    FROM DAAS_UAT.DAAS_CORE.CHECK_SALES_FACT
    WHERE check_sales_sk IN (SELECT sk FROM probe WHERE transaction_type = 'POS')
    GROUP BY 1
),
ca AS (
    SELECT check_attribute_id, property_cd, src_property_cd, MAX(IFF(delete_ind = 'N', 1, 0)) AS ok
    FROM DAAS_UAT.DAAS_CORE.CHECK_ATTRIBUTE_DIM
    WHERE check_attribute_id IN (SELECT check_attribute_id FROM cs)
    GROUP BY 1, 2, 3
)
SELECT p.transaction_type,
       p.sk                                                         AS transaction_sk,
       MIN(p.business_start_dt)                                     AS first_ng_day,
       COUNT(*)                                                     AS property_ng_rows,
       ROUND(SUM(p.f_cash_spnd_amt), 2)                             AS spend,
       MAX(IFF(hp.trip_master_id IS NOT NULL, 1, 0))                AS on_property_twin_now,
       MAX(IFF(hm.trip_master_id IS NOT NULL, 1, 0))                AS on_market_twin_now,
       MAX(IFF(p.transaction_type = 'HOTEL', hg.live, NULL))        AS stay_live,
       IFF(p.transaction_type = 'HOTEL', COUNT_IF(fl.reservation_id = hg.reservation_id AND fl.property_cd = hg.property_cd), NULL) AS folio_lines_on_this_stay,
       IFF(p.transaction_type = 'HOTEL', COUNT_IF(fh.ok = 1), NULL) AS folio_header_ok,
       IFF(p.transaction_type = 'HOTEL', COUNT_IF(t.folio_ticket_type IS NOT NULL), NULL) AS ticket_type_ok,
       IFF(p.transaction_type = 'HOTEL', COUNT_IF(fl.ticket_type NOT IN ('D', 'A') AND COALESCE(fl.folio_transfer_status, '') <> 'T'
                                                  AND fl.revenue_center_cd IS NOT NULL), NULL) AS folio_line_filters_ok,
       MAX(IFF(p.transaction_type = 'POS', COALESCE(c.ok, 0), NULL)) AS check_attribute_ok
FROM probe p
LEFT JOIN held hp ON hp.trip_master_id = p.property_trip_id AND hp.transaction_table_sk = p.sk
LEFT JOIN held hm ON hm.trip_master_id = p.market_trip_id   AND hm.transaction_table_sk = p.sk
LEFT JOIN hg      ON p.transaction_type = 'HOTEL' AND hg.sk = p.sk
LEFT JOIN fl      ON p.transaction_type = 'HOTEL' AND fl.sk2 = p.sk2
LEFT JOIN fh      ON fh.folio_id = fl.folio_id AND fh.property_cd = fl.property_cd
LEFT JOIN tt t    ON t.folio_ticket_type = fl.ticket_type
LEFT JOIN cs      ON p.transaction_type = 'POS' AND cs.sk = p.sk
LEFT JOIN ca c    ON c.check_attribute_id = cs.check_attribute_id AND c.property_cd = cs.property_cd AND c.src_property_cd = cs.src_property_cd
GROUP BY p.transaction_type, p.sk
ORDER BY 1, 3;


-- N1b. The same transactions in the view the NG step's stream reads, for each twin. The step only ever sees rows that
--      pass this view. A transaction in the view for the property twin but not for the market twin points at a filter
--      in the view (N2 shows it).
WITH mark AS (
    SELECT value AS max_tm FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_master_id_before'
),
tma AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER),
twin AS (
    SELECT mk.trip_master_id AS market_trip_id, pr.trip_master_id AS property_trip_id
    FROM tma mk
    JOIN tma pr
      ON pr.guest_unique_id = mk.guest_unique_id AND pr.trip_type = 'PROPERTY' AND pr.delete_ind = 'N'
     AND pr.property_cd = DECODE(mk.market_cd, 'BEM', 'IBE', 'WLM', 'IWA')
     AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt
    WHERE mk.trip_type = 'MARKET' AND mk.delete_ind = 'N' AND mk.trip_master_id > (SELECT max_tm FROM mark)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY mk.trip_master_id ORDER BY pr.trip_master_id) = 1
),
ng AS (
    SELECT trip_master_id, transaction_type, transaction_table_sk
    FROM DAAS_UAT.DAAS_CORE.TRIP_NG_REVENUE_SUMMARY
    WHERE delete_ind = 'N'
      AND trip_master_id IN (SELECT market_trip_id FROM twin UNION SELECT property_trip_id FROM twin)
),
bare AS (
    SELECT t.*
    FROM twin t
    WHERE t.market_trip_id NOT IN (SELECT trip_master_id FROM ng)
      AND t.property_trip_id IN (SELECT trip_master_id FROM ng)
),
probe AS (
    SELECT DISTINCT b.market_trip_id, b.property_trip_id, n.transaction_type, n.transaction_table_sk AS sk
    FROM bare b
    JOIN ng n ON n.trip_master_id = b.property_trip_id
),
v AS (
    SELECT DISTINCT trip_master_id, transaction_table_sk
    FROM DAAS_UAT.DAAS_CORE_MARKETING_VW.TRIP_DETAIL_NG_VW
    WHERE trip_master_id IN (SELECT market_trip_id FROM bare UNION SELECT property_trip_id FROM bare)
)
SELECT p.transaction_type,
       p.sk                                              AS transaction_sk,
       MAX(IFF(vm.trip_master_id IS NOT NULL, 1, 0))     AS in_view_for_market_twin,
       MAX(IFF(vp.trip_master_id IS NOT NULL, 1, 0))     AS in_view_for_property_twin
FROM probe p
LEFT JOIN v vm ON vm.trip_master_id = p.market_trip_id   AND vm.transaction_table_sk = p.sk
LEFT JOIN v vp ON vp.trip_master_id = p.property_trip_id AND vp.transaction_table_sk = p.sk
GROUP BY 1, 2
ORDER BY 1, 2;


-- N2. The view's text, both environments (as a .txt, please, like part 4's G6). A filter in it (a date range, a trip
--     type, a join to the trip) decides which transactions a rebuilt trip can ever get NG rows for.
SELECT 'UAT' AS env, GET_DDL('VIEW', 'DAAS_UAT.DAAS_CORE_MARKETING_VW.TRIP_DETAIL_NG_VW') AS view_definition
UNION ALL
SELECT 'PROD', GET_DDL('VIEW', 'DAAS_PROD.DAAS_CORE_MARKETING_VW.TRIP_DETAIL_NG_VW');


-- N3. PROD, read-only: the same transactions through the same joins, in PROD's tables, plus whether PROD already holds
--     NG rows for them (prod_ng_rows; PROD's own NG step built those). All joins passing in PROD while one fails in UAT
--     means UAT's tables, not the code: PROD's rebuilt trips would get their NG rows.
WITH mark AS (
    SELECT value AS max_tm FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_master_id_before'
),
tma AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER),
twin AS (
    SELECT mk.trip_master_id AS market_trip_id, pr.trip_master_id AS property_trip_id
    FROM tma mk
    JOIN tma pr
      ON pr.guest_unique_id = mk.guest_unique_id AND pr.trip_type = 'PROPERTY' AND pr.delete_ind = 'N'
     AND pr.property_cd = DECODE(mk.market_cd, 'BEM', 'IBE', 'WLM', 'IWA')
     AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt
    WHERE mk.trip_type = 'MARKET' AND mk.delete_ind = 'N' AND mk.trip_master_id > (SELECT max_tm FROM mark)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY mk.trip_master_id ORDER BY pr.trip_master_id) = 1
),
ng AS (
    SELECT trip_master_id, transaction_type, transaction_table_sk, transaction_secondary_table_sk, business_start_dt, f_cash_spnd_amt
    FROM DAAS_UAT.DAAS_CORE.TRIP_NG_REVENUE_SUMMARY
    WHERE delete_ind = 'N'
      AND trip_master_id IN (SELECT market_trip_id FROM twin UNION SELECT property_trip_id FROM twin)
),
bare AS (
    SELECT t.*
    FROM twin t
    WHERE t.market_trip_id NOT IN (SELECT trip_master_id FROM ng)
      AND t.property_trip_id IN (SELECT trip_master_id FROM ng)
),
probe AS (
    SELECT b.market_trip_id, b.property_trip_id, n.transaction_type, n.transaction_table_sk AS sk,
           n.transaction_secondary_table_sk AS sk2, n.business_start_dt, n.f_cash_spnd_amt
    FROM bare b
    JOIN ng n ON n.trip_master_id = b.property_trip_id
),
pn AS (
    SELECT transaction_table_sk, COUNT(*) AS n
    FROM DAAS_PROD.DAAS_CORE.TRIP_NG_REVENUE_SUMMARY
    WHERE delete_ind = 'N' AND transaction_table_sk IN (SELECT sk FROM probe)
    GROUP BY 1
),
hg AS (
    SELECT hotel_guest_reservations_fact_sk AS sk, MAX(reservation_id) AS reservation_id, MAX(property_cd) AS property_cd,
           MAX(IFF(delete_ind = 'N', 1, 0)) AS live
    FROM DAAS_PROD.DAAS_CORE.HOTEL_GUEST_RESERVATIONS_FACT
    WHERE hotel_guest_reservations_fact_sk IN (SELECT sk FROM probe WHERE transaction_type = 'HOTEL')
    GROUP BY 1
),
fl AS (
    SELECT hotel_folio_detail_fact_sk AS sk2, reservation_id, property_cd, folio_id, ticket_type, folio_transfer_status, revenue_center_cd
    FROM DAAS_PROD.DAAS_CORE.HOTEL_FOLIO_DETAIL_FACT
    WHERE hotel_folio_detail_fact_sk IN (SELECT sk2 FROM probe WHERE transaction_type = 'HOTEL')
),
fh AS (
    SELECT folio_id, property_cd, MAX(IFF(delete_ind = 'N' AND folio_type IN ('1', '5'), 1, 0)) AS ok
    FROM DAAS_PROD.DAAS_CORE.HOTEL_FOLIO_HEADER_FACT
    WHERE folio_id IN (SELECT folio_id FROM fl)
    GROUP BY 1, 2
),
tt AS (SELECT DISTINCT folio_ticket_type FROM DAAS_PROD.DAAS_CORE.FOLIO_TICKET_TYPE_LKP WHERE type_nm = 'TICKET'),
cs AS (
    SELECT check_sales_sk AS sk, MAX(check_attribute_id) AS check_attribute_id, MAX(property_cd) AS property_cd,
           MAX(src_property_cd) AS src_property_cd
    FROM DAAS_PROD.DAAS_CORE.CHECK_SALES_FACT
    WHERE check_sales_sk IN (SELECT sk FROM probe WHERE transaction_type = 'POS')
    GROUP BY 1
),
ca AS (
    SELECT check_attribute_id, property_cd, src_property_cd, MAX(IFF(delete_ind = 'N', 1, 0)) AS ok
    FROM DAAS_PROD.DAAS_CORE.CHECK_ATTRIBUTE_DIM
    WHERE check_attribute_id IN (SELECT check_attribute_id FROM cs)
    GROUP BY 1, 2, 3
)
SELECT p.transaction_type,
       p.sk                                                         AS transaction_sk,
       MAX(COALESCE(pn.n, 0))                                       AS prod_ng_rows,
       MAX(IFF(p.transaction_type = 'HOTEL', hg.live, NULL))        AS stay_live,
       IFF(p.transaction_type = 'HOTEL', COUNT_IF(fl.reservation_id = hg.reservation_id AND fl.property_cd = hg.property_cd), NULL) AS folio_lines_on_this_stay,
       IFF(p.transaction_type = 'HOTEL', COUNT_IF(fh.ok = 1), NULL) AS folio_header_ok,
       IFF(p.transaction_type = 'HOTEL', COUNT_IF(t.folio_ticket_type IS NOT NULL), NULL) AS ticket_type_ok,
       IFF(p.transaction_type = 'HOTEL', COUNT_IF(fl.ticket_type NOT IN ('D', 'A') AND COALESCE(fl.folio_transfer_status, '') <> 'T'
                                                  AND fl.revenue_center_cd IS NOT NULL), NULL) AS folio_line_filters_ok,
       MAX(IFF(p.transaction_type = 'POS', COALESCE(c.ok, 0), NULL)) AS check_attribute_ok
FROM probe p
LEFT JOIN pn      ON pn.transaction_table_sk = p.sk
LEFT JOIN hg      ON p.transaction_type = 'HOTEL' AND hg.sk = p.sk
LEFT JOIN fl      ON p.transaction_type = 'HOTEL' AND fl.sk2 = p.sk2
LEFT JOIN fh      ON fh.folio_id = fl.folio_id AND fh.property_cd = fl.property_cd
LEFT JOIN tt t    ON t.folio_ticket_type = fl.ticket_type
LEFT JOIN cs      ON p.transaction_type = 'POS' AND cs.sk = p.sk
LEFT JOIN ca c    ON c.check_attribute_id = cs.check_attribute_id AND c.property_cd = cs.property_cd AND c.src_property_cd = cs.src_property_cd
GROUP BY p.transaction_type, p.sk
ORDER BY 1, 2;


-- ===================================================================================================
-- P. What the PROD runbook needs (read-only on PROD)
-- ===================================================================================================
-- P1. The trip settings both environments cut with, for the two markets and their properties, plus the archival step's
--     retention period (how many days a retired trip's rows are kept before they are deleted for good; the PROD checks
--     have to run inside that window). Expect matching rows in UAT and PROD, MAX_TRIP_DAYS 1 for BEM and 3 for WLM.
WITH c AS (
    SELECT 'UAT' AS env, OBJECT_CONSTRUCT(*) AS o FROM DAAS_UAT.DAAS_CORE.TRIP_CONFIG
    UNION ALL
    SELECT 'PROD', OBJECT_CONSTRUCT(*) FROM DAAS_PROD.DAAS_CORE.TRIP_CONFIG
)
SELECT o:"KEY"::VARCHAR AS config_key, o:"VALUE"::VARCHAR AS config_value, o:"ACTIVE_FLG"::VARCHAR AS active_flg, env,
       OBJECT_DELETE(o, 'KEY', 'VALUE', 'ACTIVE_FLG') AS other_columns
FROM c
WHERE o::VARCHAR ILIKE ANY ('%"BEM"%', '%"WLM"%', '%"IBE"%', '%"IWA"%', '%"RETENTION_PERIOD"%')
ORDER BY config_key, other_columns::VARCHAR, env;


-- P2a. Every live BEM and WLM market trip in PROD with no identical property trip at IBE or IWA (same guest, same
--      dates): what a full rebuild would queue, by the pilot's own rule (its A4). Kept in a temporary table for P2/P2b.
CREATE OR REPLACE TEMPORARY TABLE DAASI_3641_PROD_TWINLESS AS
WITH pr AS (
    SELECT DISTINCT guest_unique_id, DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER
    WHERE trip_type = 'PROPERTY' AND delete_ind = 'N' AND property_cd IN ('IBE', 'IWA')
)
SELECT m.trip_master_id, m.guest_unique_id, m.market_cd, m.trip_start_dt, m.trip_end_dt, m.created_dttm,
       DATEDIFF(day, m.trip_start_dt, m.trip_end_dt) + 1 AS trip_days,
       (g.guest_unique_id IS NOT NULL)                    AS pilot_guest
FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER m
LEFT JOIN pr
       ON pr.guest_unique_id = m.guest_unique_id AND pr.market_cd = m.market_cd
      AND pr.trip_start_dt = m.trip_start_dt AND pr.trip_end_dt = m.trip_end_dt
LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS g
       ON g.guest_unique_id = m.guest_unique_id AND g.market_cd = m.market_cd
WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N' AND m.market_cd IN ('BEM', 'WLM')
  AND pr.guest_unique_id IS NULL;

-- P2. The full rebuild, by market. Wave 1 is the five pilot guests (of_them_pilot_guests); wave 2 is the rest.
WITH lm AS (
    SELECT market_cd, COUNT(*) AS live_market_trips
    FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER
    WHERE trip_type = 'MARKET' AND delete_ind = 'N' AND market_cd IN ('BEM', 'WLM')
    GROUP BY 1
),
pg AS (SELECT market_cd, guest_unique_id, COUNT(*) AS n FROM DAASI_3641_PROD_TWINLESS GROUP BY 1, 2),
mg AS (SELECT market_cd, MAX(n) AS most_for_one_guest, COUNT_IF(n > 1000) AS guests_over_1000_trips FROM pg GROUP BY 1),
agg AS (
    SELECT market_cd,
           COUNT(*)                                                     AS trips_to_rebuild,
           COUNT(DISTINCT guest_unique_id)                              AS guests,
           COUNT_IF(trip_days > DECODE(market_cd, 'BEM', 1, 'WLM', 3))  AS longer_than_the_cap,
           COUNT_IF(created_dttm >= '2026-08-12 11:16:26')              AS built_since_aug_12,
           MAX(trip_days)                                               AS longest_days,
           MIN(trip_start_dt)                                           AS first_start,
           MAX(trip_end_dt)                                             AS last_end,
           COUNT_IF(guest_unique_id <= 0)                               AS on_placeholder_guest_ids,
           COUNT_IF(pilot_guest)                                        AS of_them_pilot_guests
    FROM DAASI_3641_PROD_TWINLESS
    GROUP BY 1
)
SELECT a.market_cd, l.live_market_trips, a.trips_to_rebuild, a.guests, a.longer_than_the_cap, a.built_since_aug_12,
       a.longest_days, a.first_start, a.last_end, a.on_placeholder_guest_ids, a.of_them_pilot_guests,
       g.most_for_one_guest, g.guests_over_1000_trips
FROM agg a
JOIN lm l ON l.market_cd = a.market_cd
JOIN mg g ON g.market_cd = a.market_cd
ORDER BY 1;

-- P2b. The detail rows on those trips, by market and kind: the size of the job for PROD's hourly run. The rebuild
--      re-cuts the live rows; deleted_opened_rows are soft-deleted rows the rebuild gathers too (the pilot's A4 note),
--      for the record. One pass over PROD's TRIP_DETAIL: a few minutes.
SELECT t.market_cd, d.transaction_type,
       COUNT_IF(d.delete_ind = 'N')                                      AS live_detail_rows,
       COUNT(DISTINCT IFF(d.delete_ind = 'N', d.trip_master_id, NULL))   AS trips,
       COUNT_IF(d.delete_ind = 'N' AND t.pilot_guest)                   AS of_them_pilot_guests,
       COUNT_IF(d.delete_ind = 'Y' AND d.transaction_sub_type = 'OPENED') AS deleted_opened_rows
FROM DAAS_PROD.DAAS_CORE.TRIP_DETAIL d
JOIN DAASI_3641_PROD_TWINLESS t ON t.trip_master_id = d.trip_master_id
GROUP BY 1, 2
ORDER BY 1, 2;


-- P3. PROD's hourly trip steps over the last 75 days: runs, minutes, failures, and the longest run on 2026-08-18 and
--     2026-09-21, when PROD's recalculation queue took 774,000 and 1.66 million trips (readiness part 3, Q1). The
--     rebuild and the replay ride these same steps.
WITH b AS (
    SELECT j.job_name, b.batch_status, b.batch_start_date,
           DATEDIFF(second, b.batch_start_date, b.updated_dttm) / 60 AS minutes
    FROM DAAS_PROD.DAAS_COMMON.BATCH_S02 b
    JOIN DAAS_PROD.DAAS_COMMON.JOB j ON j.job_id = b.job_id
    WHERE j.job_name IN ('TRIP_RECALCULATION', 'TRIP_MERGE_CHECK', 'TRIP_MERGE', 'TRIP_SUMMARY_WRAPPER', 'TRIP_COMP_WORTH',
                         'TRIP_NG_REVENUE_SUMMARY')
      AND b.batch_start_date >= DATEADD(day, -75, CURRENT_DATE())
)
SELECT job_name,
       COUNT(*)                                            AS runs,
       COUNT_IF(NOT STARTSWITH(batch_status, 'SUCCESS'))  AS not_success,
       ROUND(MEDIAN(minutes), 1)                           AS median_minutes,
       ROUND(APPROX_PERCENTILE(minutes, 0.95), 1)          AS p95_minutes,
       ROUND(MAX(minutes), 1)                              AS longest_minutes,
       ROUND(MAX(IFF(TO_DATE(batch_start_date) IN ('2026-08-18', '2026-09-21'), minutes, NULL)), 1) AS longest_on_the_big_days
FROM b
GROUP BY 1
ORDER BY 1;


-- P4. Who may write the two PROD tables the runbook writes: INSERT on TRIP_RECALC_QUEUE (the rebuild) and UPDATE on
--     TRIP_DETAIL (the replay's marking). you_have_it TRUE means the role is one you can use; otherwise those are the
--     roles to ask for, or whoever runs the PROD steps for you. Run each SHOW, then the SELECT right after it.
SHOW GRANTS ON TABLE DAAS_PROD.DAAS_CORE.TRIP_RECALC_QUEUE;
SELECT "privilege", "grantee_name",
       ARRAY_CONTAINS("grantee_name"::VARIANT, PARSE_JSON(CURRENT_AVAILABLE_ROLES())::ARRAY) AS you_have_it
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
WHERE "privilege" IN ('INSERT', 'OWNERSHIP') AND "granted_to" = 'ROLE'
ORDER BY 1, 2;

SHOW GRANTS ON TABLE DAAS_PROD.DAAS_CORE.TRIP_DETAIL;
SELECT "privilege", "grantee_name",
       ARRAY_CONTAINS("grantee_name"::VARIANT, PARSE_JSON(CURRENT_AVAILABLE_ROLES())::ARRAY) AS you_have_it
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
WHERE "privilege" IN ('UPDATE', 'OWNERSHIP') AND "granted_to" = 'ROLE'
ORDER BY 1, 2;


-- P5. What the replay could change on PROD's property trips, for every guest: each live IBE or IWA property trip with
--     play (GAMING_FLG 'Y'), its comp worth recalculated today the way the comp-worth step values it (part 5's H2
--     method: theo by game type x the multiplier band for that theo / trip days) against what PROD stores. The replay
--     touches only the property twins of rebuilt market trips, so this is an upper bound. For the five pilot guests H2
--     found 2 of 6,114 trips differing, by $30.86 in all.
WITH t AS (
    SELECT trip_master_id, property_cd
    FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER
    WHERE trip_type = 'PROPERTY' AND delete_ind = 'N' AND property_cd IN ('IBE', 'IWA')
),
ts AS (
    SELECT s.trip_master_id, t.property_cd, s.slot_theo_win_amt, s.table_theo_win_amt, s.other_theo_win_amt, s.trip_days,
           s.comp_worth
    FROM DAAS_PROD.DAAS_CORE.TRIP_SUMMARY s
    JOIN t ON t.trip_master_id = s.trip_master_id
    WHERE s.gaming_flg = 'Y'
),
band AS (
    SELECT s.trip_master_id, m.cmp_pct_mult_type AS gt, MAX(m.pct_mult) AS mult
    FROM ts s
    JOIN DAAS_PROD.DAAS_COMMON.CMPCW_REFINED m
      ON m.property_cd = s.property_cd
     AND ((m.cmp_pct_mult_type = 'S' AND ROUND(s.slot_theo_win_amt)  BETWEEN m.from_theo AND m.to_theo)
       OR (m.cmp_pct_mult_type = 'T' AND ROUND(s.table_theo_win_amt) BETWEEN m.from_theo AND m.to_theo)
       OR (m.cmp_pct_mult_type = 'O' AND ROUND(s.other_theo_win_amt) BETWEEN m.from_theo AND m.to_theo))
    GROUP BY 1, 2
),
cw AS (
    SELECT s.trip_master_id, s.property_cd, COALESCE(s.comp_worth, 0) AS stored,
           (COALESCE(s.slot_theo_win_amt, 0)  * COALESCE(MAX(IFF(b.gt = 'S', b.mult, NULL)), 0)) / NULLIF(s.trip_days, 0)
         + (COALESCE(s.table_theo_win_amt, 0) * COALESCE(MAX(IFF(b.gt = 'T', b.mult, NULL)), 0)) / NULLIF(s.trip_days, 0)
         + (COALESCE(s.other_theo_win_amt, 0) * COALESCE(MAX(IFF(b.gt = 'O', b.mult, NULL)), 0)) / NULLIF(s.trip_days, 0) AS today
    FROM ts s
    LEFT JOIN band b ON b.trip_master_id = s.trip_master_id
    GROUP BY s.trip_master_id, s.property_cd, s.comp_worth, s.slot_theo_win_amt, s.table_theo_win_amt, s.other_theo_win_amt, s.trip_days
)
SELECT property_cd,
       COUNT(*)                                                  AS property_trips_with_play,
       COUNT_IF(ROUND(COALESCE(today, 0), 2) <> ROUND(stored, 2)) AS would_change,
       ROUND(SUM(stored), 2)                                     AS stored_total,
       ROUND(SUM(COALESCE(today, 0)), 2)                         AS today_total,
       ROUND(SUM(COALESCE(today, 0) - stored), 2)                AS net_change
FROM cw
GROUP BY 1
ORDER BY 1;
