-- DAASI-3641 UAT pilot: rebuild the broken BEM and WLM market trips of five guests through the trip pipeline's
-- own recalculation path, then prove the result at the transaction (SK) level.
--
-- What it does, in plain terms. A "trip" is the pipeline's grouping of one guest's transactions (ratings, hotel
-- nights, meals, comps...) into a visit with a start and end date. BEM and WLM are one-property markets, so each
-- market trip should be a copy of the property trip (same guest, same dates, same transactions). The old market
-- trips were built under a 7-day cap; the cap is now 1 (BEM) and 3 (WLM), and nothing in the hourly chain ever
-- shortens a trip that already exists. The pipeline does have a "rebuild this trip" path: put a trip id into
-- TRIP_RECALC_QUEUE and TRIP_RECALCULATION_PROC retires the trip, re-cuts its transactions under today's caps,
-- builds the replacement trips with new ids, and the merge and summary steps finish the job. This pilot pushes the
-- bad market trips of five guests through that path and then checks every trip table.
--
-- Roles. PART A and PART C run as DAAS_TEAM (reads, scratch tables in DAAS_TEMP_WORK, the queue insert).
--        PART B runs as the role that owns the UAT pipeline objects (readiness part 3, section R decides which):
--        the procs draw sequence values and CREATE OR REPLACE work tables in DAAS_TEMP, which DAAS_TEAM cannot.
-- Run statement by statement. Every check ends in a column that says what it expects.
-- Scratch tables (all DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_*): GUESTS, LOG, MARKS, QUEUE, TM/TD/TS/DAS _BEFORE and _AFTER.


-- ===================================================================================================
-- PART A. Scope and the before-picture (DAAS_TEAM, read-only on DAAS_CORE)
-- ===================================================================================================
USE ROLE DAAS_TEAM;
USE DATABASE DAAS_UAT;
USE SCHEMA DAAS_TEMP_WORK;

-- A1. The pilot guests: the three WLM guests from the RCA, plus the two BEM guests with the most market trips that
--     have no identical property trip ("twin"). A guest is in scope for one market only.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS (
    guest_unique_id NUMBER(38,0), market_cd VARCHAR, property_cd VARCHAR, pick_reason VARCHAR);

INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS
SELECT column1, 'WLM', 'IWA', column2
FROM VALUES (17600543027, 'RCA trip 2895722234'), (19606195360, 'RCA trip 2895809361'), (15903662806, 'RCA trip 2895852622');

INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS
WITH prop AS (
    SELECT DISTINCT guest_unique_id, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER
    WHERE trip_type = 'PROPERTY' AND property_cd = 'IBE' AND delete_ind = 'N'
),
no_twin AS (
    SELECT m.guest_unique_id,
           COUNT(*)                                                  AS trips_without_twin,
           MAX(DATEDIFF(day, m.trip_start_dt, m.trip_end_dt) + 1)    AS longest_days
    FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
    LEFT JOIN prop p
           ON p.guest_unique_id = m.guest_unique_id
          AND p.trip_start_dt   = m.trip_start_dt
          AND p.trip_end_dt     = m.trip_end_dt
    WHERE m.trip_type = 'MARKET' AND m.market_cd = 'BEM' AND m.delete_ind = 'N'
      AND p.guest_unique_id IS NULL
    GROUP BY 1
    QUALIFY ROW_NUMBER() OVER (ORDER BY trips_without_twin DESC, guest_unique_id) <= 2
)
SELECT guest_unique_id, 'BEM', 'IBE',
       'BEM guest with ' || trips_without_twin || ' market trips lacking a property twin, longest ' || longest_days || ' days'
FROM no_twin;

SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS ORDER BY market_cd, guest_unique_id;

-- A2. A log, so every later check can refer to the moment the pilot started without session variables, and the
--     highest trip ids in UAT right now: everything the pipeline builds will carry a higher id, which lets the
--     blast-radius check in C9 find new rows without scanning the whole of TRIP_DETAIL.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG (step VARCHAR, logged_at TIMESTAMP_LTZ, note VARCHAR);
INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG VALUES ('A_START', CURRENT_TIMESTAMP(), 'before-picture starts');

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS AS
SELECT 'max_trip_master_id_before' AS mark, MAX(trip_master_id) AS value FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER
UNION ALL
SELECT 'max_trip_detail_id_before', MAX(trip_detail_id) FROM DAAS_UAT.DAAS_CORE.TRIP_DETAIL;

-- A3. Before-picture: every TRIP_MASTER row of the pilot guests in their market and its property (live or not),
--     every TRIP_DETAIL row of those masters, and their TRIP_SUMMARY and DAILY_ACTIVITY_SUMMARY rows.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE AS
SELECT m.*
FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS g ON g.guest_unique_id = m.guest_unique_id
WHERE (m.trip_type = 'MARKET'   AND m.market_cd   = g.market_cd)
   OR (m.trip_type = 'PROPERTY' AND m.property_cd = g.property_cd);

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE AS
SELECT d.*
FROM DAAS_UAT.DAAS_CORE.TRIP_DETAIL d
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = d.trip_master_id;

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_BEFORE AS
SELECT s.*
FROM DAAS_UAT.DAAS_CORE.TRIP_SUMMARY s
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = s.trip_master_id;

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_DAS_BEFORE AS
SELECT s.*
FROM DAAS_UAT.DAAS_CORE.DAILY_ACTIVITY_SUMMARY s
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = s.trip_master_id;

INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG
SELECT 'A_SNAPSHOT', CURRENT_TIMESTAMP(),
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE) || ' masters, ' ||
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE) || ' details snapshotted';

-- A4. The trips to rebuild: every live market trip of a pilot guest, in the pilot market, that has no identical
--     property twin. Trips built after the config change are included on purpose: a trip cut from the wrong
--     starting day stays wrong, and the rebuild re-cuts the whole run of consecutive days in one pass.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE AS
WITH prop AS (
    SELECT DISTINCT guest_unique_id, DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE
    WHERE trip_type = 'PROPERTY' AND delete_ind = 'N'
),
hotel AS (
    SELECT DISTINCT trip_master_id
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE
    WHERE transaction_table = 'HOTEL_GUEST_RESERVATIONS_FACT' AND delete_ind = 'N' AND transaction_sub_type = 'OPENED'
),
live_rows AS (
    SELECT trip_master_id, COUNT(*) AS live_detail_rows
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE
    WHERE delete_ind = 'N' AND transaction_sub_type = 'OPENED'
    GROUP BY 1
)
SELECT m.trip_master_id, m.guest_unique_id, m.market_cd, m.trip_start_dt, m.trip_end_dt,
       DATEDIFF(day, m.trip_start_dt, m.trip_end_dt) + 1                    AS trip_days,
       DECODE(m.market_cd, 'BEM', 1, 'WLM', 3)                               AS max_trip_days,
       IFF(h.trip_master_id IS NOT NULL, 'Y', 'N')                           AS has_hotel_stay,
       COALESCE(r.live_detail_rows, 0)                                       AS live_detail_rows,
       m.created_dttm,
       IFF(m.created_dttm < '2026-08-12 11:16:26', 'before config change', 'after config change') AS built
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE m
LEFT JOIN prop p
       ON p.guest_unique_id = m.guest_unique_id AND p.market_cd = m.market_cd
      AND p.trip_start_dt = m.trip_start_dt AND p.trip_end_dt = m.trip_end_dt
LEFT JOIN hotel     h ON h.trip_master_id = m.trip_master_id
LEFT JOIN live_rows r ON r.trip_master_id = m.trip_master_id
WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
  AND p.guest_unique_id IS NULL;

-- A5. Dry-run report: what the rebuild will touch, per guest. Read this before PART B.
SELECT guest_unique_id, market_cd,
       COUNT(*)                                        AS trips_to_rebuild,
       COUNT_IF(trip_days > max_trip_days)             AS over_cap,
       MAX(trip_days)                                  AS longest_days,
       COUNT_IF(built = 'before config change')        AS built_before_change,
       COUNT_IF(built = 'after config change')         AS built_after_change,
       COUNT_IF(has_hotel_stay = 'Y')                  AS with_hotel_stay,
       COUNT_IF(live_detail_rows = 0)                  AS with_no_live_detail,
       SUM(live_detail_rows)                           AS live_detail_rows,
       MIN(trip_start_dt)                              AS first_trip_start,
       MAX(trip_end_dt)                                AS last_trip_end
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE
GROUP BY ALL
ORDER BY 2, 1;

-- A6. Pete's question, before: is anything missing from TRIP_DETAIL on the market side? Every live transaction
--     on a live property trip should also sit on a live market trip (one-property market), and nothing extra.
--     The recalculation re-cuts what the market trips already hold; missing rows here need a second step later.
WITH mk AS (
    SELECT DISTINCT t.guest_unique_id, t.market_cd, d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
),
pr AS (
    SELECT DISTINCT t.guest_unique_id, DECODE(t.property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd, d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'PROPERTY' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
)
SELECT COALESCE(mk.guest_unique_id, pr.guest_unique_id)     AS guest_unique_id,
       COALESCE(mk.market_cd, pr.market_cd)                 AS market_cd,
       COALESCE(mk.transaction_table, pr.transaction_table) AS transaction_table,
       COUNT_IF(mk.transaction_table_sk IS NOT NULL AND pr.transaction_table_sk IS NOT NULL) AS on_both,
       COUNT_IF(mk.transaction_table_sk IS NULL)             AS missing_on_market,
       COUNT_IF(pr.transaction_table_sk IS NULL)             AS extra_on_market
FROM mk
FULL OUTER JOIN pr
       ON pr.guest_unique_id = mk.guest_unique_id AND pr.market_cd = mk.market_cd
      AND pr.transaction_table = mk.transaction_table AND pr.transaction_table_sk = mk.transaction_table_sk
GROUP BY ALL
ORDER BY 2, 1, 3;

-- A7. Before: transactions sitting on more than one live market trip (the doubled-ratings residue). Expect few or none.
SELECT COUNT(*) AS sks_on_more_than_one_live_market_trip_before
FROM (
    SELECT d.transaction_table, d.transaction_table_sk, COUNT(DISTINCT d.trip_master_id) AS trips
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
    GROUP BY 1, 2
    HAVING COUNT(DISTINCT d.trip_master_id) > 1
);

-- A8. The three RCA trips as they stand now, next to the property trips covering the same days.
SELECT q.trip_master_id, q.guest_unique_id, q.market_cd, q.trip_start_dt, q.trip_end_dt, q.trip_days, q.has_hotel_stay,
       LISTAGG(p.trip_master_id || ' [' || p.trip_start_dt || '..' || p.trip_end_dt || ']', ', ')
           WITHIN GROUP (ORDER BY p.trip_start_dt) AS property_trips_on_those_days
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q
LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE p
       ON p.guest_unique_id = q.guest_unique_id AND p.trip_type = 'PROPERTY' AND p.delete_ind = 'N'
      AND p.trip_start_dt <= q.trip_end_dt AND p.trip_end_dt >= q.trip_start_dt
WHERE q.trip_master_id IN (2895722234, 2895809361, 2895852622)
GROUP BY ALL
ORDER BY 1;

-- ===================================================================================================
-- PART B. The rebuild, through the pipeline
-- ===================================================================================================

-- B1. (DAAS_TEAM) Queue the trips. Mirrors the pipeline's own INSERT into this table; BATCH_ID -3641 marks the rows
--     as ours. The queue stream must be empty first: whatever is in it would be rebuilt alongside our trips.
USE ROLE DAAS_TEAM;
SELECT SYSTEM$STREAM_HAS_DATA('DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM') AS queue_stream_has_data_expect_false;

INSERT INTO DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE (TRIP_MASTER_ID, STATUS, BATCH_ID, CREATED_DTTM, CREATED_BY, UPDATED_DTTM, UPDATED_BY)
SELECT trip_master_id, 'PENDING', -3641, CURRENT_TIMESTAMP(), CURRENT_USER(), CURRENT_TIMESTAMP(), 'DAASI-3641 pilot'
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE;

INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG
SELECT 'B1_QUEUED', CURRENT_TIMESTAMP(), COUNT(*) || ' trips queued' FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE;

SELECT (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE_STREAM WHERE METADATA$ACTION = 'INSERT') AS rows_waiting_in_stream,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE)                              AS trips_queued_expect_equal;
-- To take the rows back out before the recalculation runs (the stream then shows nothing for them):
--   DELETE FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_QUEUE WHERE BATCH_ID = -3641;

-- B2. (pipeline role) Switch to the role readiness part 3 section R settled on, with the session pointed at UAT.
--     APP_SERVICE_UAT if you can use it. DAAS_UAT_DEVELOPER otherwise, and then C11 runs at the end.
--     The procs switch the session to the warehouse named in the UAT JOB rows (DAAS_UAT_IT_WHSRCTORAW_COMPUTE),
--     so the role needs USAGE on it: the USE WAREHOUSE here fails early if it does not.
USE ROLE APP_SERVICE_UAT;
USE DATABASE DAAS_UAT;
USE SCHEMA DAAS_COMMON;
USE WAREHOUSE DAAS_UAT_IT_WHSRCTORAW_COMPUTE;
SELECT CURRENT_ROLE() AS role_now, CURRENT_DATABASE() AS db_now_expect_daas_uat, CURRENT_WAREHOUSE() AS wh_now;

-- B3. Recalculation: exactly what CORE2CORE_TRIP_RECALCULATION_TASK runs. Returns SUCCESS. Anything else: stop,
--     the proc rolled its own changes back; send me the text.
CALL DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_RECALCULATION', '', 'Core To Core', 'DAAS_CORE.TRIP_RECALC_QUEUE_STREAM');

SELECT COUNT(*)      AS trips_processed_today_expect_queue_size,
       MIN(batch_id) AS recalc_batch_id,
       MIN(created_dttm) AS first_logged, MAX(created_dttm) AS last_logged
FROM DAAS_CORE.TRIP_RECALC_PROCESSED
WHERE created_dttm >= CURRENT_DATE();

SELECT SYSTEM$STREAM_HAS_DATA('DAAS_TEMP.TRIP_MASTER_TRIP_MERGE_CHECK_STREAM') AS new_masters_waiting_for_merge_check_expect_true,
       SYSTEM$STREAM_HAS_DATA('DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM')          AS new_details_waiting_for_summary_expect_true;

-- B4. Merge check: looks at every new master and queues any that should be joined to a neighbouring live trip.
--     With a whole run of days re-cut in one pass there is usually nothing to join. Returns SUCCESS.
CALL DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_MERGE_CHECK', '', 'Core To Core', 'DAAS_TEMP.TRIP_MASTER_TRIP_MERGE_CHECK_STREAM');

SELECT SYSTEM$STREAM_HAS_DATA('DAAS_CORE.TRIP_MERGE_QUEUE_STREAM') AS merges_queued,
       (SELECT COUNT(*) FROM DAAS_CORE.TRIP_MERGE_QUEUE_STREAM WHERE METADATA$ACTION = 'INSERT') AS trips_queued_for_merge;

-- B5. Merge: only if B4 shows merges_queued = TRUE. Joins the queued pairs and re-cuts them under the caps.
--     Returns SUCCESS ("Alert : Only one record in merge queue stream" means one id and nothing to join).
--     If it ran, repeat B4 once: the chain would do that on its next hourly pass.
CALL DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_MERGE', '', 'Core To Core', 'DAAS_CORE.TRIP_MERGE_QUEUE_STREAM');

SELECT COUNT(*) AS merge_rows_logged_today FROM DAAS_CORE.TRIP_MERGE_PROCESSED WHERE created_dttm >= CURRENT_DATE();

-- B6. Summary: rebuilds TRIP_SUMMARY and DAILY_ACTIVITY_SUMMARY for every trip whose detail rows changed
--     (the new trips) and flags the retired trips' daily rows. Returns SUCCESS. Takes a while (16 minutes
--     on an average PROD hour; here it only has our rows).
CALL DAAS_COMMON.BATCH_CONTROL_DATA_LOAD_WRAPPER_PROC('TRIP_SUMMARY_WRAPPER', '', 'Core To Core', 'DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM');

SELECT SYSTEM$STREAM_HAS_DATA('DAAS_CORE.TRIP_DETAIL_SUMMARY_STREAM')             AS details_still_waiting_expect_false,
       SYSTEM$STREAM_HAS_DATA('DAAS_CORE.TRIP_MASTER_DAILY_SUMMARY_WRAPPER_STREAM') AS masters_still_waiting_expect_false;

-- B-alt. If no role of yours can run the CALLs, but readiness part 3 R4 showed the INITIAL_LOAD tasks have no
--        predecessor and your role holds OPERATE on them: run each step as the task instead. EXECUTE TASK runs it
--        as the task's owner on the task's warehouse, asynchronously, so check TASK_HISTORY before the next step.
--        Caveat: the wrapper returns "FAILURE" as text rather than raising, so a task run can show SUCCEEDED while
--        the proc failed; the B3/B4/B6 count checks above still tell the truth.
EXECUTE TASK DAAS_UAT.DAAS_COMMON.CORE2CORE_TRIP_RECALCULATION_INITIAL_LOAD_TASK;
SELECT name, state, scheduled_time, completed_time, error_message
FROM TABLE(DAAS_UAT.INFORMATION_SCHEMA.TASK_HISTORY(
        SCHEDULED_TIME_RANGE_START => DATEADD(hour, -3, CURRENT_TIMESTAMP()),
        TASK_NAME => 'CORE2CORE_TRIP_RECALCULATION_INITIAL_LOAD_TASK'))
ORDER BY scheduled_time DESC;
-- then, the same way, in this order, waiting for each to complete:
--   EXECUTE TASK DAAS_UAT.DAAS_COMMON.CORE2CORE_TRIP_MERGE_CHECK_INITIAL_LOAD_TASK;
--       (its CALL names DAAS_CORE.TRIP_MASTER_TRIP_MERGE_CHECK_STREAM, the 2022 location of that stream, which now
--        lives in DAAS_TEMP. The proc reads DAAS_TEMP regardless. If the run errors on the name, use the CALL in B4.)
--   EXECUTE TASK DAAS_UAT.DAAS_COMMON.CORE2CORE_TRIP_MERGE_INITIAL_LOAD_TASK;        (only if merges were queued)
--   EXECUTE TASK DAAS_UAT.DAAS_COMMON.CORE2CORE_TRIP_SUMMARY_INITIAL_LOAD_TASK;


-- ===================================================================================================
-- PART C. Proof (DAAS_TEAM)
-- ===================================================================================================
USE ROLE DAAS_TEAM;
USE DATABASE DAAS_UAT;
USE SCHEMA DAAS_TEMP_WORK;
INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG VALUES ('C_START', CURRENT_TIMESTAMP(), 'after-picture starts');

-- C1. After-picture, same shape as A3.
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER AS
SELECT m.*
FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS g ON g.guest_unique_id = m.guest_unique_id
WHERE (m.trip_type = 'MARKET'   AND m.market_cd   = g.market_cd)
   OR (m.trip_type = 'PROPERTY' AND m.property_cd = g.property_cd);

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER AS
SELECT d.*
FROM DAAS_UAT.DAAS_CORE.TRIP_DETAIL d
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id;

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_AFTER AS
SELECT s.*
FROM DAAS_UAT.DAAS_CORE.TRIP_SUMMARY s
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = s.trip_master_id;

CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_DAS_AFTER AS
SELECT s.*
FROM DAAS_UAT.DAAS_CORE.DAILY_ACTIVITY_SUMMARY s
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = s.trip_master_id;

-- C2. What happened to the queued trips: all retired (DELETE_IND = 'Y'), and how many replacements exist.
WITH repl AS (
    SELECT n.market_cd, COUNT(*) AS replacement_trips_built
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER n
    WHERE n.trip_type = 'MARKET' AND n.delete_ind = 'N'
      AND n.trip_master_id > (SELECT value FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_master_id_before')
    GROUP BY 1
)
SELECT q.market_cd,
       COUNT(*)                                        AS trips_queued,
       COUNT_IF(a.delete_ind = 'Y')                    AS now_retired_expect_all,
       COUNT_IF(a.delete_ind = 'N')                    AS still_live_expect_0,
       COUNT_IF(a.trip_master_id IS NULL)              AS vanished_expect_0,
       MAX(r.replacement_trips_built)                  AS replacement_trips_built
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q
LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER a ON a.trip_master_id = q.trip_master_id
LEFT JOIN repl r ON r.market_cd = q.market_cd
GROUP BY 1
ORDER BY 1;

-- C3. The cap holds: no live market trip of the pilot guests is longer than its market's cap, hotel stays aside
--     (a hotel stay may legitimately hold a trip open up to 30 days, on both sides of the pair).
WITH hotel AS (
    SELECT DISTINCT trip_master_id
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER
    WHERE transaction_table = 'HOTEL_GUEST_RESERVATIONS_FACT' AND delete_ind = 'N' AND transaction_sub_type = 'OPENED'
)
SELECT m.market_cd,
       COUNT(*)                                                                               AS live_market_trips,
       COUNT_IF(h.trip_master_id IS NULL AND DATEDIFF(day, m.trip_start_dt, m.trip_end_dt) + 1 > DECODE(m.market_cd, 'BEM', 1, 'WLM', 3)) AS over_cap_no_hotel_expect_0,
       COUNT_IF(h.trip_master_id IS NOT NULL AND DATEDIFF(day, m.trip_start_dt, m.trip_end_dt) + 1 > DECODE(m.market_cd, 'BEM', 1, 'WLM', 3)) AS over_cap_with_hotel_stay,
       MAX(DATEDIFF(day, m.trip_start_dt, m.trip_end_dt) + 1)                                 AS longest_days
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER m
LEFT JOIN hotel h ON h.trip_master_id = m.trip_master_id
WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
GROUP BY 1
ORDER BY 1;

-- C4. Twins, both ways: every live market trip has an identical live property trip, and the reverse.
WITH mk AS (
    SELECT DISTINCT guest_unique_id, market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER WHERE trip_type = 'MARKET' AND delete_ind = 'N'
),
pr AS (
    SELECT DISTINCT guest_unique_id, DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER WHERE trip_type = 'PROPERTY' AND delete_ind = 'N'
)
SELECT COALESCE(mk.guest_unique_id, pr.guest_unique_id) AS guest_unique_id,
       COALESCE(mk.market_cd, pr.market_cd)             AS market_cd,
       COUNT_IF(mk.trip_start_dt IS NOT NULL AND pr.trip_start_dt IS NOT NULL) AS twinned,
       COUNT_IF(pr.trip_start_dt IS NULL)               AS market_trips_without_twin_expect_0,
       COUNT_IF(mk.trip_start_dt IS NULL)               AS property_trips_without_twin_expect_0
FROM mk
FULL OUTER JOIN pr
       ON pr.guest_unique_id = mk.guest_unique_id AND pr.market_cd = mk.market_cd
      AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt
GROUP BY ALL
ORDER BY 2, 1;

-- C4b. The misses, if C4 shows any: both sides, in date order, so a boundary difference is visible at a glance.
WITH mk AS (
    SELECT guest_unique_id, market_cd, trip_master_id, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER WHERE trip_type = 'MARKET' AND delete_ind = 'N'
),
pr AS (
    SELECT guest_unique_id, DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd, trip_master_id, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER WHERE trip_type = 'PROPERTY' AND delete_ind = 'N'
),
miss AS (
    SELECT 'market' AS side, mk.* FROM mk
    WHERE NOT EXISTS (SELECT 1 FROM pr WHERE pr.guest_unique_id = mk.guest_unique_id AND pr.market_cd = mk.market_cd
                                        AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt)
    UNION ALL
    SELECT 'property', pr.* FROM pr
    WHERE NOT EXISTS (SELECT 1 FROM mk WHERE mk.guest_unique_id = pr.guest_unique_id AND mk.market_cd = pr.market_cd
                                        AND mk.trip_start_dt = pr.trip_start_dt AND mk.trip_end_dt = pr.trip_end_dt)
)
SELECT guest_unique_id, market_cd, trip_start_dt, trip_end_dt, side, trip_master_id,
       DATEDIFF(day, trip_start_dt, trip_end_dt) + 1 AS trip_days
FROM miss
ORDER BY 1, 2, 3, 5
LIMIT 500;

-- C5. Nothing lost, nothing invented, nothing doubled: the set of transactions on live market trips is the same
--     before and after, and each transaction sits on exactly one live market trip.
WITH b AS (
    SELECT DISTINCT t.guest_unique_id, t.market_cd, d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_BEFORE d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
),
a AS (
    SELECT DISTINCT t.guest_unique_id, t.market_cd, d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
),
doubled AS (
    SELECT d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
    GROUP BY 1, 2
    HAVING COUNT(DISTINCT d.trip_master_id) > 1
)
SELECT (SELECT COUNT(*) FROM b)                                   AS market_transactions_before,
       (SELECT COUNT(*) FROM a)                                   AS market_transactions_after_expect_same,
       (SELECT COUNT(*) FROM (SELECT * FROM b MINUS SELECT * FROM a)) AS lost_expect_0,
       (SELECT COUNT(*) FROM (SELECT * FROM a MINUS SELECT * FROM b)) AS invented_expect_0,
       (SELECT COUNT(*) FROM doubled)                             AS on_more_than_one_live_trip_expect_0;

-- C6. Pete's question, after (same query as A6). Expect the same numbers as A6: the rebuild cannot add
--     transactions the market trips never had; if missing_on_market > 0 the fact-level replay is the second step.
WITH mk AS (
    SELECT DISTINCT t.guest_unique_id, t.market_cd, d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
),
pr AS (
    SELECT DISTINCT t.guest_unique_id, DECODE(t.property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd, d.transaction_table, d.transaction_table_sk
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'PROPERTY' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
)
SELECT COALESCE(mk.guest_unique_id, pr.guest_unique_id)     AS guest_unique_id,
       COALESCE(mk.market_cd, pr.market_cd)                 AS market_cd,
       COALESCE(mk.transaction_table, pr.transaction_table) AS transaction_table,
       COUNT_IF(mk.transaction_table_sk IS NOT NULL AND pr.transaction_table_sk IS NOT NULL) AS on_both,
       COUNT_IF(mk.transaction_table_sk IS NULL)             AS missing_on_market,
       COUNT_IF(pr.transaction_table_sk IS NULL)             AS extra_on_market
FROM mk
FULL OUTER JOIN pr
       ON pr.guest_unique_id = mk.guest_unique_id AND pr.market_cd = mk.market_cd
      AND pr.transaction_table = mk.transaction_table AND pr.transaction_table_sk = mk.transaction_table_sk
GROUP BY ALL
ORDER BY 2, 1, 3;

-- C7. Detail rows agree with their masters: every live detail date falls inside its trip's window, and no live
--     market trip is empty.
SELECT COUNT_IF(d.business_start_dt NOT BETWEEN t.trip_start_dt AND t.trip_end_dt) AS detail_dates_outside_trip_expect_0,
       COUNT(DISTINCT t.trip_master_id)                                            AS live_market_trips_with_details,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER x
         WHERE x.trip_type = 'MARKET' AND x.delete_ind = 'N'
           AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER y
                            WHERE y.trip_master_id = x.trip_master_id AND y.delete_ind = 'N' AND y.transaction_sub_type = 'OPENED')) AS live_market_trips_with_no_details_expect_0
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER d
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id
WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED';

-- C8. Summaries. Every live market trip has a TRIP_SUMMARY row whose TRIP_DAYS matches its window and a
--     DAILY_ACTIVITY_SUMMARY row for every day it has (non-hotel) activity; the retired trips' daily rows are
--     flagged deleted. Theo (the house's expected win from the guest's play, the metric Tracy reads) per guest
--     is unchanged by the rebuild and equals the property side.
SELECT m.market_cd,
       COUNT(*)                                                             AS live_market_trips,
       COUNT_IF(s.trip_master_id IS NULL)                                   AS without_trip_summary_expect_0,
       COUNT_IF(s.trip_days <> DATEDIFF(day, m.trip_start_dt, m.trip_end_dt) + 1) AS trip_days_mismatch_expect_0
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER m
LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_AFTER s ON s.trip_master_id = m.trip_master_id
WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
GROUP BY 1
ORDER BY 1;

SELECT COUNT(*) AS activity_days_without_daily_summary_row_expect_0
FROM (
    SELECT DISTINCT d.trip_master_id, d.business_start_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t ON t.trip_master_id = d.trip_master_id
    WHERE t.trip_type = 'MARKET' AND t.delete_ind = 'N' AND d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
      AND d.transaction_table <> 'HOTEL_GUEST_RESERVATIONS_FACT'
) x
WHERE NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_DAS_AFTER s
                   WHERE s.trip_master_id = x.trip_master_id AND s.guest_activity_date = x.business_start_dt AND s.delete_ind = 'N');

SELECT COUNT(*) AS retired_trips_daily_rows_still_live_expect_0
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_DAS_AFTER s
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q ON q.trip_master_id = s.trip_master_id
WHERE s.delete_ind = 'N';

WITH before_theo AS (
    SELECT m.guest_unique_id, m.market_cd, SUM(s.total_theo_win_amt) AS theo
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_BEFORE m
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_BEFORE s ON s.trip_master_id = m.trip_master_id
    WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
    GROUP BY 1, 2
),
after_theo AS (
    SELECT m.guest_unique_id, m.market_cd, SUM(s.total_theo_win_amt) AS theo
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER m
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_AFTER s ON s.trip_master_id = m.trip_master_id
    WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
    GROUP BY 1, 2
),
property_theo AS (
    SELECT m.guest_unique_id, DECODE(m.property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd, SUM(s.total_theo_win_amt) AS theo
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER m
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_AFTER s ON s.trip_master_id = m.trip_master_id
    WHERE m.trip_type = 'PROPERTY' AND m.delete_ind = 'N'
    GROUP BY 1, 2
)
SELECT g.guest_unique_id, g.market_cd,
       b.theo AS market_theo_before, a.theo AS market_theo_after, p.theo AS property_theo,
       IFF(ROUND(COALESCE(a.theo, 0), 2) = ROUND(COALESCE(b.theo, 0), 2), 'same', 'CHANGED')            AS before_vs_after,
       IFF(ROUND(COALESCE(a.theo, 0), 2) = ROUND(COALESCE(p.theo, 0), 2), 'matches property', 'DIFFERS') AS market_vs_property
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS g
LEFT JOIN before_theo   b ON b.guest_unique_id = g.guest_unique_id AND b.market_cd = g.market_cd
LEFT JOIN after_theo    a ON a.guest_unique_id = g.guest_unique_id AND a.market_cd = g.market_cd
LEFT JOIN property_theo p ON p.guest_unique_id = g.guest_unique_id AND p.market_cd = g.market_cd
ORDER BY 2, 1;

-- C9. Blast radius: nothing outside the five guests' market trips moved. UAT's chain is suspended, so any row
--     touched since the pilot started is the pilot's. New rows are found by id (A2 marks), which prunes well.
SELECT (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
         WHERE m.updated_dttm >= (SELECT MIN(logged_at) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG WHERE step = 'B1_QUEUED')
           AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS g
                            WHERE g.guest_unique_id = m.guest_unique_id AND m.trip_type = 'MARKET' AND m.market_cd = g.market_cd)) AS masters_touched_outside_pilot_expect_0,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_MASTER m
         WHERE m.trip_master_id > (SELECT value FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_master_id_before')
           AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS g
                            WHERE g.guest_unique_id = m.guest_unique_id AND m.trip_type = 'MARKET' AND m.market_cd = g.market_cd)) AS masters_created_outside_pilot_expect_0,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_DETAIL d
         WHERE d.trip_detail_id > (SELECT value FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_detail_id_before')
           AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER t WHERE t.trip_master_id = d.trip_master_id)) AS details_created_outside_pilot_expect_0,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_CORE.TRIP_RECALC_PROCESSED p
         WHERE p.created_dttm >= (SELECT MIN(logged_at) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_LOG WHERE step = 'B1_QUEUED')) AS trips_recalculated,
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE) AS trips_queued_expect_equal;

-- C10. The three RCA trips: what replaced them, next to the property trips on the same days.
SELECT q.trip_master_id AS old_trip, q.trip_start_dt AS old_start, q.trip_end_dt AS old_end, q.trip_days AS old_days,
       n.trip_master_id AS new_trip, n.trip_start_dt AS new_start, n.trip_end_dt AS new_end,
       DATEDIFF(day, n.trip_start_dt, n.trip_end_dt) + 1 AS new_days,
       IFF(p.trip_master_id IS NOT NULL, 'yes: ' || p.trip_master_id, 'NO') AS has_property_twin
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_QUEUE q
LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER n
       ON n.guest_unique_id = q.guest_unique_id AND n.trip_type = 'MARKET' AND n.market_cd = q.market_cd AND n.delete_ind = 'N'
      AND n.trip_start_dt <= q.trip_end_dt AND n.trip_end_dt >= q.trip_start_dt
LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER p
       ON p.guest_unique_id = n.guest_unique_id AND p.trip_type = 'PROPERTY' AND p.delete_ind = 'N'
      AND p.trip_start_dt = n.trip_start_dt AND p.trip_end_dt = n.trip_end_dt
WHERE q.trip_master_id IN (2895722234, 2895809361, 2895852622)
ORDER BY 1, 6;

