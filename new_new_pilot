USE ROLE DAAS_TEAM;
USE SECONDARY ROLES ALL;
USE SCHEMA DAAS_UAT.DAAS_TEMP_WORK;


-- H0a. The five pilot guests' live PROD trips: market trips in their market, property trips at their property.
CREATE OR REPLACE TEMPORARY TABLE DAASI_3641_PROD_TRIPS AS
SELECT m.trip_master_id, m.guest_unique_id, m.trip_type, m.market_cd, m.property_cd, m.trip_start_dt, m.trip_end_dt
FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER m
JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_GUESTS g ON g.guest_unique_id = m.guest_unique_id
WHERE m.delete_ind = 'N'
  AND ((m.trip_type = 'MARKET' AND m.market_cd = g.market_cd) OR (m.trip_type = 'PROPERTY' AND m.property_cd = g.property_cd));

-- H0b. Their free-play, offer and rating transactions (reads PROD's TRIP_DETAIL once: several minutes).
CREATE OR REPLACE TEMPORARY TABLE DAASI_3641_PROD_TD AS
SELECT d.trip_master_id, d.transaction_type, d.transaction_table_sk, d.business_start_dt, d.delete_ind, d.transaction_sub_type
FROM DAAS_PROD.DAAS_CORE.TRIP_DETAIL d
WHERE d.trip_master_id IN (SELECT trip_master_id FROM DAASI_3641_PROD_TRIPS)
  AND d.transaction_type IN ('FREEPLAY', 'OFFER', 'RATINGS');

SELECT (SELECT COUNT(*) FROM DAASI_3641_PROD_TRIPS) AS prod_trips, (SELECT COUNT(*) FROM DAASI_3641_PROD_TD) AS prod_detail_rows;


-- H1. Every distinct free-play, offer and rating transaction on those PROD trips, by year, and how many the summary's
--     lookup finds in PROD today: COMP_FREE_PLAY_DETAIL_FACT for free play, the view OFFER_LEDGER_FACT_TRIP_VW for
--     offers (the same view text in UAT and PROD, per G6), RATINGS_FACT for ratings. Ratings also check the guest.
--     Expect 100% everywhere. A gap in older years would mean a PROD rebuild or replay loses those old figures.
WITH t AS (SELECT trip_master_id, guest_unique_id FROM DAASI_3641_PROD_TRIPS),
td AS (
    SELECT DISTINCT d.transaction_type, d.transaction_table_sk AS sk, YEAR(d.business_start_dt) AS yr, t.guest_unique_id AS guest
    FROM DAASI_3641_PROD_TD d
    JOIN t ON t.trip_master_id = d.trip_master_id
    WHERE d.delete_ind = 'N' AND d.transaction_sub_type = 'OPENED'
),
fp AS (SELECT DISTINCT comp_free_play_detail_fact_sk AS sk FROM DAAS_PROD.DAAS_CORE.COMP_FREE_PLAY_DETAIL_FACT
       WHERE comp_free_play_detail_fact_sk IN (SELECT sk FROM td WHERE transaction_type = 'FREEPLAY')),
ov AS (SELECT DISTINCT offer_ledger_fact_sk AS sk FROM DAAS_PROD.DAAS_CORE_MARKETING_VW.OFFER_LEDGER_FACT_TRIP_VW
       WHERE offer_ledger_fact_sk IN (SELECT sk FROM td WHERE transaction_type = 'OFFER')),
rf AS (SELECT ratings_fact_sk AS sk, guest_unique_id AS guest FROM DAAS_PROD.DAAS_CORE.RATINGS_FACT
       WHERE ratings_fact_sk IN (SELECT sk FROM td WHERE transaction_type = 'RATINGS')
       QUALIFY ROW_NUMBER() OVER (PARTITION BY ratings_fact_sk ORDER BY guest_unique_id) = 1)
SELECT td.transaction_type,
       td.yr                                                AS activity_year,
       COUNT(*)                                             AS transactions,
       COUNT_IF(COALESCE(fp.sk, ov.sk, rf.sk) IS NOT NULL)  AS found_where_the_summary_looks,
       IFF(td.transaction_type = 'RATINGS', COUNT_IF(rf.guest = td.guest), NULL) AS ratings_same_guest
FROM td
LEFT JOIN fp ON td.transaction_type = 'FREEPLAY' AND fp.sk = td.sk
LEFT JOIN ov ON td.transaction_type = 'OFFER'    AND ov.sk = td.sk
LEFT JOIN rf ON td.transaction_type = 'RATINGS'  AND rf.sk = td.sk
GROUP BY 1, 2
ORDER BY 1, 2;


-- H2. PROD's stored figures against the same figures recomputed today with the summary steps' own lookups (as G2
--     did in UAT), for the five guests' live PROD trips that have a summary row, by trip type. Comp worth is
--     recomputed the way TRIP_COMP_WORTH_LOAD_PROC values a property trip: theo by game type x the multiplier band
--     for that theo (DAAS_COMMON.CMPCW_REFINED) / trip days. Expect stored_equals_today on (nearly) every trip: then
--     a replay leaves PROD's property figures as they are, and the rebuilt market trips will match them.
WITH t AS (SELECT * FROM DAASI_3641_PROD_TRIPS),
ts AS (
    SELECT s.*
    FROM DAAS_PROD.DAAS_CORE.TRIP_SUMMARY s
    WHERE s.trip_master_id IN (SELECT trip_master_id FROM t)
),
td AS (SELECT * FROM DAASI_3641_PROD_TD),
fp AS (
    SELECT td.trip_master_id, COALESCE(ABS(SUM(IFF(td.delete_ind = 'N', f.free_play_points, NULL))), 0) AS v
    FROM td
    JOIN DAAS_PROD.DAAS_CORE.COMP_FREE_PLAY_DETAIL_FACT f ON f.comp_free_play_detail_fact_sk = td.transaction_table_sk
    WHERE td.transaction_type = 'FREEPLAY'
    GROUP BY 1
),
ofr AS (
    SELECT td.trip_master_id,
           COUNT(DISTINCT IFF(td.delete_ind = 'N', o.offer_id, NULL)) AS nbr_offers,
           SUM(CASE WHEN td.delete_ind = 'N' AND o.coupon_type = '0A' AND SUBSTRING(o.coupon_id, 1, 1) NOT IN ('V', 'Z', 'W', 'X')
                     AND o.coupon_id NOT IN ('GR', 'GS', 'BJ', 'BA', 'BB', 'BC', 'BD', 'BE', 'BF') THEN o.redeem_amt_cost_adjusted ELSE 0 END)
         + SUM(CASE WHEN td.delete_ind = 'N' AND o.coupon_type = '0H' THEN o.redeem_amt_cost_adjusted ELSE 0 END)
         + SUM(CASE WHEN td.delete_ind = 'N' AND o.coupon_type NOT IN ('0H', '0A') THEN o.redeem_amt_cost_adjusted ELSE 0 END)
         + SUM(CASE WHEN td.delete_ind = 'N' AND ((o.coupon_type = '0A' AND (SUBSTRING(o.coupon_id, 1, 1) IN ('V', 'Z', 'W', 'X')
                     OR o.coupon_id IN ('GR', 'GS', 'BJ', 'BA', 'BB', 'BC', 'BD', 'BE', 'BF')))
                     OR (o.coupon_type = '0L' AND o.coupon_id = 'FP')) THEN o.redeem_amt_cost_adjusted ELSE 0 END) AS total_cost
    FROM td
    JOIN DAAS_PROD.DAAS_CORE_MARKETING_VW.OFFER_LEDGER_FACT_TRIP_VW o ON o.offer_ledger_fact_sk = td.transaction_table_sk
    WHERE td.transaction_type = 'OFFER'
    GROUP BY 1
),
rated AS (   -- the comp-worth step values property trips that have live ratings
    SELECT DISTINCT trip_master_id FROM td WHERE transaction_type = 'RATINGS' AND delete_ind = 'N'
),
band AS (
    SELECT s.trip_master_id, m.cmp_pct_mult_type AS gt, MAX(m.pct_mult) AS mult
    FROM ts s
    JOIN t ON t.trip_master_id = s.trip_master_id AND t.trip_type = 'PROPERTY'
    JOIN DAAS_PROD.DAAS_COMMON.CMPCW_REFINED m
      ON m.property_cd = t.property_cd
     AND ((m.cmp_pct_mult_type = 'S' AND ROUND(s.slot_theo_win_amt)  BETWEEN m.from_theo AND m.to_theo)
       OR (m.cmp_pct_mult_type = 'T' AND ROUND(s.table_theo_win_amt) BETWEEN m.from_theo AND m.to_theo)
       OR (m.cmp_pct_mult_type = 'O' AND ROUND(s.other_theo_win_amt) BETWEEN m.from_theo AND m.to_theo))
    GROUP BY 1, 2
),
cw AS (
    SELECT s.trip_master_id,
           (COALESCE(s.slot_theo_win_amt, 0)  * COALESCE(MAX(IFF(b.gt = 'S', b.mult, NULL)), 0)) / NULLIF(s.trip_days, 0)
         + (COALESCE(s.table_theo_win_amt, 0) * COALESCE(MAX(IFF(b.gt = 'T', b.mult, NULL)), 0)) / NULLIF(s.trip_days, 0)
         + (COALESCE(s.other_theo_win_amt, 0) * COALESCE(MAX(IFF(b.gt = 'O', b.mult, NULL)), 0)) / NULLIF(s.trip_days, 0) AS v
    FROM ts s
    JOIN t ON t.trip_master_id = s.trip_master_id AND t.trip_type = 'PROPERTY'
    JOIN rated r ON r.trip_master_id = s.trip_master_id
    LEFT JOIN band b ON b.trip_master_id = s.trip_master_id
    GROUP BY s.trip_master_id, s.slot_theo_win_amt, s.table_theo_win_amt, s.other_theo_win_amt, s.trip_days
),
cmp AS (
    SELECT t.trip_type, 'free play points (DLC_FSP_POINT_AMT)' AS measure,
           COALESCE(fp.v, 0) AS today, COALESCE(s.dlc_fsp_point_amt, 0) AS stored
    FROM t JOIN ts s ON s.trip_master_id = t.trip_master_id
    LEFT JOIN fp ON fp.trip_master_id = t.trip_master_id
    UNION ALL
    SELECT t.trip_type, 'offers (OFFER_NBR_OFFERS)', COALESCE(o.nbr_offers, 0), COALESCE(s.offer_nbr_offers, 0)
    FROM t JOIN ts s ON s.trip_master_id = t.trip_master_id
    LEFT JOIN ofr o ON o.trip_master_id = t.trip_master_id
    UNION ALL
    SELECT t.trip_type, 'offer cost (OFFER_TOTAL_COST)', COALESCE(o.total_cost, 0), COALESCE(s.offer_total_cost, 0)
    FROM t JOIN ts s ON s.trip_master_id = t.trip_master_id
    LEFT JOIN ofr o ON o.trip_master_id = t.trip_master_id
    UNION ALL
    SELECT t.trip_type, 'comp worth (property trips with ratings)', c.v, COALESCE(s.comp_worth, 0)
    FROM t JOIN ts s ON s.trip_master_id = t.trip_master_id
    JOIN cw c ON c.trip_master_id = t.trip_master_id
)
SELECT measure,
       trip_type,
       COUNT(*)                                          AS trips_with_summary_row,
       COUNT_IF(ROUND(today, 2) = ROUND(stored, 2))      AS stored_equals_today,
       ROUND(SUM(stored), 2)                             AS stored_total,
       ROUND(SUM(today), 2)                              AS today_total
FROM cmp
GROUP BY 1, 2
ORDER BY 1, 2;


-- H3. UAT: the 6 pairs whose most-played denomination differs. The summary picks the denomination with the most
--     ratings on the trip, then the latest day; when two denominations tie on both, the pick is arbitrary. For each
--     side of each pair: the stored pick, then today's top three denominations with their rating counts and last day
--     (counted the way the code counts them). Two rows tied at the top explain the difference.
WITH mark AS (
    SELECT value AS max_tm FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_master_id_before'
),
tma AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER),
ts AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TS_AFTER),
pairs AS (
    SELECT mk.trip_master_id AS m_id, pr.trip_master_id AS p_id
    FROM tma mk
    JOIN tma pr
      ON pr.guest_unique_id = mk.guest_unique_id AND pr.trip_type = 'PROPERTY' AND pr.delete_ind = 'N'
     AND pr.property_cd = DECODE(mk.market_cd, 'BEM', 'IBE', 'WLM', 'IWA')
     AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt
    WHERE mk.trip_type = 'MARKET' AND mk.delete_ind = 'N' AND mk.trip_master_id > (SELECT max_tm FROM mark)
      AND mk.trip_master_id IN (SELECT trip_master_id FROM ts)
      AND pr.trip_master_id IN (SELECT trip_master_id FROM ts)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY mk.trip_master_id ORDER BY pr.trip_master_id) = 1
),
diff AS (
    SELECT x.m_id, x.p_id, sm.most_played_denom_amt AS m_denom, sp.most_played_denom_amt AS p_denom
    FROM pairs x
    JOIN ts sm ON sm.trip_master_id = x.m_id
    JOIN ts sp ON sp.trip_master_id = x.p_id
    WHERE NOT EQUAL_NULL(sm.most_played_denom_amt, sp.most_played_denom_amt)
),
sides AS (
    SELECT m_id AS pair_market_trip, 'market' AS side, m_id AS trip_master_id, m_denom AS stored_pick FROM diff
    UNION ALL
    SELECT m_id, 'property', p_id, p_denom FROM diff
),
votes AS (
    SELECT s.pair_market_trip, s.side, s.stored_pick, r.denom_amt,
           COUNT(r.denom_amt) AS ratings, MAX(r.business_dt) AS last_day,
           ROW_NUMBER() OVER (PARTITION BY s.pair_market_trip, s.side
                              ORDER BY COUNT(r.denom_amt) DESC, MAX(r.business_dt) DESC) AS place
    FROM sides s
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TD_AFTER d
      ON d.trip_master_id = s.trip_master_id AND d.transaction_type = 'RATINGS'
    JOIN DAAS_UAT.DAAS_CORE.RATINGS_FACT r ON r.ratings_fact_sk = d.transaction_table_sk
    GROUP BY s.pair_market_trip, s.side, s.stored_pick, r.denom_amt
)
SELECT pair_market_trip, side, stored_pick, place, denom_amt, ratings, last_day
FROM votes
WHERE place <= 3
ORDER BY pair_market_trip, side, place;


-- H4. UAT, TRIP_NG_REVENUE_SUMMARY: the rebuilt market trips that got no NG rows at all although their property twin
--     has some (G4's "other twin has no NG rows at all" on the missing side: 47 hotel rows, 9 POS rows). The NG step
--     finds a trip's spend by looking up each check in CHECK_SALES_FACT and each stay in HOTEL_GUEST_RESERVATIONS_FACT,
--     then its folio lines in HOTEL_FOLIO_DETAIL_FACT. If those rows are gone from UAT today, these are the free-play
--     pattern again (the property rows were written before the change); if they are all there, the cause is elsewhere.
WITH mark AS (
    SELECT value AS max_tm FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_MARKS WHERE mark = 'max_trip_master_id_before'
),
tma AS (SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PILOT_TM_AFTER),
twin AS (
    SELECT mk.trip_master_id AS market_trip_id, pr.trip_master_id AS property_trip_id
    FROM tma mk
    JOIN tma pr
      ON pr.guest_unique_id = mk.guest_unique_id AND pr.trip_type = 'PROPERTY' AND pr.delete_ind = 'N'
     AND pr.property_cd = DECODE(mk.market_cd, 'BEM', 'IBE', 'WLM', 'IWA')
     AND pr.trip_start_dt = mk.trip_start_dt AND pr.trip_end_dt = mk.trip_end_dt
    WHERE mk.trip_type = 'MARKET' AND mk.delete_ind = 'N' AND mk.trip_master_id > (SELECT max_tm FROM mark)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY mk.trip_master_id ORDER BY pr.trip_master_id) = 1
),
ng AS (
    SELECT trip_master_id, transaction_type, transaction_table_sk, transaction_secondary_table_sk, f_cash_spnd_amt
    FROM DAAS_UAT.DAAS_CORE.TRIP_NG_REVENUE_SUMMARY
    WHERE delete_ind = 'N'
      AND trip_master_id IN (SELECT market_trip_id FROM twin UNION SELECT property_trip_id FROM twin)
),
bare AS (   -- rebuilt market trip with no NG rows, property twin with some
    SELECT t.*
    FROM twin t
    WHERE t.market_trip_id NOT IN (SELECT trip_master_id FROM ng)
      AND t.property_trip_id IN (SELECT trip_master_id FROM ng)
),
probe AS (
    SELECT n.transaction_type, n.transaction_table_sk AS sk, n.transaction_secondary_table_sk AS sk2, n.f_cash_spnd_amt
    FROM bare b
    JOIN ng n ON n.trip_master_id = b.property_trip_id
),
csf AS (SELECT DISTINCT check_sales_sk AS sk FROM DAAS_UAT.DAAS_CORE.CHECK_SALES_FACT
        WHERE check_sales_sk IN (SELECT sk FROM probe WHERE transaction_type = 'POS')),
hgrf AS (SELECT DISTINCT hotel_guest_reservations_fact_sk AS sk FROM DAAS_UAT.DAAS_CORE.HOTEL_GUEST_RESERVATIONS_FACT
         WHERE hotel_guest_reservations_fact_sk IN (SELECT sk FROM probe WHERE transaction_type = 'HOTEL')),
hfd AS (SELECT DISTINCT hotel_folio_detail_fact_sk AS sk FROM DAAS_UAT.DAAS_CORE.HOTEL_FOLIO_DETAIL_FACT
        WHERE hotel_folio_detail_fact_sk IN (SELECT sk2 FROM probe WHERE transaction_type = 'HOTEL'))
SELECT p.transaction_type,
       COUNT(*)                                            AS property_ng_rows,
       COUNT(DISTINCT p.sk)                                AS transactions,
       COUNT_IF(c.sk IS NOT NULL)                          AS pos_check_in_uat_today,
       COUNT_IF(h.sk IS NOT NULL)                          AS hotel_stay_in_uat_today,
       COUNT_IF(f.sk IS NOT NULL)                          AS folio_line_in_uat_today,
       ROUND(SUM(p.f_cash_spnd_amt), 2)                    AS spend
FROM probe p
LEFT JOIN csf  c ON p.transaction_type = 'POS'   AND c.sk = p.sk
LEFT JOIN hgrf h ON p.transaction_type = 'HOTEL' AND h.sk = p.sk
LEFT JOIN hfd  f ON p.transaction_type = 'HOTEL' AND f.sk = p.sk2
GROUP BY 1
ORDER BY 1;
