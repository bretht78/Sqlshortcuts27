		ELSE COMP_DETAIL_FACT.GUEST_ID  + PD.PROPERTY_ID * 100000000
	END = BRIDGE.XREF_ACCOUNT_NBR
WHERE 
	COMP_DETAIL_FACT.DELETE_IND = 'N'
