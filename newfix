-- =============================================================================
-- DAASI-3641 · UAT · 3 FIX
-- =============================================================================
-- STEP 3: THE FIX, in one statement. About 17 minutes. Expect RESULT =
-- COMMITTED and 12 checks with passed = TRUE: 399,497 retired, 984,143
-- created, 14,596,393 detail rows moved.
--
-- How to run: paste the whole file into a NEW Snowsight worksheet (role DAAS_TEAM,
-- warehouse DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE), put the cursor anywhere
-- in it and press Ctrl+Enter. It is one statement. Nothing to deploy, no
-- session variables, nothing to edit (except where a script says so).
-- =============================================================================
EXECUTE IMMEDIATE $$
DECLARE
    P_FROM_DT       DATE DEFAULT '1900-01-01'::DATE;
    P_TO_DT         DATE DEFAULT '2100-01-01'::DATE;
    v_has_chain      BOOLEAN DEFAULT FALSE;
    v_has_backup     BOOLEAN DEFAULT FALSE;
    v_autocommit     VARCHAR;
    v_run_id         VARCHAR;
    v_err            VARCHAR;
    v_task_state     VARCHAR;
    v_locked         BOOLEAN DEFAULT FALSE;
    v_logged         BOOLEAN DEFAULT FALSE;
    v_holds_lock     BOOLEAN DEFAULT FALSE;
    v_chain_paused   BOOLEAN DEFAULT FALSE;
    v_resumed        BOOLEAN DEFAULT TRUE;
    v_in_txn         BOOLEAN DEFAULT FALSE;
    v_n              NUMBER DEFAULT 0;
    v_waited         NUMBER DEFAULT 0;
    v_bk_tm          TIMESTAMP_LTZ;
    v_bk_td          TIMESTAMP_LTZ;
    v_scan_from      DATE;
    v_scan_to        DATE;
    v_commit_ts      TIMESTAMP_LTZ;
    v_g62_before     NUMBER DEFAULT 0;
    v_g62_after      NUMBER DEFAULT 0;
    v_retire_planned NUMBER DEFAULT 0;
    v_retire_done    NUMBER DEFAULT 0;
    v_copy_planned   NUMBER DEFAULT 0;
    v_copy_done      NUMBER DEFAULT 0;
    v_dup_trip_ids   NUMBER DEFAULT 0;
    v_dup_detail_ids NUMBER DEFAULT 0;
    v_left_on_old    NUMBER DEFAULT 0;
    v_src_details    NUMBER DEFAULT 0;
    v_new_details    NUMBER DEFAULT 0;
    v_dropped        NUMBER DEFAULT 0;
    v_ratings_net    NUMBER DEFAULT 0;
    v_over_cap       NUMBER DEFAULT 0;
    v_arch_tm        NUMBER DEFAULT 0;
    v_arch_td        NUMBER DEFAULT 0;
    v_retired_tm     NUMBER DEFAULT 0;
    v_retired_td     NUMBER DEFAULT 0;
    v_dup_twins      NUMBER DEFAULT 0;
    v_failed         NUMBER DEFAULT 0;
    e_checks_failed  EXCEPTION (-20641, 'DAASI-3641: a check failed inside the transaction, so nothing was committed. Details: DAASI_3641_CHECKS, latest run.');
    e_chain_busy     EXCEPTION (-20642, 'DAASI-3641: the trip chain stayed busy for an hour, so nothing was changed and the chain was resumed. Try again later.');
    e_run_active     EXCEPTION (-20643, 'DAASI-3641: another run holds the run lock (DAASI_3641_LOCK shows which). Nothing was changed. If that run was cancelled or timed out: run DAASI_3641_RECOVER for that run_id: the RECOVER script with the run_id at its top, or CALL DAASI_3641_RECOVER(''<run_id>'').');
    e_bad_window     EXCEPTION (-20644, 'DAASI-3641: P_FROM_DT must be earlier than P_TO_DT.');
    e_no_chain       EXCEPTION (-20645, 'DAASI-3641: cannot see the trip root task, so the chain cannot be paused. Nothing was changed. Check that this role has OPERATE on it.');
    e_autocommit     EXCEPTION (-20650, 'DAASI-3641: this session has AUTOCOMMIT off. Run ALTER SESSION SET AUTOCOMMIT = TRUE; and call again. Nothing was changed.');
    e_chain_paused   EXCEPTION (-20651, 'DAASI-3641: the trip chain is already paused by someone else, so nothing was changed. Run again once it is resumed.');
    e_superseded     EXCEPTION (-20655, 'DAASI-3641: RECOVER had closed this run as cut off before it could commit, so it rolled back. Nothing was kept.');
    e_no_backup      EXCEPTION (-20658, 'DAASI-3641: no backup clones of TRIP_MASTER and TRIP_DETAIL from the last 2 days in the backup schema. Run the pre-test (PREFLIGHT, the PREPARE script) first: it takes them. Nothing was changed.');
    e_open_txn      EXCEPTION (-20657, 'DAASI-3641: this session has a transaction open (left by a cancelled call?), so nothing was done. Use a new worksheet. If that call was RUN_ALL or ROLLBACK: run DAASI_3641_RECOVER for that run_id: the RECOVER script with the run_id at its top, or CALL DAASI_3641_RECOVER(''<run_id>'').');
BEGIN
    -- Never inside a transaction left open by a cancelled call: the table
    -- statements below are DDL, and DDL would commit it (with whatever that call
    -- had half done). Use a new worksheet; RECOVER cleans the old one up.
    IF (CURRENT_TRANSACTION() IS NOT NULL) THEN
        RAISE e_open_txn;
    END IF;
    SHOW PARAMETERS LIKE 'AUTOCOMMIT' IN SESSION;
    SELECT MAX("value") INTO :v_autocommit FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
    IF (LOWER(COALESCE(v_autocommit, 'true')) <> 'true') THEN
        RAISE e_autocommit;
    END IF;
    IF (P_FROM_DT IS NULL OR P_TO_DT IS NULL OR P_FROM_DT >= P_TO_DT) THEN
        RAISE e_bad_window;
    END IF;
    -- the six working tables, created only if missing (DDL, so before any transaction)
    CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS (
        run_id          VARCHAR(20),
        kind            VARCHAR(10),      -- RUN or ROLLBACK
        from_dt         DATE,
        to_dt           DATE,
        status          VARCHAR(20),      -- STARTED, COMMITTED, NOTHING_TO_DO, CHECKS_FAILED, CHAIN_BUSY,
                                          -- CHAIN_PAUSED, LOCK_BUSY, ERROR, ABORTED, ROLLED_BACK
        chain_paused    BOOLEAN,          -- TRUE while this run holds the trip chain paused
        started_at      TIMESTAMP_LTZ,
        committed_at    TIMESTAMP_LTZ,
        finished_at     TIMESTAMP_LTZ,
        trips_retired   NUMBER(38,0),
        trips_copied    NUMBER(38,0),
        details_moved   NUMBER(38,0),
        scan_from       DATE,
        scan_to         DATE,
        run_by          VARCHAR(200),
        session_id      VARCHAR(100),     -- the Snowflake session that ran it (RECOVER uses it)
        message         VARCHAR(4000)
    );
    CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (
        run_id          VARCHAR(20),
        phase           VARCHAR(10),      -- GATE, POST1, POST3, ROLLBACK, PREFLIGHT, RECOVER
        check_no        NUMBER(4,0),
        check_name      VARCHAR(200),
        expected        VARCHAR(100),
        actual          VARCHAR(100),
        passed          BOOLEAN,          -- NULL = information only
        checked_at      TIMESTAMP_LTZ
    );
    CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG (
        run_id             VARCHAR(20),
        logged_at          TIMESTAMP_NTZ,
        from_dt            DATE,
        to_dt              DATE,
        action             VARCHAR(10),
        trip_master_id     NUMBER(38,0),  -- RETIRE: the old market trip.  COPY: the source property trip.
        new_trip_master_id NUMBER(38,0),  -- COPY only: the new market trip
        market_cd          VARCHAR(100),
        trip_start_dt      DATE,
        trip_end_dt        DATE
    );
    CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TM AS
    SELECT CAST(NULL AS VARCHAR(20)) AS run_id, t.*
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
    WHERE FALSE;
    CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TD AS
    SELECT CAST(NULL AS VARCHAR(20)) AS run_id, d.*
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    WHERE FALSE;
    -- (created with its one row)
    CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK AS
    SELECT CAST(NULL AS VARCHAR(20)) AS holder, CAST(NULL AS TIMESTAMP_LTZ) AS since;

    -- Pacific time (as the trip tables are written), the Large warehouse, a lock
    -- held by someone else fails the run instead of stalling it, a failed
    -- statement leaves the transaction open for the handler to roll back, and the
    -- longest statement timeout the account allows (nothing cuts the run short).
    EXECUTE IMMEDIATE 'ALTER SESSION SET TIMEZONE = ''America/Los_Angeles''';
    IF (COALESCE(CURRENT_WAREHOUSE(), '') <> 'DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE') THEN
        EXECUTE IMMEDIATE 'USE WAREHOUSE DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE';
    END IF;
    EXECUTE IMMEDIATE 'ALTER SESSION SET LOCK_TIMEOUT = 900';
    EXECUTE IMMEDIATE 'ALTER SESSION SET TRANSACTION_ABORT_ON_ERROR = FALSE';
    BEGIN
        EXECUTE IMMEDIATE 'ALTER SESSION SET STATEMENT_TIMEOUT_IN_SECONDS = 604800';
    EXCEPTION
        WHEN OTHER THEN
            v_n := 0;
    END;

    -- PROD: the backups are the manual step before this call; refuse without them.
    IF (v_has_backup) THEN
        SELECT MAX(created) INTO :v_bk_tm FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
        WHERE table_schema = 'DAAS_TEMP_WORK' AND LEFT(table_name, 23) = 'TRIP_MASTER_DAASI_3641_';
        SELECT MAX(created) INTO :v_bk_td FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
        WHERE table_schema = 'DAAS_TEMP_WORK' AND LEFT(table_name, 23) = 'TRIP_DETAIL_DAASI_3641_';
        IF (v_bk_tm IS NULL OR v_bk_td IS NULL
            OR v_bk_tm < DATEADD(hour, -48, CURRENT_TIMESTAMP()) OR v_bk_td < DATEADD(hour, -48, CURRENT_TIMESTAMP())) THEN
            RAISE e_no_backup;
        END IF;
    END IF;

    -- The run's record first, then the lock (one run at a time: an atomic
    -- test-and-set on the lock row), so the lock is never held without a record.
    v_run_id := TO_VARCHAR(CURRENT_TIMESTAMP(), 'YYYYMMDD_HH24MISSFF3');
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
        (run_id, kind, from_dt, to_dt, status, chain_paused, started_at, run_by, session_id, message)
    SELECT  :v_run_id, 'RUN', :P_FROM_DT, :P_TO_DT, 'STARTED', FALSE, CURRENT_TIMESTAMP(), CURRENT_USER(),
            CURRENT_SESSION(), 'Started.';
    v_logged := TRUE;
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = :v_run_id, since = CURRENT_TIMESTAMP() WHERE holder IS NULL;
    IF (SQLROWCOUNT = 0) THEN
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = 'LOCK_BUSY', finished_at = CURRENT_TIMESTAMP(), message = 'Another run held the lock; nothing was done.'
         WHERE run_id = :v_run_id;
        RAISE e_run_active;
    END IF;
    v_locked := TRUE;

    -- Pause the trip chain, then wait until no run of it is still going (an hour
    -- at most). A run already going finishes normally; the next one waits for us.
    IF (v_has_chain) THEN
        SHOW TASKS LIKE 'TRIP_ROOT_TASK' IN SCHEMA DAAS_PROD.DAAS_COMMON;
        SELECT MAX("state") INTO :v_task_state FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
        IF (v_task_state IS NULL) THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'ERROR', message = 'Trip root task not visible to this role'
             WHERE run_id = :v_run_id;
            RAISE e_no_chain;
        END IF;
        IF (v_task_state <> 'started') THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'CHAIN_PAUSED', message = 'The trip chain was already paused.'
             WHERE run_id = :v_run_id;
            RAISE e_chain_paused;
        END IF;
        -- recorded before the pause, so RECOVER knows this run paused it
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET chain_paused = TRUE WHERE run_id = :v_run_id;
        v_resumed := FALSE;
        ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK SUSPEND;
        v_chain_paused := TRUE;
        LOOP
            SELECT COUNT(*) INTO :v_n
            FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.CURRENT_TASK_GRAPHS(ROOT_TASK_NAME => 'TRIP_ROOT_TASK'))
            WHERE database_name = 'DAAS_PROD' AND schema_name = 'DAAS_COMMON' AND state = 'EXECUTING';
            IF (v_n = 0) THEN
                BREAK;
            END IF;
            IF (v_waited >= 3600) THEN
                UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'CHAIN_BUSY' WHERE run_id = :v_run_id;
                RAISE e_chain_busy;
            END IF;
            SELECT SYSTEM$WAIT(30);
            v_waited := v_waited + 30;
        END LOOP;
    END IF;

    -- Baseline for "nothing lost, nothing doubled" (6.2 in the runbook).
    SELECT COALESCE(COUNT_IF(m.sk IS NULL), 0) + COALESCE(COUNT_IF(p.sk IS NULL), 0) + COALESCE(COUNT_IF(m.trips <> p.trips), 0)
    INTO :v_g62_before
    FROM (SELECT td.transaction_table_sk AS sk, COUNT(DISTINCT tm.trip_master_id) AS trips
          FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL td ON td.trip_master_id = tm.trip_master_id
          WHERE tm.trip_type = 'PROPERTY' AND tm.property_cd IN ('IBE', 'IWA')
            AND tm.delete_ind = 'N' AND td.delete_ind = 'N' AND td.transaction_type = 'RATINGS'
          GROUP BY 1) p
    FULL OUTER JOIN
         (SELECT td.transaction_table_sk AS sk, COUNT(DISTINCT tm.trip_master_id) AS trips
          FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL td ON td.trip_master_id = tm.trip_master_id
          WHERE tm.trip_type = 'MARKET' AND tm.market_cd IN ('BEM', 'WLM')
            AND tm.delete_ind = 'N' AND td.delete_ind = 'N' AND td.transaction_type = 'RATINGS'
          GROUP BY 1) m
      ON m.sk = p.sk;

    -- Work list (Part 4 of the runbook), in a temporary table private to this session.
    CREATE OR REPLACE TEMPORARY TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_WORK AS
    WITH prop AS (
        SELECT trip_master_id, guest_unique_id,
               DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd,
               trip_start_dt, trip_end_dt
        FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        WHERE trip_type = 'PROPERTY' AND delete_ind = 'N' AND property_cd IN ('IBE', 'IWA')
    ),
    mkt AS (
        SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt, created_dttm
        FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        WHERE trip_type = 'MARKET' AND delete_ind = 'N' AND market_cd IN ('BEM', 'WLM')
    ),
    twinless AS (
        SELECT 'RETIRE' AS action,
               m.trip_master_id, m.guest_unique_id, m.market_cd, m.trip_start_dt, m.trip_end_dt,
               IFF(m.created_dttm < '2026-08-12 11:16:26', 1, 0) AS is_seed
        FROM mkt m
        WHERE NOT EXISTS (SELECT 1 FROM prop p
                          WHERE p.market_cd = m.market_cd AND p.guest_unique_id = m.guest_unique_id
                            AND p.trip_start_dt = m.trip_start_dt AND p.trip_end_dt = m.trip_end_dt)
        UNION ALL
        SELECT 'COPY',
               p.trip_master_id, p.guest_unique_id, p.market_cd, p.trip_start_dt, p.trip_end_dt,
               0
        FROM prop p
        WHERE NOT EXISTS (SELECT 1 FROM mkt m
                          WHERE m.market_cd = p.market_cd AND m.guest_unique_id = p.guest_unique_id
                            AND m.trip_start_dt = p.trip_start_dt AND m.trip_end_dt = p.trip_end_dt)
    ),
    running AS (
        SELECT t.*,
               MAX(trip_end_dt) OVER (PARTITION BY guest_unique_id, market_cd
                                      ORDER BY trip_start_dt, trip_end_dt, trip_master_id
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_max_end
        FROM twinless t
    ),
    starts AS (
        SELECT r.*,
               IFF(LAG(run_max_end) OVER (PARTITION BY guest_unique_id, market_cd
                                          ORDER BY trip_start_dt, trip_end_dt, trip_master_id)
                   >= trip_start_dt, 0, 1) AS new_island
        FROM running r
    ),
    islands AS (
        SELECT s.*,
               SUM(new_island) OVER (PARTITION BY guest_unique_id, market_cd
                                     ORDER BY trip_start_dt, trip_end_dt, trip_master_id
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS island_no
        FROM starts s
    )
    SELECT action, trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt, island_no,
           MIN(trip_start_dt) OVER (PARTITION BY guest_unique_id, market_cd, island_no) AS island_start_dt,
           MAX(is_seed)       OVER (PARTITION BY guest_unique_id, market_cd, island_no) AS in_scope
    FROM islands;

    -- The copy list, with new trip IDs (5.0).
    --     Made empty, then filled by an INSERT: the run window's dates go in as bound
    --     values, and an INSERT is the surest place for those.
    CREATE OR REPLACE TEMPORARY TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_COPY AS
    SELECT (SELECT MAX(trip_master_id) FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER) + ROW_NUMBER() OVER (ORDER BY w.trip_master_id) AS new_trip_master_id,
           w.trip_master_id AS source_trip_master_id, w.guest_unique_id, w.market_cd, w.trip_start_dt, w.trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_WORK w
    WHERE FALSE;
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_COPY
           (new_trip_master_id, source_trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt)
    SELECT (SELECT MAX(trip_master_id) FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER) + ROW_NUMBER() OVER (ORDER BY w.trip_master_id),
           w.trip_master_id, w.guest_unique_id, w.market_cd, w.trip_start_dt, w.trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_WORK w
    WHERE w.action = 'COPY' AND w.in_scope = 1
      AND w.island_start_dt >= :P_FROM_DT AND w.island_start_dt < :P_TO_DT
      AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER m
                      WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
                        AND m.market_cd = w.market_cd AND m.guest_unique_id = w.guest_unique_id
                        AND m.trip_start_dt = w.trip_start_dt AND m.trip_end_dt = w.trip_end_dt);

    -- Scan window: 31 days around the run's trips, so Snowflake can skip the rest.
    SELECT DATEADD(day, -31, MIN(trip_start_dt)), DATEADD(day, 31, MAX(trip_end_dt))
    INTO :v_scan_from, :v_scan_to
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_WORK
    WHERE in_scope = 1 AND island_start_dt >= :P_FROM_DT AND island_start_dt < :P_TO_DT;

    IF (v_scan_from IS NULL) THEN
        SELECT COUNT(*) = 1 INTO :v_holds_lock FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK WHERE holder = :v_run_id;
        IF (v_chain_paused AND v_holds_lock) THEN
            ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK RESUME;
            v_chain_paused := FALSE;
            v_resumed := TRUE;
        END IF;
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = NULL, since = NULL WHERE holder = :v_run_id;
        v_locked := FALSE;
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = IFF(status = 'STARTED', 'NOTHING_TO_DO', status), chain_paused = FALSE,
               finished_at = COALESCE(finished_at, CURRENT_TIMESTAMP()),
               message = 'No in-scope island starts in this window.'
         WHERE run_id = :v_run_id;
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
            (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        SELECT  :v_run_id, 'GATE', 99, 'RESULT', 'COMMITTED', 'NOTHING_TO_DO', TRUE, CURRENT_TIMESTAMP();
        LET rs0 RESULTSET := (SELECT check_name, expected, actual, passed
                              FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
                              WHERE run_id = :v_run_id ORDER BY check_no);
        RETURN TABLE(rs0);
    END IF;

    -- ===================== the fix: all or nothing =====================
    BEGIN TRANSACTION;
    v_in_txn := TRUE;

    -- 5.1 log what this run retires (only trips still live) and copies
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
        (run_id, logged_at, from_dt, to_dt, action, trip_master_id, new_trip_master_id,
         market_cd, trip_start_dt, trip_end_dt)
    SELECT :v_run_id, CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, :P_FROM_DT, :P_TO_DT, 'RETIRE',
           w.trip_master_id, NULL, w.market_cd, w.trip_start_dt, w.trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_WORK w
    WHERE w.action = 'RETIRE' AND w.in_scope = 1
      AND w.island_start_dt >= :P_FROM_DT AND w.island_start_dt < :P_TO_DT
      AND EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
                  WHERE t.trip_master_id = w.trip_master_id AND t.delete_ind = 'N');

    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
        (run_id, logged_at, from_dt, to_dt, action, trip_master_id, new_trip_master_id,
         market_cd, trip_start_dt, trip_end_dt)
    SELECT :v_run_id, CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, :P_FROM_DT, :P_TO_DT, 'COPY',
           c.source_trip_master_id, c.new_trip_master_id, c.market_cd, c.trip_start_dt, c.trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_COPY c;

    -- keep an exact copy of every row about to be retired (ROLLBACK restores these)
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TM
    SELECT :v_run_id, t.*
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
    WHERE t.delete_ind = 'N'
      AND t.trip_start_dt BETWEEN :v_scan_from AND :v_scan_to
      AND t.trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'RETIRE');

    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TD
    SELECT :v_run_id, d.*
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    WHERE d.delete_ind = 'N'
      AND d.business_start_dt BETWEEN :v_scan_from AND :v_scan_to
      AND d.trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'RETIRE');

    -- 5.2 new market trips: exact copies of the property trips
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        (trip_master_id, guest_unique_id, property_cd, market_cd, trip_type,
         trip_start_dt, trip_end_dt, delete_ind,
         created_dttm, created_by, updated_dttm, updated_by,
         batch_id, replay_counter, last_dml_cd)
    SELECT c.new_trip_master_id, c.guest_unique_id, 'N/A', c.market_cd, 'MARKET',
           c.trip_start_dt, c.trip_end_dt, 'N',
           CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'DAASI-3641', CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'DAASI-3641',
           -3641, NULL, 'I'
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_COPY c;

    -- 5.3 their detail rows: every live detail row of the source property trip
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL
        (trip_detail_id, trip_master_id, transaction_table_sk, transaction_table,
         transaction_type, transaction_sub_type, transaction_start_dttm, transaction_end_dttm,
         business_start_dt, business_end_dt, transaction_modified_dttm, delete_ind,
         created_dttm, created_by, updated_dttm, updated_by,
         batch_id, replay_counter, last_dml_cd, property_cd)
    SELECT (SELECT MAX(trip_detail_id) FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL) + ROW_NUMBER() OVER (ORDER BY c.new_trip_master_id, d.trip_detail_id),
           c.new_trip_master_id, d.transaction_table_sk, d.transaction_table,
           d.transaction_type, d.transaction_sub_type, d.transaction_start_dttm, d.transaction_end_dttm,
           d.business_start_dt, d.business_end_dt, d.transaction_modified_dttm, 'N',
           CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'DAASI-3641', CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'DAASI-3641',
           -3641, NULL, 'I', d.property_cd
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_COPY c
    JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = c.source_trip_master_id
    WHERE d.delete_ind = 'N'
      AND d.business_start_dt BETWEEN :v_scan_from AND :v_scan_to;

    -- 5.4 retire the old market trips: detail rows first, then the trips
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL
       SET delete_ind = 'Y', last_dml_cd = 'U',
           updated_dttm = CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, updated_by = 'DAASI-3641', batch_id = -3641
     WHERE delete_ind = 'N'
       AND business_start_dt BETWEEN :v_scan_from AND :v_scan_to
       AND trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                              WHERE run_id = :v_run_id AND action = 'RETIRE');

    UPDATE DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
       SET delete_ind = 'Y', last_dml_cd = 'U',
           updated_dttm = CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, updated_by = 'DAASI-3641', batch_id = -3641
     WHERE delete_ind = 'N'
       AND trip_start_dt BETWEEN :v_scan_from AND :v_scan_to
       AND trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                              WHERE run_id = :v_run_id AND action = 'RETIRE');

    -- ---------- checks, still inside the transaction (they see its changes) ----------
    -- G1 every logged old trip is retired (6.1)
    SELECT COUNT(DISTINCT l.trip_master_id),
           COUNT(DISTINCT IFF(t.delete_ind = 'Y' AND t.updated_by = 'DAASI-3641', l.trip_master_id, NULL))
    INTO :v_retire_planned, :v_retire_done
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
    LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t ON t.trip_master_id = l.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'RETIRE';

    -- G2 every logged copy exists, live, written by the fix (6.1)
    SELECT COUNT(DISTINCT l.new_trip_master_id),
           COUNT(DISTINCT IFF(t.delete_ind = 'N' AND t.created_by = 'DAASI-3641', l.new_trip_master_id, NULL))
    INTO :v_copy_planned, :v_copy_done
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
    LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t ON t.trip_master_id = l.new_trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY';

    -- G3 no new ID collides with an existing row
    SELECT COUNT(*) - COUNT(DISTINCT t.trip_master_id) INTO :v_dup_trip_ids
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
    WHERE t.trip_master_id IN (SELECT new_trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'COPY');

    SELECT COUNT(*) - COUNT(DISTINCT d.trip_detail_id) INTO :v_dup_detail_ids
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    WHERE d.trip_detail_id IN (SELECT n.trip_detail_id
                               FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL n
                               JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.new_trip_master_id = n.trip_master_id
                               WHERE l.run_id = :v_run_id AND l.action = 'COPY');

    -- G4 nothing left on the retired trips; the copies carry every detail row (6.4)
    SELECT COUNT(*) INTO :v_left_on_old
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.trip_master_id = d.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'RETIRE' AND d.delete_ind = 'N';

    SELECT COUNT(*) INTO :v_src_details
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.trip_master_id = d.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY' AND d.delete_ind = 'N';

    SELECT COUNT(*) INTO :v_new_details
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.new_trip_master_id = d.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY' AND d.delete_ind = 'N';

    -- G5 no transaction dropped off the market side, ratings net to 0 (6.8)
    SELECT COALESCE(SUM(IFF(r.kind = 'R' AND lv.sk IS NULL, 1, 0)), 0),
           COALESCE(SUM(IFF(r.ttype = 'RATINGS', IFF(r.kind = 'A', 1, -1), 0)), 0)
    INTO :v_dropped, :v_ratings_net
    FROM (SELECT 'A' AS kind, l.market_cd, d.transaction_type AS ttype,
                 d.transaction_table AS ttable, d.transaction_table_sk AS sk
          FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = l.new_trip_master_id
          WHERE l.run_id = :v_run_id AND l.action = 'COPY' AND d.created_by = 'DAASI-3641'
          UNION ALL
          SELECT 'R', l.market_cd, d.transaction_type, d.transaction_table, d.transaction_table_sk
          FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = l.trip_master_id
          WHERE l.run_id = :v_run_id AND l.action = 'RETIRE'
            AND d.delete_ind = 'Y' AND d.updated_by = 'DAASI-3641') r
    LEFT JOIN (SELECT DISTINCT tm.market_cd, d.transaction_type AS ttype,
                      d.transaction_table AS ttable, d.transaction_table_sk AS sk
               FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
               JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = tm.trip_master_id
               WHERE tm.trip_type = 'MARKET' AND tm.market_cd IN ('BEM', 'WLM')
                 AND tm.delete_ind = 'N' AND d.delete_ind = 'N') lv
      ON r.kind = 'R' AND lv.market_cd = r.market_cd AND lv.ttype = r.ttype
     AND lv.ttable = r.ttable AND lv.sk = r.sk;

    -- G6 no new trip is longer than its market's limit without a hotel stay (6.5)
    SELECT COUNT(*) INTO :v_over_cap
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.new_trip_master_id = tm.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY'
      AND DATEDIFF(day, tm.trip_start_dt, tm.trip_end_dt) + 1 > DECODE(tm.market_cd, 'BEM', 1, 'WLM', 3, 999)
      AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
                      WHERE d.trip_master_id = tm.trip_master_id
                        AND d.transaction_type = 'HOTEL' AND d.delete_ind = 'N');

    -- G7 nothing lost or doubled across all BEM/WLM ratings: no worse than before (6.2)
    SELECT COALESCE(COUNT_IF(m.sk IS NULL), 0) + COALESCE(COUNT_IF(p.sk IS NULL), 0) + COALESCE(COUNT_IF(m.trips <> p.trips), 0)
    INTO :v_g62_after
    FROM (SELECT td.transaction_table_sk AS sk, COUNT(DISTINCT tm.trip_master_id) AS trips
          FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL td ON td.trip_master_id = tm.trip_master_id
          WHERE tm.trip_type = 'PROPERTY' AND tm.property_cd IN ('IBE', 'IWA')
            AND tm.delete_ind = 'N' AND td.delete_ind = 'N' AND td.transaction_type = 'RATINGS'
          GROUP BY 1) p
    FULL OUTER JOIN
         (SELECT td.transaction_table_sk AS sk, COUNT(DISTINCT tm.trip_master_id) AS trips
          FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL td ON td.trip_master_id = tm.trip_master_id
          WHERE tm.trip_type = 'MARKET' AND tm.market_cd IN ('BEM', 'WLM')
            AND tm.delete_ind = 'N' AND td.delete_ind = 'N' AND td.transaction_type = 'RATINGS'
          GROUP BY 1) m
      ON m.sk = p.sk;

    -- G8 the kept copies match exactly what was retired
    SELECT COUNT(*) INTO :v_arch_tm FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TM WHERE run_id = :v_run_id;
    SELECT COUNT(*) INTO :v_arch_td FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TD WHERE run_id = :v_run_id;
    SELECT COUNT(*) INTO :v_retired_tm
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
    WHERE t.delete_ind = 'Y' AND t.updated_by = 'DAASI-3641'
      AND t.trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'RETIRE');
    SELECT COUNT(*) INTO :v_retired_td
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    WHERE d.delete_ind = 'Y' AND d.updated_by = 'DAASI-3641'
      AND d.trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'RETIRE');

    -- G9 every new trip is the only live market trip with its guest, market and dates
    SELECT COUNT(*) INTO :v_dup_twins
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER n
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.new_trip_master_id = n.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY'
      AND EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER m
                  WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
                    AND m.trip_start_dt BETWEEN :v_scan_from AND :v_scan_to
                    AND m.market_cd = n.market_cd AND m.guest_unique_id = n.guest_unique_id
                    AND m.trip_start_dt = n.trip_start_dt AND m.trip_end_dt = n.trip_end_dt
                    AND m.trip_master_id <> n.trip_master_id);

    v_failed := IFF(v_retire_done = v_retire_planned, 0, 1)
              + IFF(v_copy_done = v_copy_planned, 0, 1)
              + IFF(v_dup_trip_ids = 0, 0, 1)
              + IFF(v_dup_detail_ids = 0, 0, 1)
              + IFF(v_left_on_old = 0, 0, 1)
              + IFF(v_src_details = v_new_details, 0, 1)
              + IFF(v_dropped = 0, 0, 1)
              + IFF(v_ratings_net = 0, 0, 1)
              + IFF(v_over_cap = 0, 0, 1)
              + IFF(v_g62_after <= v_g62_before, 0, 1)
              + IFF(v_arch_tm = v_retired_tm AND v_arch_td = v_retired_td, 0, 1)
              + IFF(v_dup_twins = 0, 0, 1);

    IF (v_failed = 0) THEN
        -- The run's record changes in the same transaction as the data, so
        -- COMMITTED in DAASI_3641_RUNS always means the data is in. A run RECOVER
        -- has meanwhile closed (no longer STARTED) rolls back instead.
        v_commit_ts := CURRENT_TIMESTAMP();
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = 'COMMITTED', committed_at = :v_commit_ts,
               trips_retired = :v_retire_planned, trips_copied = :v_copy_planned,
               details_moved = :v_new_details, scan_from = :v_scan_from, scan_to = :v_scan_to,
               message = 'Committed.'
         WHERE run_id = :v_run_id AND status = 'STARTED';
        IF (SQLROWCOUNT = 0) THEN
            RAISE e_superseded;
        END IF;
        COMMIT;
        v_in_txn := FALSE;
    ELSE
        ROLLBACK;
        v_in_txn := FALSE;
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = 'CHECKS_FAILED',
               trips_retired = :v_retire_planned, trips_copied = :v_copy_planned,
               details_moved = :v_new_details, scan_from = :v_scan_from, scan_to = :v_scan_to,
               message = TO_VARCHAR(:v_failed) || ' check(s) failed, so the run was rolled back.'
         WHERE run_id = :v_run_id;
    END IF;
    -- ======================================================================

    -- Resume the chain only while this run still holds the lock (a run RECOVER
    -- closed no longer owns the chain).
    SELECT COUNT(*) = 1 INTO :v_holds_lock FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK WHERE holder = :v_run_id;
    IF (v_chain_paused AND v_holds_lock) THEN
        ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK RESUME;
        v_chain_paused := FALSE;
        v_resumed := TRUE;
    END IF;
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = NULL, since = NULL WHERE holder = :v_run_id;
    v_locked := FALSE;
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET chain_paused = FALSE, finished_at = COALESCE(finished_at, CURRENT_TIMESTAMP())
     WHERE run_id = :v_run_id;

    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
        (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    SELECT  :v_run_id, 'GATE', 1, 'Old market trips retired, as logged',
            TO_VARCHAR(:v_retire_planned), TO_VARCHAR(:v_retire_done), :v_retire_done = :v_retire_planned, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 2, 'New market trips created, as logged',
            TO_VARCHAR(:v_copy_planned), TO_VARCHAR(:v_copy_done), :v_copy_done = :v_copy_planned, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 3, 'New trip IDs that collide with another row',
            '0', TO_VARCHAR(:v_dup_trip_ids), :v_dup_trip_ids = 0, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 4, 'New detail IDs that collide with another row',
            '0', TO_VARCHAR(:v_dup_detail_ids), :v_dup_detail_ids = 0, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 5, 'Live detail rows left on retired trips',
            '0', TO_VARCHAR(:v_left_on_old), :v_left_on_old = 0, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 6, 'Detail rows on the new trips = on their property trips',
            TO_VARCHAR(:v_src_details), TO_VARCHAR(:v_new_details), :v_new_details = :v_src_details, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 7, 'Transactions dropped from every market trip',
            '0', TO_VARCHAR(:v_dropped), :v_dropped = 0, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 8, 'Ratings added minus ratings retired',
            '0', TO_VARCHAR(:v_ratings_net), :v_ratings_net = 0, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 9, 'New trips over the max trip days without a hotel stay',
            '0', TO_VARCHAR(:v_over_cap), :v_over_cap = 0, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 10, 'Ratings lost or doubled, all BEM/WLM (no worse than before)',
            '<= ' || TO_VARCHAR(:v_g62_before), TO_VARCHAR(:v_g62_after), :v_g62_after <= :v_g62_before, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 11, 'Kept copies = retired rows (trips / detail rows)',
            TO_VARCHAR(:v_retired_tm) || ' / ' || TO_VARCHAR(:v_retired_td),
            TO_VARCHAR(:v_arch_tm) || ' / ' || TO_VARCHAR(:v_arch_td),
            :v_arch_tm = :v_retired_tm AND :v_arch_td = :v_retired_td, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 12, 'New trips with a live identical market trip (a double copy)',
            '0', TO_VARCHAR(:v_dup_twins), :v_dup_twins = 0, CURRENT_TIMESTAMP()
    UNION ALL
    SELECT  :v_run_id, 'GATE', 99, 'RESULT',
            'COMMITTED', IFF(:v_failed = 0, 'COMMITTED', 'ROLLED BACK'), :v_failed = 0, CURRENT_TIMESTAMP();

    IF (v_failed > 0) THEN
        RAISE e_checks_failed;
    END IF;

    LET rs RESULTSET := (SELECT check_name, expected, actual, passed
                         FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
                         WHERE run_id = :v_run_id ORDER BY check_no);
    RETURN TABLE(rs);

EXCEPTION
    WHEN e_checks_failed THEN
        RAISE;
    WHEN OTHER THEN
        v_err := 'SQLCODE ' || SQLCODE || ': ' || SQLERRM;
        IF (v_in_txn) THEN
            ROLLBACK;
        END IF;
        -- the chain and the lock are this run's to restore only while it holds the lock
        IF (v_locked) THEN
            SELECT COUNT(*) = 1 INTO :v_holds_lock FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK WHERE holder = :v_run_id;
        END IF;
        IF (v_chain_paused AND v_holds_lock) THEN
            BEGIN
                ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK RESUME;
                v_resumed := TRUE;
            EXCEPTION
                WHEN OTHER THEN
                    v_err := v_err || ' | COULD NOT RESUME THE TRIP CHAIN. Resume it now: ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK RESUME;';
            END;
        END IF;
        IF (v_holds_lock) THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = NULL, since = NULL WHERE holder = :v_run_id;
        END IF;
        IF (v_logged) THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
               SET status       = IFF(status = 'STARTED', 'ERROR', status),
                   chain_paused = :v_holds_lock AND :v_chain_paused AND NOT :v_resumed,
                   finished_at  = COALESCE(finished_at, CURRENT_TIMESTAMP()),
                   message      = LEFT(COALESCE(message, '') || ' ' || :v_err, 4000)
             WHERE run_id = :v_run_id;
        END IF;
        RAISE;
END;
$$;