/* =====================================================================
   2. F7 / F7b: WHY 209 COMPS LOST THEIR ACTIVE ROW
   Expect in F7: every 'lost active row' line has RULE_DELETE_IND = 'Y',
   OPERATION_TYPE 0 (or 5/8) and a program that is not in the purge
   list; every 'still active' line has 'N'; GUEST_DIFFERS 0 throughout.
   Expect in F7b: the deletion months after the UAT fact's last daily
   load (June 2026 or later), with AFTER_FACT_ROW_CREATED equal to COMPS.
   ===================================================================== */
-- F7. Why comps lose their active row. The proc's own DELETE_IND rule,
--     applied to the latest raw row of every comp in the slice (the row
--     the bump touched), next to what the fact shows now. Expect every
--     'lost active row' comp to come out RULE_DELETE_IND = 'Y' from a
--     delete-type operation (0, 5, 8) by a program outside
--     PURGE_PROGRAM_NM_LKP, and every 'still active' comp to come out
--     'N'. Then the replay applied deletions the pipeline would have
--     applied anyway, and the only question is why the UAT fact had not:
--     F7b answers that with dates.
CREATE OR REPLACE TRANSIENT TABLE DAAS_TEMP_WORK.DAASI3640_RP_LATEST AS
SELECT s.CNUMRW, s.ISHDRW, s.COTLRW, s.PROPERTY_CODE,
       r.OPERATION_TYPE, TRIM(r.PROGRAM_NAME) AS program, r.OPERATION_DATE, r.SYIDRW,
       CASE WHEN TRIM(r.PROGRAM_NAME) = 'QRYO04' AND r.OPERATION_TYPE IN (0, 5, 8) THEN 'N'
            WHEN p.PROGRAM_NM IS NOT NULL                                           THEN 'N'
            WHEN r.OPERATION_TYPE IN (0, 5, 8)                                      THEN 'Y'
            ELSE 'N' END                                                            AS rule_delete_ind
FROM DAAS_TEMP_WORK.DAASI3640_RP_SLICE s
JOIN DAAS_RAW_HETCMS.CMPRW_RAW r
  ON  r.CNUMRW = s.CNUMRW AND r.ISHDRW = s.ISHDRW AND r.COTLRW = s.COTLRW AND r.PROPERTY_CODE = s.PROPERTY_CODE
  AND r.OPERATION_DATE = s.OPERATION_DATE AND r.OPERATION_SEQUENCE_NBR = s.OPERATION_SEQUENCE_NBR
  AND r.CREATED_DATE IS NOT DISTINCT FROM s.CREATED_DATE
LEFT JOIN DAAS_COMMON.PURGE_PROGRAM_NM_LKP p
  ON  r.SOURCE_SYSTEM_NAME = p.SOURCE_SYSTEM_NM AND r.PROPERTY_CODE = p.PROPERTY_CD
  AND UPPER(TRIM(r.PROGRAM_NAME)) = UPPER(TRIM(p.PROGRAM_NM));

SELECT IFF(f.COMP_NBR IS NULL, 'lost active row', 'still active')          AS fact_now,
       l.rule_delete_ind, l.OPERATION_TYPE, l.program,
       COUNT(*)                                                             AS comps,
       MIN(l.OPERATION_DATE)::DATE                                          AS earliest_raw_row,
       MAX(l.OPERATION_DATE)::DATE                                          AS latest_raw_row,
       COUNT_IF(l.SYIDRW <> e.GUEST_ID)                                     AS guest_differs,
       COUNT_IF(e.NEW_COMMENT IS NOT NULL)                                  AS with_comment,
       COUNT_IF(e.NEW_REMARKS IS NOT NULL)                                  AS with_remarks
FROM DAAS_TEMP_WORK.DAASI3640_RP_EXPECTED e
JOIN DAAS_TEMP_WORK.DAASI3640_RP_LATEST l
  ON  l.CNUMRW = e.COMP_NBR AND l.ISHDRW = e.ISHDRW AND l.COTLRW = e.CASINO_OUTLET_CD AND l.PROPERTY_CODE = e.PROPERTY_CD
LEFT JOIN DAAS_CORE.COMP_DETAIL_FACT f
  ON  f.COMP_NBR = e.COMP_NBR AND f.ISHDRW = e.ISHDRW AND f.PROPERTY_CD = e.PROPERTY_CD
  AND f.CASINO_OUTLET_CD = e.CASINO_OUTLET_CD AND f.DELETE_IND = 'N'
GROUP BY 1, 2, 3, 4
ORDER BY fact_now, comps DESC;

-- F7b. When those deletions reached raw, by month, next to when the fact
--      row was first loaded. Deletions dated after the UAT fact's last
--      daily load (B6: June 2026) are the UAT fact being behind UAT's
--      raw, which PROD's daily loads do not let happen.
SELECT DATE_TRUNC('month', l.OPERATION_DATE)::DATE                          AS deletion_month,
       COUNT(*)                                                             AS comps,
       COUNT_IF(l.OPERATION_DATE > b.CREATED_DTTM)                          AS after_fact_row_created,
       MIN(b.CREATED_DTTM)::DATE                                            AS fact_rows_created_from,
       MAX(b.CREATED_DTTM)::DATE                                            AS fact_rows_created_to
FROM DAAS_TEMP_WORK.DAASI3640_RP_EXPECTED e
JOIN DAAS_TEMP_WORK.DAASI3640_RP_LATEST l
  ON  l.CNUMRW = e.COMP_NBR AND l.ISHDRW = e.ISHDRW AND l.COTLRW = e.CASINO_OUTLET_CD AND l.PROPERTY_CODE = e.PROPERTY_CD
JOIN DAAS_TEMP_WORK.COMP_DETAIL_FACT_BKP_DAASI3640_UATREPLAY b
  ON  b.COMP_NBR = e.COMP_NBR AND b.ISHDRW = e.ISHDRW AND b.PROPERTY_CD = e.PROPERTY_CD
  AND b.CASINO_OUTLET_CD = e.CASINO_OUTLET_CD AND b.GUEST_ID = e.GUEST_ID AND b.DELETE_IND = 'N'
WHERE l.rule_delete_ind = 'Y'
GROUP BY 1
ORDER BY 1;

/* =====================================================================
   3. F8: WHAT KIND OF CHANGE THE HOST NAMES TOOK (49,442 rows)
   Expect the rows in 'same letters' or 'same words, new order' (the
   formula changed, not the person), and few or none in 'different name'.
   ===================================================================== */
-- F8. What kind of change COMPOR_NAME took (F3: 49,442 rows). The proc
--     builds it from the host master (CMPHA_RAW, latest row per host and
--     property) as "LAST FIRST" with digits stripped, then CMPAS_RAW,
--     then the Teradata lookup, so a rebuild shows today's host master
--     under today's formula. The classes separate a formula or spacing
--     change (harmless, and PROD's older rows will take the same one)
--     from a coverage change (names appearing or vanishing) and from a
--     different person (the host record itself changed). EXAMPLE is one
--     before -> after pair per class; these are employee names, fine for
--     you and Pete.
SELECT CASE WHEN b.COMPOR_NAME IS NULL AND f.COMPOR_NAME IS NOT NULL THEN 'blank, now a name'
            WHEN b.COMPOR_NAME IS NOT NULL AND f.COMPOR_NAME IS NULL THEN 'name, now blank'
            WHEN REGEXP_REPLACE(UPPER(b.COMPOR_NAME), '[^A-Z]', '')
               = REGEXP_REPLACE(UPPER(f.COMPOR_NAME), '[^A-Z]', '')      THEN 'same letters: spacing, case or digits'
            WHEN ARRAY_TO_STRING(ARRAY_SORT(SPLIT(UPPER(TRIM(b.COMPOR_NAME)), ' ')), ' ')
               = ARRAY_TO_STRING(ARRAY_SORT(SPLIT(UPPER(TRIM(f.COMPOR_NAME)), ' ')), ' ') THEN 'same words, new order'
            WHEN REGEXP_REPLACE(UPPER(b.COMPOR_NAME), '[^A-Z]', '') LIKE '%' || REGEXP_REPLACE(UPPER(f.COMPOR_NAME), '[^A-Z]', '') || '%'
              OR REGEXP_REPLACE(UPPER(f.COMPOR_NAME), '[^A-Z]', '') LIKE '%' || REGEXP_REPLACE(UPPER(b.COMPOR_NAME), '[^A-Z]', '') || '%'
                                                                        THEN 'one contains the other: a part dropped or added'
            ELSE 'different name' END                                   AS change_kind,
       COUNT(*)                                                         AS rows_,
       COUNT(DISTINCT b.COMPOR_NAME)                                    AS distinct_names_before,
       ANY_VALUE(COALESCE(b.COMPOR_NAME, '(blank)') || '  ->  ' || COALESCE(f.COMPOR_NAME, '(blank)')) AS example
FROM DAAS_TEMP_WORK.COMP_DETAIL_FACT_BKP_DAASI3640_UATREPLAY b
JOIN DAAS_TEMP_WORK.DAASI3640_RP_EXPECTED e
  ON  e.COMP_NBR = b.COMP_NBR AND e.ISHDRW = b.ISHDRW AND e.PROPERTY_CD = b.PROPERTY_CD
  AND e.CASINO_OUTLET_CD = b.CASINO_OUTLET_CD
JOIN DAAS_CORE.COMP_DETAIL_FACT f
  ON  f.COMP_DETAIL_FACT_SK = b.COMP_DETAIL_FACT_SK
WHERE f.COMPOR_NAME IS DISTINCT FROM b.COMPOR_NAME
GROUP BY 1
ORDER BY rows_ DESC;


/* =====================================================================
   4. THE QUERY PROFILE OF THE 333-SECOND INSERT, AS A RESULT SET
   GET_QUERY_OPERATOR_STATS returns what the Query Profile page draws,
   one row per operator, for a query you ran in the last 14 days. The
   first result picks the INSERT's query id (the one that produced
   49,455 rows); the second lists its operators by share of the time.
   What to read: if the top rows are TableScan / Aggregate / WindowFunction
   over CMPRW_RAW, ECPCMPCM_RAW and CMPRM_RAW with INPUT_ROWS in the
   hundreds of millions, the cost is mostly fixed (scanning raw) and the
   PROD run will not be 155 times longer; if the top rows are Joins whose
   INPUT_ROWS scale with the 49,455, the cost is per comp. Send the whole
   second result (copy as text is fine).
   ===================================================================== */
SET insert_qid = (SELECT query_id
                  FROM TABLE(INFORMATION_SCHEMA.QUERY_HISTORY_BY_USER(RESULT_LIMIT => 5000))
                  WHERE query_text ILIKE '%INSERT INTO DAAS_TEMP_WORK.COMP_DETAIL_FACT_TMP_DAASI3640%'
                    AND query_type <> 'SELECT'
                    AND rows_produced = 49455
                  ORDER BY start_time DESC
                  LIMIT 1);

SELECT $insert_qid AS insert_query_id;      -- should be the 2026-10-26 18:58 run

SELECT operator_id,
       parent_operators,
       operator_type,
       ROUND(execution_time_breakdown:overall_percentage::FLOAT, 1)        AS pct_of_time,
       operator_statistics:input_rows::NUMBER                               AS input_rows,
       operator_statistics:output_rows::NUMBER                              AS output_rows,
       operator_statistics:pruning:partitions_scanned::NUMBER               AS partitions_scanned,
       operator_statistics:pruning:partitions_total::NUMBER                 AS partitions_total,
       ROUND(operator_statistics:io:bytes_scanned::FLOAT / POWER(1024, 3), 1) AS gb_scanned,
       operator_attributes:table_name::VARCHAR                              AS table_name,
       operator_attributes:join_type::VARCHAR                               AS join_type
FROM TABLE(GET_QUERY_OPERATOR_STATS($insert_qid))
ORDER BY pct_of_time DESC NULLS LAST
LIMIT 30;


/* =====================================================================
   5. E5 IN PROD, READ-ONLY: THE BEFORE PICTURE
   Same query as part 1 against PROD's fact and raw. PROD still matches
   comments by number alone, so the first column is the number of UTU
