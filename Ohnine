JOIN foreign_lines fo
  ON  fo.COMP_NBR = fl.COMP_NBR AND fo.ISHDRW = fl.ISHDRW AND fo.CMNTCM = fl.line;

USE DATABASE DAAS_UAT;


/* =====================================================================
   6. THE TASK-DRIVEN SMOKE RUN (once the admins have created the task)
   The by-hand run proved the SQL; this proves the proc's JavaScript
   wrapper: query tag, transaction, batch-control metrics, error
   handling. Stream empty, nothing bumped, nothing written.
   The ask to the admins is in 06 C0c:
     CREATE TASK DAAS_UAT.DAAS_COMMON.DAASI3640_UAT_REPLAY_TASK
       WAREHOUSE = DAAS_UAT_IT_ADHOC_COMPUTE
       COMMENT = 'DAASI-3640 UAT replay, manual runs only; drop after the test'
     AS CALL DAAS_COMMON.HETCMS_COMP_DETAIL_FACT_LOAD_PROC(36400001, 'DAASI3640_UAT', 'DAAS_UAT_IT_ADHOC_COMPUTE', '', '');
     GRANT OPERATE ON TASK DAAS_UAT.DAAS_COMMON.DAASI3640_UAT_REPLAY_TASK TO ROLE DAAS_TEAM;
     -- plus, if OPERATE alone does not let DAAS_TEAM fire it:
     -- GRANT EXECUTE TASK ON ACCOUNT TO ROLE DAAS_TEAM;
   ===================================================================== */

-- 6a. The stream is still empty (TRUE here means a load is wanted first).
SELECT SYSTEM$STREAM_HAS_DATA('DAAS_RAW_HETCMS.CMPRW_RAW_COMP_DETAIL_STREAM') AS has_data;   -- FALSE

-- 6b. Fire it, then watch it finish. STATE goes SCHEDULED -> EXECUTING -> SUCCEEDED;
--     RETURN_VALUE is the proc's output: SUCCESS, or the metrics complaint
--     about the unknown batch 36400001 (fine: the data step committed),
--     or FAILURE with the message.
EXECUTE TASK DAAS_UAT.DAAS_COMMON.DAASI3640_UAT_REPLAY_TASK;

SELECT name, state, return_value, scheduled_time, query_start_time, completed_time, error_message
FROM TABLE(DAAS_UAT.INFORMATION_SCHEMA.TASK_HISTORY(TASK_NAME => 'DAASI3640_UAT_REPLAY_TASK',
                                                     SCHEDULED_TIME_RANGE_START => DATEADD(hour, -2, CURRENT_TIMESTAMP())))
ORDER BY scheduled_time DESC;

-- 6c. Nothing written (0), and the four statements ran under the task's
--     batch tag with no errors. The task's queries ran under
--     APP_SERVICE_UAT, so if the second query returns nothing to
--     DAAS_TEAM, run it as DAAS_SNOWFLAKE_ACCTUSAGE against
--     SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY instead (same columns, up to
--     45 minutes behind).
SELECT COUNT(*) AS rows_with_test_batch_since_the_slice_run
FROM DAAS_CORE.COMP_DETAIL_FACT
WHERE BATCH_ID = 36400001 AND UPDATED_DTTM > '2026-10-27';

SELECT start_time, LEFT(LTRIM(query_text, ' \t\n\r'), 60) AS statement_start,
       ROUND(total_elapsed_time / 1000) AS seconds, execution_status, error_message
FROM TABLE(INFORMATION_SCHEMA.QUERY_HISTORY(RESULT_LIMIT => 10000))
WHERE query_tag = '36400001_HETCMS_COMP_DETAIL_FACT_LOAD_PROC'
  AND start_time > '2026-10-27'
ORDER BY start_time;
