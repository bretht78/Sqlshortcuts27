/* =====================================================================
   DAASI-3640 | UAT close-out, part 2 (10/27)
   What this morning's results settled, and what they opened.

   Settled:
     E5 (UAT)   0 comps show another guest's note; no offending rows.
     E5 (PROD)  16,780 of 49,455 UTU March 2026 comps show another
                guest's note in the report today (34%). The before picture.
     F7         the 209 soft-deleted comps are all CMS deletions
                (operation type 0) by CMG0010 (167) and HCGC2000 (42),
                programs outside the purge list; no guest changes.

   Opened:
     F7b        the deletions are dated 2026-03-03 to 04-03, while the
                UAT fact's daily loads were running (its rows for the
                month were created 03-01 to 03-30). So the loads SAW
                the deletions and did not apply them. Part 7 shows why,
                and sizes it in PROD.
     F8         not formula drift: 34,459 rows went from blank to a
                name and 14,983 to a different person's name. Part 8
                finds the source of the new names in UAT and, more to
                the point, computes what a PROD replay would do to
                COMPOR_NAME without replaying anything.
     Profile    my percentage column was wrong (the field is a fraction,
                not a percent, and ROUND to one place flattened it).
                The row counts still told the main story: the proc's
                lookups turn 49,455 comps into 80,858,925 intermediate
                rows before the final window function cuts them back,
                a fan-out of about 1,635 per comp. Part 9 reruns the
                profile properly and checks the two lookups that could
                do that.
   All read-only. Run as DAAS_TEAM on the Large.
   ===================================================================== */

USE DATABASE DAAS_UAT;


/* =====================================================================
   7. WHY THE DAILY LOAD DID NOT APPLY THE 209 DELETIONS
   From the proc text, no query needed: DELETE_IND is not among the
   columns in MD5_CHECKSUM, and the MERGE updates an existing row only
   WHEN MATCHED AND FACT.MD5_CHECKSUM <> SRC.MD5_CHECKSUM. The second
   statement only reactivates (sets 'N'); the third only handles guest
   changes. So a CMS delete row that carries the comp's unchanged
   business columns produces the same checksum as the row already in
   the fact, and nothing fires: the comp stays DELETE_IND = 'N'. The
   replay applied the deletions only because v1.14 changed the checksum
   formula, which forced every replayed row through the update.
   This is a pre-existing defect in the load, PROD included: a comp
   deleted in CMS stays active in the fact (and the report) unless some
   other column changed on the same row. One line fixes it (add
   DELETE_IND to the MD5 formula in the daily proc, the HIST proc and
   the DT); whether that rides with v1.14 or gets its own ticket is
   Pete's call. 7a and 7b are the evidence; 7c sizes PROD.
   ===================================================================== */

-- 7a. Loads were running on the deletion days: UTU fact rows written
--     per day through March and early April 2026, from the backup.
--     Expect rows on every business day.
SELECT UPDATED_DTTM::DATE AS load_day, COUNT(*) AS rows_written, COUNT(DISTINCT BATCH_ID) AS batches
FROM DAAS_TEMP_WORK.COMP_DETAIL_FACT_BKP_DAASI3640_UATREPLAY
WHERE PROPERTY_CD = 'UTU' AND SOURCE_SYSTEM_NM = 'HETCMS'
  AND UPDATED_DTTM BETWEEN '2026-03-01' AND '2026-04-10'
GROUP BY 1
ORDER BY 1;

-- 7b. The 209 themselves: the fact row was last written BEFORE the
--     deletion reached raw, and never again until the replay. Expect
--     WRITTEN_AFTER_DELETION = 0.
SELECT COUNT(*)                                                       AS deleted_comps,
       COUNT_IF(b.UPDATED_DTTM >= l.OPERATION_DATE)                   AS written_after_deletion,
       COUNT_IF(b.UPDATED_DTTM <  l.OPERATION_DATE)                   AS untouched_since_before_deletion,
       MIN(DATEDIFF(day, b.UPDATED_DTTM, l.OPERATION_DATE))           AS min_days_between,
       MAX(DATEDIFF(day, b.UPDATED_DTTM, l.OPERATION_DATE))           AS max_days_between
FROM DAAS_TEMP_WORK.DAASI3640_RP_EXPECTED e
JOIN DAAS_TEMP_WORK.DAASI3640_RP_LATEST l
  ON  l.CNUMRW = e.COMP_NBR AND l.ISHDRW = e.ISHDRW AND l.COTLRW = e.CASINO_OUTLET_CD AND l.PROPERTY_CODE = e.PROPERTY_CD
JOIN DAAS_TEMP_WORK.COMP_DETAIL_FACT_BKP_DAASI3640_UATREPLAY b
  ON  b.COMP_NBR = e.COMP_NBR AND b.ISHDRW = e.ISHDRW AND b.PROPERTY_CD = e.PROPERTY_CD
  AND b.CASINO_OUTLET_CD = e.CASINO_OUTLET_CD AND b.GUEST_ID = e.GUEST_ID AND b.DELETE_IND = 'N'
WHERE l.rule_delete_ind = 'Y';

-- 7c. PROD: how many active comps CMS has deleted. The proc's own
--     DELETE_IND rule on the latest raw row of every active HETCMS comp
--     in the fact, counted where it says 'Y'. Reads all of CMPRW_RAW
--     once (a few minutes on the Large). This is the number the replay
--     would soft-delete if every such comp were replayed, and the size
--     of the defect either way. The second result shows the shape by
--     program and year.
USE DATABASE DAAS_PROD;

CREATE OR REPLACE TRANSIENT TABLE DAAS_TEMP_WORK.DAASI3640_PROD_STUCK_DELETES AS
WITH latest AS (
    SELECT CNUMRW, ISHDRW, COTLRW, PROPERTY_CODE, SYIDRW, OPERATION_TYPE, TRIM(PROGRAM_NAME) AS program,
           SOURCE_SYSTEM_NAME, OPERATION_DATE
    FROM DAAS_RAW_HETCMS.CMPRW_RAW
    QUALIFY ROW_NUMBER() OVER (PARTITION BY CNUMRW, ISHDRW, COTLRW, PROPERTY_CODE
            ORDER BY OPERATION_DATE DESC, OPERATION_SEQUENCE_NBR DESC, CREATED_DATE DESC) = 1
)
SELECT f.COMP_DETAIL_FACT_SK, f.COMP_NBR, f.ISHDRW, f.PROPERTY_CD, f.CASINO_OUTLET_CD, f.GUEST_ID, f.ISSUE_DT,
       f.UPDATED_DTTM AS fact_last_written, l.OPERATION_TYPE, l.program, l.OPERATION_DATE AS deleted_at,
       l.SYIDRW <> f.GUEST_ID AS guest_differs
FROM DAAS_CORE.COMP_DETAIL_FACT f
JOIN latest l
  ON  l.CNUMRW = f.COMP_NBR AND l.ISHDRW = f.ISHDRW AND l.COTLRW = f.CASINO_OUTLET_CD AND l.PROPERTY_CODE = f.PROPERTY_CD
LEFT JOIN DAAS_COMMON.PURGE_PROGRAM_NM_LKP p
  ON  l.SOURCE_SYSTEM_NAME = p.SOURCE_SYSTEM_NM AND l.PROPERTY_CODE = p.PROPERTY_CD
  AND UPPER(l.program) = UPPER(TRIM(p.PROGRAM_NM))
WHERE f.DELETE_IND = 'N' AND f.SOURCE_SYSTEM_NM = 'HETCMS'
  AND l.OPERATION_TYPE IN (0, 5, 8)
  AND l.program <> 'QRYO04'
  AND p.PROGRAM_NM IS NULL;

SELECT COUNT(*)                                   AS active_comps_cms_has_deleted,
       COUNT(DISTINCT PROPERTY_CD)                AS properties,
       MIN(deleted_at)::DATE                      AS earliest_deletion,
       MAX(deleted_at)::DATE                      AS latest_deletion,
       COUNT_IF(guest_differs)                    AS guest_differs,
       COUNT_IF(deleted_at > fact_last_written)   AS deleted_after_last_write
FROM DAAS_TEMP_WORK.DAASI3640_PROD_STUCK_DELETES;

SELECT program, OPERATION_TYPE, YEAR(deleted_at) AS deletion_year, COUNT(*) AS comps
FROM DAAS_TEMP_WORK.DAASI3640_PROD_STUCK_DELETES
GROUP BY 1, 2, 3
ORDER BY comps DESC
LIMIT 30;

USE DATABASE DAAS_UAT;


/* =====================================================================
   8. THE HOST NAMES (COMPOR_NAME)
   The proc builds the name from the host master CMPHA_RAW (latest row
   per authorizer code and property, "LAST, FIRST" with digits stripped),
   then CMPAS_RAW, then the Teradata lookup. A rebuild therefore shows
   today's host master. 8a says which names the UAT rebuild wrote and
   whether one dominates (a join or default-row problem) or many appear
   (the host master differs from what built the March rows). 8b is the
   one that matters: the same derivation run in PROD today, against
   PROD's fact, for the same slice. That is exactly what a PROD replay
   would write, computed without replaying.
   ===================================================================== */

-- 8a. UAT: the names written onto the 49,442 changed rows, most common
--     first. If the top name covers most of the rows, the join is
--     matching a catch-all host record; if the names are many and the
--     counts modest, the host master simply changed.
SELECT f.COMPOR_NAME                          AS name_after,
       COUNT(*)                               AS rows_,
       COUNT_IF(b.COMPOR_NAME IS NULL)        AS were_blank,
       COUNT(DISTINCT b.COMPOR_NAME)          AS distinct_names_before,
       COUNT(DISTINCT f.COMPOR_AUTHOR_NBR)    AS authorizer_codes,
       MIN(f.COMPOR_AUTHOR_NBR)               AS min_code,
       MAX(f.COMPOR_AUTHOR_NBR)               AS max_code
FROM DAAS_TEMP_WORK.COMP_DETAIL_FACT_BKP_DAASI3640_UATREPLAY b
JOIN DAAS_TEMP_WORK.DAASI3640_RP_EXPECTED e
  ON  e.COMP_NBR = b.COMP_NBR AND e.ISHDRW = b.ISHDRW AND e.PROPERTY_CD = b.PROPERTY_CD
  AND e.CASINO_OUTLET_CD = b.CASINO_OUTLET_CD
JOIN DAAS_CORE.COMP_DETAIL_FACT f
  ON  f.COMP_DETAIL_FACT_SK = b.COMP_DETAIL_FACT_SK
WHERE f.COMPOR_NAME IS DISTINCT FROM b.COMPOR_NAME
GROUP BY 1
ORDER BY rows_ DESC
LIMIT 15;

-- 8b. PROD: what a replay would do to COMPOR_NAME on UTU March 2026,
--     computed from today's PROD raw and lookups with the proc's own
--     derivation, against PROD's fact. WOULD_CHANGE is the PROD
--     counterpart of UAT's 49,442. The RESOLVED_BY columns say which
--     source supplies the name today.
USE DATABASE DAAS_PROD;

WITH slice AS (
    SELECT COMP_DETAIL_FACT_SK, COMP_NBR, ISHDRW, PROPERTY_CD, CASINO_OUTLET_CD, ISSUE_DT,
           COMPOR_NAME AS name_in_fact, COMPOR_AUTHOR_NBR, UPDATED_DTTM
    FROM DAAS_CORE.COMP_DETAIL_FACT
    WHERE DELETE_IND = 'N' AND SOURCE_SYSTEM_NM = 'HETCMS'
      AND PROPERTY_CD = 'UTU' AND ISSUE_DT BETWEEN '2026-03-01' AND '2026-03-31'
),
rw AS (     -- the comp's latest raw row: CAUTRW is the authorizer code the host master is keyed on
    SELECT CNUMRW, ISHDRW, COTLRW, PROPERTY_CODE, CAUTRW
    FROM DAAS_RAW_HETCMS.CMPRW_RAW
    WHERE PROPERTY_CODE = 'UTU' AND CNUMRW IN (SELECT COMP_NBR FROM slice)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY CNUMRW, ISHDRW, COTLRW, PROPERTY_CODE
            ORDER BY OPERATION_DATE DESC, OPERATION_SEQUENCE_NBR DESC, CREATED_DATE DESC) = 1
),
cd AS (     -- the comp's latest detail row: CAUTCD keys the second host table
    SELECT CNUMCD, ISHDCD, COTLCD, PROPERTY_CODE, CAUTCD
    FROM DAAS_RAW_HETCMS.CMPCD_RAW
    WHERE PROPERTY_CODE = 'UTU' AND CNUMCD IN (SELECT COMP_NBR FROM slice)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY CNUMCD, ISHDCD, COTLCD, PROPERTY_CODE
            ORDER BY OPERATION_DATE DESC, OPERATION_SEQUENCE_NBR DESC, CREATED_DATE DESC) = 1
),
ha AS (     -- host master, latest row per authorizer and property, name built the proc's way
    SELECT AUTHHA, PROPERTY_CODE, OPERATION_DATE AS ha_row_date,
           CONCAT(
           REGEXP_REPLACE (
           concat(
           case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 1), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 1) end,
           case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 2), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 2) end,
           case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 3), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 3) end,
           case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 4), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 4) end,
           case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 5), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 5) end
           ),'[0-9]',''),
           ', ',
           REGEXP_REPLACE (
           concat(
           case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 1), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 1) end,
           case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 2), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 2) end,
           case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 3), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 3) end,
           case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 4), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 4) end,
           case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 5), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 5) end
           ),'[0-9]','')) AS COPNM
    FROM DAAS_RAW_HETCMS.CMPHA_RAW
    WHERE PROPERTY_CODE = 'UTU'
    QUALIFY ROW_NUMBER() OVER (PARTITION BY AUTHHA, PROPERTY_CODE
            ORDER BY OPERATION_DATE DESC, OPERATION_SEQUENCE_NBR DESC, CREATED_DATE DESC) = 1
),
asr AS (    -- second host table, same treatment
    SELECT APIDAS, PROPERTY_CODE,
           CONCAT(
           REGEXP_REPLACE (
           concat(
           case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 1), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 1) end,
           case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 2), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 2) end,
           case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 3), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 3) end,
           case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 4), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 4) end,
           case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 5), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 5) end
           ),'[0-9]',''),
           ', ',
           REGEXP_REPLACE (
           concat(
           case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 1), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 1) end,
           case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 2), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 2) end,
           case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 3), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 3) end,
           case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 4), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 4) end,
           case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 5), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 5) end
           ),'[0-9]','') ) AS COPNM
    FROM DAAS_RAW_HETCMS.CMPAS_RAW
    WHERE PROPERTY_CODE = 'UTU'
    QUALIFY ROW_NUMBER() OVER (PARTITION BY APIDAS, PROPERTY_CODE
            ORDER BY OPERATION_DATE DESC, OPERATION_SEQUENCE_NBR DESC, CREATED_DATE DESC) = 1
),
derived AS (
    SELECT s.*, rw.CAUTRW, cd.CAUTCD, ha.ha_row_date,
           ha.COPNM            AS from_cmpha,
           asr.COPNM           AS from_cmpas,
           LKP.C_COMPOR_NAME   AS from_lkp,
           COALESCE(ha.COPNM, asr.COPNM, LKP.C_COMPOR_NAME) AS name_today
    FROM slice s
    LEFT JOIN rw  ON rw.CNUMRW = s.COMP_NBR AND rw.ISHDRW = s.ISHDRW AND rw.COTLRW = s.CASINO_OUTLET_CD AND rw.PROPERTY_CODE = s.PROPERTY_CD
    LEFT JOIN cd  ON cd.CNUMCD = s.COMP_NBR AND cd.ISHDCD = s.ISHDRW AND cd.COTLCD = s.CASINO_OUTLET_CD AND cd.PROPERTY_CODE = s.PROPERTY_CD
    LEFT JOIN ha  ON ha.AUTHHA = rw.CAUTRW AND ha.PROPERTY_CODE = s.PROPERTY_CD
    LEFT JOIN asr ON asr.APIDAS = cd.CAUTCD AND asr.PROPERTY_CODE = s.PROPERTY_CD
    LEFT JOIN DAAS_TERADATA_RAW.PML_COMP_DTL_COMPOR_LKP_DAAS LKP
           ON rw.CAUTRW = TRIM(LKP.C_COMPOR_CODE) AND s.PROPERTY_CD = TRIM(LKP.C_PROP_CD)
          AND s.ISSUE_DT BETWEEN LKP.START_DATE AND LKP.END_DATE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY s.COMP_DETAIL_FACT_SK ORDER BY LKP.START_DATE DESC NULLS LAST) = 1
)
SELECT COUNT(*)                                                                   AS comps,
       COUNT_IF(name_today IS DISTINCT FROM name_in_fact)                         AS would_change,
       COUNT_IF(name_in_fact IS NULL     AND name_today IS NOT NULL)              AS blank_now_name,
       COUNT_IF(name_in_fact IS NOT NULL AND name_today IS NULL)                  AS name_now_blank,
       COUNT_IF(name_in_fact IS NOT NULL AND name_today IS NOT NULL
                AND name_today <> name_in_fact)                                   AS different_name,
       COUNT_IF(from_cmpha IS NOT NULL)                                           AS resolved_by_cmpha,
       COUNT_IF(from_cmpha IS NULL AND from_cmpas IS NOT NULL)                    AS resolved_by_cmpas,
       COUNT_IF(from_cmpha IS NULL AND from_cmpas IS NULL AND from_lkp IS NOT NULL) AS resolved_by_lkp,
       COUNT_IF(name_today IS NULL)                                               AS unresolved
FROM derived;

--     The changes themselves, by kind, with an example each (employee
--     names; for Pete). Only meaningful if WOULD_CHANGE is not 0.
