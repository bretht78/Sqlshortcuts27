SELECT COUNT(DISTINCT fl.COMP_NBR || '-' || fl.ISHDRW)                        AS comps_showing_another_guests_line,
       (SELECT COUNT(DISTINCT COMP_NBR || '-' || ISHDRW) FROM foreign_lines)  AS comps_whose_number_has_other_guests_lines_in_cms,
       (SELECT COUNT(*) FROM slice)                                          AS comps_in_slice
