    LEFT JOIN asr ON asr.APIDAS = cd.CAUTCD AND asr.PROPERTY_CODE = s.PROPERTY_CD
    LEFT JOIN DAAS_TERADATA_RAW.PML_COMP_DTL_COMPOR_LKP_DAAS LKP
           ON rw.CAUTRW = TRIM(LKP.C_COMPOR_CODE) AND s.PROPERTY_CD = TRIM(LKP.C_PROP_CD)
          AND s.ISSUE_DT BETWEEN LKP.START_DATE AND LKP.END_DATE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY s.COMP_DETAIL_FACT_SK ORDER BY LKP.START_DATE DESC NULLS LAST) = 1
)
SELECT CASE WHEN name_in_fact IS NULL THEN 'blank, now a name'
            WHEN name_today IS NULL   THEN 'name, now blank'
            WHEN REGEXP_REPLACE(UPPER(name_in_fact), '[^A-Z]', '') = REGEXP_REPLACE(UPPER(name_today), '[^A-Z]', '')
                                      THEN 'same letters: spacing, case or digits'
            ELSE 'different name' END                                   AS change_kind,
       COUNT(*)                                                         AS rows_,
       COUNT(DISTINCT CAUTRW)                                           AS authorizer_codes,
       ANY_VALUE(COALESCE(name_in_fact, '(blank)') || '  ->  ' || COALESCE(name_today, '(blank)')
                 || '   [code ' || COALESCE(CAUTRW::VARCHAR, '?') || ', host row ' || COALESCE(ha_row_date::DATE::VARCHAR, 'none') || ']') AS example
FROM derived
WHERE name_today IS DISTINCT FROM name_in_fact
GROUP BY 1
ORDER BY rows_ DESC;

USE DATABASE DAAS_UAT;


/* =====================================================================
   9. THE PROFILE, PROPERLY, AND THE FAN-OUT
   9a reruns the operator stats with the percentage multiplied up and
   every operator listed in tree order, with its join condition, so the
   operator that turns 51,442 rows into 80,858,925 can be named. Export
   the result (the download arrow above the grid) rather than a
   screenshot; it is about fifty rows and the conditions are long.
   9b checks the two lookups joined without a latest-row filter that
   could do it: OFFSET_CONTROL (joined on property alone) and the
   Teradata host lookup (joined on a date range). 1,635 rows per UTU
   comp is about the number of days since the raw history began in
   April 2022, which is what a control table with one row per property
   per run would produce.
   ===================================================================== */

-- 9a.
SET insert_qid = (SELECT query_id
                  FROM TABLE(INFORMATION_SCHEMA.QUERY_HISTORY_BY_USER(RESULT_LIMIT => 5000))
                  WHERE query_text ILIKE '%INSERT INTO DAAS_TEMP_WORK.COMP_DETAIL_FACT_TMP_DAASI3640%'
                    AND query_type <> 'SELECT'
                    AND rows_produced = 49455
                  ORDER BY start_time DESC
                  LIMIT 1);

SELECT operator_id,
       parent_operators[0]::NUMBER                                          AS parent,
       operator_type,
       ROUND(execution_time_breakdown:overall_percentage::FLOAT * 100, 1)  AS pct_of_time,
       operator_statistics:input_rows::NUMBER                               AS input_rows,
       operator_statistics:output_rows::NUMBER                              AS output_rows,
       operator_statistics:pruning:partitions_scanned::NUMBER               AS partitions_scanned,
       ROUND(operator_statistics:io:bytes_scanned::FLOAT / POWER(1024, 3), 1) AS gb_scanned,
       ROUND(operator_statistics:spilling:bytes_spilled_local_storage::FLOAT / POWER(1024, 3), 1) AS gb_spilled,
       COALESCE(operator_attributes:table_name::VARCHAR,
                operator_attributes:join_type::VARCHAR || ' ON ' || operator_attributes:equality_join_condition::VARCHAR,
                LEFT(operator_attributes::VARCHAR, 200))                     AS what
FROM TABLE(GET_QUERY_OPERATOR_STATS($insert_qid))
ORDER BY operator_id;

-- 9b. The suspects. Expect one of these to show about 1,600 rows for UTU.
SELECT 'OFFSET_CONTROL' AS lookup, PROPERTY_CD AS key_, COUNT(*) AS rows_, COUNT(DISTINCT OFFSET) AS distinct_offsets
FROM DAAS_COMMON.OFFSET_CONTROL
GROUP BY 1, 2
ORDER BY rows_ DESC
LIMIT 5;

SELECT 'PML_COMP_DTL_COMPOR_LKP_DAAS' AS lookup, TRIM(C_COMPOR_CODE) AS key_, COUNT(*) AS rows_,
       MIN(START_DATE) AS from_, MAX(END_DATE) AS to_
FROM DAAS_TERADATA_RAW.PML_COMP_DTL_COMPOR_LKP_DAAS
WHERE TRIM(C_PROP_CD) = 'UTU'
GROUP BY 1, 2
ORDER BY rows_ DESC
LIMIT 5;

--     And the PROD daily load's own numbers, for the same question: how
--     long its INSERT takes and how many rows it produces on a normal
--     day. The replay's cost scales from these. (Needs the account usage
--     view; run as DAAS_SNOWFLAKE_ACCTUSAGE if DAAS_TEAM cannot read it.)
SELECT start_time::DATE AS run_day, warehouse_size,
       ROUND(total_elapsed_time / 1000)           AS insert_seconds,
       rows_produced                               AS comps_rebuilt,
       ROUND(bytes_spilled_to_local_storage / POWER(1024, 3), 1) AS gb_spilled
FROM SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY
WHERE database_name = 'DAAS_PROD'
  AND query_tag LIKE '%HETCMS_COMP_DETAIL_FACT_LOAD_PROC'
  AND query_text ILIKE '%INSERT INTO DAAS_TEMP.COMP_DETAIL_FACT_TMP%'
  AND start_time > DATEADD(day, -14, CURRENT_TIMESTAMP())
ORDER BY start_time DESC;
