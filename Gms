		SOURCE_SYSTEM_NM,
		TIME_ZONE,
		CREATED_DTTM,
		CREATED_BY,
		UPDATED_DTTM,
		UPDATED_BY,
		DELETE_IND,
		BATCH_ID,
		LAST_DML_CD,
		OPERATION_SEQUENCE_NBR,
		MD5_CHECKSUM,
		ISSUE_DTTM,
		ISHDRW,
		COMMENTS_EXTENDED
