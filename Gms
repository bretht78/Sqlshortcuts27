--    One row per run of this file (runs split on the TMP rebuild), with
--    the time from the TMP rebuild to the COMMIT. Smoke run first, slice
--    run second; slice minus smoke is the per-slice cost.
WITH q AS (
    SELECT start_time, end_time, query_text, warehouse_name, warehouse_size,
           SUM(IFF(query_text ILIKE 'CREATE OR REPLACE TABLE DAAS_TEMP_WORK.COMP_DETAIL_FACT_TMP_DAASI3640%', 1, 0))
               OVER (ORDER BY start_time ROWS UNBOUNDED PRECEDING) AS run_nbr
    FROM TABLE(INFORMATION_SCHEMA.QUERY_HISTORY(RESULT_LIMIT => 10000))
    WHERE query_tag = '36400001_HETCMS_COMP_DETAIL_FACT_LOAD_PROC'
      AND start_time > DATEADD(hour, -12, CURRENT_TIMESTAMP())
)
SELECT run_nbr,
       MIN(start_time)                                   AS started,
       MAX(end_time)                                     AS finished,
       DATEDIFF(second, MIN(start_time), MAX(end_time))  AS seconds,
       COUNT(*)                                          AS statements,
       ANY_VALUE(warehouse_name)                         AS warehouse,
       ANY_VALUE(warehouse_size)                         AS warehouse_size
FROM q
WHERE run_nbr > 0
GROUP BY run_nbr
ORDER BY run_nbr;

--    The two heavy statements of each run on their own.
SELECT start_time, LEFT(LTRIM(query_text, ' \t\n\r'), 45) AS statement_start,
       ROUND(total_elapsed_time / 1000) AS seconds, rows_inserted, rows_updated
FROM TABLE(INFORMATION_SCHEMA.QUERY_HISTORY(RESULT_LIMIT => 10000))
WHERE query_tag = '36400001_HETCMS_COMP_DETAIL_FACT_LOAD_PROC'
  AND (query_text ILIKE '%INSERT INTO DAAS_TEMP_WORK.COMP_DETAIL_FACT_TMP_DAASI3640%'
       OR query_text ILIKE '%MERGE INTO DAAS_CORE.COMP_DETAIL_FACT%')
ORDER BY start_time;

