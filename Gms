			CURRENT_USER AS UPDATED_BY,
			CASE 
				WHEN TRIM(CMPRW_RAW.PROGRAM_NAME) ='QRYO04' AND CMPRW_RAW.OPERATION_TYPE IN(0,5,8) THEN 'N'
				WHEN PPNL_CMPRW.PROGRAM_NM IS NOT NULL THEN 'N'
				WHEN CMPRW_RAW.OPERATION_TYPE IN(0, 5, 8) THEN 'Y'
				ELSE 'N'
			END AS DELETE_IND,
			36400001 AS BATCH_ID,
			CMPRW_RAW.OPERATION_SEQUENCE_NBR AS OPERATION_SEQUENCE_NBR,
			/*CONCAT(
				DAAS_COMMON.HUNDRED_YEAR_BUSINESS_DATE_CON_UDF(CMPRW_RAW.ISHDRW), ' ',
				DATEADD(HOUR,HOUR_TXT,
					CASE 
						WHEN CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET  > 240000 THEN '00:00:00'::TIME
						WHEN CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET  < 000000 THEN '00:00:00'::TIME
						WHEN SUBSTR(SUBSTR('000000', 1, 6-(LENGTH((CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6)))) || (CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6) , 1, 2)::INTEGER >= 24 THEN '00:00:00'::TIME
						WHEN SUBSTR(SUBSTR('000000', 1, 6-(LENGTH((CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6)))) || (CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6) , 3, 2)::INTEGER >= 60 THEN '00:00:00'::TIME
						WHEN SUBSTR(SUBSTR('000000', 1, 6-(LENGTH((CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6)))) || (CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6) , 5, 2)::INTEGER >= 60 THEN '00:00:00'::TIME
						ELSE TO_CHAR((SUBSTR('000000', 1, 6 - LENGTH((CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6))) || (CMPRW_RAW.ISTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6))::INTEGER,  '00:00:00')::TIME
					END
				)
			) AS ISSUE_DTTM,*/
			CONCAT(
				DAAS_COMMON.HUNDRED_YEAR_BUSINESS_DATE_CON_UDF(CMPRW_RAW.ISHDRW), ' ',				
				CASE WHEN CMPRW_RAW.ISTMRW >= 240000 THEN '00:00:00'::TIME ELSE DAAS_COMMON.TIME_CONV_UDF(CMPRW_RAW.ISTMRW) END	
			) AS ISSUE_DTTM, 
			CMPRW_RAW.ISHDRW,
			CMPRM_RAW.COMMENTS_EXTENDED AS COMMENTS_EXTENDED
		FROM 
		(
			SELECT 
				CMPRW_RAW.*
			FROM 
				DAAS_RAW_HETCMS.CMPRW_RAW_COMP_DETAIL_STREAM CMPRW_RAW
			WHERE 
				CMPRW_RAW.METADATA$ACTION = 'INSERT'
			QUALIFY ROW_NUMBER() OVER (PARTITION BY --CMPRW_RAW.SYIDRW, 
													CMPRW_RAW.CNUMRW, CMPRW_RAW.ISHDRW, CMPRW_RAW.COTLRW, CMPRW_RAW.PROPERTY_CODE
									  ORDER BY CMPRW_RAW.OPERATION_DATE DESC, CMPRW_RAW.OPERATION_SEQUENCE_NBR DESC, CMPRW_RAW.CREATED_DATE DESC) = 1
		) CMPRW_RAW  
		LEFT JOIN 
		(
			SELECT 
				CMPCD_RAW.*
			FROM 
				DAAS_RAW_HETCMS.CMPCD_RAW
			QUALIFY ROW_NUMBER() OVER(PARTITION BY --SYIDCD, 
												CNUMCD, ISHDCD, COTLCD, PROPERTY_CODE
									  ORDER BY OPERATION_DATE DESC ,OPERATION_SEQUENCE_NBR DESC,CREATED_DATE DESC) = 1
		) CMPCD_RAW 
		ON 
			--CMPRW_RAW.SYIDRW = CMPCD_RAW.SYIDCD
			 CMPRW_RAW.CNUMRW = CMPCD_RAW.CNUMCD
			AND CMPRW_RAW.ISHDRW = CMPCD_RAW.ISHDCD
			--AND CMPRW_RAW.STATRW = CMPCD_RAW.CSTSCD
			AND CMPRW_RAW.COTLRW = CMPCD_RAW.COTLCD
			AND CMPRW_RAW.PROPERTY_CODE = CMPCD_RAW.PROPERTY_CODE
		LEFT JOIN 
		(
			SELECT 
				APIDAS,
				PROPERTY_CODE,
				LNAMAS,
				FNAMAS,
				--CONCAT(FNAMAS , ' ,', LNAMAS) AS COPNM,
				CONCAT(
						REGEXP_REPLACE ( 
									concat(
								 case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 1), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 1) end,
								 case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 2), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 2) end,  
								 case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 3), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 3) end,  
								 case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 4), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 4) end,  
								 case when REGEXP_LIKE(SPLIT_PART(LNAMAS, ' ', 5), '[0-9].*') = true then ''  else SPLIT_PART(LNAMAS, ' ', 5) end
									),'[0-9]',''),
						', ',
						REGEXP_REPLACE ( 
							concat(
							 case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 1), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 1) end,
							 case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 2), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 2) end,  
							 case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 3), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 3) end,  
							 case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 4), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 4) end,  
							 case when REGEXP_LIKE(SPLIT_PART(FNAMAS, ' ', 5), '[0-9].*') = true then ''  else SPLIT_PART(FNAMAS, ' ', 5) end
							),'[0-9]','') ) AS COPNM
			 FROM
				DAAS_RAW_HETCMS.CMPAS_RAW
			 QUALIFY ROW_NUMBER() OVER (PARTITION BY APIDAS,PROPERTY_CODE
										ORDER BY OPERATION_DATE DESC ,OPERATION_SEQUENCE_NBR DESC,CREATED_DATE DESC) = 1
		) CMPAS_RAW
		 ON 
			CMPAS_RAW.APIDAS = CMPCD_RAW.CAUTCD
			AND CMPAS_RAW.PROPERTY_CODE = CMPCD_RAW.PROPERTY_CODE
		LEFT JOIN 
		(
			SELECT 
				LMTTLT,
				LMTDLT,
				PROPERTY_CODE 
			FROM 
				DAAS_RAW_HETCMS.CMPLT_RAW 
			QUALIFY ROW_NUMBER() OVER (PARTITION BY CMPLT_RAW.LMTTLT,CMPLT_RAW.PROPERTY_CODE
									   ORDER BY OPERATION_DATE DESC ,OPERATION_SEQUENCE_NBR DESC,CREATED_DATE DESC) = 1 
		) CMPLT_RAW
		ON 
			CMPRW_RAW.LMTTRW = CMPLT_RAW.LMTTLT
			AND CMPRW_RAW.PROPERTY_CODE = CMPLT_RAW.PROPERTY_CODE
		LEFT JOIN
		(
			/* v1.14 (DAASI-3640): a comment line belongs to a comp when its guest ever held
			   that comp (same number, issue date and property) in the comp table history.
			   Comp numbers are reused, so matching on number alone copied comments across
			   guests. The history match also keeps a note after a merge, where CMS re-points
			   the comp to the surviving guest id but leaves the comment under the old one. */
			SELECT
				CNUMRW,
				ISHDRW,
				PROPERTY_CODE,
				LISTAGG(CMNTCM, '|') WITHIN GROUP (ORDER BY CSEQCM) AS CMNTCM
			FROM
			(
				SELECT
					H.CNUMRW,
					H.ISHDRW,
					H.PROPERTY_CODE,
					L.CSEQCM,
					L.CMNTCM
				FROM
				(
					/* every guest id that ever held each comp */
					SELECT DISTINCT CNUMRW, ISHDRW, PROPERTY_CODE, SYIDRW
					FROM DAAS_RAW_HETCMS.CMPRW_RAW
				) H
				JOIN
				(
					/* latest version of each comment line */
					SELECT
						SYIDCM,
						"CMP#CM",
						CSEQCM,
						CMNTCM,
						PROPERTY_CODE,
						OPERATION_DATE,
						OPERATION_SEQUENCE_NBR,
						CREATED_DATE
					FROM
						DAAS_RAW_HETCMS.ECPCMPCM_RAW ECPCMPCM_RAW
					QUALIFY ROW_NUMBER() OVER (PARTITION BY SYIDCM, "CMP#CM", CSEQCM, PROPERTY_CODE
										   ORDER BY OPERATION_DATE DESC, OPERATION_SEQUENCE_NBR DESC, CREATED_DATE DESC) = 1
				) L
				ON
					L.SYIDCM = H.SYIDRW
					AND L."CMP#CM" = H.CNUMRW
					AND L.PROPERTY_CODE = H.PROPERTY_CODE
				/* one text per line number; if a merged pair carries the same line under both ids, keep the latest */
				QUALIFY ROW_NUMBER() OVER (PARTITION BY H.CNUMRW, H.ISHDRW, H.PROPERTY_CODE, L.CSEQCM
										   ORDER BY L.OPERATION_DATE DESC, L.OPERATION_SEQUENCE_NBR DESC, L.CREATED_DATE DESC) = 1
			)
			GROUP BY
				CNUMRW,
				ISHDRW,
				PROPERTY_CODE
		) ECPCMPCM_RAW
		ON
			CMPRW_RAW.CNUMRW = ECPCMPCM_RAW.CNUMRW
			AND CMPRW_RAW.ISHDRW = ECPCMPCM_RAW.ISHDRW
			AND CMPRW_RAW.PROPERTY_CODE = ECPCMPCM_RAW.PROPERTY_CODE
		LEFT JOIN
		(
			/* v1.14 (DAASI-3640): remarks (CMPRM) carry no guest id. A remark line belongs to the
			   comp that was live on its number when the line was written: the comp whose first
			   appearance in the comp table is the latest one at or before the line. A 60-second
			   allowance covers lines captured just ahead of their own comp row, and the first comp
			   seen on a number takes any earlier lines (the April 2022 history start). The purge
			   deletes remarks by number, so a purged line still carries its text and stays with
			   its comp. Lines are joined with | in line-number order, capped at 4000 characters. */
			SELECT
				CNUMRW,
				ISHDRW,
				PROPERTY_CODE,
				LEFT(LISTAGG(EXPLRM, '|') WITHIN GROUP (ORDER BY SEQNRM), 4000) AS COMMENTS_EXTENDED
			FROM
			(
				SELECT
					C.CNUMRW,
					C.ISHDRW,
					C.PROPERTY_CODE,
					R.SEQNRM,
					R.EXPLRM
				FROM
				(
					/* each comp's life on its number: first appearance, and the next comp's first appearance */
					SELECT
						CNUMRW,
						ISHDRW,
						PROPERTY_CODE,
						FIRST_SEEN,
						LAG(FIRST_SEEN)  OVER (PARTITION BY CNUMRW, PROPERTY_CODE ORDER BY FIRST_SEEN, ISHDRW) AS PREV_FIRST_SEEN,
						LEAD(FIRST_SEEN) OVER (PARTITION BY CNUMRW, PROPERTY_CODE ORDER BY FIRST_SEEN, ISHDRW) AS NEXT_FIRST_SEEN
					FROM
					(
						SELECT CNUMRW, ISHDRW, PROPERTY_CODE, MIN(OPERATION_DATE) AS FIRST_SEEN
						FROM DAAS_RAW_HETCMS.CMPRW_RAW
						GROUP BY CNUMRW, ISHDRW, PROPERTY_CODE
					)
				) C
				JOIN
					DAAS_RAW_HETCMS.CMPRM_RAW R
				ON
					R.CNUMRM = C.CNUMRW
					AND R.PROPERTY_CODE = C.PROPERTY_CODE
					AND (C.PREV_FIRST_SEEN IS NULL OR R.OPERATION_DATE >= DATEADD(SECOND, -60, C.FIRST_SEEN))
					AND (C.NEXT_FIRST_SEEN IS NULL OR R.OPERATION_DATE <  DATEADD(SECOND, -60, C.NEXT_FIRST_SEEN))
				/* latest version of each remark line within that comp's life */
				QUALIFY ROW_NUMBER() OVER (PARTITION BY C.CNUMRW, C.ISHDRW, C.PROPERTY_CODE, R.SEQNRM
										   ORDER BY R.OPERATION_DATE DESC, R.OPERATION_SEQUENCE_NBR DESC, R.CREATED_DATE DESC) = 1
			)
			GROUP BY
				CNUMRW,
				ISHDRW,
				PROPERTY_CODE
		) CMPRM_RAW
		ON
			CMPRW_RAW.CNUMRW = CMPRM_RAW.CNUMRW
			AND CMPRW_RAW.ISHDRW = CMPRM_RAW.ISHDRW
			AND CMPRW_RAW.PROPERTY_CODE = CMPRM_RAW.PROPERTY_CODE
		LEFT JOIN
			DAAS_COMMON.OFFSET_CONTROL 
		ON
			CMPRW_RAW.PROPERTY_CODE=OFFSET_CONTROL.PROPERTY_CD
		LEFT JOIN 
		(
			SELECT 
				OCATRC,
				COTLRC
			 FROM 
				DAAS_RAW_HETCMS.CMPRC_RAW 
			QUALIFY ROW_NUMBER() OVER(PARTITION BY COTLRC 
									  ORDER BY OPERATION_DATE DESC ,OPERATION_SEQUENCE_NBR DESC,CREATED_DATE DESC) = 1
		) CMPRC_RAW
		ON 
			CMPRW_RAW.COTLRW = CMPRC_RAW.COTLRC							
		LEFT JOIN 
		(
			SELECT 
				AUTHHA,
				RVCDHA,
				FNAMHA,
				LNAMHA,
				--CONCAT(FNAMHA , ' ,', LNAMHA) AS COPNM,
				--CONCAT(LNAMHA , ', ', FNAMHA) AS COPNM,
				CONCAT(
						REGEXP_REPLACE ( 
								concat(
							 case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 1), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 1) end,
							 case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 2), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 2) end,  
							 case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 3), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 3) end,  
							 case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 4), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 4) end,  
							 case when REGEXP_LIKE(SPLIT_PART(LNAMHA, ' ', 5), '[0-9].*') = true then ''  else SPLIT_PART(LNAMHA, ' ', 5) end
										),'[0-9]',''),
						', ',       
						REGEXP_REPLACE ( 
								concat(
							 case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 1), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 1) end,
							 case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 2), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 2) end,  
							 case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 3), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 3) end,  
							 case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 4), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 4) end,  
							 case when REGEXP_LIKE(SPLIT_PART(FNAMHA, ' ', 5), '[0-9].*') = true then ''  else SPLIT_PART(FNAMHA, ' ', 5) end
										),'[0-9]','')) AS COPNM,
				PROPERTY_CODE,
				LEVLHA 
			FROM 
				DAAS_RAW_HETCMS.CMPHA_RAW
			QUALIFY ROW_NUMBER() OVER (PARTITION BY AUTHHA,/*RVCDHA,*/PROPERTY_CODE
									ORDER BY OPERATION_DATE DESC ,OPERATION_SEQUENCE_NBR DESC,CREATED_DATE DESC) = 1
		) CMPHA_RAW 
		ON 
			CMPRW_RAW.CAUTRW=CMPHA_RAW.AUTHHA	
			--AND CMPRW_RAW.COTLRW=CMPHA_RAW.RVCDHA
			AND CMPRW_RAW.PROPERTY_CODE=CMPHA_RAW.PROPERTY_CODE
		LEFT JOIN
			--DAAS_TERADATA_RAW.EDW_COMPOR_LKP LKP
		DAAS_TERADATA_RAW.PML_COMP_DTL_COMPOR_LKP_DAAS LKP
		ON
			CMPRW_RAW.CAUTRW = TRIM(LKP.C_COMPOR_CODE)	
			AND CMPRW_RAW.PROPERTY_CODE = TRIM(LKP.C_PROP_CD)
			AND DAAS_COMMON.HUNDRED_YEAR_BUSINESS_DATE_CON_UDF(CMPRW_RAW.ISHDRW) BETWEEN LKP.START_DATE AND LKP.END_DATE
		LEFT JOIN 
			DAAS_COMMON.PURGE_PROGRAM_NM_LKP PPNL_CMPRW
		ON 
			CMPRW_RAW.SOURCE_SYSTEM_NAME = PPNL_CMPRW.SOURCE_SYSTEM_NM
			AND CMPRW_RAW.PROPERTY_CODE = PPNL_CMPRW.PROPERTY_CD
			AND UPPER(TRIM(CMPRW_RAW.PROGRAM_NAME)) = UPPER(TRIM(PPNL_CMPRW.PROGRAM_NM))
		/*LEFT JOIN
			DAAS_CORE.CASINO_OUTLET_CD_LKP COCL
		ON
			CMPRW_RAW.PROPERTY_CODE = COCL.PROPERTY_CD
			AND CMPRW_RAW.COTLRW = COCL.CASINO_OUTLET_CD*/
		LEFT JOIN 
	    (
			SELECT  
				PROPERTY_CD,
				CASINO_REVENUE_CENTER_CD,
				MAX(REVENUE_CATEGORY_ID) AS REVENUE_CATEGORY_ID
			FROM 
				DAAS_CORE.CONS_REVENUE_CENTER_FACT
			WHERE 
				ACTIVE_FLG ='Y'
			GROUP BY ALL	
	    ) CRCF
		ON 
			CMPRW_RAW.PROPERTY_CODE = CRCF.PROPERTY_CD
			AND CMPRW_RAW.COTLRW = CRCF.CASINO_REVENUE_CENTER_CD -- changed from CONS_REV_CENTER_CD July 2026		
		LEFT JOIN
			DAAS_CORE.REVENUE_CATEGORY_LKP RCL
		ON
			 CRCF.REVENUE_CATEGORY_ID = RCL.REVENUE_CATEGORY_ID
		QUALIFY ROW_NUMBER() OVER (PARTITION BY --CMPRW_RAW.SYIDRW, 
												CMPRW_RAW.CNUMRW, CMPRW_RAW.ISHDRW, CMPRW_RAW.COTLRW, CMPRW_RAW.PROPERTY_CODE 
					ORDER BY CMPRW_RAW.OPERATION_DATE DESC, CMPRW_RAW.OPERATION_SEQUENCE_NBR DESC, CMPRW_RAW.CREATED_DATE DESC, CMPCD_RAW.DEPTCD DESC NULLS LAST) = 1
	)
	
;

-- 3.2  my_sql_command_2: reactivate rows the source reactivated
	UPDATE DAAS_CORE.COMP_DETAIL_FACT 
	SET 
		DELETE_IND = 'N',
		UPDATED_DTTM = CURRENT_TIMESTAMP,
		UPDATED_BY = CURRENT_USER,
		LAST_DML_CD = 'U',
		BATCH_ID = 36400001
	WHERE (COMP_NBR,ISHDRW,PROPERTY_CD,CASINO_OUTLET_CD) IN 
					(SELECT 
						SRC.COMP_NBR,SRC.ISHDRW,SRC.PROPERTY_CD,SRC.CASINO_OUTLET_CD
					FROM 
						DAAS_TEMP_WORK.COMP_DETAIL_FACT_TMP_DAASI3640 AS SRC
					INNER JOIN 
						DAAS_CORE.COMP_DETAIL_FACT AS FACT
					ON 
						SRC.COMP_NBR = FACT.COMP_NBR
						AND SRC.ISHDRW = FACT.ISHDRW
						AND SRC.PROPERTY_CD = FACT.PROPERTY_CD
						AND SRC.CASINO_OUTLET_CD = FACT.CASINO_OUTLET_CD
					WHERE (SRC.DELETE_IND <> FACT.DELETE_IND) AND (SRC.GUEST_ID = FACT.GUEST_ID))
;

-- 3.3  my_sql_command_3: soft-delete the old guest's row when the guest changed
	UPDATE DAAS_CORE.COMP_DETAIL_FACT 
	SET 
		DELETE_IND = 'Y',
		UPDATED_DTTM = CURRENT_TIMESTAMP,
		UPDATED_BY = CURRENT_USER,
		LAST_DML_CD = 'U',
		BATCH_ID = 36400001
	WHERE (GUEST_ID,COMP_NBR,ISHDRW,PROPERTY_CD,CASINO_OUTLET_CD,DELETE_IND) IN 
					(SELECT 
						FACT.GUEST_ID,FACT.COMP_NBR,FACT.ISHDRW,FACT.PROPERTY_CD,FACT.CASINO_OUTLET_CD,FACT.DELETE_IND
					FROM 
						DAAS_TEMP_WORK.COMP_DETAIL_FACT_TMP_DAASI3640 AS SRC
					INNER JOIN 
						DAAS_CORE.COMP_DETAIL_FACT AS FACT
					ON 
						SRC.COMP_NBR = FACT.COMP_NBR
						AND SRC.ISHDRW = FACT.ISHDRW
						AND SRC.PROPERTY_CD = FACT.PROPERTY_CD
						AND SRC.CASINO_OUTLET_CD = FACT.CASINO_OUTLET_CD
						AND FACT.DELETE_IND = 'N'
					WHERE SRC.GUEST_ID <> FACT.GUEST_ID)
;

