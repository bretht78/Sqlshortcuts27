	CASINO_OUTLET_CD VARCHAR(3) NOT NULL COMMENT 'Casino Outlet Code',
	LIMIT_TYPE_CD VARCHAR(3) NOT NULL COMMENT 'Limit Type Code',
	AUTHORIZER_ID VARCHAR(50) NOT NULL COMMENT 'Authorizer Id',
	COMPOR_DEPARTMENT_CD VARCHAR(3),
	PROPERTY_CD VARCHAR(3) NOT NULL,
