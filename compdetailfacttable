	DISCRETIONARY_COMP_FLG VARCHAR(1),
	ISSUED_BY_CD VARCHAR(7),
	COMP_TYPE_CD VARCHAR(4),
	NUMBER_OF_PEOPLE_CNT NUMBER(38,2),
	WINE_COMP_LIMIT_AMT NUMBER(38,2),
	ISSUE_POINT_LIMIT_AMT NUMBER(38,2),
	WINE_POINT_LIMIT_AMT NUMBER(38,2),
	ISSUE_POINT_LIMIT NUMBER(38,2),
	REDEEM_AUTHORIZATION_CD VARCHAR(7),
