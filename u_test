-- =============================================================================
-- DAASI-3641 · one-call version · UAT TEST (Monday)
-- =============================================================================
-- Run it ONE STATEMENT AT A TIME, top to bottom: cursor in the statement,
-- Ctrl+Enter (runs just that one), then check the result against the step's
-- note before going on. (Running the whole file at once goes straight through
-- the fix, the post-test and the rollback rehearsal, and shows only the last
-- result.) Any statement can be run again (step 0 always puts UAT back to the
-- before-picture). Use a NEW worksheet (so Friday's session settings don't
-- carry over). No session variables; every object is fully named. Steps 3 and
-- 7b are the long ones (about what Friday's runs took).
-- =============================================================================

-- The warehouse the procedures use; start the session on it too.
USE WAREHOUSE DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE;

-- STEP 0. Put the UAT trip tables back to Friday's before-picture: the frozen
--         clones from the runbook's 9.1 (taken at 2026-10-09 13:59:13, before
--         the first hand run). Zero-copy, seconds. This is the "clone prod data
--         to UAT" step: it is Friday's prod, which is also what Friday's
--         hand-run fix started from, so that fix is the answer key (step 6).
--         (For a fresh picture of today's prod instead, clone from
--         DAAS_PROD.DAAS_CORE.TRIP_MASTER / TRIP_DETAIL; then step 6 does not
--         apply, because prod has moved on since Friday.)
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER CLONE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TM_BEFORE;
CREATE OR REPLACE TABLE DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL CLONE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TD_BEFORE;
-- Must be 0: nothing the fix wrote is in the before-picture.
SELECT COUNT(*) AS fix_rows_in_before_picture
FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER WHERE created_by = 'DAASI-3641' OR updated_by = 'DAASI-3641';
-- Set Friday's hand-run log aside, once: the one-call version keeps its own
-- under the same name (its procedures create the six DAASI_3641_* tables on
-- first call), and step 6 reads Friday's rows from the new name. Safe to run
-- again: once DAASI_3641_LOG_MANUAL exists it does nothing.
EXECUTE IMMEDIATE $$
DECLARE
    n NUMBER DEFAULT 0;
BEGIN
    SELECT COUNT(*) INTO :n FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
    WHERE table_schema = 'DAAS_TEMP_WORK' AND table_name = 'DAASI_3641_LOG_MANUAL';
    IF (n > 0) THEN
        RETURN 'Friday''s log is already set aside as DAASI_3641_LOG_MANUAL: nothing to do.';
    END IF;
    ALTER TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG RENAME TO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG_MANUAL;
    RETURN 'Friday''s log set aside as DAASI_3641_LOG_MANUAL.';
END;
$$;
-- STARTING OVER (any later time): the reset above, then drop the one-call
-- version's own tables; the next CALL recreates them empty:
--   DROP TABLE IF EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS;
--   DROP TABLE IF EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS;
--   DROP TABLE IF EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG;
--   DROP TABLE IF EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TM;
--   DROP TABLE IF EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TD;
--   DROP TABLE IF EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK;

-- STEP 1. Deploy the five files DAASI_3641_ONECALL_UAT_<PREFLIGHT, RUN_ALL,
--         POST_CHECK, ROLLBACK, RECOVER>.sql (GitHub Actions; one procedure per
--         file, one statement each). They change no data; the six DAASI_3641_*
--         tables appear on the first call, in DAAS_UAT.DAAS_TEMP_WORK.

-- STEP 2. Pre-test. RESULT must say READY. Rows 8-11 are information in UAT (a
--         read-only look at the PROD chain: whether this role can see what
--         Pete's role will need to see). Row 12 should say none. Rows 13-14 say
--         what RUN_ALL will do; expect Friday's totals, from its log:
--           BEM 329,245 to retire / 841,952 to copy; WLM 70,252 / 142,191.
--         (The runbook's Part 4 note says 142,190 for WLM copies, one fewer.
--         The log counts what Friday actually did, and step 6 compares with
--         the log, so 142,191 is the number that matters.) Row 16 tries each
--         kind of write the procedures use (inserts and updates with bound
--         values) on a scratch table; it must say "all ran".
CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PREFLIGHT();

-- STEP 3. The fix, in one call. Expect RESULT = COMMITTED and 12 checks with
--         passed = TRUE. Retired 399,497 and created 984,143 trips, moved
--         14,596,393 detail rows (Friday's two runs added up); the exact
--         numbers are in DAASI_3641_RUNS. (The ALTER SESSION line makes sure
--         nothing cuts the call short; the default is 2 days, already plenty.)
ALTER SESSION SET STATEMENT_TIMEOUT_IN_SECONDS = 604800;
CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUN_ALL();

-- STEP 4. Post-test. Expect RESULT = PASS: in-scope trips still to fix 0 / 0,
--         over-cap trips without a hotel stay 0, BEM minus IBE and WLM minus IWA
--         detail rows 0 and 0, new trips the UAT run did not also create 0; the
--         chain rows say n/a.
CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_POST_CHECK();

-- STEP 5. Every check inside the transaction passed (a blank "passed" counts
--         as not passed). Expect no rows.
SELECT c.run_id, c.check_no, c.check_name, c.expected, c.actual, c.passed
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS c
WHERE c.phase = 'GATE' AND COALESCE(c.passed, FALSE) = FALSE
ORDER BY 1, 2;

-- STEP 6. The answer key: same input as Friday's hand-run fix, so the same
--         result. 6a: counts by action and market; every row must say "same".
--         6b: the live BEM/WLM market trips and every live detail row on them,
--         against Friday's fixed copy (DAASI_3641_TM_AFTER / _TD_AFTER), trip
--         for trip; only the new IDs differ. All six rows must be 0.
WITH one_call AS (
    SELECT l.action, l.market_cd, COUNT(*) AS n
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS r ON r.run_id = l.run_id AND r.kind = 'RUN' AND r.status = 'COMMITTED'
    GROUP BY ALL
),
friday AS (
    SELECT action, market_cd, COUNT(*) AS n
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG_MANUAL
    WHERE run_id IN ('20261009_135913', '20261009_142018')
    GROUP BY ALL
)
SELECT COALESCE(o.action, f.action) AS action,
       COALESCE(o.market_cd, f.market_cd) AS market_cd,
       f.n AS friday_hand_run,
       o.n AS one_call,
       IFF(EQUAL_NULL(o.n, f.n), 'same', 'DIFFERENT') AS verdict
FROM one_call o
FULL OUTER JOIN friday f ON f.action = o.action AND f.market_cd = o.market_cd
ORDER BY 1, 2;

WITH auto_tm AS (
    SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
    WHERE trip_type = 'MARKET' AND market_cd IN ('BEM', 'WLM') AND delete_ind = 'N'
),
friday_tm AS (
    SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TM_AFTER
    WHERE trip_type = 'MARKET' AND market_cd IN ('BEM', 'WLM') AND delete_ind = 'N'
),
auto_td AS (
    SELECT t.guest_unique_id, t.market_cd, t.trip_start_dt, t.trip_end_dt,
           d.transaction_table, d.transaction_table_sk, d.transaction_type
    FROM auto_tm t
    JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = t.trip_master_id
    WHERE d.delete_ind = 'N'
),
friday_td AS (
    SELECT t.guest_unique_id, t.market_cd, t.trip_start_dt, t.trip_end_dt,
           d.transaction_table, d.transaction_table_sk, d.transaction_type
    FROM friday_tm t
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TD_AFTER d ON d.trip_master_id = t.trip_master_id
    WHERE d.delete_ind = 'N'
)
SELECT 'trips in the one-call result, not in Friday''s' AS check_name,
       (SELECT COUNT(*) FROM (SELECT guest_unique_id, market_cd, trip_start_dt, trip_end_dt FROM auto_tm
                              MINUS
                              SELECT guest_unique_id, market_cd, trip_start_dt, trip_end_dt FROM friday_tm)) AS n
UNION ALL
SELECT 'trips in Friday''s result, not in the one-call one',
       (SELECT COUNT(*) FROM (SELECT guest_unique_id, market_cd, trip_start_dt, trip_end_dt FROM friday_tm
                              MINUS
                              SELECT guest_unique_id, market_cd, trip_start_dt, trip_end_dt FROM auto_tm))
UNION ALL
SELECT 'detail rows in the one-call result, not in Friday''s',
       (SELECT COUNT(*) FROM (SELECT * FROM auto_td MINUS SELECT * FROM friday_td))
UNION ALL
SELECT 'detail rows in Friday''s result, not in the one-call one',
       (SELECT COUNT(*) FROM (SELECT * FROM friday_td MINUS SELECT * FROM auto_td))
UNION ALL
SELECT 'live trips: one-call minus Friday''s',
       (SELECT COUNT(*) FROM auto_tm) - (SELECT COUNT(*) FROM friday_tm)
UNION ALL
SELECT 'live detail rows on them: one-call minus Friday''s',
       (SELECT COUNT(*) FROM auto_td) - (SELECT COUNT(*) FROM friday_td);

-- STEP 7. The rollback rehearsal, with the real procedure.
-- 7a. Simulate the archival step for half the retired trips (BEM): hard-delete
--     them, so ROLLBACK must bring those back from the copies it kept at retire
--     time, while it flips the WLM ones back in place.
DELETE FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL
 WHERE delete_ind = 'Y' AND updated_by = 'DAASI-3641'
   AND trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                          WHERE action = 'RETIRE' AND market_cd = 'BEM');
DELETE FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
 WHERE delete_ind = 'Y' AND updated_by = 'DAASI-3641'
   AND trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                          WHERE action = 'RETIRE' AND market_cd = 'BEM');

-- 7b. Undo the run. RESULT: ROLLED BACK.
CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_ROLLBACK('ALL');

-- 7c. Grade it against Friday's before-picture (9.4 of the runbook). All six
--     rows must be 0. This also leaves UAT back in its before state.
WITH before_tm AS (
    SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TM_BEFORE
    WHERE delete_ind = 'N' AND trip_type = 'MARKET' AND market_cd IN ('BEM', 'WLM')
),
now_tm AS (
    SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
    WHERE delete_ind = 'N' AND trip_type = 'MARKET' AND market_cd IN ('BEM', 'WLM')
),
before_td AS (
    SELECT d.trip_detail_id, d.trip_master_id, d.transaction_table,
           d.transaction_table_sk, d.transaction_type
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TD_BEFORE d
    JOIN before_tm t ON t.trip_master_id = d.trip_master_id
    WHERE d.delete_ind = 'N'
),
now_td AS (
    SELECT d.trip_detail_id, d.trip_master_id, d.transaction_table,
           d.transaction_table_sk, d.transaction_type
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    JOIN now_tm t ON t.trip_master_id = d.trip_master_id
    WHERE d.delete_ind = 'N'
)
SELECT 'BEM/WLM trips live before, not now' AS check_name,
       (SELECT COUNT(*) FROM (SELECT * FROM before_tm MINUS SELECT * FROM now_tm)) AS n
UNION ALL
SELECT 'BEM/WLM trips live now, not before',
       (SELECT COUNT(*) FROM (SELECT * FROM now_tm MINUS SELECT * FROM before_tm))
UNION ALL
SELECT 'their detail rows live before, not now',
       (SELECT COUNT(*) FROM (SELECT * FROM before_td MINUS SELECT * FROM now_td))
UNION ALL
SELECT 'their detail rows live now, not before',
       (SELECT COUNT(*) FROM (SELECT * FROM now_td MINUS SELECT * FROM before_td))
UNION ALL
SELECT 'live trips, whole table: before minus now',
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TM_BEFORE WHERE delete_ind = 'N')
     - (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER WHERE delete_ind = 'N')
UNION ALL
SELECT 'live detail rows, whole table: before minus now',
       (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TD_BEFORE WHERE delete_ind = 'N')
     - (SELECT COUNT(*) FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL WHERE delete_ind = 'N');

-- THE SCOREBOARD (any time): every call's verdict in time order, what each run
-- did, and any check that failed. After step 7 expect, in order: PREFLIGHT READY;
-- RUN: ROLLED_BACK with 399497 retired, 984143 copied, 14596393 detail rows
-- moved; GATE COMMITTED; POST1 PASS; ROLLBACK: COMMITTED; ROLLBACK ROLLED BACK;
-- and no FAILED CHECK rows.
SELECT checked_at AS at_time, 'verdict' AS what, phase AS step, actual AS detail
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
WHERE check_no = 99
UNION ALL
SELECT started_at, 'run', kind || ': ' || status,
       IFF(kind = 'RUN' AND trips_retired IS NOT NULL,
           TO_VARCHAR(trips_retired) || ' retired, ' || TO_VARCHAR(trips_copied) || ' copied, '
             || TO_VARCHAR(details_moved) || ' detail rows moved',
           LEFT(message, 100))
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
UNION ALL
SELECT checked_at, 'FAILED CHECK', phase || ' #' || TO_VARCHAR(check_no) || ': ' || check_name,
       'expected ' || COALESCE(expected, '?') || ', got ' || COALESCE(actual, '?')
FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
WHERE passed = FALSE
ORDER BY at_time, what;

-- STEP 8 (recommended: the one thing the simulator cannot prove). Rehearse a
--         cut-off call and the recovery, now that UAT is back in its before
--         state:
--   8a. In this worksheet: CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUN_ALL();
--       and about 8 to 10 minutes in, cancel it from Query History (or with
--       the worksheet's stop button). Monday's run took 17 minutes and opens
--       its transaction a few minutes in, after building the work list, so
--       this cancels it mid-transaction. DAASI_3641_RUNS shows it STARTED, the
--       lock row shows it as holder, and SHOW TRANSACTIONS; shows its
--       transaction. (Cancelled earlier, there is no transaction yet: 8b then
--       runs and says NOT READY because of the lock, and 8c still frees it.)
--   8b. Still in THIS worksheet: CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PREFLIGHT();
--       It must refuse with "this session has a transaction open" (-20657).
--       That guard is what keeps a later call from committing the cancelled
--       one's half-done work; if it does NOT refuse, stop here and tell me.
--   8c. In a NEW worksheet, as the same user:
--       CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RECOVER('<that run_id>');
--       Expect RESULT = RECOVERED, "ended <id>" in row 2, the lock released,
--       the run ABORTED, and no fix rows in TRIP_MASTER (the reset query from
--       step 0 returns 0 again).
--   8d. In the new worksheet: CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUN_ALL();
--       then CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_POST_CHECK(); (RESULT = PASS), then step 6
--       again: "same" and six zeros. This also leaves UAT in its fixed state
--       for Tracy to look at.
-- To start over at any point: step 0 again (the reset takes seconds).


