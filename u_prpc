-- =============================================================================
-- DAASI-3641 · BEM/WLM market trip history rebuild · one-call version
-- Environment: UAT
-- Built from the same template as the PROD file; the two differ only in
-- object names, the ID source, the trip chain (PROD pauses it), and backups
-- (PROD requires them; UAT works on clones and takes none).
-- =============================================================================
-- THE RUN, in order. Every step is one call; no session variables.
--
--   The steps, with what to expect at each, are in daasi_3641_onecall_uat_test.sql:
--   reset the clones, deploy this file, PREFLIGHT, RUN_ALL, POST_CHECK, the
--   comparison with Friday's hand-run fix, then the rollback rehearsal.
--
-- If it has to be undone (one run, or everything the fix has done):
--     CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_ROLLBACK('ALL');          -- or a run_id from DAASI_3641_RUNS
-- If a call was cancelled or stopped by a statement timeout (it then still holds
-- the run lock), in a NEW worksheet, as the same user:
--     CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RECOVER('<run_id>');
-- Where things stand:
--     SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS ORDER BY started_at DESC;
--     SELECT * FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS ORDER BY checked_at DESC, check_no;
--
-- WHAT RUN_ALL DOES, in one call, with no stops: switches the session to
-- DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE and Pacific time (the time zone the trip tables are
-- written in); takes the run lock (one run at a time);
-- builds the work list (every BEM/WLM market trip without an identical property
-- trip, and every IBE/IWA property trip without an identical market trip,
-- grouped into "islands" of overlapping trips per guest; an island is in scope
-- when it holds a market trip built before the 2026-08-12 11:16:26 config
-- change); then, in ONE transaction: logs the work, keeps an exact copy of every
-- row it is about to retire, creates the new market trips (copies of the
-- property trips, with every live detail row), retires the old market trips
-- (detail rows first), and runs 12 checks on the result. It commits only if
-- every check passes; otherwise it rolls back and nothing is kept. Afterwards
-- it releases the lock and returns the check results.
-- It does not stop for anything short of a failed check or an error. Expect
-- about the time Friday's UAT runs took, on the same warehouse.
-- An optional window limits it to islands that START in [from, to):
--     CALL DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUN_ALL('2026-07-01', '2026-08-01');   -- July 2026 only
--
-- Calls need a session on warehouse DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE with
-- AUTOCOMMIT on (the Snowflake default; the procedures refuse to start
-- otherwise) and no transaction open. The procedures set the session to Pacific
-- time, TRANSACTION_ABORT_ON_ERROR = FALSE, LOCK_TIMEOUT = 900 and the longest
-- statement timeout allowed, and leave them that way.
--
-- Privileges: every procedure runs as the caller (EXECUTE AS CALLER), so the
-- caller's role needs what the manual runbook needed: DML on the two trip
-- tables, CREATE TABLE in DAAS_UAT.DAAS_TEMP_WORK, and
-- USAGE on the warehouse. PREFLIGHT checks what it can without writing.
-- Redeploying is safe: tables are created only if missing, and the procedures
-- are replaced with their grants kept.
--
-- UAT: the trip tables are the zero-copy clones in DAAS_UAT.DAAS_TEMP_WORK.
-- There is no trip chain to pause (PREFLIGHT still takes a read-only look at
-- the PROD chain, for information), new IDs continue from the clones' highest
-- IDs (no sequences here), and no backups are taken: the clones are the copy.
-- =============================================================================


-- -----------------------------------------------------------------------------
-- 1. TABLES
-- -----------------------------------------------------------------------------
-- One row per call of RUN_ALL or ROLLBACK.
CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS (
    run_id          VARCHAR(20),
    kind            VARCHAR(10),      -- RUN or ROLLBACK
    from_dt         DATE,
    to_dt           DATE,
    status          VARCHAR(20),      -- STARTED, COMMITTED, NOTHING_TO_DO, CHECKS_FAILED, CHAIN_BUSY,
                                      -- CHAIN_PAUSED, LOCK_BUSY, ERROR, ABORTED, ROLLED_BACK
    chain_paused    BOOLEAN,          -- TRUE while this run holds the trip chain paused
    started_at      TIMESTAMP_LTZ,
    committed_at    TIMESTAMP_LTZ,
    finished_at     TIMESTAMP_LTZ,
    trips_retired   NUMBER(38,0),
    trips_copied    NUMBER(38,0),
    details_moved   NUMBER(38,0),
    scan_from       DATE,
    scan_to         DATE,
    run_by          VARCHAR(200),
    session_id      VARCHAR(100),     -- the Snowflake session that ran it (RECOVER uses it)
    message         VARCHAR(4000)
);

-- Every check result: GATE (inside the transaction, before the commit), POST1 /
-- POST3 (the post-test, before / after 72 hours), ROLLBACK, PREFLIGHT, RECOVER.
CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (
    run_id          VARCHAR(20),
    phase           VARCHAR(10),
    check_no        NUMBER(4,0),
    check_name      VARCHAR(200),
    expected        VARCHAR(100),
    actual          VARCHAR(100),
    passed          BOOLEAN,          -- NULL = information only
    checked_at      TIMESTAMP_LTZ
);

-- Every trip each run retired or copied.
CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG (
    run_id             VARCHAR(20),
    logged_at          TIMESTAMP_NTZ,
    from_dt            DATE,
    to_dt              DATE,
    action             VARCHAR(10),
    trip_master_id     NUMBER(38,0),  -- RETIRE: the old market trip.  COPY: the source property trip.
    new_trip_master_id NUMBER(38,0),  -- COPY only: the new market trip
    market_cd          VARCHAR(100),
    trip_start_dt      DATE,
    trip_end_dt        DATE
);

-- Exact copies of every row a run retired, taken inside its transaction just
-- before the retire. ROLLBACK restores from these, so it is exact even after
-- the archival step has removed the originals.
CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TM AS
SELECT CAST(NULL AS VARCHAR(20)) AS run_id, t.*
FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
WHERE FALSE;

CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TD AS
SELECT CAST(NULL AS VARCHAR(20)) AS run_id, d.*
FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
WHERE FALSE;

-- One row: which run holds the "one run at a time" lock.
CREATE TABLE IF NOT EXISTS DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK (
    holder          VARCHAR(20),
    since           TIMESTAMP_LTZ
);
INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK (holder, since)
SELECT NULL, NULL
WHERE NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK);


-- -----------------------------------------------------------------------------
-- 2. PREFLIGHT: the pre-test. Read-only apart from its own rows in
--    DAASI_3641_CHECKS (it builds the work list in a temporary table, so it takes
--    a few minutes on the Large warehouse). RESULT must say READY. Rows with an
--    empty "passed" are information: among them, what RUN_ALL will do, by market.
-- -----------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_PREFLIGHT()
COPY GRANTS
RETURNS TABLE (CHECK_NAME VARCHAR, EXPECTED VARCHAR, ACTUAL VARCHAR, PASSED BOOLEAN)
LANGUAGE SQL
COMMENT = 'DAASI-3641: the pre-test. Changes nothing except adding its own rows to DAASI_3641_CHECKS. RESULT must say READY.'
EXECUTE AS CALLER
AS
$$
DECLARE
    v_has_chain     BOOLEAN DEFAULT FALSE;
    v_has_backup    BOOLEAN DEFAULT FALSE;
    v_id            VARCHAR;
    v_val           VARCHAR;
    v_n             NUMBER DEFAULT 0;
    v_m             NUMBER DEFAULT 0;
    v_k             NUMBER DEFAULT 0;
    v_ts            TIMESTAMP_LTZ;
    v_ts2           TIMESTAMP_LTZ;
    v_failed        NUMBER DEFAULT 0;
    v_timeout_s     NUMBER DEFAULT 0;
    v_wh_timeout_s  NUMBER DEFAULT -1;
    v_call_wh       VARCHAR;
BEGIN
    v_id := 'PF' || TO_VARCHAR(CURRENT_TIMESTAMP(), 'YYYYMMDD_HH24MISSFF3');
    v_call_wh := CURRENT_WAREHOUSE();
    EXECUTE IMMEDIATE 'ALTER SESSION SET TIMEZONE = ''America/Los_Angeles''';

    -- 1. AUTOCOMMIT on (every procedure refuses to start without it)
    SHOW PARAMETERS LIKE 'AUTOCOMMIT' IN SESSION;
    SELECT LOWER(MAX("value")) INTO :v_val FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    VALUES (:v_id, 'PREFLIGHT', 1, 'Session AUTOCOMMIT', 'true', COALESCE(:v_val, 'unknown'),
            COALESCE(:v_val, 'true') = 'true', CURRENT_TIMESTAMP());

    -- 2. the warehouse the run uses (start the call on it too)
    BEGIN
        EXECUTE IMMEDIATE 'USE WAREHOUSE DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE';
        v_val := CURRENT_WAREHOUSE();
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES (:v_id, 'PREFLIGHT', 2, 'Warehouse the run uses (start the call on it too)', 'DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE',
                LEFT(COALESCE(:v_val, 'none') || ' (this call started on ' || COALESCE(:v_call_wh, 'none') || ')', 100),
                COALESCE(:v_val, '') = 'DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE', CURRENT_TIMESTAMP());
    EXCEPTION
        WHEN OTHER THEN
            v_val := LEFT(SQLERRM, 100);
            INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
            VALUES (:v_id, 'PREFLIGHT', 2, 'Warehouse the run uses (start the call on it too)', 'DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE', :v_val, FALSE, CURRENT_TIMESTAMP());
    END;

    -- 3. the statement timeout in force (the run must not be cut off partway)
    SHOW PARAMETERS LIKE 'STATEMENT_TIMEOUT_IN_SECONDS' IN SESSION;
    SELECT COALESCE(MAX(TRY_TO_NUMBER("value")), 0) INTO :v_timeout_s FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
    BEGIN
        SHOW PARAMETERS LIKE 'STATEMENT_TIMEOUT_IN_SECONDS' IN WAREHOUSE DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE;
        SELECT COALESCE(MAX(TRY_TO_NUMBER("value")), 0) INTO :v_wh_timeout_s FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
    EXCEPTION
        WHEN OTHER THEN
            v_wh_timeout_s := -1;
    END;
    IF (v_wh_timeout_s > 0 AND (v_timeout_s = 0 OR v_wh_timeout_s < v_timeout_s)) THEN
        v_timeout_s := v_wh_timeout_s;
    END IF;
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    VALUES (:v_id, 'PREFLIGHT', 3, 'Statement timeout in force (session and warehouse)', 'at least 4 hours',
            LEFT(IFF(:v_timeout_s = 0, 'none (the 7-day maximum applies)', TO_VARCHAR(FLOOR(:v_timeout_s / 3600)::INTEGER) || ' hour(s)')
              || IFF(:v_wh_timeout_s < 0, '; could not read the warehouse''s', ''), 100),
            :v_timeout_s = 0 OR :v_timeout_s >= 14400, CURRENT_TIMESTAMP());

    -- 4. the run lock: one row, free
    SELECT COUNT(*), MAX(holder) INTO :v_n, :v_val FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK;
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    VALUES (:v_id, 'PREFLIGHT', 4, 'Run lock', '1 row, free',
            TO_VARCHAR(:v_n) || ' row(s), ' || COALESCE('held by run ' || :v_val, 'free'),
            :v_n = 1 AND :v_val IS NULL, CURRENT_TIMESTAMP());

    -- 5. the trip tables
    BEGIN
        SELECT (SELECT COUNT(*) FROM (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER LIMIT 1))
             + (SELECT COUNT(*) FROM (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL LIMIT 1))
        INTO :v_n;
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES (:v_id, 'PREFLIGHT', 5, 'Trip tables readable, with rows', '2 of 2', TO_VARCHAR(:v_n) || ' of 2',
                :v_n = 2, CURRENT_TIMESTAMP());
    EXCEPTION
        WHEN OTHER THEN
            v_val := LEFT(SQLERRM, 100);
            INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
            VALUES (:v_id, 'PREFLIGHT', 5, 'Trip tables readable, with rows', '2 of 2', :v_val, FALSE, CURRENT_TIMESTAMP());
    END;

    -- 6. the kept-copy tables still have the trip tables' columns, same names in the
    --    same order after run_id (a column added to a trip table after deploying
    --    would make the copy and restore steps fail)
    BEGIN
        SELECT COUNT(*) INTO :v_n
        FROM (SELECT pos, col
              FROM (SELECT ordinal_position AS pos, column_name AS col
                    FROM DAAS_UAT.INFORMATION_SCHEMA.COLUMNS
                    WHERE table_schema = 'DAAS_TEMP_WORK' AND table_name = 'TRIP_MASTER'
                    UNION ALL
                    SELECT ordinal_position - 1, column_name
                    FROM DAAS_UAT.INFORMATION_SCHEMA.COLUMNS
                    WHERE table_schema = 'DAAS_TEMP_WORK' AND table_name = 'DAASI_3641_RETIRED_TM' AND column_name <> 'RUN_ID')
              GROUP BY pos, col HAVING COUNT(*) <> 2);
        SELECT COUNT(*) INTO :v_m
        FROM (SELECT pos, col
              FROM (SELECT ordinal_position AS pos, column_name AS col
                    FROM DAAS_UAT.INFORMATION_SCHEMA.COLUMNS
                    WHERE table_schema = 'DAAS_TEMP_WORK' AND table_name = 'TRIP_DETAIL'
                    UNION ALL
                    SELECT ordinal_position - 1, column_name
                    FROM DAAS_UAT.INFORMATION_SCHEMA.COLUMNS
                    WHERE table_schema = 'DAAS_TEMP_WORK' AND table_name = 'DAASI_3641_RETIRED_TD' AND column_name <> 'RUN_ID')
              GROUP BY pos, col HAVING COUNT(*) <> 2);
        SELECT COUNT(*) INTO :v_k FROM DAAS_UAT.INFORMATION_SCHEMA.COLUMNS
        WHERE table_schema = 'DAAS_TEMP_WORK' AND table_name IN ('TRIP_MASTER', 'TRIP_DETAIL');
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES (:v_id, 'PREFLIGHT', 6, 'Kept-copy tables match the trip tables (column names and order)', '0 differences',
                TO_VARCHAR(:v_n + :v_m) || ' difference(s); ' || TO_VARCHAR(:v_k) || ' trip-table columns seen',
                :v_n + :v_m = 0 AND :v_k > 0, CURRENT_TIMESTAMP());
    EXCEPTION
        WHEN OTHER THEN
            v_val := LEFT(SQLERRM, 100);
            INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
            VALUES (:v_id, 'PREFLIGHT', 6, 'Kept-copy tables match the trip tables (column names and order)', '0 differences', :v_val,
                    FALSE, CURRENT_TIMESTAMP());
    END;

    -- 7. backups (PROD: the clones BACKUP takes, within the last 2 days; UAT: none needed)
    IF (v_has_backup) THEN
        BEGIN
            SELECT MAX(created) INTO :v_ts FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
            WHERE table_schema = 'DAAS_TEMP_WORK' AND LEFT(table_name, 23) = 'TRIP_MASTER_DAASI_3641_';
            SELECT MAX(created) INTO :v_ts2 FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
            WHERE table_schema = 'DAAS_TEMP_WORK' AND LEFT(table_name, 23) = 'TRIP_DETAIL_DAASI_3641_';
            INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
            VALUES (:v_id, 'PREFLIGHT', 7, 'Backups of the trip tables taken in the last 2 days', 'yes',
                    'TRIP_MASTER: ' || COALESCE(TO_VARCHAR(:v_ts, 'YYYY-MM-DD HH24:MI'), 'none')
                      || ', TRIP_DETAIL: ' || COALESCE(TO_VARCHAR(:v_ts2, 'YYYY-MM-DD HH24:MI'), 'none'),
                    COALESCE(:v_ts >= DATEADD(hour, -48, CURRENT_TIMESTAMP()), FALSE)
                    AND COALESCE(:v_ts2 >= DATEADD(hour, -48, CURRENT_TIMESTAMP()), FALSE), CURRENT_TIMESTAMP());
        EXCEPTION
            WHEN OTHER THEN
                v_val := LEFT(SQLERRM, 100);
                INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
                VALUES (:v_id, 'PREFLIGHT', 7, 'Backups of the trip tables taken in the last 2 days', 'yes', :v_val,
                        FALSE, CURRENT_TIMESTAMP());
        END;
    ELSE
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES (:v_id, 'PREFLIGHT', 7, 'Backups of the trip tables taken in the last 2 days', 'n/a',
                'n/a (UAT works on clones)', NULL, CURRENT_TIMESTAMP());
    END IF;

    -- 8-11. The trip chain and the tables it feeds. In PROD these must pass. In
    --       UAT (no chain to pause) they are a read-only look at the PROD chain,
    --       for information: they show whether this role can see what PROD needs.
    BEGIN
        SHOW TASKS LIKE 'TRIP_ROOT_TASK' IN SCHEMA DAAS_PROD.DAAS_COMMON;
        SELECT MAX("state") INTO :v_val FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES (:v_id, 'PREFLIGHT', 8, 'Trip chain root task visible and running', 'started',
                COALESCE(:v_val, 'not visible to this role'),
                IFF(:v_has_chain, COALESCE(:v_val = 'started', FALSE), NULL), CURRENT_TIMESTAMP());
    EXCEPTION
        WHEN OTHER THEN
            v_val := LEFT(SQLERRM, 100);
            INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
            VALUES (:v_id, 'PREFLIGHT', 8, 'Trip chain root task visible and running', 'started', :v_val,
                    IFF(:v_has_chain, FALSE, NULL), CURRENT_TIMESTAMP());
    END;

    BEGIN
        SELECT COUNT(*) INTO :v_n
        FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.CURRENT_TASK_GRAPHS(ROOT_TASK_NAME => 'TRIP_ROOT_TASK'))
        WHERE database_name = 'DAAS_PROD' AND schema_name = 'DAAS_COMMON' AND state = 'EXECUTING';
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES (:v_id, 'PREFLIGHT', 9, 'Trip chain runs in progress readable', 'readable',
                TO_VARCHAR(:v_n) || ' running now', IFF(:v_has_chain, TRUE, NULL), CURRENT_TIMESTAMP());
    EXCEPTION
        WHEN OTHER THEN
            v_val := LEFT(SQLERRM, 100);
            INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
            VALUES (:v_id, 'PREFLIGHT', 9, 'Trip chain runs in progress readable', 'readable', :v_val,
                    IFF(:v_has_chain, FALSE, NULL), CURRENT_TIMESTAMP());
    END;

    -- (the post-test waits for a finished chain run after the commit, so this
    --  role must be able to see the chain's history)
    BEGIN
        SELECT MAX(completed_time) INTO :v_ts
        FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.TASK_HISTORY(
                 SCHEDULED_TIME_RANGE_START => DATEADD(hour, -6, CURRENT_TIMESTAMP()),
                 RESULT_LIMIT => 10000,
                 TASK_NAME => 'TRIP_ROOT_TASK'))
        WHERE database_name = 'DAAS_PROD' AND schema_name = 'DAAS_COMMON' AND state = 'SUCCEEDED';
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES (:v_id, 'PREFLIGHT', 10, 'Trip chain finished a run in the last 2 hours', 'yes',
                COALESCE('last at ' || TO_VARCHAR(:v_ts, 'YYYY-MM-DD HH24:MI'), 'none seen in 6 hours'),
                IFF(:v_has_chain, COALESCE(:v_ts >= DATEADD(hour, -2, CURRENT_TIMESTAMP()), FALSE), NULL),
                CURRENT_TIMESTAMP());
    EXCEPTION
        WHEN OTHER THEN
            v_val := LEFT(SQLERRM, 100);
            INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
            VALUES (:v_id, 'PREFLIGHT', 10, 'Trip chain finished a run in the last 2 hours', 'yes', :v_val,
                    IFF(:v_has_chain, FALSE, NULL), CURRENT_TIMESTAMP());
    END;

    BEGIN
        SELECT (SELECT COUNT(*) FROM (SELECT trip_master_id FROM DAAS_PROD.DAAS_CORE.TRIP_SUMMARY_DT WHERE FALSE))
             + (SELECT COUNT(*) FROM (SELECT trip_master_id FROM DAAS_PROD.DAAS_CORE_MARKETING_VW.TRIP_SUMMARY_VW WHERE FALSE))
             + (SELECT COUNT(*) FROM (SELECT trip_master_id FROM DAAS_PROD.DAAS_TIBCO_DWS.TRIP_SUMMARY WHERE FALSE))
             + (SELECT COUNT(*) FROM (SELECT trip_master_id FROM DAAS_PROD.DAAS_TIBCO_DWS.TRIP_SUMMARY_18MO WHERE FALSE))
             + (SELECT COUNT(*) FROM (SELECT trip_master_id FROM DAAS_PROD.DAAS_TIBCO_SMART.TRIP_SUMMARY WHERE FALSE))
             + (SELECT COUNT(*) FROM (SELECT trip_master_id FROM DAAS_PROD.DAAS_CORE.DAILY_ACTIVITY_SUMMARY WHERE FALSE))
             + (SELECT COUNT(*) FROM (SELECT trip_master_id FROM DAAS_PROD.DAAS_CORE.DAAS_TRIP_NUM_GAP_DAILY_METRIC_MKTENT WHERE FALSE))
        INTO :v_n;
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES (:v_id, 'PREFLIGHT', 11, 'Downstream tables the post-test reads', '7 readable', '7 readable',
                IFF(:v_has_chain, TRUE, NULL), CURRENT_TIMESTAMP());
    EXCEPTION
        WHEN OTHER THEN
            v_val := LEFT(SQLERRM, 100);
            INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
            VALUES (:v_id, 'PREFLIGHT', 11, 'Downstream tables the post-test reads', '7 readable', :v_val,
                    IFF(:v_has_chain, FALSE, NULL), CURRENT_TIMESTAMP());
    END;

    -- 12. a call made inside an open transaction would not behave (information)
    v_val := CURRENT_TRANSACTION();
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    VALUES (:v_id, 'PREFLIGHT', 12, 'Open transaction in this session (call with none open)', 'none',
            COALESCE(:v_val, 'none'), NULL, CURRENT_TIMESTAMP());

    -- 13-14. What RUN_ALL will do, by market (information). The same work list
    --        RUN_ALL builds; compare with the UAT run's numbers.
    CREATE OR REPLACE TEMPORARY TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_PREVIEW AS
    WITH prop AS (
        SELECT trip_master_id, guest_unique_id,
               DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd,
               trip_start_dt, trip_end_dt
        FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        WHERE trip_type = 'PROPERTY' AND delete_ind = 'N' AND property_cd IN ('IBE', 'IWA')
    ),
    mkt AS (
        SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt, created_dttm
        FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        WHERE trip_type = 'MARKET' AND delete_ind = 'N' AND market_cd IN ('BEM', 'WLM')
    ),
    twinless AS (
        SELECT 'RETIRE' AS action,
               m.trip_master_id, m.guest_unique_id, m.market_cd, m.trip_start_dt, m.trip_end_dt,
               IFF(m.created_dttm < '2026-08-12 11:16:26', 1, 0) AS is_seed
        FROM mkt m
        WHERE NOT EXISTS (SELECT 1 FROM prop p
                          WHERE p.market_cd = m.market_cd AND p.guest_unique_id = m.guest_unique_id
                            AND p.trip_start_dt = m.trip_start_dt AND p.trip_end_dt = m.trip_end_dt)
        UNION ALL
        SELECT 'COPY',
               p.trip_master_id, p.guest_unique_id, p.market_cd, p.trip_start_dt, p.trip_end_dt,
               0
        FROM prop p
        WHERE NOT EXISTS (SELECT 1 FROM mkt m
                          WHERE m.market_cd = p.market_cd AND m.guest_unique_id = p.guest_unique_id
                            AND m.trip_start_dt = p.trip_start_dt AND m.trip_end_dt = p.trip_end_dt)
    ),
    running AS (
        SELECT t.*,
               MAX(trip_end_dt) OVER (PARTITION BY guest_unique_id, market_cd
                                      ORDER BY trip_start_dt, trip_end_dt, trip_master_id
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_max_end
        FROM twinless t
    ),
    starts AS (
        SELECT r.*,
               IFF(LAG(run_max_end) OVER (PARTITION BY guest_unique_id, market_cd
                                          ORDER BY trip_start_dt, trip_end_dt, trip_master_id)
                   >= trip_start_dt, 0, 1) AS new_island
        FROM running r
    ),
    islands AS (
        SELECT s.*,
               SUM(new_island) OVER (PARTITION BY guest_unique_id, market_cd
                                     ORDER BY trip_start_dt, trip_end_dt, trip_master_id
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS island_no
        FROM starts s
    )
    SELECT action, trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt, island_no,
           MIN(trip_start_dt) OVER (PARTITION BY guest_unique_id, market_cd, island_no) AS island_start_dt,
           MAX(is_seed)       OVER (PARTITION BY guest_unique_id, market_cd, island_no) AS in_scope
    FROM islands;
    SELECT COUNT_IF(in_scope = 1 AND action = 'RETIRE'), COUNT_IF(in_scope = 1 AND action = 'COPY'), COUNT_IF(in_scope = 0)
    INTO :v_n, :v_m, :v_k
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_PREVIEW WHERE market_cd = 'BEM';
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    VALUES (:v_id, 'PREFLIGHT', 13, 'BEM: market trips to retire / property trips to copy / out of scope (information)',
            'compare with UAT', TO_VARCHAR(:v_n) || ' / ' || TO_VARCHAR(:v_m) || ' / ' || TO_VARCHAR(:v_k), NULL, CURRENT_TIMESTAMP());
    SELECT COUNT_IF(in_scope = 1 AND action = 'RETIRE'), COUNT_IF(in_scope = 1 AND action = 'COPY'), COUNT_IF(in_scope = 0)
    INTO :v_n, :v_m, :v_k
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_PREVIEW WHERE market_cd = 'WLM';
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    VALUES (:v_id, 'PREFLIGHT', 14, 'WLM: market trips to retire / property trips to copy / out of scope (information)',
            'compare with UAT', TO_VARCHAR(:v_n) || ' / ' || TO_VARCHAR(:v_m) || ' / ' || TO_VARCHAR(:v_k), NULL, CURRENT_TIMESTAMP());

    -- 15. PROD: the two sequences the run draws new IDs from are visible to this role
    IF (v_has_backup) THEN
        BEGIN
            SELECT COUNT(*) INTO :v_n FROM DAAS_UAT.INFORMATION_SCHEMA.SEQUENCES
            WHERE sequence_schema = 'DAAS_TEMP_WORK' AND sequence_name IN ('TRIP_MASTER_SEQ', 'TRIP_DETAIL_SEQ');
            INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
            VALUES (:v_id, 'PREFLIGHT', 15, 'Trip ID sequences visible to this role', '2 of 2', TO_VARCHAR(:v_n) || ' of 2',
                    :v_n = 2, CURRENT_TIMESTAMP());
        EXCEPTION
            WHEN OTHER THEN
                v_val := LEFT(SQLERRM, 100);
                INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
                VALUES (:v_id, 'PREFLIGHT', 15, 'Trip ID sequences visible to this role', '2 of 2', :v_val, FALSE, CURRENT_TIMESTAMP());
        END;
    ELSE
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES (:v_id, 'PREFLIGHT', 15, 'Trip ID sequences visible to this role', 'n/a', 'n/a (UAT continues from the clones'' highest IDs)',
                NULL, CURRENT_TIMESTAMP());
    END IF;

    SELECT COUNT_IF(passed = FALSE) INTO :v_failed
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
    WHERE run_id = :v_id AND phase = 'PREFLIGHT';
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    VALUES (:v_id, 'PREFLIGHT', 99, 'RESULT', 'READY',
            IFF(:v_failed = 0, 'READY', 'NOT READY: ' || TO_VARCHAR(:v_failed) || ' check(s) failed'),
            :v_failed = 0, CURRENT_TIMESTAMP());

    LET rs RESULTSET := (SELECT check_name, expected, actual, passed
                         FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
                         WHERE run_id = :v_id ORDER BY check_no);
    RETURN TABLE(rs);
END;
$$;


-- -----------------------------------------------------------------------------
-- 3. RUN_ALL: the fix, in one call. See the top of the file.
-- -----------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUN_ALL(P_FROM_DT DATE DEFAULT '1900-01-01'::DATE, P_TO_DT DATE DEFAULT '2100-01-01'::DATE)
COPY GRANTS
RETURNS TABLE (CHECK_NAME VARCHAR, EXPECTED VARCHAR, ACTUAL VARCHAR, PASSED BOOLEAN)
LANGUAGE SQL
COMMENT = 'DAASI-3641: rebuilds the BEM/WLM market trips of every in-scope island (that starts in [P_FROM_DT, P_TO_DT); the defaults cover everything) in one transaction. Commits only if every check passes.'
EXECUTE AS CALLER
AS
$$
DECLARE
    v_has_chain      BOOLEAN DEFAULT FALSE;
    v_has_backup     BOOLEAN DEFAULT FALSE;
    v_autocommit     VARCHAR;
    v_run_id         VARCHAR;
    v_err            VARCHAR;
    v_task_state     VARCHAR;
    v_locked         BOOLEAN DEFAULT FALSE;
    v_logged         BOOLEAN DEFAULT FALSE;
    v_holds_lock     BOOLEAN DEFAULT FALSE;
    v_chain_paused   BOOLEAN DEFAULT FALSE;
    v_resumed        BOOLEAN DEFAULT TRUE;
    v_in_txn         BOOLEAN DEFAULT FALSE;
    v_n              NUMBER DEFAULT 0;
    v_waited         NUMBER DEFAULT 0;
    v_bk_tm          TIMESTAMP_LTZ;
    v_bk_td          TIMESTAMP_LTZ;
    v_scan_from      DATE;
    v_scan_to        DATE;
    v_commit_ts      TIMESTAMP_LTZ;
    v_g62_before     NUMBER DEFAULT 0;
    v_g62_after      NUMBER DEFAULT 0;
    v_retire_planned NUMBER DEFAULT 0;
    v_retire_done    NUMBER DEFAULT 0;
    v_copy_planned   NUMBER DEFAULT 0;
    v_copy_done      NUMBER DEFAULT 0;
    v_dup_trip_ids   NUMBER DEFAULT 0;
    v_dup_detail_ids NUMBER DEFAULT 0;
    v_left_on_old    NUMBER DEFAULT 0;
    v_src_details    NUMBER DEFAULT 0;
    v_new_details    NUMBER DEFAULT 0;
    v_dropped        NUMBER DEFAULT 0;
    v_ratings_net    NUMBER DEFAULT 0;
    v_over_cap       NUMBER DEFAULT 0;
    v_arch_tm        NUMBER DEFAULT 0;
    v_arch_td        NUMBER DEFAULT 0;
    v_retired_tm     NUMBER DEFAULT 0;
    v_retired_td     NUMBER DEFAULT 0;
    v_dup_twins      NUMBER DEFAULT 0;
    v_failed         NUMBER DEFAULT 0;
    e_checks_failed  EXCEPTION (-20641, 'DAASI-3641: a check failed inside the transaction, so nothing was committed. Details: DAASI_3641_CHECKS, latest run.');
    e_chain_busy     EXCEPTION (-20642, 'DAASI-3641: the trip chain stayed busy for an hour, so nothing was changed and the chain was resumed. Try again later.');
    e_run_active     EXCEPTION (-20643, 'DAASI-3641: another run holds the run lock (DAASI_3641_LOCK shows which). Nothing was changed. If that run was cancelled or timed out: CALL DAASI_3641_RECOVER(''<run_id>'').');
    e_bad_window     EXCEPTION (-20644, 'DAASI-3641: P_FROM_DT must be earlier than P_TO_DT.');
    e_no_chain       EXCEPTION (-20645, 'DAASI-3641: cannot see the trip root task, so the chain cannot be paused. Nothing was changed. Check that this role has OPERATE on it.');
    e_autocommit     EXCEPTION (-20650, 'DAASI-3641: this session has AUTOCOMMIT off. Run ALTER SESSION SET AUTOCOMMIT = TRUE; and call again. Nothing was changed.');
    e_chain_paused   EXCEPTION (-20651, 'DAASI-3641: the trip chain is already paused by someone else, so nothing was changed. Run again once it is resumed.');
    e_superseded     EXCEPTION (-20655, 'DAASI-3641: RECOVER had closed this run as cut off before it could commit, so it rolled back. Nothing was kept.');
    e_no_backup      EXCEPTION (-20658, 'DAASI-3641: no backup clones of TRIP_MASTER and TRIP_DETAIL from the last 2 days in the backup schema. Run CALL DAASI_3641_BACKUP(); first. Nothing was changed.');
BEGIN
    SHOW PARAMETERS LIKE 'AUTOCOMMIT' IN SESSION;
    SELECT MAX("value") INTO :v_autocommit FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
    IF (LOWER(COALESCE(v_autocommit, 'true')) <> 'true') THEN
        RAISE e_autocommit;
    END IF;
    IF (P_FROM_DT IS NULL OR P_TO_DT IS NULL OR P_FROM_DT >= P_TO_DT) THEN
        RAISE e_bad_window;
    END IF;

    -- Pacific time (as the trip tables are written), the Large warehouse, a lock
    -- held by someone else fails the run instead of stalling it, a failed
    -- statement leaves the transaction open for the handler to roll back, and the
    -- longest statement timeout the account allows (nothing cuts the run short).
    EXECUTE IMMEDIATE 'ALTER SESSION SET TIMEZONE = ''America/Los_Angeles''';
    IF (COALESCE(CURRENT_WAREHOUSE(), '') <> 'DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE') THEN
        EXECUTE IMMEDIATE 'USE WAREHOUSE DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE';
    END IF;
    EXECUTE IMMEDIATE 'ALTER SESSION SET LOCK_TIMEOUT = 900';
    EXECUTE IMMEDIATE 'ALTER SESSION SET TRANSACTION_ABORT_ON_ERROR = FALSE';
    BEGIN
        EXECUTE IMMEDIATE 'ALTER SESSION SET STATEMENT_TIMEOUT_IN_SECONDS = 604800';
    EXCEPTION
        WHEN OTHER THEN
            v_n := 0;
    END;

    -- PROD: the backups are the manual step before this call; refuse without them.
    IF (v_has_backup) THEN
        SELECT MAX(created) INTO :v_bk_tm FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
        WHERE table_schema = 'DAAS_TEMP_WORK' AND LEFT(table_name, 23) = 'TRIP_MASTER_DAASI_3641_';
        SELECT MAX(created) INTO :v_bk_td FROM DAAS_UAT.INFORMATION_SCHEMA.TABLES
        WHERE table_schema = 'DAAS_TEMP_WORK' AND LEFT(table_name, 23) = 'TRIP_DETAIL_DAASI_3641_';
        IF (v_bk_tm IS NULL OR v_bk_td IS NULL
            OR v_bk_tm < DATEADD(hour, -48, CURRENT_TIMESTAMP()) OR v_bk_td < DATEADD(hour, -48, CURRENT_TIMESTAMP())) THEN
            RAISE e_no_backup;
        END IF;
    END IF;

    -- The run's record first, then the lock (one run at a time: an atomic
    -- test-and-set on the lock row), so the lock is never held without a record.
    v_run_id := TO_VARCHAR(CURRENT_TIMESTAMP(), 'YYYYMMDD_HH24MISSFF3');
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
        (run_id, kind, from_dt, to_dt, status, chain_paused, started_at, run_by, session_id, message)
    VALUES
        (:v_run_id, 'RUN', :P_FROM_DT, :P_TO_DT, 'STARTED', FALSE, CURRENT_TIMESTAMP(), CURRENT_USER(),
         CURRENT_SESSION(), 'Started.');
    v_logged := TRUE;
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = :v_run_id, since = CURRENT_TIMESTAMP() WHERE holder IS NULL;
    IF (SQLROWCOUNT = 0) THEN
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = 'LOCK_BUSY', finished_at = CURRENT_TIMESTAMP(), message = 'Another run held the lock; nothing was done.'
         WHERE run_id = :v_run_id;
        RAISE e_run_active;
    END IF;
    v_locked := TRUE;

    -- Pause the trip chain, then wait until no run of it is still going (an hour
    -- at most). A run already going finishes normally; the next one waits for us.
    IF (v_has_chain) THEN
        SHOW TASKS LIKE 'TRIP_ROOT_TASK' IN SCHEMA DAAS_PROD.DAAS_COMMON;
        SELECT MAX("state") INTO :v_task_state FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
        IF (v_task_state IS NULL) THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'ERROR', message = 'Trip root task not visible to this role'
             WHERE run_id = :v_run_id;
            RAISE e_no_chain;
        END IF;
        IF (v_task_state <> 'started') THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'CHAIN_PAUSED', message = 'The trip chain was already paused.'
             WHERE run_id = :v_run_id;
            RAISE e_chain_paused;
        END IF;
        -- recorded before the pause, so RECOVER knows this run paused it
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET chain_paused = TRUE WHERE run_id = :v_run_id;
        v_resumed := FALSE;
        ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK SUSPEND;
        v_chain_paused := TRUE;
        LOOP
            SELECT COUNT(*) INTO :v_n
            FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.CURRENT_TASK_GRAPHS(ROOT_TASK_NAME => 'TRIP_ROOT_TASK'))
            WHERE database_name = 'DAAS_PROD' AND schema_name = 'DAAS_COMMON' AND state = 'EXECUTING';
            IF (v_n = 0) THEN
                BREAK;
            END IF;
            IF (v_waited >= 3600) THEN
                UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'CHAIN_BUSY' WHERE run_id = :v_run_id;
                RAISE e_chain_busy;
            END IF;
            SELECT SYSTEM$WAIT(30);
            v_waited := v_waited + 30;
        END LOOP;
    END IF;

    -- Baseline for "nothing lost, nothing doubled" (6.2 in the runbook).
    SELECT COUNT_IF(m.sk IS NULL) + COUNT_IF(p.sk IS NULL) + COUNT_IF(m.trips <> p.trips)
    INTO :v_g62_before
    FROM (SELECT td.transaction_table_sk AS sk, COUNT(DISTINCT tm.trip_master_id) AS trips
          FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL td ON td.trip_master_id = tm.trip_master_id
          WHERE tm.trip_type = 'PROPERTY' AND tm.property_cd IN ('IBE', 'IWA')
            AND tm.delete_ind = 'N' AND td.delete_ind = 'N' AND td.transaction_type = 'RATINGS'
          GROUP BY 1) p
    FULL OUTER JOIN
         (SELECT td.transaction_table_sk AS sk, COUNT(DISTINCT tm.trip_master_id) AS trips
          FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL td ON td.trip_master_id = tm.trip_master_id
          WHERE tm.trip_type = 'MARKET' AND tm.market_cd IN ('BEM', 'WLM')
            AND tm.delete_ind = 'N' AND td.delete_ind = 'N' AND td.transaction_type = 'RATINGS'
          GROUP BY 1) m
      ON m.sk = p.sk;

    -- Work list (Part 4 of the runbook), in a temporary table private to this session.
    CREATE OR REPLACE TEMPORARY TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_WORK AS
    WITH prop AS (
        SELECT trip_master_id, guest_unique_id,
               DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd,
               trip_start_dt, trip_end_dt
        FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        WHERE trip_type = 'PROPERTY' AND delete_ind = 'N' AND property_cd IN ('IBE', 'IWA')
    ),
    mkt AS (
        SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt, created_dttm
        FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        WHERE trip_type = 'MARKET' AND delete_ind = 'N' AND market_cd IN ('BEM', 'WLM')
    ),
    twinless AS (
        SELECT 'RETIRE' AS action,
               m.trip_master_id, m.guest_unique_id, m.market_cd, m.trip_start_dt, m.trip_end_dt,
               IFF(m.created_dttm < '2026-08-12 11:16:26', 1, 0) AS is_seed
        FROM mkt m
        WHERE NOT EXISTS (SELECT 1 FROM prop p
                          WHERE p.market_cd = m.market_cd AND p.guest_unique_id = m.guest_unique_id
                            AND p.trip_start_dt = m.trip_start_dt AND p.trip_end_dt = m.trip_end_dt)
        UNION ALL
        SELECT 'COPY',
               p.trip_master_id, p.guest_unique_id, p.market_cd, p.trip_start_dt, p.trip_end_dt,
               0
        FROM prop p
        WHERE NOT EXISTS (SELECT 1 FROM mkt m
                          WHERE m.market_cd = p.market_cd AND m.guest_unique_id = p.guest_unique_id
                            AND m.trip_start_dt = p.trip_start_dt AND m.trip_end_dt = p.trip_end_dt)
    ),
    running AS (
        SELECT t.*,
               MAX(trip_end_dt) OVER (PARTITION BY guest_unique_id, market_cd
                                      ORDER BY trip_start_dt, trip_end_dt, trip_master_id
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_max_end
        FROM twinless t
    ),
    starts AS (
        SELECT r.*,
               IFF(LAG(run_max_end) OVER (PARTITION BY guest_unique_id, market_cd
                                          ORDER BY trip_start_dt, trip_end_dt, trip_master_id)
                   >= trip_start_dt, 0, 1) AS new_island
        FROM running r
    ),
    islands AS (
        SELECT s.*,
               SUM(new_island) OVER (PARTITION BY guest_unique_id, market_cd
                                     ORDER BY trip_start_dt, trip_end_dt, trip_master_id
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS island_no
        FROM starts s
    )
    SELECT action, trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt, island_no,
           MIN(trip_start_dt) OVER (PARTITION BY guest_unique_id, market_cd, island_no) AS island_start_dt,
           MAX(is_seed)       OVER (PARTITION BY guest_unique_id, market_cd, island_no) AS in_scope
    FROM islands;

    -- The copy list, with new trip IDs (5.0).
    CREATE OR REPLACE TEMPORARY TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_COPY AS
    SELECT (SELECT MAX(trip_master_id) FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER) + ROW_NUMBER() OVER (ORDER BY w.trip_master_id) AS new_trip_master_id,
           w.trip_master_id AS source_trip_master_id, w.guest_unique_id, w.market_cd, w.trip_start_dt, w.trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_WORK w
    WHERE w.action = 'COPY' AND w.in_scope = 1
      AND w.island_start_dt >= :P_FROM_DT AND w.island_start_dt < :P_TO_DT
      AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER m
                      WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
                        AND m.market_cd = w.market_cd AND m.guest_unique_id = w.guest_unique_id
                        AND m.trip_start_dt = w.trip_start_dt AND m.trip_end_dt = w.trip_end_dt);

    -- Scan window: 31 days around the run's trips, so Snowflake can skip the rest.
    SELECT DATEADD(day, -31, MIN(trip_start_dt)), DATEADD(day, 31, MAX(trip_end_dt))
    INTO :v_scan_from, :v_scan_to
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_WORK
    WHERE in_scope = 1 AND island_start_dt >= :P_FROM_DT AND island_start_dt < :P_TO_DT;

    IF (v_scan_from IS NULL) THEN
        SELECT COUNT(*) = 1 INTO :v_holds_lock FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK WHERE holder = :v_run_id;
        IF (v_chain_paused AND v_holds_lock) THEN
            ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK RESUME;
            v_chain_paused := FALSE;
            v_resumed := TRUE;
        END IF;
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = NULL, since = NULL WHERE holder = :v_run_id;
        v_locked := FALSE;
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = IFF(status = 'STARTED', 'NOTHING_TO_DO', status), chain_paused = FALSE,
               finished_at = COALESCE(finished_at, CURRENT_TIMESTAMP()),
               message = 'No in-scope island starts in this window.'
         WHERE run_id = :v_run_id;
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
            (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES
            (:v_run_id, 'GATE', 99, 'RESULT', 'COMMITTED', 'NOTHING_TO_DO', TRUE, CURRENT_TIMESTAMP());
        LET rs0 RESULTSET := (SELECT check_name, expected, actual, passed
                              FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
                              WHERE run_id = :v_run_id ORDER BY check_no);
        RETURN TABLE(rs0);
    END IF;

    -- ===================== the fix: all or nothing =====================
    BEGIN TRANSACTION;
    v_in_txn := TRUE;

    -- 5.1 log what this run retires (only trips still live) and copies
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
        (run_id, logged_at, from_dt, to_dt, action, trip_master_id, new_trip_master_id,
         market_cd, trip_start_dt, trip_end_dt)
    SELECT :v_run_id, CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, :P_FROM_DT, :P_TO_DT, 'RETIRE',
           w.trip_master_id, NULL, w.market_cd, w.trip_start_dt, w.trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_WORK w
    WHERE w.action = 'RETIRE' AND w.in_scope = 1
      AND w.island_start_dt >= :P_FROM_DT AND w.island_start_dt < :P_TO_DT
      AND EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
                  WHERE t.trip_master_id = w.trip_master_id AND t.delete_ind = 'N');

    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
        (run_id, logged_at, from_dt, to_dt, action, trip_master_id, new_trip_master_id,
         market_cd, trip_start_dt, trip_end_dt)
    SELECT :v_run_id, CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, :P_FROM_DT, :P_TO_DT, 'COPY',
           c.source_trip_master_id, c.new_trip_master_id, c.market_cd, c.trip_start_dt, c.trip_end_dt
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_COPY c;

    -- keep an exact copy of every row about to be retired (ROLLBACK restores these)
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TM
    SELECT :v_run_id, t.*
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
    WHERE t.delete_ind = 'N'
      AND t.trip_start_dt BETWEEN :v_scan_from AND :v_scan_to
      AND t.trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'RETIRE');

    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TD
    SELECT :v_run_id, d.*
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    WHERE d.delete_ind = 'N'
      AND d.business_start_dt BETWEEN :v_scan_from AND :v_scan_to
      AND d.trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'RETIRE');

    -- 5.2 new market trips: exact copies of the property trips
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        (trip_master_id, guest_unique_id, property_cd, market_cd, trip_type,
         trip_start_dt, trip_end_dt, delete_ind,
         created_dttm, created_by, updated_dttm, updated_by,
         batch_id, replay_counter, last_dml_cd)
    SELECT c.new_trip_master_id, c.guest_unique_id, 'N/A', c.market_cd, 'MARKET',
           c.trip_start_dt, c.trip_end_dt, 'N',
           CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'DAASI-3641', CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'DAASI-3641',
           -3641, NULL, 'I'
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_COPY c;

    -- 5.3 their detail rows: every live detail row of the source property trip
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL
        (trip_detail_id, trip_master_id, transaction_table_sk, transaction_table,
         transaction_type, transaction_sub_type, transaction_start_dttm, transaction_end_dttm,
         business_start_dt, business_end_dt, transaction_modified_dttm, delete_ind,
         created_dttm, created_by, updated_dttm, updated_by,
         batch_id, replay_counter, last_dml_cd, property_cd)
    SELECT (SELECT MAX(trip_detail_id) FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL) + ROW_NUMBER() OVER (ORDER BY c.new_trip_master_id, d.trip_detail_id),
           c.new_trip_master_id, d.transaction_table_sk, d.transaction_table,
           d.transaction_type, d.transaction_sub_type, d.transaction_start_dttm, d.transaction_end_dttm,
           d.business_start_dt, d.business_end_dt, d.transaction_modified_dttm, 'N',
           CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'DAASI-3641', CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, 'DAASI-3641',
           -3641, NULL, 'I', d.property_cd
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_COPY c
    JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = c.source_trip_master_id
    WHERE d.delete_ind = 'N'
      AND d.business_start_dt BETWEEN :v_scan_from AND :v_scan_to;

    -- 5.4 retire the old market trips: detail rows first, then the trips
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL
       SET delete_ind = 'Y', last_dml_cd = 'U',
           updated_dttm = CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, updated_by = 'DAASI-3641', batch_id = -3641
     WHERE delete_ind = 'N'
       AND business_start_dt BETWEEN :v_scan_from AND :v_scan_to
       AND trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                              WHERE run_id = :v_run_id AND action = 'RETIRE');

    UPDATE DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
       SET delete_ind = 'Y', last_dml_cd = 'U',
           updated_dttm = CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, updated_by = 'DAASI-3641', batch_id = -3641
     WHERE delete_ind = 'N'
       AND trip_start_dt BETWEEN :v_scan_from AND :v_scan_to
       AND trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                              WHERE run_id = :v_run_id AND action = 'RETIRE');

    -- ---------- checks, still inside the transaction (they see its changes) ----------
    -- G1 every logged old trip is retired (6.1)
    SELECT COUNT(DISTINCT l.trip_master_id),
           COUNT(DISTINCT IFF(t.delete_ind = 'Y' AND t.updated_by = 'DAASI-3641', l.trip_master_id, NULL))
    INTO :v_retire_planned, :v_retire_done
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
    LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t ON t.trip_master_id = l.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'RETIRE';

    -- G2 every logged copy exists, live, written by the fix (6.1)
    SELECT COUNT(DISTINCT l.new_trip_master_id),
           COUNT(DISTINCT IFF(t.delete_ind = 'N' AND t.created_by = 'DAASI-3641', l.new_trip_master_id, NULL))
    INTO :v_copy_planned, :v_copy_done
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
    LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t ON t.trip_master_id = l.new_trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY';

    -- G3 no new ID collides with an existing row
    SELECT COUNT(*) - COUNT(DISTINCT t.trip_master_id) INTO :v_dup_trip_ids
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
    WHERE t.trip_master_id IN (SELECT new_trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'COPY');

    SELECT COUNT(*) - COUNT(DISTINCT d.trip_detail_id) INTO :v_dup_detail_ids
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    WHERE d.trip_detail_id IN (SELECT n.trip_detail_id
                               FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL n
                               JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.new_trip_master_id = n.trip_master_id
                               WHERE l.run_id = :v_run_id AND l.action = 'COPY');

    -- G4 nothing left on the retired trips; the copies carry every detail row (6.4)
    SELECT COUNT(*) INTO :v_left_on_old
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.trip_master_id = d.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'RETIRE' AND d.delete_ind = 'N';

    SELECT COUNT(*) INTO :v_src_details
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.trip_master_id = d.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY' AND d.delete_ind = 'N';

    SELECT COUNT(*) INTO :v_new_details
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.new_trip_master_id = d.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY' AND d.delete_ind = 'N';

    -- G5 no transaction dropped off the market side, ratings net to 0 (6.8)
    SELECT COALESCE(SUM(IFF(r.kind = 'R' AND lv.sk IS NULL, 1, 0)), 0),
           COALESCE(SUM(IFF(r.ttype = 'RATINGS', IFF(r.kind = 'A', 1, -1), 0)), 0)
    INTO :v_dropped, :v_ratings_net
    FROM (SELECT 'A' AS kind, l.market_cd, d.transaction_type AS ttype,
                 d.transaction_table AS ttable, d.transaction_table_sk AS sk
          FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = l.new_trip_master_id
          WHERE l.run_id = :v_run_id AND l.action = 'COPY' AND d.created_by = 'DAASI-3641'
          UNION ALL
          SELECT 'R', l.market_cd, d.transaction_type, d.transaction_table, d.transaction_table_sk
          FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = l.trip_master_id
          WHERE l.run_id = :v_run_id AND l.action = 'RETIRE'
            AND d.delete_ind = 'Y' AND d.updated_by = 'DAASI-3641') r
    LEFT JOIN (SELECT DISTINCT tm.market_cd, d.transaction_type AS ttype,
                      d.transaction_table AS ttable, d.transaction_table_sk AS sk
               FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
               JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = tm.trip_master_id
               WHERE tm.trip_type = 'MARKET' AND tm.market_cd IN ('BEM', 'WLM')
                 AND tm.delete_ind = 'N' AND d.delete_ind = 'N') lv
      ON r.kind = 'R' AND lv.market_cd = r.market_cd AND lv.ttype = r.ttype
     AND lv.ttable = r.ttable AND lv.sk = r.sk;

    -- G6 no new trip is longer than its market's limit without a hotel stay (6.5)
    SELECT COUNT(*) INTO :v_over_cap
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.new_trip_master_id = tm.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY'
      AND DATEDIFF(day, tm.trip_start_dt, tm.trip_end_dt) + 1 > DECODE(tm.market_cd, 'BEM', 1, 'WLM', 3, 999)
      AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
                      WHERE d.trip_master_id = tm.trip_master_id
                        AND d.transaction_type = 'HOTEL' AND d.delete_ind = 'N');

    -- G7 nothing lost or doubled across all BEM/WLM ratings: no worse than before (6.2)
    SELECT COUNT_IF(m.sk IS NULL) + COUNT_IF(p.sk IS NULL) + COUNT_IF(m.trips <> p.trips)
    INTO :v_g62_after
    FROM (SELECT td.transaction_table_sk AS sk, COUNT(DISTINCT tm.trip_master_id) AS trips
          FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL td ON td.trip_master_id = tm.trip_master_id
          WHERE tm.trip_type = 'PROPERTY' AND tm.property_cd IN ('IBE', 'IWA')
            AND tm.delete_ind = 'N' AND td.delete_ind = 'N' AND td.transaction_type = 'RATINGS'
          GROUP BY 1) p
    FULL OUTER JOIN
         (SELECT td.transaction_table_sk AS sk, COUNT(DISTINCT tm.trip_master_id) AS trips
          FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
          JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL td ON td.trip_master_id = tm.trip_master_id
          WHERE tm.trip_type = 'MARKET' AND tm.market_cd IN ('BEM', 'WLM')
            AND tm.delete_ind = 'N' AND td.delete_ind = 'N' AND td.transaction_type = 'RATINGS'
          GROUP BY 1) m
      ON m.sk = p.sk;

    -- G8 the kept copies match exactly what was retired
    SELECT COUNT(*) INTO :v_arch_tm FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TM WHERE run_id = :v_run_id;
    SELECT COUNT(*) INTO :v_arch_td FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TD WHERE run_id = :v_run_id;
    SELECT COUNT(*) INTO :v_retired_tm
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
    WHERE t.delete_ind = 'Y' AND t.updated_by = 'DAASI-3641'
      AND t.trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'RETIRE');
    SELECT COUNT(*) INTO :v_retired_td
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
    WHERE d.delete_ind = 'Y' AND d.updated_by = 'DAASI-3641'
      AND d.trip_master_id IN (SELECT trip_master_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG
                               WHERE run_id = :v_run_id AND action = 'RETIRE');

    -- G9 every new trip is the only live market trip with its guest, market and dates
    SELECT COUNT(*) INTO :v_dup_twins
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER n
    JOIN DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l ON l.new_trip_master_id = n.trip_master_id
    WHERE l.run_id = :v_run_id AND l.action = 'COPY'
      AND EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER m
                  WHERE m.trip_type = 'MARKET' AND m.delete_ind = 'N'
                    AND m.trip_start_dt BETWEEN :v_scan_from AND :v_scan_to
                    AND m.market_cd = n.market_cd AND m.guest_unique_id = n.guest_unique_id
                    AND m.trip_start_dt = n.trip_start_dt AND m.trip_end_dt = n.trip_end_dt
                    AND m.trip_master_id <> n.trip_master_id);

    v_failed := IFF(v_retire_done = v_retire_planned, 0, 1)
              + IFF(v_copy_done = v_copy_planned, 0, 1)
              + IFF(v_dup_trip_ids = 0, 0, 1)
              + IFF(v_dup_detail_ids = 0, 0, 1)
              + IFF(v_left_on_old = 0, 0, 1)
              + IFF(v_src_details = v_new_details, 0, 1)
              + IFF(v_dropped = 0, 0, 1)
              + IFF(v_ratings_net = 0, 0, 1)
              + IFF(v_over_cap = 0, 0, 1)
              + IFF(v_g62_after <= v_g62_before, 0, 1)
              + IFF(v_arch_tm = v_retired_tm AND v_arch_td = v_retired_td, 0, 1)
              + IFF(v_dup_twins = 0, 0, 1);

    IF (v_failed = 0) THEN
        -- The run's record changes in the same transaction as the data, so
        -- COMMITTED in DAASI_3641_RUNS always means the data is in. A run RECOVER
        -- has meanwhile closed (no longer STARTED) rolls back instead.
        v_commit_ts := CURRENT_TIMESTAMP();
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = 'COMMITTED', committed_at = :v_commit_ts,
               trips_retired = :v_retire_planned, trips_copied = :v_copy_planned,
               details_moved = :v_new_details, scan_from = :v_scan_from, scan_to = :v_scan_to,
               message = 'Committed.'
         WHERE run_id = :v_run_id AND status = 'STARTED';
        IF (SQLROWCOUNT = 0) THEN
            RAISE e_superseded;
        END IF;
        COMMIT;
        v_in_txn := FALSE;
    ELSE
        ROLLBACK;
        v_in_txn := FALSE;
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = 'CHECKS_FAILED',
               trips_retired = :v_retire_planned, trips_copied = :v_copy_planned,
               details_moved = :v_new_details, scan_from = :v_scan_from, scan_to = :v_scan_to,
               message = TO_VARCHAR(:v_failed) || ' check(s) failed, so the run was rolled back.'
         WHERE run_id = :v_run_id;
    END IF;
    -- ======================================================================

    -- Resume the chain only while this run still holds the lock (a run RECOVER
    -- closed no longer owns the chain).
    SELECT COUNT(*) = 1 INTO :v_holds_lock FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK WHERE holder = :v_run_id;
    IF (v_chain_paused AND v_holds_lock) THEN
        ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK RESUME;
        v_chain_paused := FALSE;
        v_resumed := TRUE;
    END IF;
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = NULL, since = NULL WHERE holder = :v_run_id;
    v_locked := FALSE;
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET chain_paused = FALSE, finished_at = COALESCE(finished_at, CURRENT_TIMESTAMP())
     WHERE run_id = :v_run_id;

    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
        (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    VALUES
        (:v_run_id, 'GATE', 1, 'Old market trips retired, as logged',
         TO_VARCHAR(:v_retire_planned), TO_VARCHAR(:v_retire_done), :v_retire_done = :v_retire_planned, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 2, 'New market trips created, as logged',
         TO_VARCHAR(:v_copy_planned), TO_VARCHAR(:v_copy_done), :v_copy_done = :v_copy_planned, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 3, 'New trip IDs that collide with another row',
         '0', TO_VARCHAR(:v_dup_trip_ids), :v_dup_trip_ids = 0, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 4, 'New detail IDs that collide with another row',
         '0', TO_VARCHAR(:v_dup_detail_ids), :v_dup_detail_ids = 0, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 5, 'Live detail rows left on retired trips',
         '0', TO_VARCHAR(:v_left_on_old), :v_left_on_old = 0, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 6, 'Detail rows on the new trips = on their property trips',
         TO_VARCHAR(:v_src_details), TO_VARCHAR(:v_new_details), :v_new_details = :v_src_details, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 7, 'Transactions dropped from every market trip',
         '0', TO_VARCHAR(:v_dropped), :v_dropped = 0, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 8, 'Ratings added minus ratings retired',
         '0', TO_VARCHAR(:v_ratings_net), :v_ratings_net = 0, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 9, 'New trips over the max trip days without a hotel stay',
         '0', TO_VARCHAR(:v_over_cap), :v_over_cap = 0, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 10, 'Ratings lost or doubled, all BEM/WLM (no worse than before)',
         '<= ' || TO_VARCHAR(:v_g62_before), TO_VARCHAR(:v_g62_after), :v_g62_after <= :v_g62_before, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 11, 'Kept copies = retired rows (trips / detail rows)',
         TO_VARCHAR(:v_retired_tm) || ' / ' || TO_VARCHAR(:v_retired_td),
         TO_VARCHAR(:v_arch_tm) || ' / ' || TO_VARCHAR(:v_arch_td),
         :v_arch_tm = :v_retired_tm AND :v_arch_td = :v_retired_td, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 12, 'New trips with a live identical market trip (a double copy)',
         '0', TO_VARCHAR(:v_dup_twins), :v_dup_twins = 0, CURRENT_TIMESTAMP()),
        (:v_run_id, 'GATE', 99, 'RESULT',
         'COMMITTED', IFF(:v_failed = 0, 'COMMITTED', 'ROLLED BACK'), :v_failed = 0, CURRENT_TIMESTAMP());

    IF (v_failed > 0) THEN
        RAISE e_checks_failed;
    END IF;

    LET rs RESULTSET := (SELECT check_name, expected, actual, passed
                         FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
                         WHERE run_id = :v_run_id ORDER BY check_no);
    RETURN TABLE(rs);

EXCEPTION
    WHEN e_checks_failed THEN
        RAISE;
    WHEN OTHER THEN
        v_err := 'SQLCODE ' || SQLCODE || ': ' || SQLERRM;
        IF (v_in_txn) THEN
            ROLLBACK;
        END IF;
        -- the chain and the lock are this run's to restore only while it holds the lock
        IF (v_locked) THEN
            SELECT COUNT(*) = 1 INTO :v_holds_lock FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK WHERE holder = :v_run_id;
        END IF;
        IF (v_chain_paused AND v_holds_lock) THEN
            BEGIN
                ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK RESUME;
                v_resumed := TRUE;
            EXCEPTION
                WHEN OTHER THEN
                    v_err := v_err || ' | COULD NOT RESUME THE TRIP CHAIN. Resume it now: ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK RESUME;';
            END;
        END IF;
        IF (v_holds_lock) THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = NULL, since = NULL WHERE holder = :v_run_id;
        END IF;
        IF (v_logged) THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
               SET status       = IFF(status = 'STARTED', 'ERROR', status),
                   chain_paused = :v_holds_lock AND :v_chain_paused AND NOT :v_resumed,
                   finished_at  = COALESCE(finished_at, CURRENT_TIMESTAMP()),
                   message      = LEFT(COALESCE(message, '') || ' ' || :v_err, 4000)
             WHERE run_id = :v_run_id;
        END IF;
        RAISE;
END;
$$;


-- -----------------------------------------------------------------------------
-- 4. POST_CHECK: the post-test for a committed run (the latest, or the
--    run_id given). In UAT there is no chain, so run it right after RUN_ALL.
--    RESULT is PASS, FAIL or WAITING; for WAITING, "expected" says what for.
-- -----------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_POST_CHECK(P_RUN_ID VARCHAR DEFAULT NULL)
COPY GRANTS
RETURNS TABLE (CHECK_NAME VARCHAR, EXPECTED VARCHAR, ACTUAL VARCHAR, PASSED BOOLEAN)
LANGUAGE SQL
COMMENT = 'DAASI-3641: the post-test for a committed run (the latest, or the run_id given). RESULT: PASS, FAIL or WAITING.'
EXECUTE AS CALLER
AS
$$
DECLARE
    v_has_chain     BOOLEAN DEFAULT FALSE;
    v_autocommit    VARCHAR;
    v_run           VARCHAR;
    v_status        VARCHAR;
    v_committed_at  TIMESTAMP_LTZ;
    v_since         TIMESTAMP_LTZ;
    v_phase         VARCHAR;
    v_root_id       VARCHAR;
    v_failed_task   VARCHAR;
    v_runs_since    NUMBER DEFAULT 0;
    v_failed_since  NUMBER DEFAULT 0;
    v_busy          NUMBER DEFAULT 0;
    v_tsdt          NUMBER DEFAULT 0;
    v_vw            NUMBER DEFAULT 0;
    v_dws           NUMBER DEFAULT 0;
    v_18mo          NUMBER DEFAULT 0;
    v_smart         NUMBER DEFAULT 0;
    v_das           NUMBER DEFAULT 0;
    v_gap           NUMBER DEFAULT 0;
    v_lingering     NUMBER DEFAULT 0;
    v_new_missing   NUMBER DEFAULT 0;
    v_new_removed   NUMBER DEFAULT 0;
    v_new_updated   NUMBER DEFAULT 0;
    v_not_in_uat    NUMBER DEFAULT -1;
    v_left_bem      NUMBER DEFAULT 0;
    v_left_wlm      NUMBER DEFAULT 0;
    v_over_cap      NUMBER DEFAULT 0;
    v_bem_diff      NUMBER DEFAULT 0;
    v_wlm_diff      NUMBER DEFAULT 0;
    v_fail          NUMBER DEFAULT 0;
    v_chain_result  VARCHAR;
    v_chain_reason  VARCHAR;
    v_result        VARCHAR;
    v_reason        VARCHAR;
    v_ts            TIMESTAMP_LTZ;
    e_autocommit    EXCEPTION (-20650, 'DAASI-3641: this session has AUTOCOMMIT off. Run ALTER SESSION SET AUTOCOMMIT = TRUE; and call again. Nothing was changed.');
BEGIN
    SHOW PARAMETERS LIKE 'AUTOCOMMIT' IN SESSION;
    SELECT MAX("value") INTO :v_autocommit FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
    IF (LOWER(COALESCE(v_autocommit, 'true')) <> 'true') THEN
        RAISE e_autocommit;
    END IF;
    IF (COALESCE(CURRENT_WAREHOUSE(), '') <> 'DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE') THEN
        EXECUTE IMMEDIATE 'USE WAREHOUSE DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE';
    END IF;
    EXECUTE IMMEDIATE 'ALTER SESSION SET TIMEZONE = ''America/Los_Angeles''';

    -- the run under test: the one given, or the latest committed one
    IF (P_RUN_ID IS NULL) THEN
        SELECT MAX_BY(run_id, started_at) INTO :v_run
        FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS WHERE kind = 'RUN' AND status = 'COMMITTED';
    ELSE
        v_run := P_RUN_ID;
    END IF;
    SELECT MAX(status), MAX(committed_at) INTO :v_status, :v_committed_at
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
    WHERE run_id = :v_run AND kind = 'RUN';

    IF (v_run IS NULL OR v_status IS NULL OR v_status <> 'COMMITTED') THEN
        v_status := COALESCE(v_status, IFF(v_run IS NULL, 'no committed run', 'no such run'));
        v_run := COALESCE(v_run, 'NONE');
        INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
            (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
        VALUES
            (:v_run, 'POST1', 99, 'RESULT', 'a committed run', :v_status, FALSE, CURRENT_TIMESTAMP());
        LET rs0 RESULTSET := (SELECT 'RESULT' AS check_name, 'a committed run' AS expected,
                                     :v_status AS actual, FALSE AS passed);
        RETURN TABLE(rs0);
    END IF;

    v_phase := IFF(v_committed_at <= DATEADD(hour, -72, CURRENT_TIMESTAMP()), 'POST3', 'POST1');

    -- ---------- PROD: the trip chain and the tables it feeds ----------
    IF (v_has_chain) THEN
        -- A finished chain run that started after the commit. (If a later run is
        -- going now, a failing look is treated as WAITING, below.)
        v_since := GREATEST(v_committed_at, DATEADD(day, -6, CURRENT_TIMESTAMP()));
        SELECT COUNT(*) INTO :v_runs_since
        FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.TASK_HISTORY(
                 SCHEDULED_TIME_RANGE_START => :v_since,
                 RESULT_LIMIT => 10000,
                 TASK_NAME => 'TRIP_ROOT_TASK'))
        WHERE database_name = 'DAAS_PROD'
          AND schema_name = 'DAAS_COMMON'
          AND state = 'SUCCEEDED'
          AND query_start_time > :v_committed_at;

        SELECT COUNT(*) INTO :v_busy
        FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.CURRENT_TASK_GRAPHS(ROOT_TASK_NAME => 'TRIP_ROOT_TASK'))
        WHERE database_name = 'DAAS_PROD' AND schema_name = 'DAAS_COMMON' AND state = 'EXECUTING';

        -- POST1: any task of the chain that failed or was cancelled after the commit is
        -- for a person to look at (the root task can succeed while a child fails).
        -- A look that itself fails just means no failure was seen.
        IF (v_phase = 'POST1') THEN
            BEGIN
                SHOW TASKS LIKE 'TRIP_ROOT_TASK' IN SCHEMA DAAS_PROD.DAAS_COMMON;
                SELECT MAX("id") INTO :v_root_id FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
                SELECT COUNT(*), MAX(name) INTO :v_failed_since, :v_failed_task
                FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.TASK_HISTORY(
                         SCHEDULED_TIME_RANGE_START => :v_since,
                         RESULT_LIMIT => 10000,
                         ROOT_TASK_ID => :v_root_id,
                         ERROR_ONLY => TRUE))
                WHERE COALESCE(query_start_time, scheduled_time) > :v_committed_at;
            EXCEPTION
                WHEN OTHER THEN
                    v_failed_since := 0;
            END;
        END IF;

        IF (v_failed_since > 0) THEN
            v_chain_result := 'FAIL';
            v_chain_reason := LEFT('chain task ' || COALESCE(v_failed_task, '?') || ' failed or was cancelled after the commit', 100);
        ELSEIF (v_runs_since = 0) THEN
            IF (v_committed_at <= DATEADD(hour, -4, CURRENT_TIMESTAMP())) THEN
                v_chain_result := 'FAIL';
                v_chain_reason := 'no finished trip chain run in the 4 hours since the commit';
            ELSE
                v_chain_result := 'WAITING';
                v_chain_reason := 'the next trip chain run to finish';
            END IF;
        END IF;

        IF (v_chain_result IS NULL) THEN
            -- Retired trips still in a downstream table (fine until the archival step clears them)
            SELECT COUNT(DISTINCT x.trip_master_id) INTO :v_tsdt
            FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r JOIN DAAS_PROD.DAAS_CORE.TRIP_SUMMARY_DT x ON x.trip_master_id = r.trip_master_id
            WHERE r.run_id = :v_run AND r.action = 'RETIRE';
            SELECT COUNT(DISTINCT x.trip_master_id) INTO :v_vw
            FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r JOIN DAAS_PROD.DAAS_CORE_MARKETING_VW.TRIP_SUMMARY_VW x ON x.trip_master_id = r.trip_master_id
            WHERE r.run_id = :v_run AND r.action = 'RETIRE';
            SELECT COUNT(DISTINCT x.trip_master_id) INTO :v_dws
            FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r JOIN DAAS_PROD.DAAS_TIBCO_DWS.TRIP_SUMMARY x ON x.trip_master_id = r.trip_master_id
            WHERE r.run_id = :v_run AND r.action = 'RETIRE';
            SELECT COUNT(DISTINCT x.trip_master_id) INTO :v_18mo
            FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r JOIN DAAS_PROD.DAAS_TIBCO_DWS.TRIP_SUMMARY_18MO x ON x.trip_master_id = r.trip_master_id
            WHERE r.run_id = :v_run AND r.action = 'RETIRE';
            SELECT COUNT(DISTINCT x.trip_master_id) INTO :v_smart
            FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r JOIN DAAS_PROD.DAAS_TIBCO_SMART.TRIP_SUMMARY x ON x.trip_master_id = r.trip_master_id
            WHERE r.run_id = :v_run AND r.action = 'RETIRE';
            SELECT COUNT(DISTINCT x.trip_master_id) INTO :v_das
            FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r JOIN DAAS_PROD.DAAS_CORE.DAILY_ACTIVITY_SUMMARY x ON x.trip_master_id = r.trip_master_id
            WHERE r.run_id = :v_run AND r.action = 'RETIRE';
            SELECT COUNT(DISTINCT x.trip_master_id) INTO :v_gap
            FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r JOIN DAAS_PROD.DAAS_CORE.DAAS_TRIP_NUM_GAP_DAILY_METRIC_MKTENT x ON x.trip_master_id = r.trip_master_id
            WHERE r.run_id = :v_run AND r.action = 'RETIRE';
            v_lingering := v_tsdt + v_vw + v_dws + v_18mo + v_smart + v_das + v_gap;

            -- New trips the summaries should now hold, and what the chain did to them
            SELECT COUNT(*) INTO :v_new_missing
            FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r
            WHERE r.run_id = :v_run AND r.action = 'COPY'
              AND NOT EXISTS (SELECT 1 FROM DAAS_PROD.DAAS_CORE.TRIP_SUMMARY_DT x
                              WHERE x.trip_master_id = r.new_trip_master_id);

            SELECT COUNT_IF(t.trip_master_id IS NULL OR t.delete_ind <> 'N'),
                   COUNT_IF(t.delete_ind = 'N' AND COALESCE(t.updated_by, '') <> 'DAASI-3641')
            INTO :v_new_removed, :v_new_updated
            FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r
            LEFT JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t ON t.trip_master_id = r.new_trip_master_id
            WHERE r.run_id = :v_run AND r.action = 'COPY';

            v_fail := IFF(v_new_missing = 0, 0, 1) + IFF(v_new_removed = 0, 0, 1);
            IF (v_fail > 0 AND v_busy > 0) THEN
                -- the chain is mid-run, so this may be a half-finished picture: look again later
                v_chain_result := 'WAITING';
                v_chain_reason := 'the trip chain run now in progress to finish';
                v_fail := 0;
            END IF;
            IF (v_chain_result IS NULL AND v_phase = 'POST3' AND v_fail = 0 AND v_lingering > 0) THEN
                -- Some layers keep retired trips until the archival step clears them ("within
                -- about 3 days"): wait for it, up to 7 days after the commit.
                IF (v_committed_at > DATEADD(day, -7, CURRENT_TIMESTAMP())) THEN
                    v_chain_result := 'WAITING';
                    v_chain_reason := 'retired trips to clear downstream (archival step; up to 7 days)';
                ELSE
                    v_chain_result := 'FAIL';
                    v_chain_reason := 'retired trips cleared downstream within 7 days';
                END IF;
            END IF;
        END IF;
    END IF;

    -- ---------- both environments: the core tables themselves ----------
    -- Final proof (6.0): no in-scope island is left to fix.
    CREATE OR REPLACE TEMPORARY TABLE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_PROOF AS
    WITH prop AS (
        SELECT trip_master_id, guest_unique_id,
               DECODE(property_cd, 'IBE', 'BEM', 'IWA', 'WLM') AS market_cd,
               trip_start_dt, trip_end_dt
        FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        WHERE trip_type = 'PROPERTY' AND delete_ind = 'N' AND property_cd IN ('IBE', 'IWA')
    ),
    mkt AS (
        SELECT trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt, created_dttm
        FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
        WHERE trip_type = 'MARKET' AND delete_ind = 'N' AND market_cd IN ('BEM', 'WLM')
    ),
    twinless AS (
        SELECT 'RETIRE' AS action,
               m.trip_master_id, m.guest_unique_id, m.market_cd, m.trip_start_dt, m.trip_end_dt,
               IFF(m.created_dttm < '2026-08-12 11:16:26', 1, 0) AS is_seed
        FROM mkt m
        WHERE NOT EXISTS (SELECT 1 FROM prop p
                          WHERE p.market_cd = m.market_cd AND p.guest_unique_id = m.guest_unique_id
                            AND p.trip_start_dt = m.trip_start_dt AND p.trip_end_dt = m.trip_end_dt)
        UNION ALL
        SELECT 'COPY',
               p.trip_master_id, p.guest_unique_id, p.market_cd, p.trip_start_dt, p.trip_end_dt,
               0
        FROM prop p
        WHERE NOT EXISTS (SELECT 1 FROM mkt m
                          WHERE m.market_cd = p.market_cd AND m.guest_unique_id = p.guest_unique_id
                            AND m.trip_start_dt = p.trip_start_dt AND m.trip_end_dt = p.trip_end_dt)
    ),
    running AS (
        SELECT t.*,
               MAX(trip_end_dt) OVER (PARTITION BY guest_unique_id, market_cd
                                      ORDER BY trip_start_dt, trip_end_dt, trip_master_id
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_max_end
        FROM twinless t
    ),
    starts AS (
        SELECT r.*,
               IFF(LAG(run_max_end) OVER (PARTITION BY guest_unique_id, market_cd
                                          ORDER BY trip_start_dt, trip_end_dt, trip_master_id)
                   >= trip_start_dt, 0, 1) AS new_island
        FROM running r
    ),
    islands AS (
        SELECT s.*,
               SUM(new_island) OVER (PARTITION BY guest_unique_id, market_cd
                                     ORDER BY trip_start_dt, trip_end_dt, trip_master_id
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS island_no
        FROM starts s
    )
    SELECT action, trip_master_id, guest_unique_id, market_cd, trip_start_dt, trip_end_dt, island_no,
           MIN(trip_start_dt) OVER (PARTITION BY guest_unique_id, market_cd, island_no) AS island_start_dt,
           MAX(is_seed)       OVER (PARTITION BY guest_unique_id, market_cd, island_no) AS in_scope
    FROM islands;
    SELECT COUNT_IF(market_cd = 'BEM'), COUNT_IF(market_cd = 'WLM') INTO :v_left_bem, :v_left_wlm
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TMP_PROOF WHERE in_scope = 1;

    -- Tracy's check in the core tables (6.5): BEM/WLM market trips over the max
    -- trip days with no hotel stay, the whole table.
    SELECT COUNT(*) INTO :v_over_cap
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
    WHERE tm.trip_type = 'MARKET' AND tm.market_cd IN ('BEM', 'WLM') AND tm.delete_ind = 'N'
      AND DATEDIFF(day, tm.trip_start_dt, tm.trip_end_dt) + 1 > DECODE(tm.market_cd, 'BEM', 1, 'WLM', 3, 999)
      AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d
                      WHERE d.trip_master_id = tm.trip_master_id
                        AND d.transaction_type = 'HOTEL' AND d.delete_ind = 'N');

    -- Live detail rows, market side minus property side (6.3): BEM vs IBE, WLM vs IWA.
    SELECT COALESCE(SUM(IFF(tm.trip_type = 'MARKET' AND tm.market_cd = 'BEM', 1, 0)), 0)
         - COALESCE(SUM(IFF(tm.trip_type = 'PROPERTY' AND tm.property_cd = 'IBE', 1, 0)), 0),
           COALESCE(SUM(IFF(tm.trip_type = 'MARKET' AND tm.market_cd = 'WLM', 1, 0)), 0)
         - COALESCE(SUM(IFF(tm.trip_type = 'PROPERTY' AND tm.property_cd = 'IWA', 1, 0)), 0)
    INTO :v_bem_diff, :v_wlm_diff
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER tm
    JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL d ON d.trip_master_id = tm.trip_master_id
    WHERE tm.delete_ind = 'N' AND d.delete_ind = 'N'
      AND ((tm.trip_type = 'MARKET' AND tm.market_cd IN ('BEM', 'WLM'))
           OR (tm.trip_type = 'PROPERTY' AND tm.property_cd IN ('IBE', 'IWA')));

    -- Answer key: every trip this run created, the UAT run created too (information)
    BEGIN
        SELECT COUNT(*) INTO :v_not_in_uat
        FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG r
        JOIN DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t ON t.trip_master_id = r.new_trip_master_id
        WHERE r.run_id = :v_run AND r.action = 'COPY'
          AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_TM_AFTER u
                          WHERE u.trip_type = 'MARKET' AND u.delete_ind = 'N' AND u.created_by = 'DAASI-3641'
                            AND u.guest_unique_id = t.guest_unique_id AND u.market_cd = t.market_cd
                            AND u.trip_start_dt = t.trip_start_dt AND u.trip_end_dt = t.trip_end_dt);
    EXCEPTION
        WHEN OTHER THEN
            v_not_in_uat := -1;
    END;

    v_fail := v_fail + IFF(v_left_bem + v_left_wlm = 0, 0, 1) + IFF(v_over_cap = 0, 0, 1);
    IF (v_chain_result IS NOT NULL) THEN
        v_result := v_chain_result;
        v_reason := v_chain_reason;
        IF (v_result = 'WAITING' AND v_fail > 0) THEN
            v_result := 'FAIL';
            v_reason := 'the core-table checks (the chain checks still waiting)';
        END IF;
    ELSE
        v_result := IFF(v_fail = 0, 'PASS', 'FAIL');
        v_reason := 'PASS';
    END IF;

    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
        (run_id, phase, check_no, check_name, expected, actual, passed, checked_at)
    VALUES
        (:v_run, :v_phase, 1, 'In-scope trips still to fix after the run (BEM / WLM)',
         '0 / 0', TO_VARCHAR(:v_left_bem) || ' / ' || TO_VARCHAR(:v_left_wlm), :v_left_bem + :v_left_wlm = 0, CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 2, 'BEM/WLM market trips over the max trip days without a hotel stay (whole table)',
         '0', TO_VARCHAR(:v_over_cap), :v_over_cap = 0, CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 3, 'Live detail rows, BEM minus IBE (information; 0 right after the run)',
         '0', TO_VARCHAR(:v_bem_diff), NULL, CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 4, 'Live detail rows, WLM minus IWA (information; 0 right after the run)',
         '0', TO_VARCHAR(:v_wlm_diff), NULL, CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 5, 'New trips the UAT run did not also create (information)',
         '0', IFF(:v_not_in_uat < 0, 'n/a', TO_VARCHAR(:v_not_in_uat)), NULL, CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 6, 'New trips missing from TRIP_SUMMARY_DT',
         '0', IFF(:v_has_chain, IFF(:v_chain_result IS NULL OR :v_chain_result = 'PASS', TO_VARCHAR(:v_new_missing), 'not checked yet'), 'n/a (no chain)'),
         IFF(:v_has_chain AND :v_chain_result IS NULL, :v_new_missing = 0, NULL), CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 7, 'New trips the chain removed (look before going on)',
         '0', IFF(:v_has_chain, IFF(:v_chain_result IS NULL, TO_VARCHAR(:v_new_removed), 'not checked yet'), 'n/a (no chain)'),
         IFF(:v_has_chain AND :v_chain_result IS NULL, :v_new_removed = 0, NULL), CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 8, 'New trips the chain updated (information)',
         'any', IFF(:v_has_chain, IFF(:v_chain_result IS NULL, TO_VARCHAR(:v_new_updated), 'not checked yet'), 'n/a (no chain)'), NULL, CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 9, 'Retired trips still in TRIP_SUMMARY_DT',
         IFF(:v_phase = 'POST3', '0', 'any for now'), IFF(:v_has_chain, TO_VARCHAR(:v_tsdt), 'n/a (no chain)'),
         IFF(:v_phase = 'POST3' AND :v_has_chain AND :v_chain_result IS NULL, :v_tsdt = 0, NULL), CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 10, 'Retired trips still in TRIP_SUMMARY_VW',
         IFF(:v_phase = 'POST3', '0', 'any for now'), IFF(:v_has_chain, TO_VARCHAR(:v_vw), 'n/a (no chain)'),
         IFF(:v_phase = 'POST3' AND :v_has_chain AND :v_chain_result IS NULL, :v_vw = 0, NULL), CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 11, 'Retired trips still in TIBCO DWS TRIP_SUMMARY',
         IFF(:v_phase = 'POST3', '0', 'any for now'), IFF(:v_has_chain, TO_VARCHAR(:v_dws), 'n/a (no chain)'),
         IFF(:v_phase = 'POST3' AND :v_has_chain AND :v_chain_result IS NULL, :v_dws = 0, NULL), CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 12, 'Retired trips still in TIBCO TRIP_SUMMARY_18MO',
         IFF(:v_phase = 'POST3', '0', 'any for now'), IFF(:v_has_chain, TO_VARCHAR(:v_18mo), 'n/a (no chain)'),
         IFF(:v_phase = 'POST3' AND :v_has_chain AND :v_chain_result IS NULL, :v_18mo = 0, NULL), CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 13, 'Retired trips still in TIBCO SMART TRIP_SUMMARY',
         IFF(:v_phase = 'POST3', '0', 'any for now'), IFF(:v_has_chain, TO_VARCHAR(:v_smart), 'n/a (no chain)'),
         IFF(:v_phase = 'POST3' AND :v_has_chain AND :v_chain_result IS NULL, :v_smart = 0, NULL), CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 14, 'Retired trips still in DAILY_ACTIVITY_SUMMARY',
         IFF(:v_phase = 'POST3', '0', 'any for now'), IFF(:v_has_chain, TO_VARCHAR(:v_das), 'n/a (no chain)'),
         IFF(:v_phase = 'POST3' AND :v_has_chain AND :v_chain_result IS NULL, :v_das = 0, NULL), CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 15, 'Retired trips still in the trip-number gap metric',
         IFF(:v_phase = 'POST3', '0', 'any for now'), IFF(:v_has_chain, TO_VARCHAR(:v_gap), 'n/a (no chain)'),
         IFF(:v_phase = 'POST3' AND :v_has_chain AND :v_chain_result IS NULL, :v_gap = 0, NULL), CURRENT_TIMESTAMP()),
        (:v_run, :v_phase, 99, 'RESULT',
         :v_reason, :v_result, IFF(:v_result = 'WAITING', NULL, :v_result = 'PASS'), CURRENT_TIMESTAMP());

    LET rs RESULTSET := (SELECT check_name, expected, actual, passed
                         FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
                         WHERE run_id = :v_run AND phase = :v_phase
                           AND checked_at = (SELECT MAX(checked_at) FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_CHECKS
                                             WHERE run_id = :v_run AND phase = :v_phase)
                         ORDER BY check_no);
    RETURN TABLE(rs);
END;
$$;


-- -----------------------------------------------------------------------------
-- 5. ROLLBACK: undo one committed run, or every committed run not yet
--    undone (Part 8 of the runbook). Pass a run_id from DAASI_3641_RUNS, or 'ALL'.
-- -----------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_ROLLBACK(P_RUN_ID VARCHAR)
COPY GRANTS
RETURNS TABLE (CHECK_NAME VARCHAR, EXPECTED VARCHAR, ACTUAL VARCHAR, PASSED BOOLEAN)
LANGUAGE SQL
COMMENT = 'DAASI-3641: undoes one committed run (its run_id) or every committed run (''ALL''): takes back the new trips and brings back the retired ones, from the copies kept at retire time if the archival step removed them.'
EXECUTE AS CALLER
AS
$$
DECLARE
    v_has_chain      BOOLEAN DEFAULT FALSE;
    v_autocommit     VARCHAR;
    v_rb_id          VARCHAR;
    v_err            VARCHAR;
    v_task_state     VARCHAR;
    v_locked         BOOLEAN DEFAULT FALSE;
    v_logged         BOOLEAN DEFAULT FALSE;
    v_holds_lock     BOOLEAN DEFAULT FALSE;
    v_chain_paused   BOOLEAN DEFAULT FALSE;
    v_resumed        BOOLEAN DEFAULT TRUE;
    v_in_txn         BOOLEAN DEFAULT FALSE;
    v_n              NUMBER DEFAULT 0;
    v_waited         NUMBER DEFAULT 0;
    v_scope          NUMBER DEFAULT 0;
    v_new_live       NUMBER DEFAULT 0;
    v_old_not_live   NUMBER DEFAULT 0;
    v_no_market      NUMBER DEFAULT 0;
    v_failed         NUMBER DEFAULT 0;
    e_bad_arg        EXCEPTION (-20646, 'DAASI-3641: pass a run_id exactly as DAASI_3641_RUNS shows it, or ''ALL''.');
    e_nothing        EXCEPTION (-20648, 'DAASI-3641: no committed run matches that run_id (it may have been rolled back already). Nothing was changed.');
    e_run_active     EXCEPTION (-20643, 'DAASI-3641: another run holds the run lock (DAASI_3641_LOCK shows which). Nothing was changed. If that run was cancelled or timed out: CALL DAASI_3641_RECOVER(''<run_id>'').');
    e_chain_busy     EXCEPTION (-20642, 'DAASI-3641: the trip chain stayed busy for an hour, so nothing was changed and the chain was resumed. Try again later.');
    e_no_chain       EXCEPTION (-20645, 'DAASI-3641: cannot see the trip root task, so the chain cannot be paused. Nothing was changed. Check that this role has OPERATE on it.');
    e_rb_failed      EXCEPTION (-20649, 'DAASI-3641: a rollback check failed, so the rollback itself was rolled back and nothing changed. Details: DAASI_3641_CHECKS, latest ROLLBACK run.');
    e_autocommit     EXCEPTION (-20650, 'DAASI-3641: this session has AUTOCOMMIT off. Run ALTER SESSION SET AUTOCOMMIT = TRUE; and call again. Nothing was changed.');
    e_chain_paused   EXCEPTION (-20651, 'DAASI-3641: the trip chain is already paused by someone else, so nothing was changed. Run again once it is resumed.');
    e_superseded     EXCEPTION (-20655, 'DAASI-3641: RECOVER had closed this rollback as cut off before it could commit, so it rolled back. Nothing was kept.');
BEGIN
    SHOW PARAMETERS LIKE 'AUTOCOMMIT' IN SESSION;
    SELECT MAX("value") INTO :v_autocommit FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
    IF (LOWER(COALESCE(v_autocommit, 'true')) <> 'true') THEN
        RAISE e_autocommit;
    END IF;
    IF (P_RUN_ID IS NULL OR (P_RUN_ID <> 'ALL' AND NOT REGEXP_LIKE(P_RUN_ID, '[0-9]{8}_[0-9]{6,9}'))) THEN
        RAISE e_bad_arg;
    END IF;

    EXECUTE IMMEDIATE 'ALTER SESSION SET TIMEZONE = ''America/Los_Angeles''';
    IF (COALESCE(CURRENT_WAREHOUSE(), '') <> 'DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE') THEN
        EXECUTE IMMEDIATE 'USE WAREHOUSE DAAS_PROD_STRATEGICANALYTICS_BIG_COMPUTE';
    END IF;
    EXECUTE IMMEDIATE 'ALTER SESSION SET LOCK_TIMEOUT = 900';
    EXECUTE IMMEDIATE 'ALTER SESSION SET TRANSACTION_ABORT_ON_ERROR = FALSE';
    BEGIN
        EXECUTE IMMEDIATE 'ALTER SESSION SET STATEMENT_TIMEOUT_IN_SECONDS = 604800';
    EXCEPTION
        WHEN OTHER THEN
            v_n := 0;
    END;

    -- the run's record first, then the lock
    v_rb_id := TO_VARCHAR(CURRENT_TIMESTAMP(), 'YYYYMMDD_HH24MISSFF3');
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
        (run_id, kind, status, chain_paused, started_at, run_by, session_id, message)
    VALUES
        (:v_rb_id, 'ROLLBACK', 'STARTED', FALSE, CURRENT_TIMESTAMP(), CURRENT_USER(), CURRENT_SESSION(),
         'Started: rollback of ' || :P_RUN_ID || '.');
    v_logged := TRUE;
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOCK SET holder = :v_rb_id, since = CURRENT_TIMESTAMP() WHERE holder IS NULL;
    IF (SQLROWCOUNT = 0) THEN
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = 'LOCK_BUSY', finished_at = CURRENT_TIMESTAMP(), message = 'Another run held the lock; nothing was done.'
         WHERE run_id = :v_rb_id;
        RAISE e_run_active;
    END IF;
    v_locked := TRUE;

    -- Only committed runs that have not been undone already.
    SELECT COUNT(*) INTO :v_scope
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
    WHERE kind = 'RUN' AND status = 'COMMITTED' AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID);
    IF (v_scope = 0) THEN
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'NOTHING_TO_DO', message = 'No committed run matches ' || :P_RUN_ID || '.'
         WHERE run_id = :v_rb_id;
        RAISE e_nothing;
    END IF;

    IF (v_has_chain) THEN
        SHOW TASKS LIKE 'TRIP_ROOT_TASK' IN SCHEMA DAAS_PROD.DAAS_COMMON;
        SELECT MAX("state") INTO :v_task_state FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
        IF (v_task_state IS NULL) THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'ERROR', message = 'Trip root task not visible to this role'
             WHERE run_id = :v_rb_id;
            RAISE e_no_chain;
        END IF;
        IF (v_task_state <> 'started') THEN
            UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'CHAIN_PAUSED', message = 'The trip chain was already paused.'
             WHERE run_id = :v_rb_id;
            RAISE e_chain_paused;
        END IF;
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET chain_paused = TRUE WHERE run_id = :v_rb_id;
        v_resumed := FALSE;
        ALTER TASK DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK SUSPEND;
        v_chain_paused := TRUE;
        LOOP
            SELECT COUNT(*) INTO :v_n
            FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.CURRENT_TASK_GRAPHS(ROOT_TASK_NAME => 'TRIP_ROOT_TASK'))
            WHERE database_name = 'DAAS_PROD' AND schema_name = 'DAAS_COMMON' AND state = 'EXECUTING';
            IF (v_n = 0) THEN
                BREAK;
            END IF;
            IF (v_waited >= 3600) THEN
                UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS SET status = 'CHAIN_BUSY' WHERE run_id = :v_rb_id;
                RAISE e_chain_busy;
            END IF;
            SELECT SYSTEM$WAIT(30);
            v_waited := v_waited + 30;
        END LOOP;
    END IF;

    BEGIN TRANSACTION;
    v_in_txn := TRUE;

    -- 8.1 take back the new market trips and all their detail rows; only trips the fix created
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL
       SET delete_ind = 'Y', last_dml_cd = 'U',
           updated_dttm = CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, updated_by = 'DAASI-3641-ROLLBACK'
     WHERE delete_ind = 'N'
       AND trip_master_id IN (SELECT t.trip_master_id
                              FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
                              WHERE t.created_by = 'DAASI-3641'
                                AND t.trip_master_id IN (SELECT l.new_trip_master_id
                                                         FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
                                                         WHERE l.action = 'COPY'
                                                           AND l.run_id IN (SELECT run_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
                                                                            WHERE kind = 'RUN' AND status = 'COMMITTED'
                                                                              AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID))));

    UPDATE DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
       SET delete_ind = 'Y', last_dml_cd = 'U',
           updated_dttm = CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, updated_by = 'DAASI-3641-ROLLBACK'
     WHERE delete_ind = 'N'
       AND created_by = 'DAASI-3641'
       AND trip_master_id IN (SELECT l.new_trip_master_id
                              FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
                              WHERE l.action = 'COPY'
                                AND l.run_id IN (SELECT run_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
                                                 WHERE kind = 'RUN' AND status = 'COMMITTED'
                                                   AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID)));

    -- 8.2 bring back retired trips still in place
    UPDATE DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL
       SET delete_ind = 'N', last_dml_cd = 'U',
           updated_dttm = CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, updated_by = 'DAASI-3641-ROLLBACK'
     WHERE delete_ind = 'Y'
       AND updated_by = 'DAASI-3641'
       AND trip_master_id IN (SELECT l.trip_master_id
                              FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
                              WHERE l.action = 'RETIRE'
                                AND l.run_id IN (SELECT run_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
                                                 WHERE kind = 'RUN' AND status = 'COMMITTED'
                                                   AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID)));

    UPDATE DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
       SET delete_ind = 'N', last_dml_cd = 'U',
           updated_dttm = CURRENT_TIMESTAMP()::TIMESTAMP_NTZ, updated_by = 'DAASI-3641-ROLLBACK'
     WHERE delete_ind = 'Y'
       AND updated_by = 'DAASI-3641'
       AND trip_master_id IN (SELECT l.trip_master_id
                              FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
                              WHERE l.action = 'RETIRE'
                                AND l.run_id IN (SELECT run_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
                                                 WHERE kind = 'RUN' AND status = 'COMMITTED'
                                                   AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID)));

    -- 8.3 put back retired rows the archival step already removed, exactly as they were
    --     when the run retired them (the newest kept copy, if a trip was retired twice)
    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER
    SELECT r.* EXCLUDE (run_id)
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TM r
    WHERE r.run_id IN (SELECT run_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
                       WHERE kind = 'RUN' AND status = 'COMMITTED'
                         AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID))
      AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t WHERE t.trip_master_id = r.trip_master_id)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY r.trip_master_id ORDER BY r.run_id DESC) = 1;

    INSERT INTO DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL
    SELECT r.* EXCLUDE (run_id)
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RETIRED_TD r
    WHERE r.run_id IN (SELECT run_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
                       WHERE kind = 'RUN' AND status = 'COMMITTED'
                         AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID))
      AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_DETAIL t WHERE t.trip_detail_id = r.trip_detail_id)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY r.trip_detail_id ORDER BY r.run_id DESC) = 1;

    -- checks before committing the rollback
    SELECT COUNT(*) INTO :v_new_live
    FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
    WHERE t.created_by = 'DAASI-3641' AND t.delete_ind = 'N'
      AND t.trip_master_id IN (SELECT l.new_trip_master_id
                               FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
                               WHERE l.action = 'COPY'
                                 AND l.run_id IN (SELECT run_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
                                                  WHERE kind = 'RUN' AND status = 'COMMITTED'
                                                    AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID)));

    SELECT COUNT(DISTINCT l.trip_master_id) INTO :v_old_not_live
    FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_LOG l
    WHERE l.action = 'RETIRE'
      AND l.run_id IN (SELECT run_id FROM DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
                       WHERE kind = 'RUN' AND status = 'COMMITTED'
                         AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID))
      AND NOT EXISTS (SELECT 1 FROM DAAS_UAT.DAAS_TEMP_WORK.TRIP_MASTER t
                      WHERE t.trip_master_id = l.trip_master_id AND t.delete_ind = 'N');

    v_failed := IFF(v_new_live = 0, 0, 1) + IFF(v_old_not_live = 0, 0, 1);
    IF (v_failed = 0) THEN
        -- the records change in the same transaction as the data: this run first
        -- (one RECOVER has closed rolls back instead), then the undone runs
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = 'COMMITTED', committed_at = CURRENT_TIMESTAMP(),
               message = 'Rolled back ' || :P_RUN_ID || ' (' || TO_VARCHAR(:v_scope) || ' run(s)).'
         WHERE run_id = :v_rb_id AND status = 'STARTED';
        IF (SQLROWCOUNT = 0) THEN
            RAISE e_superseded;
        END IF;
        UPDATE DAAS_UAT.DAAS_TEMP_WORK.DAASI_3641_RUNS
           SET status = 'ROLLED_BACK', message = LEFT(COALESCE(message, '') || ' Rolled back by run ' || :v_rb_id || '.', 4000)
         WHERE kind = 'RUN' AND status = 'COMMITTED' AND (:P_RUN_ID = 'ALL' OR run_id = :P_RUN_ID);
        COMMIT;
        v_in_txn := FALSE