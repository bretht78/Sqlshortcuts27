-- K8b. The time limits the bulk run needs, read from the tasks' own definitions: the summary task 6 hours or more
--      (4 now), the comp-worth task a limit of its own of 3 hours or more (none now). Until both show, the RUN file
--      stops before the bulk run with the four statements for the tasks' owner.
SELECT ROUND(TRY_TO_NUMBER(REGEXP_SUBSTR(REPLACE(UPPER(GET_DDL('TASK', 'DAAS_PROD.DAAS_COMMON.TRIP_ROOT_TASK')), ' ', ''),
                                        'USER_TASK_TIMEOUT_MS=([0-9]+)', 1, 1, 'e', 1)) / 3600000, 1)                AS root_task_hours,
       ROUND(TRY_TO_NUMBER(REGEXP_SUBSTR(REPLACE(UPPER(GET_DDL('TASK', 'DAAS_PROD.DAAS_COMMON.CORE2CORE_TRIP_SUMMARY_LOAD_TASK')), ' ', ''),
                                        'USER_TASK_TIMEOUT_MS=([0-9]+)', 1, 1, 'e', 1)) / 3600000, 1)                AS summary_task_hours,
