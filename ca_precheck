                                        'USER_TASK_TIMEOUT_MS=([0-9]+)', 1, 1, 'e', 1)) / 3600000, 1)                AS comp_worth_task_hours_own;


-- K9. The caps the pipeline will cut with, read through its own TRIP_CONFIG functions on every date the live BEM/WLM
--     market trips span, from the earliest start to the latest end (or today, if later), as the RUN's C2 does. Expect
--     no rows: every date reads MAX_TRIP_DAYS BEM 1, WLM 3, IBE 1, IWA 3 and TRIP_GAP_DAYS 1. Each row is a stretch of
--     dates that reads otherwise (-1 = no config row covers the date, which would keep the date-cutting step looping
--     until its time limit). The RUN stops on any.
WITH span AS (
    SELECT MIN(trip_start_dt) AS first_dt,
           GREATEST(COALESCE(MAX(trip_end_dt), CURRENT_DATE()), CURRENT_DATE()) AS last_dt
    FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER
    WHERE trip_type = 'MARKET' AND delete_ind = 'N' AND market_cd IN ('BEM', 'WLM')
),
d AS (
    SELECT DATEADD(day, g.n, s.first_dt) AS dt
    FROM (SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS n FROM TABLE(GENERATOR(ROWCOUNT => 40000))) g
    CROSS JOIN span s
    WHERE DATEADD(day, g.n, s.first_dt) <= s.last_dt
),
caps AS (
    SELECT d.dt,
           COALESCE(TRY_TO_NUMBER(DAAS_PROD.DAAS_COMMON.TRIP_CONFIG_UDF_MARKET('MAX_TRIP_DAYS', 'BEM', TO_VARCHAR(d.dt, 'YYYY-MM-DD'))), -1)   AS bem_days,
           COALESCE(TRY_TO_NUMBER(DAAS_PROD.DAAS_COMMON.TRIP_CONFIG_UDF_MARKET('MAX_TRIP_DAYS', 'WLM', TO_VARCHAR(d.dt, 'YYYY-MM-DD'))), -1)   AS wlm_days,
           COALESCE(TRY_TO_NUMBER(DAAS_PROD.DAAS_COMMON.TRIP_CONFIG_UDF_PROPERTY('MAX_TRIP_DAYS', 'IBE', TO_VARCHAR(d.dt, 'YYYY-MM-DD'))), -1) AS ibe_days,
           COALESCE(TRY_TO_NUMBER(DAAS_PROD.DAAS_COMMON.TRIP_CONFIG_UDF_PROPERTY('MAX_TRIP_DAYS', 'IWA', TO_VARCHAR(d.dt, 'YYYY-MM-DD'))), -1) AS iwa_days,
           COALESCE(TRY_TO_NUMBER(DAAS_PROD.DAAS_COMMON.TRIP_CONFIG_UDF_MARKET('TRIP_GAP_DAYS', 'BEM', TO_VARCHAR(d.dt, 'YYYY-MM-DD'))), -1)   AS bem_gap,
           COALESCE(TRY_TO_NUMBER(DAAS_PROD.DAAS_COMMON.TRIP_CONFIG_UDF_MARKET('TRIP_GAP_DAYS', 'WLM', TO_VARCHAR(d.dt, 'YYYY-MM-DD'))), -1)   AS wlm_gap,
           COALESCE(TRY_TO_NUMBER(DAAS_PROD.DAAS_COMMON.TRIP_CONFIG_UDF_PROPERTY('TRIP_GAP_DAYS', 'IBE', TO_VARCHAR(d.dt, 'YYYY-MM-DD'))), -1) AS ibe_gap,
           COALESCE(TRY_TO_NUMBER(DAAS_PROD.DAAS_COMMON.TRIP_CONFIG_UDF_PROPERTY('TRIP_GAP_DAYS', 'IWA', TO_VARCHAR(d.dt, 'YYYY-MM-DD'))), -1) AS iwa_gap
    FROM d
),
odd AS (
    SELECT c.*,
           DATEADD(day, -ROW_NUMBER() OVER (PARTITION BY bem_days, wlm_days, ibe_days, iwa_days, bem_gap, wlm_gap, ibe_gap, iwa_gap
                                            ORDER BY dt), dt) AS stretch
    FROM caps c
    WHERE NOT (bem_days = 1 AND wlm_days = 3 AND ibe_days = 1 AND iwa_days = 3
               AND bem_gap = 1 AND wlm_gap = 1 AND ibe_gap = 1 AND iwa_gap = 1)
)
SELECT MIN(dt) AS from_date, MAX(dt) AS to_date, COUNT(*) AS dates,
       bem_days, wlm_days, ibe_days, iwa_days, bem_gap, wlm_gap, ibe_gap, iwa_gap
FROM odd
GROUP BY stretch, bem_days, wlm_days, ibe_days, iwa_days, bem_gap, wlm_gap, ibe_gap, iwa_gap
ORDER BY 1;


-- K10. The downstream objects the bulk run pauses, as they stand now: 11 dynamic tables in DAAS_CORE, 9 in
--      DAAS_TIBCO_DWS and 4 tasks in DAAS_TIBCO_SMART (August's list). Expect RUNNING and started. One that is already
--      SUSPENDED is left alone by the run and by the resume file, for its owner to decide (August's runbook paused
--      TRIP_SUMMARY_18MO and its resume list left it out). Empty results only mean this role cannot see them.
