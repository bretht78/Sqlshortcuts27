       AND "name" IN ('TRIP_SUMMARY_DT', 'DAILY_SUMMARY_DT', 'TRIP_DETAILS_GAMING_DT', 'TRIP_DETAILS_COMP_DT', 'TRIP_DETAILS_POS_DT',
                      'TRIP_DETAILS_FREEPLAY_DT', 'TRIP_DETAILS_OFFER_DT', 'TRIP_DETAILS_MARKERS_DT',
                      'TRIP_DETAILS_HOTEL_RESERVATIONS_DT', 'TRIP_DETAILS_HOTEL_FOLIOS_DT', 'DAILY_SUMMARY_YEAR_MONTH_METRICS'))
   OR ("schema_name" = 'DAAS_TIBCO_DWS'
       AND "name" IN ('TRIP_SUMMARY_18MO', 'GST_12_MONTH_PLUS', 'GST_24_MONTH_PLUS', 'GST_ACTIVITY_FTD', 'GST_PDB_TRIP',
                      'NG_SPEND_BY_CATG', 'RMS_TRIPS', 'TRIP_NG_REVENUE_SUMMARY', 'TRIP_SUMMARY'))
