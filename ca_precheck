-- K10b. What each dynamic table reads, from Snowflake's own graph, and the fewest days of change history any table it
--       reads keeps. A dynamic table paused for longer than its tables keep history cannot resume normally, so that
--       number, not K4b's, is the real room for the pause (the bulk run pauses for hours: 1 day or more is room enough).
--       Rows: the 20 dynamic tables of K10 (in_runs_list Y), and any other dynamic table that reads a trip table or a
--       TIBCO DWS table (N). An N row is not paused by the run and refreshes through it: tell Pete before run 2. A view
--       among the inputs hides its own tables (look those up if the fewest days is blank); an input in another
--       database shows no days here. Blank inputs or state only mean this role lacks MONITOR on that dynamic table.
WITH g AS (
    SELECT schema_name, name, scheduling_state:state::STRING AS state, inputs,
           (schema_name = 'DAAS_CORE'
            AND name IN ('TRIP_SUMMARY_DT', 'DAILY_SUMMARY_DT', 'TRIP_DETAILS_GAMING_DT', 'TRIP_DETAILS_COMP_DT', 'TRIP_DETAILS_POS_DT',
                         'TRIP_DETAILS_FREEPLAY_DT', 'TRIP_DETAILS_OFFER_DT', 'TRIP_DETAILS_MARKERS_DT',
                         'TRIP_DETAILS_HOTEL_RESERVATIONS_DT', 'TRIP_DETAILS_HOTEL_FOLIOS_DT', 'DAILY_SUMMARY_YEAR_MONTH_METRICS'))
        OR (schema_name = 'DAAS_TIBCO_DWS'
            AND name IN ('TRIP_SUMMARY_18MO', 'GST_12_MONTH_PLUS', 'GST_24_MONTH_PLUS', 'GST_ACTIVITY_FTD', 'GST_PDB_TRIP',
                         'NG_SPEND_BY_CATG', 'RMS_TRIPS', 'TRIP_NG_REVENUE_SUMMARY', 'TRIP_SUMMARY')) AS in_list
    FROM TABLE(DAAS_PROD.INFORMATION_SCHEMA.DYNAMIC_TABLE_GRAPH_HISTORY())
    WHERE database_name = 'DAAS_PROD' AND valid_to IS NULL
),
i AS (
    SELECT g.schema_name, g.name, g.state, g.in_list,
           UPPER(REPLACE(f.value:name::STRING, '"', '')) AS input_name, LOWER(f.value:kind::STRING) AS input_kind
    FROM g, LATERAL FLATTEN(input => g.inputs, outer => TRUE) f
)
SELECT i.schema_name, i.name, IFF(i.in_list, 'Y', 'N') AS in_runs_list, i.state,
       LISTAGG(i.input_name || ' (' || i.input_kind || ')', ', ') WITHIN GROUP (ORDER BY i.input_name) AS reads,
       MIN(t.retention_time) AS fewest_history_days
FROM i
LEFT JOIN DAAS_PROD.INFORMATION_SCHEMA.TABLES t
       ON i.input_name = t.table_catalog || '.' || t.table_schema || '.' || t.table_name
GROUP BY i.schema_name, i.name, i.in_list, i.state
HAVING i.in_list
    OR BOOLOR_AGG(i.input_name LIKE 'DAAS_PROD.DAAS_CORE.TRIP%' OR i.input_name LIKE 'DAAS_PROD.DAAS_CORE.DAILY%'
                  OR i.input_name LIKE 'DAAS_PROD.DAAS_TIBCO_DWS.%')
ORDER BY in_runs_list DESC, 1, 2;