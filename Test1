WITH snap AS (
    SELECT GREATEST(MAX(created_dttm), MAX(updated_dttm)) AS backup_as_of
    FROM DAAS_PROD.DAAS_BACKUP.TRIP_MASTER_DAASI_3376_20260812
),
before_ AS (
    SELECT trip_master_id
    FROM DAAS_PROD.DAAS_BACKUP.TRIP_MASTER_DAASI_3376_20260812
    WHERE trip_type = 'MARKET' AND market_cd = 'VAM'
),
now_ AS (
    SELECT trip_master_id
    FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER
    WHERE trip_type = 'MARKET' AND market_cd = 'VAM'
)
SELECT s.backup_as_of,
       COUNT_IF(n.trip_master_id IS NULL)                                      AS vam_trips_gone,
       COUNT_IF(b.trip_master_id IS NULL)                                      AS vam_trips_new,
       COUNT_IF(b.trip_master_id IS NOT NULL AND n.trip_master_id IS NOT NULL) AS vam_trips_kept
FROM before_ b
FULL OUTER JOIN now_ n
  ON n.trip_master_id = b.trip_master_id
CROSS JOIN snap s
GROUP BY s.backup_as_of;


WITH gone AS (
    SELECT b.trip_master_id
    FROM DAAS_PROD.DAAS_BACKUP.TRIP_MASTER_DAASI_3376_20260812 b
    LEFT JOIN DAAS_PROD.DAAS_CORE.TRIP_MASTER t
           ON t.trip_master_id = b.trip_master_id
    WHERE b.trip_type = 'MARKET'
      AND b.market_cd = 'VAM'
      AND t.trip_master_id IS NULL
)
SELECT 'TRIP_DETAIL'                    AS downstream_table,
       COUNT(DISTINCT x.trip_master_id) AS replaced_trips_still_there
FROM DAAS_PROD.DAAS_CORE.TRIP_DETAIL x
JOIN gone g ON g.trip_master_id = x.trip_master_id
UNION ALL
SELECT 'TRIP_SUMMARY', COUNT(DISTINCT x.trip_master_id)
FROM DAAS_PROD.DAAS_CORE.TRIP_SUMMARY x
JOIN gone g ON g.trip_master_id = x.trip_master_id
UNION ALL
SELECT 'DAILY_ACTIVITY_SUMMARY', COUNT(DISTINCT x.trip_master_id)
FROM DAAS_PROD.DAAS_CORE.DAILY_ACTIVITY_SUMMARY x
JOIN gone g ON g.trip_master_id = x.trip_master_id
UNION ALL
SELECT 'DAAS_TRIP_NUM_GAP_DAILY_METRIC_MKTENT', COUNT(DISTINCT x.trip_master_id)
FROM DAAS_PROD.DAAS_CORE.DAAS_TRIP_NUM_GAP_DAILY_METRIC_MKTENT x
JOIN gone g ON g.trip_master_id = x.trip_master_id;


-- 1c. The platform's own rebuild queue. First, see its columns:
SELECT * FROM DAAS_PROD.DAAS_CORE.TRIP_RECALC_QUEUE LIMIT 5;

--     Then: what was queued around Aug 12, labeled by market from the Aug 12 backup.
--     (If CREATED_DTTM isn't a column, use whichever timestamp the peek shows.)
--       VAM only    -> BEM/WLM were never queued; the native path deserves a pilot.
--       BEM/WLM too -> they were queued and still not split; use the copy fix.
SELECT DATE_TRUNC('hour', q.created_dttm)                      AS queued_hour,
       b.trip_type,
       IFF(b.trip_type = 'MARKET', b.market_cd, b.property_cd) AS trip_owner,
       COUNT(*)                                                AS queued_rows
FROM DAAS_PROD.DAAS_CORE.TRIP_RECALC_QUEUE q
LEFT JOIN DAAS_PROD.DAAS_BACKUP.TRIP_MASTER_DAASI_3376_20260812 b
       ON b.trip_master_id = q.trip_master_id
WHERE q.created_dttm >= '2026-08-11'
  AND q.created_dttm <  '2026-08-14'
GROUP BY ALL
ORDER BY 1, 4 DESC;


SHOW TASKS LIKE 'INSERT_TRIP_RECALC_QUEUE' IN SCHEMA DAAS_PROD.DAAS_ADHOC;
SELECT "definition" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));

SELECT procedure_name,
       procedure_definition ILIKE '%trip_config%'          AS reads_trip_config,
       procedure_definition ILIKE '%recalc_queue%'         AS reads_recalc_queue,
       procedure_definition ILIKE '%delete from%'          AS hard_deletes,
       procedure_definition ILIKE '%delete_ind%'           AS uses_delete_ind,
       procedure_definition ILIKE '%trip_identifier_proc%' AS calls_trip_identifier,
       LENGTH(procedure_definition)                        AS source_chars
FROM SNOWFLAKE.ACCOUNT_USAGE.PROCEDURES
WHERE procedure_catalog = 'DAAS_PROD'
  AND deleted IS NULL
  AND procedure_name IN ('TRIP_RECALCULATION_PROC', 'TRIP_CONFIG_UPDATE_PROC');


SELECT tm.property_cd,
       YEAR(tm.trip_start_dt)                                   AS start_year,
       IFF(h.trip_master_id IS NULL, 'no hotel', 'hotel')       AS stay,
       COUNT(*)                                                 AS over_cap_trips,
       MAX(DATEDIFF(day, tm.trip_start_dt, tm.trip_end_dt) + 1) AS longest_days
FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER tm
LEFT JOIN (
    SELECT DISTINCT trip_master_id
    FROM DAAS_PROD.DAAS_CORE.TRIP_DETAIL
    WHERE transaction_type = 'HOTEL'
      AND delete_ind = 'N'
      AND property_cd IN ('IBE', 'IWA')
) h ON h.trip_master_id = tm.trip_master_id
WHERE tm.trip_type = 'PROPERTY'
  AND tm.delete_ind = 'N'
  AND tm.property_cd IN ('IBE', 'IWA')
  AND DATEDIFF(day, tm.trip_start_dt, tm.trip_end_dt) + 1
      > DECODE(tm.property_cd, 'IBE', 1, 'IWA', 3)
GROUP BY ALL
ORDER BY 1, 2, 3;


SELECT COUNT(DISTINCT tm.trip_master_id)  AS deleted_trips,
       COUNT(DISTINCT t18.trip_master_id) AS still_in_tibco_18mo,
       COUNT(DISTINCT dws.trip_master_id) AS still_in_tibco_dws,
       COUNT(DISTINCT sm.trip_master_id)  AS still_in_tibco_smart
FROM DAAS_PROD.DAAS_CORE.TRIP_MASTER tm
LEFT JOIN DAAS_PROD.DAAS_TIBCO_DWS.TRIP_SUMMARY_18MO t18
       ON t18.trip_master_id = tm.trip_master_id
LEFT JOIN DAAS_PROD.DAAS_TIBCO_DWS.TRIP_SUMMARY dws
       ON dws.trip_master_id = tm.trip_master_id
LEFT JOIN DAAS_PROD.DAAS_TIBCO_SMART.TRIP_SUMMARY sm
       ON sm.trip_master_id = tm.trip_master_id
WHERE tm.delete_ind = 'Y'
  AND ((tm.trip_type = 'MARKET'   AND tm.market_cd   IN ('VAM', 'BEM', 'WLM'))
    OR (tm.trip_type = 'PROPERTY' AND tm.property_cd IN ('CDA', 'IBE', 'IWA')));


SELECT table_schema, table_name, row_count
FROM TABLE(RESULT_SCAN('<paste C1 query ID here>'))
WHERE trip_columns ILIKE '%TRIP_MASTER_ID%'
  AND table_type = 'BASE TABLE'
  AND table_catalog = 'DAAS_PROD'
  AND table_schema <> 'DAAS_BACKUP'
