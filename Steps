ALTER DYNAMIC TABLE DAAS_PROD.DAAS_TIBCO_DWS.TRIP_SUMMARY_18MO SUSPEND;
ALTER DYNAMIC TABLE DAAS_PROD.DAAS_CORE.TRIP_SUMMARY_DT SUSPEND;
ALTER DYNAMIC TABLE DAAS_PROD.DAAS_CORE.DAILY_SUMMARY_YEAR_MONTH_METRICS SUSPEND;
