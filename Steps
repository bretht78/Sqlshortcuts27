ALTER DYNAMIC TABLE DAAS_PROD.DAAS_CORE.TRIP_DETAILS_GAMING_DT SUSPEND;
ALTER DYNAMIC TABLE DAAS_PROD.DAAS_CORE.TRIP_DETAILS_COMP_DT SUSPEND;
ALTER DYNAMIC TABLE DAAS_PROD.DAAS_CORE.TRIP_DETAILS_POS_DT SUSPEND;
ALTER DYNAMIC TABLE DAAS_PROD.DAAS_CORE.TRIP_DETAILS_FREEPLAY_DT SUSPEND;
