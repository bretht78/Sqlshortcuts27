						WHEN CMPRW_RAW.RDTMRW - OFFSET_CONTROL.OFFSET  < 000000 THEN '00:00:00'::TIME
						WHEN SUBSTR(SUBSTR('000000', 1, 6-(LENGTH((CMPRW_RAW.RDTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6)))) || (CMPRW_RAW.RDTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6) , 1, 2)::INTEGER >= 24 THEN '00:00:00'::TIME
