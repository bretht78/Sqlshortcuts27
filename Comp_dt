						WHEN SUBSTR(SUBSTR('000000', 1, 6-(LENGTH((CMPRW_RAW.TRTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6)))) || (CMPRW_RAW.TRTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6) , 3, 2)::INTEGER >= 60 THEN '00:00:00'::TIME
						WHEN SUBSTR(SUBSTR('000000', 1, 6-(LENGTH((CMPRW_RAW.TRTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6)))) || (CMPRW_RAW.TRTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6) , 5, 2)::INTEGER >= 60 THEN '00:00:00'::TIME
						ELSE TO_CHAR((SUBSTR('000000', 1, 6 - LENGTH((CMPRW_RAW.TRTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6))) || (CMPRW_RAW.TRTMRW - OFFSET_CONTROL.OFFSET)::CHAR(6))::INTEGER,  '00:00:00')::TIME
