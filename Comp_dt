				DECODE(CMPRW_RAW.CRHDRW, 0, '1899-12-31'::DATE, CMPRW_RAW.CRHDRW + '1899-12-31'::DATE), ' ',
				CASE WHEN CMPRW_RAW.CRTMRW >= 240000 THEN '00:00:00'::TIME ELSE 
        LPAD(
            CASE WHEN CMPRW_RAW.CRTMRW = 240000 THEN 0 ELSE CMPRW_RAW.CRTMRW END,
