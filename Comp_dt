		END
			) AS CREATE_DTTM, 
			/*CONCAT(
				"DAAS_COMMON"."HUNDRED_YEAR_BUSINESS_DATE_CON_UDF"(CMPRW_RAW.TRHDRW), ' ',
				DATEADD(HOUR, HOUR_TXT,
					CASE 
						WHEN CMPRW_RAW.TRTMRW - OFFSET_CONTROL.OFFSET  > 240000 THEN '00:00:00'::TIME
						WHEN CMPRW_RAW.TRTMRW - OFFSET_CONTROL.OFFSET  < 000000 THEN '00:00:00'::TIME
