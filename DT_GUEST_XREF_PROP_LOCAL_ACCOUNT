-- DAASI-3612: HLT local accounts no longer show as hosted (HOST_CD = '' for HLT rows).
create or replace task DAAS_COMMON.DT_GUEST_XREF_PROP_LOCAL_ACCOUNT
	warehouse=DAAS_PROD_IT_DT_COMPUTE
	schedule='USING CRON */15 * * * * America/Los_Angeles'
	as BEGIN
    INSERT OVERWRITE INTO DAAS_CORE.GUEST_XREF_PROP_LOCAL_ACCOUNT (PROPERTY_CD, GUEST_UNIQUE_ID, LOCAL_WINNET, LOCAL_CASINO_NBR, HOST_CD, SOURCE_UPDATED_DTTM)
    SELECT COALESCE(CAS_DTL.PROPERTY_CD,PRIMARY.PROPERTY_CD) AS PROPERTY_CD
        ,COALESCE(CAS_DTL.GUEST_UNIQUE_ID,PRIMARY.GUEST_UNIQUE_ID) AS GUEST_UNIQUE_ID
        ,COALESCE(CAS_DTL.LOCAL_WINNET,PRIMARY.LOCAL_WINNET) AS LOCAL_WINNET
        ,COALESCE(CAS_DTL.LOCAL_CASINO_NBR,PRIMARY.LOCAL_CASINO_NBR) AS LOCAL_CASINO_NBR
        -- DAASI-3612: HLT's CMS has been combined with TAH, so HLT host codes are no longer current.
        -- HLT rows publish as unhosted (''), the same empty value unhosted accounts already carry.
        -- Applied after account selection, so the REPNO tie-breaks below still pick the same account.
        ,CASE WHEN COALESCE(CAS_DTL.PROPERTY_CD,PRIMARY.PROPERTY_CD) = 'HLT' THEN ''
              ELSE COALESCE(CAS_DTL.HOST_CD,PRIMARY.HOST_CD)
         END AS HOST_CD
        ,COALESCE(CAS_DTL.SOURCE_UPDATED_DTTM,PRIMARY.SOURCE_UPDATED_DTTM) AS SOURCE_UPDATED_DTTM
    FROM (
                SELECT PROPERTY_CD, BRDG.PRIMARY_ACCOUNT_NBR AS GUEST_UNIQUE_ID, BRDG.XREF_ACCOUNT_NBR AS LOCAL_WINNET, CMSID AS LOCAL_CASINO_NBR, REPNO AS HOST_CD, OPERATION_DATE AS SOURCE_UPDATED_DTTM
                FROM (
                    SELECT PROP.PROPERTY_CD, PROP.PROPERTY_ID*100000000+CMSID AS GUEST_UNIQUE_ID, CMPMS_SUB.*
                    FROM (
                        SELECT PROPERTY_CODE, CMSID,  CMBTMS, SCDEMS, CTYPMS, CESTD, REPNO, OPERATION_DATE, "ALIM$", OPERATION_TYPE
                        FROM DAAS_RAW_HETCMS.CMPMS_RAW
                        QUALIFY ROW_NUMBER() OVER(PARTITION BY PROPERTY_CODE, CMSID ORDER BY OPERATION_DATE DESC, OPERATION_SEQUENCE_NBR DESC, CREATED_DATE DESC )=1
                        ) CMPMS_SUB
                    	JOIN DAAS_CORE.PROPERTY_DIM PROP
                       	 ON PROP.PROPERTY_CD = CMPMS_SUB.PROPERTY_CODE
			WHERE OPERATION_TYPE NOT IN (0,5,8)
                    ) CMPMS_SUB
                JOIN DAAS_CORE_CUSTOMER_VW.GUEST_XREF_BRIDGE_LKP_VW BRDG
                   ON CMPMS_SUB.GUEST_UNIQUE_ID = BRDG.XREF_ACCOUNT_NBR

                QUALIFY ROW_NUMBER() OVER(PARTITION BY CMPMS_SUB.PROPERTY_CD, BRDG.PRIMARY_ACCOUNT_NBR
                    ORDER BY CMBTMS ASC -- cms xref field, 0 if none.
                        ,CASE WHEN CMPMS_SUB.GUEST_UNIQUE_ID = BRDG.PRIMARY_ACCOUNT_NBR THEN 1 ELSE 0 END DESC -- check if the account is the same as their primary account, if so, give them priority
                        ,CASE WHEN COALESCE(REPNO,'') <> ''  THEN 1 ELSE 0 END DESC -- if one of the accounts is hosted but the other isn't, prioritize the one with a host
                        ,CASE SCDEMS -- account status -- XX = combined, D is deleted, C is closed, H is STOP, I is SUSPEND -- choose those last.
                            WHEN 'X' THEN 1
                            WHEN 'D' THEN 2
                            WHEN 'C' THEN 3
                            WHEN 'H' THEN 4
                            WHEN 'I' THEN 5
                         ELSE 6 END DESC
                        ,REPNO DESC
                        ,CASE CESTD WHEN 0 THEN 99999 ELSE CESTD END ASC -- established date. prioritize the one with less - unless it's 0.
                        ,"ALIM$" DESC -- give priority to the account with the highest available credit limit
                        ,OPERATION_DATE DESC -- finally give priority to latest record.
                    ) = 1
            ) CAS_DTL
            FULL JOIN (
                SELECT PROPERTY_CD, GUEST_UNIQUE_ID, LOCAL_WINNET, LOCAL_CASINO_NBR, SOURCE_UPDATED_DTTM, CMPMS.REPNO AS HOST_CD
                FROM (select PROP.PROPERTY_CD
                      , BRDG.PRIMARY_ACCOUNT_NBR AS GUEST_UNIQUE_ID
                      , BRDG.PRIMARY_ACCOUNT_NBR AS LOCAL_WINNET
                      , GST.GUEST_ID  AS LOCAL_CASINO_NBR
                      , GST.CREATED_DT AS SOURCE_UPDATED_DTTM
                 from DAAS_CORE_CUSTOMER_VW.GUEST_XREF_BRIDGE_LKP_VW BRDG
                          JOIN DAAS_CORE_CUSTOMER_VW.PROPERTY_DIM_VW PROP
                               ON SUBSTR(BRDG.PRIMARY_ACCOUNT_NBR, 1, 3) = PROP.PROPERTY_ID
                          JOIN DAAS_CORE_CUSTOMER_VW.GUEST_DIM_VW GST
                            ON BRDG.PRIMARY_ACCOUNT_NBR = GST.GUEST_UNIQUE_ID
                 ) CAS_DTL
		LEFT JOIN (
			SELECT PROPERTY_CODE, CMSID,  CMBTMS, SCDEMS, CTYPMS, CESTD, REPNO, OPERATION_TYPE FROM
			(
				SELECT PROPERTY_CODE, CMSID,  CMBTMS, SCDEMS, CTYPMS, CESTD, REPNO, OPERATION_TYPE
				FROM DAAS_RAW_HETCMS.CMPMS_RAW
				QUALIFY ROW_NUMBER() OVER(PARTITION BY PROPERTY_CODE, CMSID ORDER BY OPERATION_DATE DESC, OPERATION_SEQUENCE_NBR DESC, CREATED_DATE DESC )=1
                        ) CMPMS_SUB
			WHERE OPERATION_TYPE NOT IN (0,5,8)
		) CMPMS
		 ON CAS_DTL.PROPERTY_CD = CMPMS.PROPERTY_CODE
		 AND CAS_DTL.LOCAL_CASINO_NBR = CMPMS.CMSID
            ) PRIMARY
            ON CAS_DTL.GUEST_UNIQUE_ID = PRIMARY.GUEST_UNIQUE_ID
            AND CAS_DTL.PROPERTY_CD = PRIMARY.PROPERTY_CD

    -- dedupe primary account nbr + property cd, prioritize CMPMS
    QUALIFY ROW_NUMBER() OVER(PARTITION BY COALESCE(CAS_DTL.GUEST_UNIQUE_ID,PRIMARY.GUEST_UNIQUE_ID), COALESCE(CAS_DTL.PROPERTY_CD,PRIMARY.PROPERTY_CD)
        ORDER BY COALESCE(CAS_DTL.SOURCE_UPDATED_DTTM,DATE'1899-12-31'::TIMESTAMP) DESC
            , COALESCE(PRIMARY.SOURCE_UPDATED_DTTM,DATE'1899-12-31'::TIMESTAMP) DESC) = 1
        ;
END;

-- CREATE OR REPLACE leaves the task suspended. Keep this line if the other task files end with it;
-- drop it if the deploy resumes tasks itself.
ALTER TASK DAAS_COMMON.DT_GUEST_XREF_PROP_LOCAL_ACCOUNT RESUME;